###############################################################################
# LANCommander line-ending policy
#
# The repository stores every text file as LF. Working trees get CRLF by
# default, because the bulk of this codebase is Windows-targeted (.NET,
# Avalonia, PowerShell, MSBuild). Files below that are executed by a Linux or
# macOS shell, a container, or a CI runner are forced to LF.
#
# `text=auto` is used on directory-wide rules so git's binary detection still
# applies and never mangles an asset that lands in a matched directory.
###############################################################################

# Default: normalize to LF in the repo, check out CRLF.
* text=auto eol=crlf

###############################################################################
# LF required | consumed by Linux/macOS shells, containers and CI
###############################################################################

# Shell scripts
*.sh              text eol=lf
*.bash            text eol=lf

# Containers
Dockerfile        text eol=lf
Dockerfile.*      text eol=lf
*.dockerfile      text eol=lf
.dockerignore     text eol=lf
docker-compose*.yml   text eol=lf
docker-compose*.yaml  text eol=lf
compose*.yml          text eol=lf
compose*.yaml         text eol=lf

# Make / CMake driven builds
Makefile          text eol=lf
makefile          text eol=lf
GNUmakefile       text eol=lf
*.mk              text eol=lf
CMakeLists.txt    text eol=lf
*.cmake           text eol=lf

# GitHub Actions
.github/**        text=auto eol=lf

# Cross-platform scripting
*.py              text eol=lf
*.pl              text eol=lf
*.rb              text eol=lf

# Linux desktop integration & packaging
*.desktop         text eol=lf
*.service         text eol=lf
*.socket          text eol=lf
*.timer           text eol=lf
*.appdata.xml     text eol=lf
*.metainfo.xml    text eol=lf
*.rules           text eol=lf
*.spec            text eol=lf
PKGBUILD          text eol=lf

# Git / editor dotfiles read by POSIX tooling
.gitattributes    text eol=lf
.gitignore        text eol=lf
.gitmodules       text eol=lf
.editorconfig     text eol=lf
.mailmap          text eol=lf

###############################################################################
# CRLF required | Windows
###############################################################################
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.reg             text eol=crlf

# Windows-native tooling (redundant with the default, stated for intent)
*.ps1             text eol=crlf
*.psm1            text eol=crlf
*.psd1            text eol=crlf
*.sln             text eol=crlf
*.slnx            text eol=crlf
*.csproj          text eol=crlf
*.props           text eol=crlf
*.targets         text eol=crlf
*.manifest        text eol=crlf
*.rc              text eol=crlf

