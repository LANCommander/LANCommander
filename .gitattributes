###############################################################################
# Vendored & generated | keep out of language stats and diffs
###############################################################################
LANCommander.Server/wwwroot/lib/**        linguist-vendored
LANCommander.Launcher.Legacy/vendor/**    linguist-vendored
LANCommander.SDK.Cpp/vendor/**            linguist-vendored

*.min.js   -diff linguist-generated
*.min.css  -diff linguist-generated
*.map      -diff linguist-generated
LANCommander.Server/wwwroot/lib/dropzone/dist/dropzone-min.js -diff linguist-generated

# EF Core model snapshots are machine-written and enormous
**/Migrations/DatabaseContextModelSnapshot.cs -diff linguist-generated

###############################################################################
# Diff drivers | richer hunk headers
###############################################################################
*.cs      diff=csharp
*.cshtml  diff=html
*.razor   diff=html
*.html    diff=html
*.css     diff=css
*.scss    diff=css
*.md      diff=markdown
*.mdx     diff=markdown
*.c       diff=cpp
*.h       diff=cpp
*.cpp     diff=cpp
*.py      diff=python
*.ts      diff=typescript
*.js      diff=javascript
