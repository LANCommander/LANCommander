// Generated by CMake from launcher.rc.in — do not edit.

// Application icon — shown in taskbar, Alt+Tab, and title bar.
// Absolute path because this file is generated into the build tree, away from
// the icon; both windres and rc.exe accept forward slashes here.
IDI_ICON1 ICON "@LAUNCHER_ICON_PATH@"

// The login backgrounds used to be embedded here as RCDATA and read with
// FindResourceA. They now ship as files under assets/backgrounds/ and load
// through decode_image_asset(), because RT_RCDATA is Win32-only and would
// block a DOS build. The EXE icon has to stay a Win32 resource.

// ---------------------------------------------------------------------------
// Version information — surfaces in the .exe's Properties > Details pane.
// ---------------------------------------------------------------------------
// Literal 1 is VS_VERSION_INFO, and the flag values below are spelled out
// numerically, so this compiles without <winver.h>. The Win9x target builds
// under MinGW where pulling in that header has historically been a nuisance.
//
// FILEVERSION cannot carry a prerelease suffix — it is four 16-bit integers —
// so the "-39-geaa9f520" part of a dev version survives only in the string
// fields below. The fourth integer is the commit count since the tag.
1 VERSIONINFO
FILEVERSION    @LAUNCHER_VERSION_MAJOR@,@LAUNCHER_VERSION_MINOR@,@LAUNCHER_VERSION_PATCH@,@LAUNCHER_VERSION_TWEAK@
PRODUCTVERSION @LAUNCHER_VERSION_MAJOR@,@LAUNCHER_VERSION_MINOR@,@LAUNCHER_VERSION_PATCH@,@LAUNCHER_VERSION_TWEAK@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x4L          // VOS__WINDOWS32 — generic Win32, not NT-only.
FILETYPE 0x1L        // VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "LANCommander"
            VALUE "FileDescription",  "LANCommander Launcher"
            VALUE "FileVersion",      "@LAUNCHER_VERSION@"
            VALUE "InternalName",     "LANCommander"
            VALUE "LegalCopyright",   "LANCommander"
            VALUE "OriginalFilename", "LANCommander.exe"
            VALUE "ProductName",      "LANCommander Launcher"
            VALUE "ProductVersion",   "@LAUNCHER_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
