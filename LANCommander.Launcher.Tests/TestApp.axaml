<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LANCommander.Launcher.Tests.TestApp"
             RequestedThemeVariant="Dark">
    <!-- The launcher's own theme, so screenshots and baselines look like the real app. -->
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://LANCommander.Launcher/Theme/AppStyles.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://LANCommander.Launcher/Theme/AppResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
