<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>LANCommanderDark.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Plugin allowlist for the bundled VLC runtime. Imported before the NuGet's own
       targets so its "copy everything" defaults never apply. -->
  <Import Project="$(MSBuildThisFileDirectory)..\build\VlcPlugins.props" />

  <!-- VideoLAN.LibVLC.Windows copies win-x86, win-x64 *and* win-arm64 into every
       build, because its targets key off $(Platform) (AnyCPU for us) rather than
       $(RuntimeIdentifier). That put ~180 MB of foreign-architecture binaries into
       every publish and every local build. Disable all three, then re-enable only
       the one we are actually building for. -->
  <PropertyGroup>
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <VlcWindowsX86Enabled>true</VlcWindowsX86Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <VlcWindowsArm64Enabled>true</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <!-- No RID means a local build or `dotnet run`; x64 is the sensible default there. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == ''">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
  </PropertyGroup>

  <!-- Ships alongside the bundled libvlc/FFmpeg it covers. LGPL requires the notice to
       reach the user, not just the repository. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Svg.Skia" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HotAvalonia" PrivateAssets="All" Publish="True" />
    <PackageReference Include="ByteSize" />
    <PackageReference Include="LiveChartsCore" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Notify.NET" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="$(RuntimeIdentifier.StartsWith('win')) OR ($([MSBuild]::IsOSPlatform('Windows')) AND '$(RuntimeIdentifier)' == '')" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ($([MSBuild]::IsOSPlatform('OSX')) AND '$(RuntimeIdentifier)' == '')" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LANCommander.Launcher.Tests" />
  </ItemGroup>

  <!-- The Interposer's DLL and injector for both architectures go under Data\Libraries\Interposer\
       (see LauncherLibraries), not loose beside the executable. They stay real files because they
       are injected into and run as games. -->
  <PropertyGroup>
    <InterposerNativeOutputPath>Data\Libraries\Interposer\</InterposerNativeOutputPath>
    <InterposerCopyApplicationDll>false</InterposerCopyApplicationDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.Packaging.Worker.Core\LANCommander.Packaging.Worker.Core.csproj" />
    <ProjectReference Include="..\LANCommander.Launcher.Plugins\LANCommander.Launcher.Plugins.csproj" />
    <ProjectReference Include="..\LANCommander.Launcher.Services\LANCommander.Launcher.Services.csproj" />
    <ProjectReference Include="..\LANCommander.Launcher.Settings\LANCommander.Launcher.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaXaml Remove="Theme\ColorPalette.axaml" />
    <AvaloniaResource Include="Theme\ColorPalette.axaml" />
    <AvaloniaXaml Remove="Theme\LANCommander.axaml" />
    <AvaloniaResource Include="Theme\LANCommander.axaml" />
  </ItemGroup>

  <!--
    Packaging workers.

    DLL injection requires the injector and its target to share a bitness. The launcher is the
    worker for its own architecture (started again with packaging-worker arguments; see Program.cs),
    so a separate worker is only published for each architecture it is not, into
    Data\Libraries\Packaging\{arch}\. They are deliberately NOT publish inputs of the launcher: as
    Content they would be swept into the single-file bundle by IncludeAllContentForSelfExtract and
    extracted to %TEMP%, which makes an executable that injects DLLs look exactly like a dropper.

    The worker is Native AOT, which needs MSVC on a Windows machine; pass
    -p:PackagingWorkerAot=false to build a self-contained single file instead.

    CI publishes them with an explicit job (see .github/workflows/LANCommander.Launcher.yml).
    This target covers local development so `dotnet run` finds them.
  -->
  <PropertyGroup>
    <PackagingWorkerProject>$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker\LANCommander.Packaging.Worker.csproj</PackagingWorkerProject>

    <!-- Set BuildPackagingWorkers=false to skip the worker publish entirely. -->
    <BuildPackagingWorkers Condition="'$(BuildPackagingWorkers)' == '' AND '$(OS)' == 'Windows_NT'">true</BuildPackagingWorkers>
    <BuildPackagingWorkers Condition="'$(BuildPackagingWorkers)' == ''">false</BuildPackagingWorkers>

    <!-- Keyed by the launcher's runtime, because that decides which workers are needed. -->
    <PackagingWorkersRuntimeKey>$(RuntimeIdentifier)</PackagingWorkersRuntimeKey>
    <PackagingWorkersRuntimeKey Condition="'$(PackagingWorkersRuntimeKey)' == ''">portable</PackagingWorkersRuntimeKey>
  </PropertyGroup>

  <!-- The architectures the launcher cannot be the worker for. No RID is a local x64 build. -->
  <ItemGroup>
    <PackagingWorkerArchitecture Include="x86" Condition="'$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == 'win-arm64'" />
    <PackagingWorkerArchitecture Include="x64" Condition="'$(RuntimeIdentifier)' == 'win-x86' OR '$(RuntimeIdentifier)' == 'win-arm64'" />
  </ItemGroup>

  <ItemGroup>
    <PackagingWorkerSource Include="$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker\**\*.cs;$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker.Core\**\*.cs;$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Abstractions\**\*.cs"
                           Exclude="$(MSBuildThisFileDirectory)..\LANCommander.Packaging.*\bin\**;$(MSBuildThisFileDirectory)..\LANCommander.Packaging.*\obj\**" />
    <PackagingWorkerSource Include="$(PackagingWorkerProject)" />
  </ItemGroup>

  <!-- OutDir is defined by the common targets, which import after this file's body, so output
       paths have to be computed at execution time rather than in a body PropertyGroup. -->
  <Target Name="ResolvePackagingWorkerPaths">
    <PropertyGroup>
      <PackagingWorkersStagingDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\artifacts\packaging-workers\$(Configuration)\launcher-$(PackagingWorkersRuntimeKey)\'))</PackagingWorkersStagingDir>
      <PackagingWorkersOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(OutDir)Data\Libraries\Packaging\'))</PackagingWorkersOutputDir>
      <PackagingWorkersStamp>$(PackagingWorkersOutputDir).stamp</PackagingWorkersStamp>

      <!-- Beside staging rather than in it, which is copied wholesale. Publish copies from
           staging, so its being current matters as much as the build output's. -->
      <PackagingWorkersStagingStamp>$([System.IO.Path]::TrimEndingDirectorySeparator('$(PackagingWorkersStagingDir)')).stamp</PackagingWorkersStagingStamp>
    </PropertyGroup>

    <ItemGroup>
      <_PackagingWorkerPublish Include="$(PackagingWorkerProject)">
        <AdditionalProperties>RuntimeIdentifier=win-%(PackagingWorkerArchitecture.Identity);PublishDir=$(PackagingWorkersStagingDir)%(PackagingWorkerArchitecture.Identity)\</AdditionalProperties>
      </_PackagingWorkerPublish>
    </ItemGroup>
  </Target>

  <!-- Inputs/Outputs matter here: without them every incremental build would re-publish the
       workers, which takes minutes under Native AOT. -->
  <Target Name="PublishPackagingWorkers"
          AfterTargets="Build"
          DependsOnTargets="ResolvePackagingWorkerPaths"
          Condition="'$(BuildPackagingWorkers)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '@(PackagingWorkerArchitecture)' != ''"
          Inputs="@(PackagingWorkerSource)"
          Outputs="$(PackagingWorkersStamp);$(PackagingWorkersStagingStamp)">

    <Message Importance="high" Text="Publishing packaging workers (@(PackagingWorkerArchitecture)) to $(PackagingWorkersStagingDir)" />

    <!-- Everything under staging is copied, so nothing from an earlier publish may linger. -->
    <RemoveDir Directories="$(PackagingWorkersStagingDir);$(PackagingWorkersOutputDir)" />

    <!-- Nothing references the worker project, so restoring the launcher does not restore it.
         The extra property gives the restore its own evaluation, which MSBuild requires before
         building in the same session. -->
    <MSBuild Projects="$(PackagingWorkerProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);PackagingWorkerAot=$(PackagingWorkerAot);_PackagingWorkerRestore=true" />

    <!-- TargetFramework is set explicitly because the MSBuild task passes the calling project's
         global properties through; pinning it keeps the worker on the framework it targets. -->
    <MSBuild Projects="@(_PackagingWorkerPublish)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;SelfContained=true;PackagingWorkerAot=$(PackagingWorkerAot)" />

    <ItemGroup>
      <StagedPackagingWorkerFile Include="$(PackagingWorkersStagingDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(StagedPackagingWorkerFile)"
          DestinationFiles="@(StagedPackagingWorkerFile->'$(PackagingWorkersOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Touch Files="$(PackagingWorkersStamp);$(PackagingWorkersStagingStamp)" AlwaysCreate="true" />
  </Target>

  <!-- CI publishes the workers in a Windows job of its own (the launcher job runs on Linux, where
       the target above does not run). This mirrors that for a local publish so a developer can
       test a packaged build without reproducing the workflow by hand. -->
  <Target Name="CopyPackagingWorkersToPublishDir"
          AfterTargets="Publish"
          DependsOnTargets="PublishPackagingWorkers"
          Condition="'$(BuildPackagingWorkers)' == 'true' AND '$(DesignTimeBuild)' != 'true' AND '@(PackagingWorkerArchitecture)' != ''">

    <ItemGroup>
      <PackagingWorkerFile Include="$(PackagingWorkersStagingDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PackagingWorkerFile)"
          DestinationFiles="@(PackagingWorkerFile->'$(PublishDir)Data\Libraries\Packaging\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
