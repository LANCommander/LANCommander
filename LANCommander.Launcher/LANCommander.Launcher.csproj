<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>LANCommanderDark.ico</ApplicationIcon>
    <!-- Single source of truth: derives AssemblyVersion, FileVersion and InformationalVersion.
         Release builds override it with -p:Version from the tag. -->
    <Version>2.1.10</Version>
  </PropertyGroup>

  <!-- Plugin allowlist for the bundled VLC runtime. Imported before the NuGet's own
       targets so its "copy everything" defaults never apply. -->
  <Import Project="$(MSBuildThisFileDirectory)..\build\VlcPlugins.props" />

  <!-- VideoLAN.LibVLC.Windows copies win-x86, win-x64 *and* win-arm64 into every
       build, because its targets key off $(Platform) (AnyCPU for us) rather than
       $(RuntimeIdentifier). That put ~180 MB of foreign-architecture binaries into
       every publish and every local build. Disable all three, then re-enable only
       the one we are actually building for. -->
  <PropertyGroup>
    <VlcWindowsX64Enabled>false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <VlcWindowsX86Enabled>true</VlcWindowsX86Enabled>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <VlcWindowsArm64Enabled>true</VlcWindowsArm64Enabled>
  </PropertyGroup>
  <!-- No RID means a local build or `dotnet run`; x64 is the sensible default there. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == ''">
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
  </PropertyGroup>

  <!-- Ships alongside the bundled libvlc/FFmpeg it covers. LGPL requires the notice to
       reach the user, not just the repository. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.ReactiveUI" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="Avalonia.Svg.Skia" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="HotAvalonia" PrivateAssets="All" Publish="True" />
    <PackageReference Include="ByteSize" />
    <PackageReference Include="LiveChartsCore" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Notify.NET" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="LibVLCSharp" />
    <PackageReference Include="LibVLCSharp.Avalonia" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Condition="$(RuntimeIdentifier.StartsWith('win')) OR ($([MSBuild]::IsOSPlatform('Windows')) AND '$(RuntimeIdentifier)' == '')" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Condition="$(RuntimeIdentifier.StartsWith('osx')) OR ($([MSBuild]::IsOSPlatform('OSX')) AND '$(RuntimeIdentifier)' == '')" />
    <PackageReference Include="ppy.SDL3-CS" />
  </ItemGroup>

  <!-- On the Windows-desktop TFM, LibVLCSharp drags in Microsoft.WindowsAppSDK (for its unused WinUI
       integration; we use LibVLCSharp.Avalonia). Its buildTransitive targets force a legacy UWP
       RuntimeIdentifiers list that breaks framework-pack resolution (NETSDK1082/1083). Reference it
       directly with all assets excluded so those targets aren't imported. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="Microsoft.WindowsAppSDK" VersionOverride="1.1.1" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LANCommander.Launcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.Launcher.Plugins\LANCommander.Launcher.Plugins.csproj" />
    <ProjectReference Include="..\LANCommander.Launcher.Services\LANCommander.Launcher.Services.csproj" />
    <ProjectReference Include="..\LANCommander.Launcher.Settings\LANCommander.Launcher.Settings.csproj" />

    <!-- GameOverlay.Capture: platform-neutral API plus a per-OS backend that self-registers at runtime. -->
    <ProjectReference Include="..\External\GameOverlay.Capture\src\GameOverlay.Capture\GameOverlay.Capture.csproj" />

    <!-- Windows backend (net10.0-windows10.0.19041.0) -->
    <ProjectReference Include="..\External\GameOverlay.Capture\src\GameOverlay.Capture.Windows\GameOverlay.Capture.Windows.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'" />

    <!-- Linux / macOS backends (net10.0) -->
    <ProjectReference Include="..\External\GameOverlay.Capture\src\GameOverlay.Capture.Linux\GameOverlay.Capture.Linux.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\External\GameOverlay.Capture\src\GameOverlay.Capture.MacOS\GameOverlay.Capture.MacOS.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaXaml Remove="Theme\ColorPalette.axaml" />
    <AvaloniaResource Include="Theme\ColorPalette.axaml" />
    <AvaloniaXaml Remove="Theme\LANCommander.axaml" />
    <AvaloniaResource Include="Theme\LANCommander.axaml" />
  </ItemGroup>

  <!--
    Packaging workers.

    DLL injection requires the injector and its target to share a bitness, so one worker is
    published per architecture into Packaging\{rid}\ beside the launcher. They are deliberately
    NOT publish inputs of the launcher: as Content they would be swept into the single-file
    bundle by IncludeAllContentForSelfExtract and re-extracted to %TEMP% on every launch, which
    is slow and makes an executable that injects DLLs look exactly like a dropper.

    CI publishes them with an explicit step (see .github/workflows/LANCommander.Launcher.yml).
    This target covers local development so `dotnet run` finds them.
  -->
  <PropertyGroup>
    <PackagingWorkerProject>$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker\LANCommander.Packaging.Worker.csproj</PackagingWorkerProject>

    <!-- Set BuildPackagingWorkers=false to skip the worker publish entirely. -->
    <BuildPackagingWorkers Condition="'$(BuildPackagingWorkers)' == '' AND '$(OS)' == 'Windows_NT'">true</BuildPackagingWorkers>
    <BuildPackagingWorkers Condition="'$(BuildPackagingWorkers)' == ''">false</BuildPackagingWorkers>
  </PropertyGroup>

  <ItemGroup>
    <PackagingWorkerSource Include="$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker\**\*.cs"
                           Exclude="$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker\bin\**;$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Worker\obj\**" />
    <PackagingWorkerSource Include="$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Abstractions\**\*.cs"
                           Exclude="$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Abstractions\bin\**;$(MSBuildThisFileDirectory)..\LANCommander.Packaging.Abstractions\obj\**" />
    <PackagingWorkerSource Include="$(PackagingWorkerProject)" />
  </ItemGroup>

  <!-- OutDir is defined by the common targets, which import after this file's body, so output
       paths have to be computed at execution time rather than in a body PropertyGroup. -->
  <Target Name="ResolvePackagingWorkerPaths">
    <PropertyGroup>
      <!-- Staging is shared across target frameworks and the properties passed to the worker
           publish are identical from every inner build, so MSBuild coalesces them into one
           build rather than running two concurrently over the same obj directory. -->
      <PackagingWorkersStagingDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\artifacts\packaging-workers\$(Configuration)\'))</PackagingWorkersStagingDir>

      <!-- The stamp is per target framework. A shared one is what two inner builds actually
           collide on (MSB3371), because each writes its own. -->
      <PackagingWorkersOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(OutDir)Packaging\'))</PackagingWorkersOutputDir>
      <PackagingWorkersStamp>$(PackagingWorkersOutputDir).stamp</PackagingWorkersStamp>
    </PropertyGroup>
  </Target>

  <!-- Inputs/Outputs matter here: without them every incremental build would re-publish two
       self-contained trimmed applications, which takes minutes. -->
  <Target Name="PublishPackagingWorkers"
          AfterTargets="Build"
          DependsOnTargets="ResolvePackagingWorkerPaths"
          Condition="'$(BuildPackagingWorkers)' == 'true' AND '$(DesignTimeBuild)' != 'true'"
          Inputs="@(PackagingWorkerSource)"
          Outputs="$(PackagingWorkersStamp)">

    <Message Importance="high" Text="Publishing packaging workers to $(PackagingWorkersStagingDir)" />

    <!-- TargetFramework must be set explicitly. The MSBuild task passes the calling project's
         global properties through, and this launcher is multi-targeted, so its
         net10.0-windows inner build would otherwise ask the worker — which only targets
         net10.0 — to build for a framework it does not have (NETSDK1005). -->
    <MSBuild Projects="$(PackagingWorkerProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(PackagingWorkersStagingDir)win-x64\" />

    <MSBuild Projects="$(PackagingWorkerProject)"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=win-x86;SelfContained=true;PublishSingleFile=false;PublishDir=$(PackagingWorkersStagingDir)win-x86\" />

    <!-- Copy into this target framework's output so `dotnet run -f <tfm>` and an IDE run
         configuration both find the workers, whichever framework they use. -->
    <ItemGroup>
      <StagedPackagingWorkerFile Include="$(PackagingWorkersStagingDir)**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(StagedPackagingWorkerFile)"
          DestinationFiles="@(StagedPackagingWorkerFile->'$(PackagingWorkersOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Touch Files="$(PackagingWorkersStamp)" AlwaysCreate="true" />
  </Target>

  <!-- CI publishes the workers with its own step (the runner is Linux, where the target above
       does not run). This mirrors that for a local publish so a developer can test a packaged
       build without reproducing the workflow by hand. -->
  <Target Name="CopyPackagingWorkersToPublishDir"
          AfterTargets="Publish"
          DependsOnTargets="PublishPackagingWorkers"
          Condition="'$(BuildPackagingWorkers)' == 'true' AND '$(DesignTimeBuild)' != 'true'">

    <ItemGroup>
      <PackagingWorkerFile Include="$(PackagingWorkersStagingDir)**\*" Exclude="$(PackagingWorkersStamp)" />
    </ItemGroup>

    <Copy SourceFiles="@(PackagingWorkerFile)"
          DestinationFiles="@(PackagingWorkerFile->'$(PublishDir)Packaging\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
