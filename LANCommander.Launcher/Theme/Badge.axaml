<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LANCommander.Launcher.Controls">

        <!-- Badge: a clickable tag (developer, genre, tag). Surface with a hairline edge, secondary text;
             steps up to Raised on hover. -->
        <Style Selector="Button.Badge">
                <Setter Property="Padding" Value="11,0" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.Badge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderStrongBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.Badge:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
        </Style>

        <Style Selector="Button.Badge TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
                <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- "Show more" among badges: an accent text link rather than another chip -->
        <Style Selector="Button.Badge.Primary">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.Badge.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.Badge.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Button.Badge.Primary /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}" />
        </Style>

        <Style Selector="StackPanel.Badges">
                <Setter Property="Spacing" Value="10" />
        </Style>

        <Style Selector="StackPanel.Badges Button.Badge">
                <Setter Property="Margin" Value="0, 0, 8, 8" />
        </Style>

        <!-- Section label above a group of badges: the kicker style -->
        <Style Selector="StackPanel.Badges TextBlock.Header">
                <Setter Property="FontSize" Value="{DynamicResource FontSizeKicker}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="LetterSpacing" Value="0.9" />
                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>

</Styles>
