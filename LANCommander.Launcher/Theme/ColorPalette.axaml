<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ===================== -->
  <!-- Primary (Blue) Scale  -->
  <!-- ===================== -->
  <Color x:Key="Primary1">#E6F4FF</Color>
  <Color x:Key="Primary2">#BAE0FF</Color>
  <Color x:Key="Primary3">#91CAFF</Color>
  <Color x:Key="Primary4">#69B1FF</Color>
  <Color x:Key="Primary5">#4096FF</Color>
  <Color x:Key="Primary6">#1677FF</Color> <!-- Base -->
  <Color x:Key="Primary7">#0958D9</Color>
  <Color x:Key="Primary8">#003EB3</Color>
  <Color x:Key="Primary9">#002C8C</Color>
  <Color x:Key="Primary10">#001D66</Color>

  <!-- ===================== -->
  <!-- Success (Green)       -->
  <!-- ===================== -->
  <Color x:Key="Success1">#F6FFED</Color>
  <Color x:Key="Success2">#D9F7BE</Color>
  <Color x:Key="Success3">#B7EB8F</Color>
  <Color x:Key="Success4">#95DE64</Color>
  <Color x:Key="Success5">#73D13D</Color>
  <Color x:Key="Success6">#52C41A</Color>
  <Color x:Key="Success7">#389E0D</Color>
  <Color x:Key="Success8">#237804</Color>
  <Color x:Key="Success9">#135200</Color>
  <Color x:Key="Success10">#092B00</Color>

  <!-- ===================== -->
  <!-- Warning (Gold)        -->
  <!-- ===================== -->
  <Color x:Key="Warning1">#FFFBE6</Color>
  <Color x:Key="Warning2">#FFF1B8</Color>
  <Color x:Key="Warning3">#FFE58F</Color>
  <Color x:Key="Warning4">#FFD666</Color>
  <Color x:Key="Warning5">#FFC53D</Color>
  <Color x:Key="Warning6">#FAAD14</Color>
  <Color x:Key="Warning7">#D48806</Color>
  <Color x:Key="Warning8">#AD6800</Color>
  <Color x:Key="Warning9">#874D00</Color>
  <Color x:Key="Warning10">#613400</Color>

  <!-- ===================== -->
  <!-- Error (Red)           -->
  <!-- ===================== -->
  <Color x:Key="Error1">#FFF2F0</Color>
  <Color x:Key="Error2">#FFF1F0</Color>
  <Color x:Key="Error3">#FFCCC7</Color>
  <Color x:Key="Error4">#FFA39E</Color>
  <Color x:Key="Error5">#FF7875</Color>
  <Color x:Key="Error6">#FF4D4F</Color>
  <Color x:Key="Error7">#CF1322</Color>
  <Color x:Key="Error8">#A8071A</Color>
  <Color x:Key="Error9">#820014</Color>
  <Color x:Key="Error10">#5C0011</Color>

  <!-- ===================== -->
  <!-- Neutral (Gray)        -->
  <!-- ===================== -->
  <!-- Dark scale: 1=darkest → 13=lightest -->
  <Color x:Key="Gray1">#000000</Color>
  <Color x:Key="Gray2">#141414</Color>
  <Color x:Key="Gray3">#1F1F1F</Color>
  <Color x:Key="Gray4">#282828</Color>
  <Color x:Key="Gray5">#303030</Color>
  <Color x:Key="Gray6">#3A3A3A</Color>
  <Color x:Key="Gray7">#424242</Color>
  <Color x:Key="Gray8">#595959</Color>
  <Color x:Key="Gray9">#8C8C8C</Color>
  <Color x:Key="Gray10">#BFBFBF</Color>
  <Color x:Key="Gray11">#D9D9D9</Color>
  <Color x:Key="Gray12">#F0F0F0</Color>
  <Color x:Key="Gray13">#FFFFFF</Color>

  <!-- ===================== -->
  <!-- Semantic Tokens       -->
  <!-- ===================== -->
  <Color x:Key="ColorPrimary">#1677FF</Color>
  <Color x:Key="ColorSuccess">#49AA19</Color>
  <Color x:Key="ColorWarning">#D89614</Color>
  <Color x:Key="ColorError">#DC4446</Color>

  <Color x:Key="TextPrimary">#D9FFFFFF</Color>
  <Color x:Key="TextSecondary">#A6FFFFFF</Color>
  <Color x:Key="TextTertiary">#8CFFFFFF</Color>
  <Color x:Key="TextDisabled">#66FFFFFF</Color>

  <Color x:Key="BackgroundBase">#141414</Color>
  <Color x:Key="BackgroundLayout">#000000</Color>

  <!-- ===================== -->
  <!-- Role Tokens           -->
  <!-- ===================== -->
  <!-- Surface ramp: one job per Gray step. Views should use these rather than raw hex or Fluent Chrome brushes. -->
  <!-- Canvas:  window background, title bar, rails, footer -->
  <!-- Chrome:  recessed wells (segment tracks, progress troughs) -->
  <!-- Surface: cards, list groups, dialogs -->
  <!-- Raised:  selected rows, inputs, secondary buttons, nested controls -->
  <!-- Popover: flyouts, menus, toasts -->

  <!-- Hairlines: 1px edge on every surface, plus a lit top edge on Surface and above -->
  <Color x:Key="HairlineBorder">#1AFFFFFF</Color>
  <Color x:Key="HairlineBorderStrong">#24FFFFFF</Color>
  <Color x:Key="HairlineDivider">#12FFFFFF</Color>
  <Color x:Key="HairlineHighlight">#12FFFFFF</Color>

  <!-- State overlays, laid over whatever the control's own fill is -->
  <Color x:Key="StateHover">#0FFFFFFF</Color>
  <Color x:Key="StatePressed">#1CFFFFFF</Color>
  <Color x:Key="FocusRing">#4096FF</Color>

  <!-- Accent and status: fill behind white text, tint when the colour carries text on a dark surface -->
  <Color x:Key="AccentFill">#177DDC</Color>
  <Color x:Key="AccentText">#4096FF</Color>
  <Color x:Key="SuccessText">#73D13D</Color>
  <Color x:Key="WarningText">#FFC53D</Color>
  <Color x:Key="ErrorText">#FF7875</Color>

  <!-- Dialog scrim -->
  <Color x:Key="Scrim">#A8000000</Color>

  <!-- Shadow only for what floats -->
  <BoxShadows x:Key="PopoverShadow">0 12 32 0 #8C000000</BoxShadows>
  <BoxShadows x:Key="DialogShadow">0 24 64 0 #C7000000</BoxShadows>
  <BoxShadows x:Key="SurfaceHighlightShadow">inset 0 1 0 0 #12FFFFFF</BoxShadows>
  <BoxShadows x:Key="FocusRingShadow">inset 0 0 0 2 #4096FF</BoxShadows>
  <BoxShadows x:Key="NoShadow">0 0 0 0 #00000000</BoxShadows>

  <!-- Hairline edges drawn as inset shadows, so they cost no layout: 1px ring plus the lit top edge -->
  <BoxShadows x:Key="HairlineShadow">inset 0 0 0 1 #1AFFFFFF, inset 0 1 0 0 #12FFFFFF</BoxShadows>
  <BoxShadows x:Key="HairlineHoverShadow">inset 0 0 0 1 #24FFFFFF, inset 0 1 0 0 #17FFFFFF</BoxShadows>
  <BoxShadows x:Key="HairlinePressedShadow">inset 0 0 0 1 #1AFFFFFF</BoxShadows>
  <!-- Solid (accent/status) fills get only the lit top edge, brighter since it sits on colour -->
  <BoxShadows x:Key="SolidHighlightShadow">inset 0 1 0 0 #24FFFFFF</BoxShadows>

  <!-- Radius: three steps plus full -->
  <CornerRadius x:Key="RadiusSmall">2</CornerRadius>  <!-- icon tiles, badges -->
  <CornerRadius x:Key="RadiusMedium">4</CornerRadius> <!-- buttons, rows, tags, covers -->
  <CornerRadius x:Key="RadiusLarge">6</CornerRadius>  <!-- cards, panels, popovers, large buttons -->
  <CornerRadius x:Key="RadiusFull">999</CornerRadius> <!-- count pills, dots -->

  <!-- ===================== -->
  <!-- Brushes (Auto-map)    -->
  <!-- ===================== -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundBase}" />

  <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="{StaticResource Gray1}" />
  <SolidColorBrush x:Key="SurfaceChromeBrush" Color="{StaticResource Gray2}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Gray3}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource Gray4}" />
  <SolidColorBrush x:Key="SurfacePopoverBrush" Color="{StaticResource Gray5}" />

  <SolidColorBrush x:Key="HairlineBorderBrush" Color="{StaticResource HairlineBorder}" />
  <SolidColorBrush x:Key="HairlineBorderStrongBrush" Color="{StaticResource HairlineBorderStrong}" />
  <SolidColorBrush x:Key="HairlineDividerBrush" Color="{StaticResource HairlineDivider}" />

  <SolidColorBrush x:Key="StateHoverBrush" Color="{StaticResource StateHover}" />
  <SolidColorBrush x:Key="StatePressedBrush" Color="{StaticResource StatePressed}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRing}" />

  <SolidColorBrush x:Key="AccentFillBrush" Color="{StaticResource AccentFill}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentText}" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessText}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningText}" />
  <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorText}" />

  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource Scrim}" />

  <!-- Override Fluent's accent family (normally the Windows accent colour) with the brand blue, so
       checkboxes, radios, toggles, sliders and selection pick it up. Dark theme leans on the Light
       variants for fills on dark surfaces. -->
  <Color x:Key="SystemAccentColor">#177DDC</Color>
  <Color x:Key="SystemAccentColorLight1">#4096FF</Color>
  <Color x:Key="SystemAccentColorLight2">#69B1FF</Color>
  <Color x:Key="SystemAccentColorLight3">#91CAFF</Color>
  <Color x:Key="SystemAccentColorDark1">#0958D9</Color>
  <Color x:Key="SystemAccentColorDark2">#003EB3</Color>
  <Color x:Key="SystemAccentColorDark3">#002C8C</Color>

  <!-- Override FluentTheme Chrome brushes so views still on them land on the surface ramp.
       Medium was Fluent's #1F1F1F and MediumLow its #2B2B2B, so this is a re-route, not a restyle. -->
  <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="{StaticResource Gray3}" />
  <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{StaticResource Gray4}" />

  <!-- Override FluentTheme list highlight brushes (ListBoxItem, ComboBoxItem, menu items) so every row
       uses the shared state overlays, and selection is Raised instead of an accent tint. -->
  <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{StaticResource StateHover}" />
  <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{StaticResource StatePressed}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{StaticResource Gray4}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{StaticResource Gray5}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{StaticResource Gray6}" />

  <!-- Override FluentTheme menu flyout brushes: menus sit on Popover with the same state overlays -->
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource Gray5}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource HairlineBorder}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource StateHover}" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{StaticResource StatePressed}" />

  <!-- Override FluentTheme ComboBox dropdown brushes (ComboBoxItem has its own keys, not the list brushes).
       Selection steps up from Popover rather than down to Raised, which would read darker than the flyout. -->
  <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Gray5}" />
  <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource HairlineBorder}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{StaticResource StateHover}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{StaticResource StatePressed}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource Gray6}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{StaticResource Gray7}" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{StaticResource Gray7}" />
  <!-- Grey alone is too close to hover; the accent text tint marks the selection -->
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource AccentText}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPointerOver" Color="{StaticResource AccentText}" />
  <SolidColorBrush x:Key="ComboBoxItemForegroundSelectedPressed" Color="{StaticResource AccentText}" />

  <!-- Fluent's shared flyout/menu/dropdown radius: popovers take RadiusLarge -->
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>

  <SolidColorBrush x:Key="Primary4Brush" Color="{StaticResource Primary4}" />
  <SolidColorBrush x:Key="Primary5Brush" Color="{StaticResource Primary5}" />
  <SolidColorBrush x:Key="Primary7Brush" Color="{StaticResource Primary7}" />
  <SolidColorBrush x:Key="Gray3Brush" Color="{StaticResource Gray3}" />
  
  <!-- Solid button hover/active are the fill with StateHover (6%) / StatePressed (11%) composited in,
       since a single Background can't layer an overlay over a colour. -->

  <!-- Button - Primary -->
  <Color x:Key="ButtonPrimaryBg">#177DDC</Color>
  <Color x:Key="ButtonPrimaryHover">#2585DE</Color>
  <Color x:Key="ButtonPrimaryActive">#318BE0</Color>
  <Color x:Key="ButtonPrimaryText">#FFFFFF</Color>

  <!-- Button - Success -->
  <Color x:Key="ButtonSuccessBg">#49AA19</Color>
  <Color x:Key="ButtonSuccessHover">#54AF27</Color>
  <Color x:Key="ButtonSuccessActive">#5DB332</Color>
  <Color x:Key="ButtonSuccessText">#FFFFFF</Color>

  <!-- Button - Warning -->
  <Color x:Key="ButtonWarningBg">#D89614</Color>
  <Color x:Key="ButtonWarningHover">#DA9C22</Color>
  <Color x:Key="ButtonWarningActive">#DCA22E</Color>
  <Color x:Key="ButtonWarningText">#FFFFFF</Color>

  <!-- Button - Error -->
  <Color x:Key="ButtonErrorBg">#DC4446</Color>
  <Color x:Key="ButtonErrorHover">#DE4F51</Color>
  <Color x:Key="ButtonErrorActive">#E0595A</Color>
  <Color x:Key="ButtonErrorText">#FFFFFF</Color>

  <!-- Button - Text (ghost) / Glass -->
  <Color x:Key="ButtonTextHoverBg">#0FFFFFFF</Color>   <!-- StateHover -->
  <Color x:Key="ButtonTextPressedBg">#1CFFFFFF</Color> <!-- StatePressed -->
  <Color x:Key="ButtonGlassBg">#00000080</Color>
  <Color x:Key="ButtonGlassHoverBg">#1AFFFFFF</Color>
  <Color x:Key="ButtonGlassPressedBg">#2AFFFFFF</Color>

  <!-- Button - Glass.Dark -->
  <Color x:Key="ButtonGlassDarkBg">#80000000</Color>
  <Color x:Key="ButtonGlassDarkHoverBg">#EE111111</Color>
  <Color x:Key="ButtonGlassDarkPressedBg">#FF111111</Color>

  <!-- Button - Default (secondary: Raised, stepping up the ramp on hover/press) -->
  <Color x:Key="ButtonDefaultBg">#282828</Color>
  <Color x:Key="ButtonDefaultHover">#303030</Color>
  <Color x:Key="ButtonDefaultActive">#3A3A3A</Color>

  <!-- Button - Shared -->
  <Color x:Key="ButtonDisabledBg">#14FFFFFF</Color>
  <Color x:Key="ButtonDisabledText">#40FFFFFF</Color>

  <!-- Input -->
  <!-- Fields are black wells: a hairline edge at rest, a stronger one on hover, accent on focus -->
  <Color x:Key="InputBg">#000000</Color>
  <Color x:Key="InputBorder">#1FFFFFFF</Color>
  <Color x:Key="InputHoverBorder">#33FFFFFF</Color>
  <Color x:Key="InputFocusBorder">#4096FF</Color>
  <Color x:Key="InputText">#D9FFFFFF</Color>
  <Color x:Key="InputPlaceholder">#40FFFFFF</Color>

  <!-- Toast -->
  <Color x:Key="ToastBg">#1F1F1F</Color>
  <Color x:Key="ToastBorder">#303030</Color>
  <Color x:Key="ToastText">#D9FFFFFF</Color>

  <!-- ===================== -->
  <!-- Component Brushes     -->
  <!-- ===================== -->
  <SolidColorBrush x:Key="ButtonPrimaryBgBrush" Color="{StaticResource ButtonPrimaryBg}" />
  <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="{StaticResource ButtonPrimaryHover}" />
  <SolidColorBrush x:Key="ButtonPrimaryActiveBrush" Color="{StaticResource ButtonPrimaryActive}" />
  <SolidColorBrush x:Key="ButtonPrimaryTextBrush" Color="{StaticResource ButtonPrimaryText}" />

  <SolidColorBrush x:Key="ButtonSuccessBgBrush" Color="{StaticResource ButtonSuccessBg}" />
  <SolidColorBrush x:Key="ButtonSuccessHoverBrush" Color="{StaticResource ButtonSuccessHover}" />
  <SolidColorBrush x:Key="ButtonSuccessActiveBrush" Color="{StaticResource ButtonSuccessActive}" />
  <SolidColorBrush x:Key="ButtonSuccessTextBrush" Color="{StaticResource ButtonSuccessText}" />

  <SolidColorBrush x:Key="ButtonWarningBgBrush" Color="{StaticResource ButtonWarningBg}" />
  <SolidColorBrush x:Key="ButtonWarningHoverBrush" Color="{StaticResource ButtonWarningHover}" />
  <SolidColorBrush x:Key="ButtonWarningActiveBrush" Color="{StaticResource ButtonWarningActive}" />
  <SolidColorBrush x:Key="ButtonWarningTextBrush" Color="{StaticResource ButtonWarningText}" />

  <SolidColorBrush x:Key="ButtonErrorBgBrush" Color="{StaticResource ButtonErrorBg}" />
  <SolidColorBrush x:Key="ButtonErrorHoverBrush" Color="{StaticResource ButtonErrorHover}" />
  <SolidColorBrush x:Key="ButtonErrorActiveBrush" Color="{StaticResource ButtonErrorActive}" />
  <SolidColorBrush x:Key="ButtonErrorTextBrush" Color="{StaticResource ButtonErrorText}" />

  <SolidColorBrush x:Key="ButtonTextHoverBgBrush" Color="{StaticResource ButtonTextHoverBg}" />
  <SolidColorBrush x:Key="ButtonTextPressedBgBrush" Color="{StaticResource ButtonTextPressedBg}" />

  <SolidColorBrush x:Key="ButtonGlassBgBrush" Color="{StaticResource ButtonGlassBg}" />
  <SolidColorBrush x:Key="ButtonGlassHoverBgBrush" Color="{StaticResource ButtonGlassHoverBg}" />
  <SolidColorBrush x:Key="ButtonGlassPressedBgBrush" Color="{StaticResource ButtonGlassPressedBg}" />

  <SolidColorBrush x:Key="ButtonGlassDarkBgBrush" Color="{StaticResource ButtonGlassDarkBg}" />
  <SolidColorBrush x:Key="ButtonGlassDarkHoverBgBrush" Color="{StaticResource ButtonGlassDarkHoverBg}" />
  <SolidColorBrush x:Key="ButtonGlassDarkPressedBgBrush" Color="{StaticResource ButtonGlassDarkPressedBg}" />

  <SolidColorBrush x:Key="ButtonDefaultBgBrush" Color="{StaticResource ButtonDefaultBg}" />
  <SolidColorBrush x:Key="ButtonDefaultHoverBrush" Color="{StaticResource ButtonDefaultHover}" />
  <SolidColorBrush x:Key="ButtonDefaultActiveBrush" Color="{StaticResource ButtonDefaultActive}" />

  <SolidColorBrush x:Key="ButtonDisabledBgBrush" Color="{StaticResource ButtonDisabledBg}" />
  <SolidColorBrush x:Key="ButtonDisabledTextBrush" Color="{StaticResource ButtonDisabledText}" />

  <!-- Override FluentTheme TextBox internal resource keys -->
  <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource InputBg}" />
  <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource InputBg}" />
  <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource InputBg}" />
  <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource Gray3}" />
  <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource InputBorder}" />
  <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource InputHoverBorder}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource InputFocusBorder}" />
  <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource HairlineDivider}" />

  <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}" />
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorder}" />
  <SolidColorBrush x:Key="InputHoverBorderBrush" Color="{StaticResource InputHoverBorder}" />
  <SolidColorBrush x:Key="InputFocusBorderBrush" Color="{StaticResource InputFocusBorder}" />
  <SolidColorBrush x:Key="InputTextBrush" Color="{StaticResource InputText}" />
  <SolidColorBrush x:Key="InputPlaceholderBrush" Color="{StaticResource InputPlaceholder}" />

  <SolidColorBrush x:Key="ToastBgBrush" Color="{StaticResource ToastBg}" />
  <SolidColorBrush x:Key="ToastBorderBrush" Color="{StaticResource ToastBorder}" />
  <SolidColorBrush x:Key="ToastTextBrush" Color="{StaticResource ToastText}" />

  <!-- ===================== -->
  <!-- Markdown / Typography -->
  <!-- ===================== -->

  <!-- Code surface (shared by fenced code blocks and inline code) -->
  <Color x:Key="CodeSurface">#1AFFFFFF</Color>
  <SolidColorBrush x:Key="CodeSurfaceBrush" Color="{StaticResource CodeSurface}" />

  <!-- ===================== -->
  <!-- Typography            -->
  <!-- ===================== -->
  <!-- Archivo for everything; Roboto Mono for anything numeric (sizes, speeds, versions, paths) so
       figures line up. Both OFL, bundled in Assets/Fonts. Overriding Fluent's ContentControlThemeFontFamily
       makes Archivo the app default; Inter stays as the fallback for glyphs Archivo lacks. -->
  <FontFamily x:Key="ContentControlThemeFontFamily">avares://LANCommander.Launcher/Assets/Fonts/Archivo#Archivo, fonts:Inter#Inter, $Default</FontFamily>
  <FontFamily x:Key="MonoFontFamily">avares://LANCommander.Launcher/Assets/Fonts/RobotoMono#Roboto Mono, Cascadia Mono, Consolas, monospace</FontFamily>

  <!-- Type scale: seven steps. Views reference these rather than literal sizes. -->
  <x:Double x:Key="FontSizeDisplay">40</x:Double> <!-- 700: hero titles -->
  <x:Double x:Key="FontSizeTitle">22</x:Double>   <!-- 600: page titles -->
  <x:Double x:Key="FontSizeSection">17</x:Double> <!-- 600: section headings -->
  <x:Double x:Key="FontSizeBody">14</x:Double>    <!-- 400: rows, descriptions, menu items -->
  <x:Double x:Key="FontSizeLabel">13</x:Double>   <!-- 500: buttons, tabs, field labels -->
  <x:Double x:Key="FontSizeCaption">12</x:Double> <!-- 400: secondary metadata, helper text -->
  <x:Double x:Key="FontSizeKicker">11</x:Double>  <!-- 600, tracked, uppercase: section eyebrows -->

  <!-- Monospace font for code -->
  <FontFamily x:Key="CodeFontFamily">Cascadia Code,Consolas,Menlo,Courier New,monospace</FontFamily>

  <!-- Markdown heading scale factors (multiplied against base FontSize) -->
  <x:Double x:Key="MarkdownHeading1Scale">1.6</x:Double>
  <x:Double x:Key="MarkdownHeading2Scale">1.4</x:Double>
  <x:Double x:Key="MarkdownHeading3Scale">1.2</x:Double>
  <x:Double x:Key="MarkdownHeadingScale">1.1</x:Double> <!-- h4+ -->
  <x:Double x:Key="MarkdownCodeFontScale">0.9</x:Double>
  <x:Double x:Key="MarkdownLineHeightScale">1.6</x:Double>

  <!-- Markdown whitespace (kept in the stylesheet so spacing is tunable globally) -->
  <Thickness x:Key="MarkdownHeadingMargin">0,4,0,2</Thickness>
  <Thickness x:Key="MarkdownParagraphMargin">0,4,0,4</Thickness>
  <Thickness x:Key="MarkdownCodeBlockMargin">0,3,0,3</Thickness>
  <Thickness x:Key="MarkdownCodeBlockPadding">10,6</Thickness>
  <Thickness x:Key="MarkdownRuleMargin">0,6,0,6</Thickness>
  <Thickness x:Key="MarkdownQuoteMargin">0,3,0,3</Thickness>
  <Thickness x:Key="MarkdownQuotePadding">8,4</Thickness>
  <CornerRadius x:Key="MarkdownCodeCornerRadius">4</CornerRadius>
</ResourceDictionary>
