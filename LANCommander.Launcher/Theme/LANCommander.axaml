  <!-- ===================================================== -->
  <!-- BUTTONS — Text / ghost variant (declared after solid -->
  <!-- so declaration order wins for equal-specificity rules) -->
  <!-- ===================================================== -->

  <!-- Ghost: no fill, secondary text at rest, the shared state overlays on hover/press.
       Foreground is also set on the presenter so FluentTheme's pointerover foreground
       doesn't override it. -->
  <Style Selector="Button.Text,
                   local|IconButton.Text">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.Text:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Text:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Text:disabled /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <!-- Ghost + color: text takes the lighter status tint, which reads on dark surfaces
       where the fill colour doesn't. Two-class selector wins over single-class solid styles. -->
  <Style Selector="Button.Text.Primary,
                   local|IconButton.Text.Primary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Button.Text.Success,
                   local|IconButton.Text.Success">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Success:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Success:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Success:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>

  <Style Selector="Button.Text.Warning,
                   local|IconButton.Text.Warning">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Warning:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Warning:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Warning:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>

  <Style Selector="Button.Text.Error,
                   local|IconButton.Text.Error">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Error:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Error:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>
  <Style Selector="Button.Text.Error:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text.Error:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- BUTTONS — Glass variants                              -->
  <!-- ===================================================== -->

  <Style Selector="Button.Glass, local|IconButton.Glass">
    <Setter Property="Background" Value="{DynamicResource ButtonGlassBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.Glass:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonGlassHoverBgBrush}" />
  </Style>
  <Style Selector="Button.Glass:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Glass:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonGlassPressedBgBrush}" />
  </Style>

  <Style Selector="Button.Glass.Dark, local|IconButton.Glass.Dark">
      <Setter Property="Background" Value="{DynamicResource ButtonGlassDarkBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>
  <!-- Over artwork: a 14% hairline ring keeps the button's edge visible on any image -->
  <Style Selector="Button.Glass.Dark /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Glass.Dark /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BoxShadow" Value="inset 0 0 0 1 #24FFFFFF" />
  </Style>
  <Style Selector="Button.Glass.Dark:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Glass.Dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonGlassDarkHoverBgBrush}" />
  </Style>
  <Style Selector="Button.Glass.Dark:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Glass.Dark:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ButtonGlassDarkPressedBgBrush}" />
  </Style>

  <!-- Large (hero Play/Install) buttons take the panel radius.
       Declared after every variant so it wins at equal specificity. -->
  <Style Selector="Button.Large, SplitButton.Large, local|IconButton.Large">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
  </Style>

  <!-- ===================================================== -->
  <!-- BUTTONS — Hairline edges                              -->
  <!-- (inset shadows, so no layout cost; declared after    -->
  <!-- every variant so later rules here win)               -->
  <!-- ===================================================== -->

  <!-- Secondary: the default Raised fill plus a hairline ring and lit top edge. Opt-in, because
       plain Buttons are also used as transparent click targets that shouldn't get a ring. -->
  <Style Selector="Button.Secondary /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Secondary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource HairlineShadow}" />
  </Style>
  <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource HairlineHoverShadow}" />
  </Style>
  <Style Selector="Button.Secondary:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource HairlinePressedShadow}" />
  </Style>

  <!-- Solid fills: lit top edge only -->
  <Style Selector="Button.Primary /template/ ContentPresenter#PART_ContentPresenter,
                   Button.Success /template/ ContentPresenter#PART_ContentPresenter,
                   Button.Warning /template/ ContentPresenter#PART_ContentPresenter,
                   Button.Error /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Primary /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Success /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Warning /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Error /template/ ContentPresenter#PART_ContentPresenter,
                   SplitButton.Primary /template/ Button /template/ ContentPresenter#PART_ContentPresenter,
                   SplitButton.Success /template/ Button /template/ ContentPresenter#PART_ContentPresenter,
                   SplitButton.Warning /template/ Button /template/ ContentPresenter#PART_ContentPresenter,
                   SplitButton.Error /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource SolidHighlightShadow}" />
  </Style>
  <!-- Ghost + colour (.Text.Error etc.) also matches the solid selectors above; ghosts have no edge -->
  <Style Selector="Button.Text /template/ ContentPresenter#PART_ContentPresenter,
                   local|IconButton.Text /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BoxShadow" Value="{DynamicResource NoShadow}" />
  </Style>

  <!-- ===================================================== -->
  <!-- SEGMENTED CONTROL                                     -->
  <!-- Border.Segmented track holding Button.Segment items;  -->
  <!-- the current one gets .active                          -->
  <!-- ===================================================== -->

  <Style Selector="Border.Segmented">
    <Setter Property="Background" Value="{DynamicResource SurfaceChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <!-- Item radius = track radius minus its padding, so the curves stay concentric -->
  <Style Selector="Button.Segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.Segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Segment.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.Segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.Segment.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- PROGRESS                                              -->
  <!-- (Fluent fills with the OS accent; brand blue on a    -->
  <!-- Raised trough instead)                               -->
  <!-- ===================================================== -->

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
  </Style>

  <!-- Circular variant: a trough ring with the value drawn as an arc clockwise from 12 o'clock.
       Indeterminate swaps in a spinning quarter arc. -->
  <Style Selector="ProgressBar.Ring">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Required part; ProgressBar sizes it for the linear bar, the arc below does the drawing -->
          <Border x:Name="PART_Indicator" IsVisible="False" />
          <Ellipse Stroke="{TemplateBinding Background}" StrokeThickness="2.5" />
          <Arc Stroke="{TemplateBinding Foreground}"
               StrokeThickness="2.5"
               StrokeLineCap="Round"
               StartAngle="-90"
               SweepAngle="{Binding Percentage, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource RingSweepConverter}, ConverterParameter=3.6}"
               IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" />
          <Arc Classes="RingSpinner"
               Stroke="{TemplateBinding Foreground}"
               StrokeThickness="2.5"
               StrokeLineCap="Round"
               StartAngle="-90"
               SweepAngle="90"
               RenderTransform="rotate(0deg)"
               IsVisible="{TemplateBinding IsIndeterminate}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ProgressBar.Ring /template/ Arc.RingSpinner">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- ===================================================== -->
  <!-- TYPE SCALE                                            -->
  <!-- (TextBlock classes; sizes are resources in           -->
  <!-- ColorPalette.axaml so views can also use them bare)  -->
  <!-- ===================================================== -->

  <Style Selector="TextBlock.Display">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="-1" />
  </Style>
  <Style Selector="TextBlock.Title">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>
  <Style Selector="TextBlock.Section">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.Body">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
  </Style>
  <Style Selector="TextBlock.Label">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <!-- Kicker text is written uppercase in the source; Avalonia has no text-transform -->
  <Style Selector="TextBlock.Kicker">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeKicker}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <!-- Figures: sizes, speeds, versions, paths -->
  <Style Selector="TextBlock.Mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="SelectableTextBlock.Mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>
  <Style Selector="TextBox.Mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
  </Style>

  <!-- ===================================================== -->
  <!-- RAIL NAVIGATION                                       -->
  <!-- Full-width rows in a side rail; the current page     -->
  <!-- gets .active (Raised + accent rail)                   -->
  <!-- ===================================================== -->

  <Style Selector="Button.RailNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0,10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.RailNav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.RailNav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <!-- Rail as a left border with the padding trimmed by the same 2px, so the label doesn't shift -->
  <Style Selector="Button.RailNav.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="Padding" Value="10,0,10,0" />
  </Style>
  <Style Selector="Button.RailNav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.RailNav.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- Count pill (rail badges, section totals) -->
  <Style Selector="Border.CountPill">
    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusFull}" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.CountPill > TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeKicker}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- Neutral: section totals, where the count is information rather than a call to act -->
  <Style Selector="Border.CountPill.Neutral">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,1" />
  </Style>
  <Style Selector="Border.CountPill.Neutral > TextBlock">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- STATUS TAGS                                           -->
  <!-- Tinted fill + tinted edge + light text; accent by    -->
  <!-- default, .Success / .Warning / .Error for status      -->
  <!-- ===================================================== -->

  <Style Selector="Border.StatusTag">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="#33177DDC" />
    <Setter Property="BorderBrush" Value="#664096FF" />
  </Style>
  <Style Selector="Border.StatusTag > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeKicker}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Primary4Brush}" />
  </Style>
  <Style Selector="Border.StatusTag.Success">
    <Setter Property="Background" Value="#3349AA19" />
    <Setter Property="BorderBrush" Value="#6B73D13D" />
  </Style>
  <Style Selector="Border.StatusTag.Success > TextBlock">
    <Setter Property="Foreground" Value="#95DE64" />
  </Style>
  <Style Selector="Border.StatusTag.Warning">
    <Setter Property="Background" Value="#33D89614" />
    <Setter Property="BorderBrush" Value="#66FFC53D" />
  </Style>
  <Style Selector="Border.StatusTag.Warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Border.StatusTag.Error">
    <Setter Property="Background" Value="#33DC4446" />
    <Setter Property="BorderBrush" Value="#61FF7875" />
  </Style>
  <Style Selector="Border.StatusTag.Error > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- NOTICES                                               -->
  <!-- Inline callouts: tinted fill and edge, secondary     -->
  <!-- caption text, icon in the status colour               -->
  <!-- ===================================================== -->

  <Style Selector="Border.Notice">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background" Value="#24177DDC" />
    <Setter Property="BorderBrush" Value="#524096FF" />
  </Style>
  <Style Selector="Border.Notice TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.Notice Icon">
    <Setter Property="Foreground" Value="{DynamicResource Primary4Brush}" />
  </Style>
  <Style Selector="Border.Notice.Success">
    <Setter Property="Background" Value="#2449AA19" />
    <Setter Property="BorderBrush" Value="#5273D13D" />
  </Style>
  <Style Selector="Border.Notice.Success Icon">
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>
  <Style Selector="Border.Notice.Warning">
    <Setter Property="Background" Value="#24D89614" />
    <Setter Property="BorderBrush" Value="#52FFC53D" />
  </Style>
  <Style Selector="Border.Notice.Warning Icon">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>
  <Style Selector="Border.Notice.Error">
    <Setter Property="Background" Value="#24DC4446" />
    <Setter Property="BorderBrush" Value="#52FF7875" />
  </Style>
  <Style Selector="Border.Notice.Error Icon">
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- TREES                                                 -->
  <!-- 28px rows at radius 2, 18px of indent per level with  -->
  <!-- a hairline guide down each open branch. The caret     -->
  <!-- column is fixed, so leaves line up with the folders   -->
  <!-- above them. Sit the TreeView in a Border.Card at      -->
  <!-- Padding 6,8. Row content: CheckBox, Icon.TreeIcon,    -->
  <!-- TextBlock.TreeLabel, then StatusTag / TreeMeta docked -->
  <!-- right, 8px apart.                                     -->
  <!-- ===================================================== -->

  <!-- Rows trim to the panel rather than widening it; deep install trees otherwise grow a horizontal scrollbar -->
  <Style Selector="TreeView">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- Replaces Fluent's template, which indents by padding the header and has no guides. Children sit in a
       Border whose left edge is the guide: 14px in, so it runs under the caret's centre (8px row padding +
       half the 13px caret), plus 1px edge and 3px padding for 18px per level. The part names differ from
       Fluent's, so its state styles don't reach in. PART_Header keeps the double-tap-to-expand hook. -->
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <!-- Focus is an inset ring on the row (below); an adorner would wrap the whole open branch -->
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Panel Name="PART_Header" MinHeight="{TemplateBinding MinHeight}">
            <Border Name="PART_Row"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border Name="PART_SelectionRail"
                    Width="2"
                    Margin="0,6"
                    CornerRadius="1"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource AccentTextBrush}"
                    IsVisible="False" />
            <Grid ColumnDefinitions="13,*" Margin="{TemplateBinding Padding}">
              <!-- The glyph is content rather than template so the rotation style below can reach it -->
              <ToggleButton Name="PART_Caret"
                            Focusable="False"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate>
                    <ContentPresenter Background="Transparent"
                                      Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                  </ControlTemplate>
                </ToggleButton.Template>
                <Path Name="PART_CaretGlyph"
                      Width="13"
                      Height="13"
                      Data="M4.9,3 L8.4,6.5 L4.9,10"
                      Stroke="{DynamicResource TextSecondaryBrush}"
                      StrokeThickness="1.3"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="None"
                      RenderTransformOrigin="50%,50%"
                      RenderTransform="rotate(0deg)">
                  <Path.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
                    </Transitions>
                  </Path.Transitions>
                </Path>
              </ToggleButton>
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Focusable="False"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center" />
            </Grid>
          </Panel>
          <Border Name="PART_Guide"
                  Margin="14,0,0,0"
                  Padding="3,0,0,0"
                  BorderThickness="1,0,0,0"
                  BorderBrush="#17FFFFFF"
                  IsVisible="{TemplateBinding IsExpanded}">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TreeViewItem /template/ ToggleButton#PART_Caret:checked Path#PART_CaretGlyph">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <!-- The caret hides but keeps its column, so leaves stay aligned with folders -->
  <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_Caret,
                   TreeViewItem:empty /template/ Border#PART_Guide">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Hover keys off the row itself: an item is :pointerover whenever any row in its branch is -->
  <Style Selector="TreeViewItem /template/ Panel#PART_Header:pointerover > Border#PART_Row">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
  </Style>
  <!-- Selected: Raised plus the 2px accent rail, as in lists; declared after hover so it holds under the pointer -->
  <Style Selector="TreeViewItem:selected /template/ Border#PART_Row">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_SelectionRail">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TreeViewItem:focus-visible /template/ Border#PART_Row">
    <Setter Property="BoxShadow" Value="{DynamicResource FocusRingShadow}" />
  </Style>

  <!-- Tree checkbox: 15px at radius 2. Checked and partly checked both fill with the accent; a folder whose
       children disagree shows a bar, not a tick. Glyphs are drawn inside the 1px edge, hence the offsets. -->
  <Style Selector="TreeViewItem CheckBox">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="2"
                BorderBrush="{DynamicResource FocusRingBrush}"
                CornerRadius="5"
                Margin="-3"
                AdornerLayer.IsClipEnabled="False" />
      </FocusAdornerTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Box"
                Width="15"
                Height="15"
                CornerRadius="{DynamicResource RadiusSmall}"
                BorderThickness="1"
                BorderBrush="#47FFFFFF"
                Background="Transparent">
          <Panel>
            <Path Name="PART_Tick"
                  Data="M3.8,6.7 L5.5,8.4 L9.2,4.8"
                  Stroke="White"
                  StrokeThickness="1.4"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Stretch="None"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsVisible="False" />
            <Path Name="PART_Bar"
                  Data="M4,6.5 L9,6.5"
                  Stroke="White"
                  StrokeThickness="1.4"
                  StrokeLineCap="Round"
                  Stretch="None"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TreeViewItem CheckBox:pointerover /template/ Border#PART_Box">
    <Setter Property="BorderBrush" Value="#73FFFFFF" />
  </Style>
  <Style Selector="TreeViewItem CheckBox:checked /template/ Border#PART_Box,
                   TreeViewItem CheckBox:indeterminate /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource AccentFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}" />
  </Style>
  <Style Selector="TreeViewItem CheckBox:checked /template/ Path#PART_Tick,
                   TreeViewItem CheckBox:indeterminate /template/ Path#PART_Bar">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="TreeViewItem CheckBox:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- Row content -->
  <Style Selector="Icon.TreeIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Value" Value="File" />
  </Style>
  <Style Selector="Icon.TreeIcon.Folder">
    <Setter Property="Value" Value="FolderSimple" />
  </Style>
  <!-- Folder names in the UI face; file names (.Mono) and the root path in mono at 12 -->
  <Style Selector="TextBlock.TreeLabel">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.TreeLabel.Mono">
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.TreeLabel.Root">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <!-- What is left out reads as left out -->
  <Style Selector="TextBlock.TreeLabel.Excluded">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <!-- Right-hand figures: sizes, counts -->
  <Style Selector="TextBlock.TreeMeta">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeKicker}" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Status tags run a step smaller in a 28px row -->
  <Style Selector="TreeViewItem Border.StatusTag">
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TreeViewItem Border.StatusTag > TextBlock">
    <Setter Property="FontSize" Value="10" />
  </Style>

  <!-- ===================================================== -->
  <!-- SURFACES                                              -->
  <!-- ===================================================== -->

  <!-- Card: Surface with a hairline edge and lit top edge; views set their own Padding -->
  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="BoxShadow" Value="{DynamicResource SurfaceHighlightShadow}" />
  </Style>

  <!-- Dialog: the exception to the tone rule. A panel this large would look washed out at Popover, so it
       stays on Surface, sits on the scrim and floats on the deeper dialog shadow. -->
  <Style Selector="Border.Dialog">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="BoxShadow" Value="{DynamicResource DialogShadow}" />
  </Style>

  <!-- Dialog header: title row over a hairline. The right padding is short because the header ends
       in DialogTitleBar's close button, which sits 8px from the edge. -->
  <Style Selector="Border.DialogHeader">
    <Setter Property="MinHeight" Value="54" />
    <Setter Property="Padding" Value="20,0,8,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.DialogHeader > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Dialog footer: actions under a hairline -->
  <Style Selector="Border.DialogFooterBar">
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- Tag: small non-clickable label with a hairline edge (player modes, tools); matches Button.Badge -->
  <Style Selector="Border.Tag">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>
  <Style Selector="Border.Tag TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- ===================================================== -->
  <!-- BUTTONS — Dialog/overlay footer actions               -->
  <!-- (OK, Cancel, Confirm, Save, etc.)                     -->
  <!-- ===================================================== -->

  <!-- Mark a footer container with Classes="DialogFooter"; its buttons inherit these -->
  <Style Selector=".DialogFooter Button">
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- ===================================================== -->
  <!-- MENUS                                                 -->
  <!-- (colours come from the MenuFlyout overrides in       -->
  <!-- ColorPalette.axaml) 5px menu padding so the           -->
  <!-- highlighted row's inset reads evenly; 32px rows at    -->
  <!-- radius 2 against the menu's 6                         -->
  <!-- ===================================================== -->

  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem, ContextMenu MenuItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
  </Style>
  <!-- A destructive row is the only one that takes a colour -->
  <Style Selector="MenuItem.Destructive">
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>
  <Style Selector="MenuItem.Destructive:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator">
    <Setter Property="Margin" Value="8,5" />
    <Setter Property="Background" Value="{DynamicResource HairlineBorderBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- LIST ROWS                                             -->
  <!-- (hover/pressed/selected fills come from the Fluent    -->
  <!-- list brush overrides in ColorPalette.axaml)           -->
  <!-- ===================================================== -->

  <Style Selector="ListBoxItem, ComboBoxItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>

  <!-- Selected row: Raised (from the Fluent override) plus a 2px accent rail. Fluent's template is a lone
       ContentPresenter; this keeps it (its state styles target it by name) and overlays the rail, so the
       content doesn't shift. An inset BoxShadow can't draw a one-sided rail: Avalonia translates both the
       hole and the outline by the offset. Views that replace the template draw their own rail. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
          <Border Name="PART_SelectionRail"
                  Width="2"
                  Margin="0,6"
                  CornerRadius="1"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource AccentTextBrush}"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:selected /template/ Border#PART_SelectionRail">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <!-- ===================================================== -->
  <!-- TEXT INPUTS                                           -->
  <!-- ===================================================== -->

  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- Override inner template Border to defeat FluentTheme's internal state styles -->
  <Style Selector="TextBox /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus-within /template/ Border">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border">
    <Setter Property="Background" Value="{DynamicResource Gray3Brush}" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- COMBOBOX (SELECT)                                     -->
  <!-- ===================================================== -->

  <!-- The closed dropdown is an input well, same as a TextBox: black, hairline edge, stronger edge on
       hover, accent edge when open or keyboard/gamepad focused. The caret flips and takes the accent
       while open. -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0,0,0" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Gray3Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
  </Style>
  <!-- Fluent's focus-visible overlay repaints the well in its own unfocused grey -->
  <Style Selector="ComboBox /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- Fluent recolours the selection on focus; keep it the input text colour -->
  <Style Selector="ComboBox:focus-visible /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
  </Style>
  <Style Selector="ComboBox:focused:pressed /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InputPlaceholderBrush}" />
  </Style>
  <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="ComboBox:dropdownopen /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="RenderTransform" Value="rotate(180deg)" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ PathIcon#DropDownGlyph">
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>

  <!-- ===================================================== -->
  <!-- TOAST (CUSTOM CONTROL STYLE)                          -->
  <!-- ===================================================== -->

  <Style Selector="controls|ContentControl.toast">
    <Setter Property="Background" Value="{DynamicResource ToastBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ToastTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Toast Variants -->
  <Style Selector="controls|ContentControl.toast.success">
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="controls|ContentControl.toast.error">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <Style Selector="controls|ContentControl.toast.warning">
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
  </Style>
  
  <!-- ===================================================== -->
  <!-- TEXT INPUTS — defaults                                -->
  <!-- Black well with a hairline edge; accent edge on      -->
  <!-- focus (colours in ColorPalette.axaml Input*)          -->
  <!-- ===================================================== -->

  <Style Selector="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBox.Glass /template/ Border">
    <Setter Property="Background" Value="#88000000" />
  </Style>

  <!-- ===================================================== -->
  <!-- NUMERIC UP/DOWN                                       -->
  <!-- The spinner draws the input well so the buttons sit  -->
  <!-- inside it; the inner TextBox gives up its own well.  -->
  <!-- Kept after the TextBox styles: order wins here.      -->
  <!-- ===================================================== -->

  <Style Selector="NumericUpDown /template/ ButtonSpinner">
    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>
  <Style Selector="NumericUpDown:pointerover /template/ ButtonSpinner">
    <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
  </Style>
  <Style Selector="NumericUpDown:focus-within /template/ ButtonSpinner">
    <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
  </Style>
  <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner">
    <Setter Property="Background" Value="{DynamicResource Gray3Brush}" />
  </Style>

  <Style Selector="NumericUpDown /template/ TextBox">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- One style per state: a pseudoclass style outranks a plain one regardless of order, so the
       TextBox:pointerover/:focus-within wells above (and Fluent's :focus thickness) would otherwise
       redraw a square box over the spinner's frame. -->
  <Style Selector="NumericUpDown /template/ TextBox /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox:pointerover /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox:focus /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox:focus-within /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="NumericUpDown /template/ TextBox:disabled /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <!-- Fluent's spinner RepeatButton template doesn't bind CornerRadius through -->
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:nth-last-child(1)">
    <Setter Property="Margin" Value="0,3,3,3" />
  </Style>


</Styles>
