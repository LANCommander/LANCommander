  <!-- Flyout open: Fluent paints both halves its neutral FlyoutOpen grey; keep the variant's colour
       (its pressed shade) so the button doesn't go grey while its menu is showing. -->
  <Style Selector="SplitButton.Primary:flyout-open /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonPrimaryActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryTextBrush}" />
  </Style>
  <Style Selector="SplitButton.Success:flyout-open /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonSuccessActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonSuccessTextBrush}" />
  </Style>
  <Style Selector="SplitButton.Warning:flyout-open /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonWarningActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonWarningTextBrush}" />
  </Style>
  <Style Selector="SplitButton.Error:flyout-open /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ButtonErrorActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ButtonErrorTextBrush}" />
  </Style>

