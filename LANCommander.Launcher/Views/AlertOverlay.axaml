<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LANCommander.Launcher.Controls"
             xmlns:components="using:LANCommander.Launcher.Views.Components"
             x:Class="LANCommander.Launcher.Views.AlertOverlay"
             controls:AutoFocus.IsEnabled="True">

    <!-- Full-window dim backdrop -->
    <Grid Background="{DynamicResource ScrimBrush}">

        <!-- Centered card -->
        <Border Classes="Dialog"
                Width="420"
                MaxHeight="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Spacing="0">

                <!-- Header -->
                <Border Classes="DialogHeader">
                    <components:DialogTitleBar x:Name="TitleBar"
                                               Title="Error"
                                               CloseRequested="TitleBar_CloseRequested" />
                </Border>

                <!-- Message -->
                <Border Padding="20,18">
                    <ScrollViewer MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MessageText"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   Opacity="0.85" />
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <Border Classes="DialogFooter DialogFooterBar">
                    <Button Content="OK"
                            Classes="Primary"
                            HorizontalAlignment="Right"
                            Click="OK_Click" />
                </Border>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
