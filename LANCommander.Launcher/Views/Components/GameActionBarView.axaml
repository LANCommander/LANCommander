<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Components"
             xmlns:controls="using:LANCommander.Launcher.Controls"
             xmlns:interposer="using:LANCommander.Launcher.Services.Interposer"
             x:Class="LANCommander.Launcher.Views.Components.GameActionBarView"
             x:DataType="vm:GameActionBarViewModel"
             controls:AutoFocus.IsEnabled="True">

    <UserControl.Styles>
        <!-- Running state: "Running" text visible, "Stop" hidden -->
        <Style Selector="SplitButton.Running TextBlock.RunningState">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="SplitButton.Running StackPanel.Stop">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hover: fade out "Running", fade in "Stop" -->
        <Style Selector="SplitButton.Running:pointerover TextBlock.RunningState">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="SplitButton.Running:pointerover StackPanel.Stop">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Make the caret/secondary button independently focusable for gamepad navigation -->
        <Style Selector="SplitButton /template/ Button#PART_SecondaryButton">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
        </Style>

        <!-- Hero-sized controls: Play/Install and the square glass buttons share one 46px row -->
        <Style Selector="SplitButton.Hero">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="IconButton.Square">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Relay status dot: off is muted, on the way is amber, connected green, refused red -->
        <Style Selector="Ellipse.RelayDot">
            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="Ellipse.RelayDot.Connecting">
            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="Ellipse.RelayDot.Connected">
            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.RelayDot.Failed">
            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <!-- Hover: turn button red (error/danger) -->
        <Style Selector="SplitButton.Running:pointerover /template/ Button#PART_PrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonErrorBgBrush}" />
        </Style>
        <Style Selector="SplitButton.Running:pointerover /template/ Button#PART_SecondaryButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonErrorBgBrush}" />
        </Style>
        <Style Selector="SplitButton.Running:pointerover /template/ Button#PART_PrimaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonErrorActiveBrush}" />
        </Style>
        <Style Selector="SplitButton.Running:pointerover /template/ Button#PART_SecondaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonErrorActiveBrush}" />
        </Style>
    </UserControl.Styles>
    
    <!-- Play/Install, square shortcuts, then the play stats after a divider -->
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <!-- Install SplitButton (not installed). Flyout assigned in code-behind. -->
                    <SplitButton x:Name="InstallSplitButton"
                                 Command="{Binding InstallCommand}"
                                 IsVisible="{Binding !IsInstalled}"
                                 IsEnabled="{Binding CanInstall}"
                                 Classes="Primary Large Hero">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Install" FontWeight="SemiBold" IsVisible="{Binding !IsInstalling}" />
                            <TextBlock Text="Installing..." IsVisible="{Binding IsInstalling}" />
                        </StackPanel>
                    </SplitButton>

                    <!-- Play / Update / Stop SplitButton (installed) -->
                    <SplitButton x:Name="PlaySplitButton"
                                 Command="{Binding PrimaryActionCommand}"
                                 IsVisible="{Binding IsInstalled}"
                                 IsEnabled="{Binding PlayButtonIsEnabled}"
                                 Classes.Running="{Binding IsRunning}"
                                 Classes.Starting="{Binding IsStarting}"
                                 Classes.Stopping="{Binding IsStopping}"
                                 Classes.Success="{Binding ShowPlayLabel}"
                                 Classes.Primary="{Binding !ShowPlayLabel}"
                                 Classes="Large Hero">
                        <Panel>
                            <!-- Idle + update available: Update -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding ShowUpdateLabel}">
                                <TextBlock Text="Update" FontWeight="SemiBold" IsVisible="{Binding !IsInstalling}" />
                                <TextBlock Text="Updating..." IsVisible="{Binding IsInstalling}" />
                            </StackPanel>

                            <!-- Idle + no update: Play / Starting -->
                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding ShowPlayLabel}">
                                <Icon Type="Regular" Value="Play" Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding !IsStarting}" />
                                <TextBlock Text="Play" FontWeight="SemiBold" IsVisible="{Binding !IsStarting}" />
                                <TextBlock Text="Starting" IsVisible="{Binding IsStarting}" />
                            </StackPanel>

                            <!-- Running: overlapping "Running" and "Stop" labels -->
                            <Panel IsVisible="{Binding IsRunning}">
                                <!-- Shown by default; fades out on hover via CSS -->
                                <TextBlock Classes="RunningState" IsVisible="{Binding !IsStopping}" Text="Running" />
                                <TextBlock Classes="StoppingState" IsVisible="{Binding IsStopping}" Text="Stopping" />
                                <!-- Hidden by default; fades in on hover via CSS -->
                                <StackPanel Classes="Stop" Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource Regular_Stop}"
                                              Width="14" Height="14" />
                                    <TextBlock Text="Stop" FontWeight="SemiBold" />
                                </StackPanel>
                            </Panel>
                        </Panel>
                        <!-- Flyout assigned in code-behind (consolidated game menu). -->
                    </SplitButton>

                    <!-- Debug Scripts button (when script debugging is enabled). Works before install too:
                         the debugger lists the server's scripts and catches them as the install runs. -->
                    <SplitButton Command="{Binding OpenScriptDebuggerCommand}"
                                 IsVisible="{Binding IsScriptDebuggingEnabled}"
                                 Classes="Hero"
                                 Padding="14,0"
                                 ToolTip.Tip="Debug Scripts">
                        <Icon Type="Regular" Value="Bug" Width="16" Height="16" />

                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="Open Script Debugger" Command="{Binding OpenScriptDebuggerCommand}" />
                                <MenuItem Header="Open PowerShell Console" Command="{Binding OpenPowerShellConsoleCommand}"
                                          IsEnabled="{Binding IsInstalled}" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <!-- Add to Library -->
                    <IconButton Command="{Binding AddToLibraryCommand}"
                                IsVisible="{Binding !IsInLibrary}"
                                IsEnabled="{Binding !IsAddingToLibrary}"
                                Classes="Glass Dark Square"
                                IconType="Regular"
                                IconValue="Plus"
                                Size="18"
                                ToolTip.Tip="Add to Library" />

                    <IconButton Command="{Binding BrowseFilesCommand}"
                                IsVisible="{Binding IsInstalled}"
                                Classes="Glass Dark Square"
                                IconType="Regular"
                                IconValue="FolderOpen"
                                Size="18"
                                ToolTip.Tip="Browse Files" />

                    <IconButton Command="{Binding OpenFirstManualCommand}"
                                IsVisible="{Binding HasManuals}"
                                Classes="Glass Dark Square"
                                IconType="Regular"
                                IconValue="BookOpen"
                                Size="18"
                                ToolTip.Tip="Open Manual" />

                    <!-- Same consolidated game menu as the split button's caret; flyout assigned in code-behind -->
                    <IconButton x:Name="MoreButton"
                                Classes="Glass Dark Square"
                                IconType="Regular"
                                IconValue="DotsThree"
                                Size="18"
                                ToolTip.Tip="More Actions" />

                    <Border Width="1" Height="28" Margin="8,0" VerticalAlignment="Center"
                            Background="{DynamicResource HairlineBorderBrush}" />

                    <!-- Stats -->
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <StackPanel Spacing="3"
                                    IsVisible="{Binding DownloadSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="DOWNLOAD SIZE" Classes="Kicker" />
                            <TextBlock Text="{Binding DownloadSizeText}" Classes="Mono" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="PLAY TIME" Classes="Kicker" />
                            <TextBlock Text="{Binding PlayTime}" Classes="Mono" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="LAST PLAYED" Classes="Kicker" />
                            <TextBlock Text="{Binding LastPlayed}" Classes="Mono" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                        </StackPanel>

                        <!-- The running game's place on the network relay; opens who else is there -->
                        <Button x:Name="RelayButton"
                                Classes="Text"
                                Padding="0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding Relay.IsVisible}"
                                ToolTip.Tip="Network relay">
                            <StackPanel Spacing="3">
                                <TextBlock Text="NETWORK RELAY" Classes="Kicker" />
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Classes="RelayDot"
                                             Classes.Connected="{Binding Relay.IsConnected}"
                                             Classes.Connecting="{Binding Relay.IsConnecting}"
                                             Classes.Failed="{Binding Relay.IsFailed}"
                                             Width="8" Height="8"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Relay.Summary}" Classes="Mono"
                                               FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                                </StackPanel>
                            </StackPanel>

                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Width="300" Spacing="10" Margin="4">
                                        <TextBlock Text="Network relay" FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeLabel}" />
                                        <TextBlock Text="{Binding Relay.Explanation}"
                                                   FontSize="{DynamicResource FontSizeCaption}" Opacity="0.7"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Spacing="6" IsVisible="{Binding Relay.IsConnected}">
                                            <TextBlock Text="PLAYERS" Classes="Kicker" />
                                            <TextBlock Text="No one else has joined yet."
                                                       IsVisible="{Binding Relay.HasNoPlayers}"
                                                       FontSize="{DynamicResource FontSizeCaption}" Opacity="0.55" />
                                            <ItemsControl ItemsSource="{Binding Relay.Players}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="interposer:RelayPlayer">
                                                        <DockPanel Margin="0,0,0,4">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding VirtualAddress}"
                                                                       Classes="Mono" FontSize="{DynamicResource FontSizeCaption}"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Classes="Secondary" Content="Disconnect"
                                                    IsVisible="{Binding Relay.CanDisconnect}"
                                                    Command="{Binding Relay.DisconnectCommand}" />
                                            <Button Classes="Primary" Content="Reconnect"
                                                    IsVisible="{Binding Relay.CanReconnect}"
                                                    Command="{Binding Relay.ReconnectCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
    </StackPanel>
</UserControl>
