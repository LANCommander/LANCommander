<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels"
             xmlns:vmComponents="using:LANCommander.Launcher.ViewModels.Components"
             xmlns:components="using:LANCommander.Launcher.Views.Components"
             xmlns:controls="using:LANCommander.Launcher.Controls"
             xmlns:local="using:LANCommander.Launcher.Views"
             x:Class="LANCommander.Launcher.Views.GamesShelfView"
             x:DataType="vm:GamesCollectionViewModel">

    <!-- Horizontal view: one carousel, paged with its arrows like the Library and Depot rows.
         Covers load as they come within a page of the screen, so long lists stay cheap. -->
    <ScrollViewer Classes="TitlebarOffset"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  controls:ScrollPersistence.ViewModel="{Binding}">
        <CarouselControl Title="{Binding ViewTitle}"
                         ItemsSource="{Binding Games}"
                         ItemWidth="160"
                         VisibleItems="6"
                         Gap="16"
                         ItemOverflow="14"
                         Margin="10,52,10,24">
            <CarouselControl.ItemTemplate>
                <DataTemplate x:DataType="vmComponents:GameItemViewModel">
                    <components:CoverButton
                        Width="160" Height="240"
                        controls:GameContextMenu.IsEnabled="True"
                        Command="{Binding $parent[local:GamesShelfView].((vm:GamesCollectionViewModel)DataContext).ViewGameDetailsCommand}"
                        CommandParameter="{Binding}" />
                </DataTemplate>
            </CarouselControl.ItemTemplate>
        </CarouselControl>
    </ScrollViewer>

</UserControl>
