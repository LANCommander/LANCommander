<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels"
             xmlns:views="using:LANCommander.Launcher.Views"
             xmlns:controls="using:LANCommander.Launcher.Controls"
             xmlns:components="using:LANCommander.Launcher.Views.Components"
             x:Class="LANCommander.Launcher.Views.InstallOptionsOverlay"
             x:DataType="vm:InstallOptionsViewModel"
             controls:AutoFocus.IsEnabled="True">

    <!-- Full-window dim backdrop -->
    <Grid Background="{DynamicResource ScrimBrush}">

        <!-- Centered card -->
        <Border Classes="Dialog"
                Width="560"
                MaxHeight="600"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <DockPanel>

                <!-- ── Header ─────────────────────────────────────────────── -->
                <Border DockPanel.Dock="Top" Classes="DialogHeader">
                    <components:DialogTitleBar Title="{Binding DialogTitle}"
                                               CloseRequested="TitleBar_CloseRequested" />
                </Border>

                <!-- ── Buttons ────────────────────────────────────────────── -->
                <Border DockPanel.Dock="Bottom" Classes="DialogFooterBar">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Classes="DialogFooter">
                        <Button Classes="Secondary" Content="Cancel"
                                Click="Cancel_Click" />
                        <Button Content="{Binding ConfirmButtonText}"
                                Classes="Primary"
                                Click="Confirm_Click" />
                    </StackPanel>
                </Border>

                <!-- ── Body ───────────────────────────────────────────────── -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <!-- Margin on the content rather than Padding on the ScrollViewer, which this
                         Avalonia version leaves out of the scroll extent -->
                    <views:InstallOptionsBody Margin="20,18" />
                </ScrollViewer>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
