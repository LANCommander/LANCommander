<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels"
             xmlns:models="using:LANCommander.SDK.Models"
             xmlns:views="using:LANCommander.Launcher.Views"
             xmlns:controls="using:LANCommander.Launcher.Controls"
             xmlns:components="using:LANCommander.Launcher.Views.Components"
             x:Class="LANCommander.Launcher.Views.ManageOverlay"
             x:DataType="vm:ManageOverlayViewModel"
             controls:AutoFocus.IsEnabled="True">

    <UserControl.DataTemplates>

        <!-- ══ Option node templates (shared by the Options section) ══════════ -->

        <!-- Group → expander section with recursive children -->
        <DataTemplate DataType="vm:GameOptionGroupViewModel">
            <Expander Header="{Binding DisplayName}"
                      IsExpanded="True"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding Children}" />
            </Expander>
        </DataTemplate>

        <!-- bool → CheckBox -->
        <DataTemplate DataType="vm:BoolOptionViewModel">
            <StackPanel Spacing="2" Margin="0,0,0,10">
                <CheckBox IsChecked="{Binding Value}"
                          Content="{Binding DisplayName}" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           FontSize="{DynamicResource FontSizeCaption}" Opacity="0.45"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!-- choice → ComboBox -->
        <DataTemplate DataType="vm:ChoiceOptionViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="{Binding DisplayName}"
                           IsVisible="{Binding HasLabel}"
                           FontSize="{DynamicResource FontSizeLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           FontSize="{DynamicResource FontSizeCaption}" Opacity="0.45"
                           TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding SelectedChoice}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="models:OptionChoice">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DataTemplate>

        <!-- int → NumericUpDown -->
        <DataTemplate DataType="vm:IntOptionViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="{Binding DisplayName}"
                           IsVisible="{Binding HasLabel}"
                           FontSize="{DynamicResource FontSizeLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           FontSize="{DynamicResource FontSizeCaption}" Opacity="0.45"
                           TextWrapping="Wrap" />
                <NumericUpDown Value="{Binding Value}"
                               Increment="1"
                               FormatString="0"
                               HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>

        <!-- string → TextBox -->
        <DataTemplate DataType="vm:StringOptionViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="{Binding DisplayName}"
                           IsVisible="{Binding HasLabel}"
                           FontSize="{DynamicResource FontSizeLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           FontSize="{DynamicResource FontSizeCaption}" Opacity="0.45"
                           TextWrapping="Wrap" />
                <TextBox Text="{Binding Value}"
                         HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>

        <!-- list row → fields + remove -->
        <DataTemplate DataType="vm:GameOptionListRowViewModel">
            <Border Background="{DynamicResource SurfaceRaisedBrush}"
                    Padding="8" Margin="0,0,0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Classes="Text"
                            Padding="6,4"
                            VerticalAlignment="Top"
                            Margin="6,0,0,0"
                            IsEnabled="{Binding CanRemove}"
                            Command="{Binding RemoveCommand}">
                        <Icon Type="Regular" Value="X" Width="12" Height="12" />
                    </Button>
                    <ItemsControl ItemsSource="{Binding Fields}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- list → rows + add -->
        <DataTemplate DataType="vm:GameOptionListViewModel">
            <StackPanel Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="{Binding DisplayName}"
                           IsVisible="{Binding HasLabel}"
                           FontSize="{DynamicResource FontSizeLabel}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}"
                           IsVisible="{Binding HasDescription}"
                           FontSize="{DynamicResource FontSizeCaption}" Opacity="0.45"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Rows}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="Secondary" Content="Add Item"
                            IsEnabled="{Binding CanAdd}"
                            Command="{Binding AddRowCommand}" />
                    <TextBlock Text="{Binding BoundsHint}"
                               IsVisible="{Binding HasBoundsHint}"
                               FontSize="{DynamicResource FontSizeCaption}" Opacity="0.45"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ══ Section content templates ═════════════════════════════════════ -->

        <!-- Options section -->
        <DataTemplate DataType="vm:GameOptionsOverlayViewModel">
            <StackPanel Spacing="0">
                <ItemsControl ItemsSource="{Binding RootLeaves}" />
                <ItemsControl ItemsSource="{Binding Tabs}" />
            </StackPanel>
        </DataTemplate>

        <!-- Modify section -->
        <DataTemplate DataType="vm:InstallOptionsViewModel">
            <views:InstallOptionsBody />
        </DataTemplate>

        <!-- Versions section -->
        <DataTemplate DataType="vm:GameVersionsViewModel">
            <ItemsControl ItemsSource="{Binding Versions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GameVersionItemViewModel">
                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                Padding="12,10"
                                Margin="0,0,0,6"
                                CornerRadius="4">
                            <StackPanel Spacing="6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Installed"
                                                   FontSize="{DynamicResource FontSizeKicker}"
                                                   Opacity="0.55"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding IsInstalled}" />
                                        <Button Content="{Binding ButtonText}"
                                                Classes="Primary"
                                                Command="{Binding SwitchCommand}"
                                                IsVisible="{Binding IsInstallable}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding VersionLabel}"
                                                   FontWeight="SemiBold"
                                                   FontSize="{DynamicResource FontSizeBody}" />
                                        <TextBlock Text="{Binding CreatedOnText}"
                                                   FontSize="{DynamicResource FontSizeKicker}"
                                                   Opacity="0.55"
                                                   IsVisible="{Binding CreatedOnKnown}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding ChangelogText}"
                                           FontSize="{DynamicResource FontSizeCaption}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding HasChangelog}" />
                                <TextBlock FontSize="{DynamicResource FontSizeKicker}"
                                           Opacity="0.55"
                                           IsVisible="{Binding HasSize}">
                                    <Run Text="Download:" />
                                    <Run Text="{Binding SizeText}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- Saves section: server saves as a list group, newest first. The newest gets the
             selected-row treatment (Raised + accent rail) and a LATEST tag. -->
        <DataTemplate DataType="vm:GameSavesViewModel">
            <StackPanel Spacing="10">
                <DockPanel IsVisible="{Binding HasSaves}">
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding TotalSizeText}"
                               Classes="Mono"
                               FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="ON THE SERVER" Classes="Kicker" VerticalAlignment="Center" />
                        <Border Classes="CountPill Neutral">
                            <TextBlock Text="{Binding Saves.Count}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="No cloud saves for this game yet."
                           Classes="Caption"
                           IsVisible="{Binding IsEmpty}" />

                <Border Classes="Card"
                        ClipToBounds="True"
                        IsVisible="{Binding HasSaves}">
                    <ItemsControl ItemsSource="{Binding Saves}">
                        <ItemsControl.Styles>
                            <Style Selector="Border.SaveRow">
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="Padding" Value="14,0,8,0" />
                                <Setter Property="BorderBrush" Value="{DynamicResource HairlineDividerBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                            <!-- Rail as a left border; padding trimmed by the same 2px so columns stay put -->
                            <Style Selector="Border.SaveRow.Latest">
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                                <Setter Property="BorderThickness" Value="2,0,0,0" />
                                <Setter Property="Padding" Value="12,0,8,0" />
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameSaveItemViewModel">
                                <Border Classes="SaveRow" Classes.Latest="{Binding IsLatest}">
                                    <!-- Timestamp | relative time + LATEST (shrinks first) | size | actions -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding TimestampText}"
                                                   Classes="Mono"
                                                   FontSize="{DynamicResource FontSizeLabel}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,14,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                                    VerticalAlignment="Center" ClipToBounds="True">
                                            <TextBlock Text="{Binding RelativeText}"
                                                       FontSize="{DynamicResource FontSizeCaption}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Classes="StatusTag" IsVisible="{Binding IsLatest}">
                                                <TextBlock Text="LATEST" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SizeText}"
                                                   Classes="Mono"
                                                   FontSize="{DynamicResource FontSizeCaption}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0"
                                                   IsVisible="{Binding HasSize}" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Classes="Secondary"
                                                    Width="30" Height="30" Padding="0"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Download this save"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Command="{Binding DownloadCommand}">
                                                <Icon Type="Regular" Value="DownloadSimple" Width="14" Height="14" />
                                            </Button>
                                            <Button Classes="Text Error"
                                                    Width="30" Height="30" Padding="0"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    ToolTip.Tip="Delete this save"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    Command="{Binding DeleteCommand}">
                                                <Icon Type="Regular" Value="Trash" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>

    </UserControl.DataTemplates>

    <!-- Full-window dim backdrop -->
    <Grid Background="{DynamicResource ScrimBrush}">

        <!-- Centered card -->
        <Border Classes="Dialog"
                Width="720"
                MaxHeight="640"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <DockPanel>

                <!-- ── Header ─────────────────────────────────────────────── -->
                <Border DockPanel.Dock="Top" Classes="DialogHeader">
                    <components:DialogTitleBar Title="{Binding DialogTitle}"
                                               CloseRequested="TitleBar_CloseRequested" />
                </Border>

                <!-- ── Footer ─────────────────────────────────────────────── -->
                <Border DockPanel.Dock="Bottom" Classes="DialogFooterBar">
                    <DockPanel>
                        <Button Classes="Secondary" DockPanel.Dock="Left"
                                Content="Close"
                                Click="Close_Click" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="12"
                                    Classes="DialogFooter">
                            <TextBlock Text="{Binding SelectedSection.Status}"
                                       Opacity="0.6"
                                       FontSize="{DynamicResource FontSizeCaption}"
                                       VerticalAlignment="Center" />
                            <Button Content="{Binding SelectedSection.ActionText}"
                                    Classes="Primary"
                                    IsVisible="{Binding SelectedSection.HasAction}"
                                    Command="{Binding SelectedSection.RunActionCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── Body: nav + content ────────────────────────────────── -->
                <Grid ColumnDefinitions="180,*" MinHeight="360">

                    <!-- Left navigation -->
                    <ListBox Grid.Column="0"
                             Background="{DynamicResource SurfaceRaisedBrush}"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManageSectionViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Icon Type="Regular"
                                          Value="{Binding IconValue}"
                                          Width="16" Height="16"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Right content -->
                    <ScrollViewer Grid.Column="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <!-- Margin on the content rather than Padding on the ScrollViewer, which this
                             Avalonia version leaves out of the scroll extent -->
                        <ContentControl Margin="20,8,20,8" Content="{Binding SelectedSection.Content}" />
                    </ScrollViewer>

                </Grid>

            </DockPanel>
        </Border>
    </Grid>
</UserControl>
