<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             x:Class="LANCommander.Launcher.Views.Packaging.CapturePanelView"
             x:DataType="vm:CaptureStepViewModel">

    <!-- The parts of a capture that look the same wherever it is run from: the base installer on
         the Monitor step, and any patch or mod installer on the Customize step. Typed against
         the shared base so both inherit it rather than keeping two copies in sync. -->
    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Elevation prompt -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="4"
                Background="#332A1A"
                BorderBrush="#FFA500"
                BorderThickness="1"
                IsVisible="{Binding NeedsElevation}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Restart as administrator"
                        Command="{Binding ElevateCommand}"
                        Margin="12,0,0,0"
                        Padding="14,6" />

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Administrator rights required"
                               FontWeight="SemiBold"
                               Foreground="#FFA500" />
                    <TextBlock Text="{Binding ElevationMessage}"
                               FontSize="12"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Counters -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Spacing="6">
                <!-- Uniform columns so the counters hold their position as the numbers climb
                     during a capture instead of shuffling sideways on every tick. -->
                <UniformGrid Columns="3"
                             MinWidth="240"
                             HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Files" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding FileCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Registry" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding RegistryCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Processes" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding ProcessCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </UniformGrid>

                <!-- Injection is a poll-and-inject race; a short-lived child can finish before it
                     can be hooked. Say so rather than quietly producing a partial capture. -->
                <TextBlock Foreground="#FFA500"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasUninstrumentedProcesses}"
                           Text="{Binding UninstrumentedProcessCount, StringFormat='{}{0} process(es) were seen but could not be monitored. Some files may be missing — the install folder is also scanned on the following steps.'}" />

                <TextBlock Foreground="#FFA500"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasDroppedEvents}"
                           Text="{Binding DroppedEventCount, StringFormat='{}{0} event(s) were dropped because the installer produced them faster than they could be recorded.'}" />
            </StackPanel>
        </Border>

        <!-- Log. A read-only TextBox rather than a list of TextBlocks so the capture summary
             can be selected and copied out. -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy log" Click="OnCopyLogClick" Padding="12,4" />
                    <Button Content="Save log..." Click="OnSaveLogClick" Padding="12,4" />
                </StackPanel>

                <TextBlock Text="Log" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
            </DockPanel>

            <TextBox Grid.Row="1"
                     x:Name="LogBox"
                     Text="{Binding LogText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas,Menlo,monospace"
                     FontSize="11"
                     VerticalContentAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</UserControl>
