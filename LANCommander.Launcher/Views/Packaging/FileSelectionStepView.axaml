<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             xmlns:components="using:LANCommander.Launcher.ViewModels.Components"
             x:Class="LANCommander.Launcher.Views.Packaging.FileSelectionStepView"
             x:DataType="vm:FileSelectionStepViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="Secondary" Content="Select all" Command="{Binding SelectAllCommand}" Padding="12,5" />
                <Button Classes="Secondary" Content="Select none" Command="{Binding SelectNoneCommand}" Padding="12,5" />
                <Button Classes="Secondary" Content="Rescan" Command="{Binding RefreshCommand}" Padding="12,5" />
            </StackPanel>

            <TextBlock Text="Choose the files to include"
                       FontSize="{DynamicResource FontSizeSection}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <!-- The disk sweep recovers files written by processes that could not be instrumented
                 in time, which is the main practical mitigation for the injection race. -->
            <Border Classes="Notice Success" IsVisible="{Binding HasSweptFiles}">
                <DockPanel>
                    <Icon DockPanel.Dock="Left" Type="Regular" Value="CheckCircle" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding SweptFileCount, StringFormat='{}Found {0} additional file(s) in the install folder that were not captured while monitoring. They are included by default.'}" />
                </DockPanel>
            </Border>

            <Border Classes="Notice Info" IsVisible="{Binding HasPostInstallFiles}">
                <DockPanel>
                    <Icon DockPanel.Dock="Left" Type="Regular" Value="Info" Width="14" Height="14" Margin="0,1,10,0" VerticalAlignment="Top" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding PostInstallFileCount, StringFormat='{}{0} file(s) were added or changed after the install finished; they are marked in the tree below.'}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Classes="Card" Padding="6,8">
            <TreeView ItemsSource="{Binding Roots}">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="components:CheckableTreeNode"
                                      ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsThreeState="False"
                                      MinWidth="0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />

                            <!-- Marks what the Customize step saw appear or change, so a no-CD
                                 patch is findable among the installer's thousands of files. -->
                            <Border Classes="StatusTag"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasAnnotation}">
                                <TextBlock Text="{Binding Annotation}" />
                            </Border>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{Binding Summary}"
                   Classes="Mono"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</UserControl>
