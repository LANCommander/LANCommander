<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             xmlns:components="using:LANCommander.Launcher.ViewModels.Components"
             x:Class="LANCommander.Launcher.Views.Packaging.FileSelectionStepView"
             x:DataType="vm:FileSelectionStepViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Select all" Command="{Binding SelectAllCommand}" Padding="12,5" />
                <Button Content="Select none" Command="{Binding SelectNoneCommand}" Padding="12,5" />
                <Button Content="Rescan" Command="{Binding RefreshCommand}" Padding="12,5" />
            </StackPanel>

            <TextBlock Text="Choose the files to include"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
            <!-- The disk sweep recovers files written by processes that could not be instrumented
                 in time, which is the main practical mitigation for the injection race. -->
            <TextBlock FontSize="12"
                       Foreground="#7FBF7F"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasSweptFiles}"
                       Text="{Binding SweptFileCount, StringFormat='{}Found {0} additional file(s) in the install folder that were not captured while monitoring. They are included by default.'}" />

            <TextBlock FontSize="12"
                       Foreground="#7FA8BF"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasPostInstallFiles}"
                       Text="{Binding PostInstallFileCount, StringFormat='{}{0} file(s) were added or changed after the install finished; they are marked in the tree below.'}" />
        </StackPanel>

        <Border Grid.Row="2"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <TreeView ItemsSource="{Binding Roots}" Padding="6">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="components:CheckableTreeNode"
                                      ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsThreeState="False"
                                      MinWidth="0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />

                            <!-- Marks what the Customize step saw appear or change, so a no-CD
                                 patch is findable among the installer's thousands of files. -->
                            <Border CornerRadius="3"
                                    Padding="5,1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                    IsVisible="{Binding HasAnnotation}">
                                <TextBlock Text="{Binding Annotation}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#7FA8BF" />
                            </Border>
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{Binding Summary}"
                   FontSize="12"
                   Opacity="0.7" />
    </Grid>
</UserControl>
