<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             xmlns:packaging="using:LANCommander.Launcher.Views.Packaging"
             x:Class="LANCommander.Launcher.Views.Packaging.MonitorStepView"
             x:DataType="vm:MonitorStepViewModel">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Installer picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="Browse..."
                    Click="OnBrowseClick"
                    IsEnabled="{Binding !IsMonitoring}"
                    Margin="8,0,0,0"
                    Padding="14,6" />

            <TextBox Text="{Binding InstallerPath}"
                     Watermark="Choose the installer to monitor"
                     IsEnabled="{Binding !IsMonitoring}" />
        </DockPanel>

        <!-- Status + controls -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Start"
                        Classes="Primary"
                        Command="{Binding StartCommand}"
                        IsVisible="{Binding !IsMonitoring}"
                        Padding="16,6" />

                <!-- The Packager had no way to end a capture early, so an installer that left a
                     helper running stranded the wizard. -->
                <Button Content="Stop monitoring"
                        Classes="Primary"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsMonitoring}"
                        Padding="16,6" />
            </StackPanel>

            <TextBlock Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <packaging:CapturePanelView Grid.Row="2" />
    </Grid>
</UserControl>
