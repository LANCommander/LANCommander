<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             x:Class="LANCommander.Launcher.Views.Packaging.MonitorStepView"
             x:DataType="vm:MonitorStepViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Installer picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="Browse..."
                    Click="OnBrowseClick"
                    IsEnabled="{Binding !IsMonitoring}"
                    Margin="8,0,0,0"
                    Padding="14,6" />

            <TextBox Text="{Binding InstallerPath}"
                     Watermark="Choose the installer to monitor"
                     IsEnabled="{Binding !IsMonitoring}" />
        </DockPanel>

        <!-- Status + controls -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Start"
                        Classes="Primary"
                        Command="{Binding StartCommand}"
                        IsVisible="{Binding !IsMonitoring}"
                        Padding="16,6" />

                <!-- The Packager had no way to end a capture early, so an installer that left a
                     helper running stranded the wizard. -->
                <Button Content="Stop monitoring"
                        Classes="Primary"
                        Command="{Binding StopCommand}"
                        IsVisible="{Binding IsMonitoring}"
                        Padding="16,6" />
            </StackPanel>

            <TextBlock Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </DockPanel>

        <!-- Elevation prompt -->
        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="4"
                Background="#332A1A"
                BorderBrush="#FFA500"
                BorderThickness="1"
                IsVisible="{Binding NeedsElevation}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Restart as administrator"
                        Command="{Binding ElevateCommand}"
                        Margin="12,0,0,0"
                        Padding="14,6" />

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Administrator rights required"
                               FontWeight="SemiBold"
                               Foreground="#FFA500" />
                    <TextBlock Text="{Binding ElevationMessage}"
                               FontSize="12"
                               Opacity="0.85"
                               TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Counters -->
        <Border Grid.Row="3"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel>
                        <TextBlock Text="Files" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding FileCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Registry" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding RegistryCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Processes" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding ProcessCount}" FontSize="20" FontWeight="Bold" />
                    </StackPanel>
                </StackPanel>

                <!-- Injection is a poll-and-inject race; a short-lived child can finish before it
                     can be hooked. Say so rather than quietly producing a partial capture. -->
                <TextBlock Foreground="#FFA500"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasUninstrumentedProcesses}"
                           Text="{Binding UninstrumentedProcessCount, StringFormat='{}{0} process(es) were seen but could not be monitored. Some files may be missing — the next step also scans the install folder.'}" />

                <TextBlock Foreground="#FFA500"
                           FontSize="12"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasDroppedEvents}"
                           Text="{Binding DroppedEventCount, StringFormat='{}{0} event(s) were dropped because the installer produced them faster than they could be recorded.'}" />
            </StackPanel>
        </Border>

        <!-- Log -->
        <Border Grid.Row="4"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <ScrollViewer Padding="10">
                <ItemsControl ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}"
                                       FontFamily="Consolas,Menlo,monospace"
                                       FontSize="11"
                                       Opacity="0.8"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
