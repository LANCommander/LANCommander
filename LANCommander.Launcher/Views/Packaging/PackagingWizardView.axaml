<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             x:Class="LANCommander.Launcher.Views.Packaging.PackagingWizardView"
             x:DataType="vm:PackagingWizardViewModel">

    <UserControl.Styles>
        <!-- Step indicator. Display only: Back/Next remain the only navigation, so a step cannot
             be entered without OnLeaveAsync having run on the one before it. -->
        <Style Selector="Rectangle.connector">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource InputBorderBrush}" />
        </Style>

        <Style Selector="Border.marker">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.marker.complete">
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}" />
        </Style>
        <!-- After .complete so the current step wins if both ever applied. -->
        <Style Selector="Border.marker.current">
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}" />
        </Style>

        <Style Selector="TextBlock.markerNumber">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        </Style>
        <Style Selector="TextBlock.markerNumber.current">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryTextBrush}" />
        </Style>

        <Style Selector="TextBlock.stepLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        </Style>
        <Style Selector="TextBlock.stepLabel.complete">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.stepLabel.current">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">

        <!-- Current step. Uses the shared view registry so each step resolves to its own view,
             which also lets a plugin replace an individual step later.
             The 52px top inset clears the floating shell titlebar. -->
        <ContentControl Grid.Row="0"
                        x:Name="StepHost"
                        Margin="16,52,16,12"
                        Content="{Binding CurrentStep}" />

        <!-- Footer: the step indicator and the navigation buttons share a row. -->
        <Border Grid.Row="1"
                Padding="16,10"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
            <Grid RowDefinitions="Auto,Auto">

                <TextBlock Grid.Row="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

                    <!-- Clips rather than pushing the buttons off-screen if the steps ever outgrow
                         the 900px minimum window width. -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding ApplicableSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PackagingStepViewModel">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Rectangle Classes="connector" IsVisible="{Binding !IsFirst}" />

                                        <Border Classes="marker"
                                                Classes.current="{Binding IsCurrent}"
                                                Classes.complete="{Binding IsComplete}">
                                            <Panel>
                                                <TextBlock Classes="markerNumber"
                                                           Classes.current="{Binding IsCurrent}"
                                                           Text="{Binding DisplayNumber}"
                                                           IsVisible="{Binding !IsComplete}" />

                                                <Icon Type="Bold"
                                                      Value="Check"
                                                      Width="11"
                                                      Height="11"
                                                      Foreground="{DynamicResource ButtonPrimaryBgBrush}"
                                                      IsVisible="{Binding IsComplete}" />
                                            </Panel>
                                        </Border>

                                        <TextBlock Classes="stepLabel"
                                                   Classes.current="{Binding IsCurrent}"
                                                   Classes.complete="{Binding IsComplete}"
                                                   Text="{Binding Title}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="16,0,0,0">
                        <Button Content="Back"
                                Command="{Binding BackCommand}"
                                IsEnabled="{Binding CanGoBack}"
                                Padding="16,6" />

                        <Button Content="{Binding NextLabel}"
                                Classes="Primary"
                                Command="{Binding NextCommand}"
                                IsEnabled="{Binding CurrentStep.CanGoNext}"
                                IsVisible="{Binding !IsLastStep}"
                                Padding="16,6" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
