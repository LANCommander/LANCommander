<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             xmlns:packaging="using:LANCommander.Launcher.Views.Packaging"
             x:Class="LANCommander.Launcher.Views.Packaging.PostInstallStepView"
             x:DataType="vm:PostInstallStepViewModel">

    <UserControl.Styles>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="Additional Changes"
                       FontSize="15"
                       FontWeight="SemiBold" />

            <TextBlock FontSize="12"
                       Opacity="0.7"
                       TextWrapping="Wrap"
                       Text="Apply any additional changes to the game files now. When you're ready to continue packaging, click the rescan button." />

            <TextBlock Text="{Binding InstallDirectory}"
                       FontSize="11"
                       Opacity="0.55"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid RowDefinitions="Auto,Auto">
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                        <!-- First in the row because it is the other way of making a change, not
                             a variation on rescanning. -->
                        <Button Content="Run &amp; Monitor"
                                Click="OnRunInstallerClick"
                                IsVisible="{Binding !IsMonitoring}"
                                ToolTip.Tip="Select another executable to run and monitor for additional file and registry changes"
                                Padding="12,5" />

                        <Button Content="Stop monitoring"
                                Classes="Primary"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsMonitoring}"
                                Padding="14,5" />

                        <Button Content="Browse"
                                Command="{Binding BrowseInstallFolderCommand}"
                                ToolTip.Tip="Open the install folder"
                                Padding="12,5" />

                        <Button Content="Reset"
                                Command="{Binding ResetBaselineCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                ToolTip.Tip="Treat the folder as it is now as the starting point, and forget the changes listed below."
                                Padding="12,5" />

                        <Button Content="Rescan"
                                Classes="Primary"
                                Command="{Binding RescanCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                Padding="14,5" />
                    </StackPanel>

                    <TextBlock Text="{Binding ScanSummary}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>

                <UniformGrid Grid.Row="1"
                             Columns="4"
                             MinWidth="320"
                             Margin="0,10,0,0"
                             HorizontalAlignment="Left"
                             IsVisible="{Binding HasScanned}">
                    <StackPanel>
                        <TextBlock Text="Baseline" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding BaselineFileCount}" FontSize="18" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Added" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding AddedCount}" FontSize="18" FontWeight="Bold" Foreground="#7FBF7F" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Changed" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding ModifiedCount}" FontSize="18" FontWeight="Bold" Foreground="#7FA8BF" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Removed" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding RemovedCount}" FontSize="18" FontWeight="Bold" Foreground="#BF7F7F" />
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- Monitoring state, and what has been run so far. Both stay out of the way until an
             installer has actually been run through the step. -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="{Binding Status}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ItemsControl ItemsSource="{Binding AdditionalInstallers}"
                          IsVisible="{Binding HasAdditionalInstallers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}"
                                   FontSize="11"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Only once something has been run: an empty log panel on a step most people will walk
             straight past is just noise. -->
        <packaging:CapturePanelView Grid.Row="3"
                                    Height="200"
                                    Margin="0,0,0,10"
                                    IsVisible="{Binding HasLog}" />

        <!-- What changed -->
        <Border Grid.Row="4"
                CornerRadius="4"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid RowDefinitions="*,Auto">
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Changes}"
                         Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:DirectoryChangeItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="badge" Background="#1F3A1F" IsVisible="{Binding IsAdded}">
                                    <TextBlock Text="added" Foreground="#7FBF7F" />
                                </Border>
                                <Border Classes="badge" Background="#1F2E3A" IsVisible="{Binding IsModified}">
                                    <TextBlock Text="changed" Foreground="#7FA8BF" />
                                </Border>
                                <Border Classes="badge" Background="#3A1F1F" IsVisible="{Binding IsRemoved}">
                                    <TextBlock Text="removed" Foreground="#BF7F7F" />
                                </Border>

                                <TextBlock Text="{Binding RelativePath}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding Path}" />

                                <TextBlock Text="{Binding Size}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Margin="8,6"
                           FontSize="11"
                           Foreground="#FFA500"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsChangeListTruncated}"
                           Text="Only the first 2,000 changes are listed. The counts above are complete, and every changed file is still included in the package." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
