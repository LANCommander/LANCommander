<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.Packaging"
             xmlns:components="using:LANCommander.Launcher.ViewModels.Components"
             x:Class="LANCommander.Launcher.Views.Packaging.RegistrySelectionStepView"
             x:DataType="vm:RegistrySelectionStepViewModel">

    <!-- Values are not files; the theme's file glyph would say otherwise -->
    <UserControl.Styles>
        <Style Selector="Icon.TreeIcon">
            <Setter Property="Value" Value="Hash" />
        </Style>
        <Style Selector="Icon.TreeIcon.Folder">
            <Setter Property="Value" Value="FolderSimple" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="Secondary" Content="Select all" Command="{Binding SelectAllCommand}" Padding="12,5" />
                <Button Classes="Secondary" Content="Select none" Command="{Binding SelectNoneCommand}" Padding="12,5" />
            </StackPanel>

            <TextBlock Text="Choose the registry changes to recreate"
                       FontSize="{DynamicResource FontSizeSection}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Classes="Card" Padding="6,8">
            <TreeView ItemsSource="{Binding Roots}">
                <!-- The node decides what starts open; without this every branch starts collapsed -->
                <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="components:CheckableTreeNode">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="components:CheckableTreeNode"
                                      ItemsSource="{Binding Children}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Left"
                                      Margin="0,0,8,0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsThreeState="False" />
                            <Icon DockPanel.Dock="Left"
                                  Margin="0,0,8,0"
                                  Classes="TreeIcon"
                                  Classes.Folder="{Binding !IsLeaf}" />

                            <Border DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Classes="StatusTag"
                                    ToolTip.Tip="Key created"
                                    IsVisible="{Binding IsCreate}">
                                <TextBlock Text="CREATED" />
                            </Border>
                            <Border DockPanel.Dock="Right"
                                    Margin="8,0,0,0"
                                    Classes="StatusTag Warning"
                                    ToolTip.Tip="Value written"
                                    IsVisible="{Binding IsUpdate}">
                                <TextBlock Text="WRITTEN" />
                            </Border>

                            <!-- Keys read as folders; values in mono like file names -->
                            <TextBlock Classes="TreeLabel"
                                       Classes.Mono="{Binding IsLeaf}"
                                       Classes.Excluded="{Binding IsExcluded}"
                                       Text="{Binding Name}" />
                        </DockPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Text="{Binding Summary}"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Opacity="0.7"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
