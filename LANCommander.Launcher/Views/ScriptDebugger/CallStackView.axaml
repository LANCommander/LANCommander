<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.ScriptDebugger"
             xmlns:items="using:LANCommander.Launcher.ViewModels.ScriptDebugger.Items"
             x:Class="LANCommander.Launcher.Views.ScriptDebugger.CallStackView"
             x:DataType="vm:CallStackViewModel">

  <ListBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" Background="Transparent" Padding="4,6">
    <ListBox.ItemTemplate>
      <DataTemplate x:DataType="items:CallStackFrameViewModel">
        <TextBlock Classes="Code" Text="{Binding Display}" />
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
