<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LANCommander.Launcher.ViewModels.ScriptDebugger"
        xmlns:views="using:LANCommander.Launcher.Views.ScriptDebugger"
        x:Class="LANCommander.Launcher.Views.ScriptDebugger.ScriptDebuggerWindow"
        x:DataType="vm:ScriptDebuggerWindowViewModel"
        Title="{Binding Title}"
        Width="1400" Height="860"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceCanvasBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RunCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding StopCommand}" />
    <KeyBinding Gesture="F10" Command="{Binding StepOverCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding StepIntoCommand}" />
    <KeyBinding Gesture="Shift+F11" Command="{Binding StepOutCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding ToggleBreakpointCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <!-- Editor zoom. OemPlus is the =/+ key, so Ctrl+= and Ctrl+Shift+= both zoom in; the numpad works too. -->
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+OemPlus" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ResetZoomCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ResetZoomCommand}" />
  </Window.KeyBindings>

  <!--
    The debugger is a dense tool window, so it tightens a few launcher defaults. Everything else (buttons,
    cards, tags, notices, trees) comes from the launcher theme. Scoped to this window and its panes.
  -->
  <Window.Styles>
    <!-- Square icon buttons in the toolbar -->
    <Style Selector="Border.DebugToolbar Button">
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.DebugToolbar Icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Border.ToolbarDivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource HairlineBorderBrush}" />
    </Style>

    <!-- The splitters sit in the gutters between cards and stay invisible -->
    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Debug panes list many short rows: tighter than the launcher's list rows -->
    <Style Selector="ListBox ListBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Console and command lists: one line per row -->
    <Style Selector="ListBox.Dense ListBoxItem">
      <Setter Property="Padding" Value="10,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Code-shaped text: names, values, expressions, console output -->
    <Style Selector="TextBlock.Code">
      <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>
    <Style Selector="TextBox.Code">
      <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <!-- Kicker headings inside a card -->
    <Style Selector="TextBlock.PaneHeader">
      <Setter Property="Margin" Value="12,10,12,6" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Toolbar -->
    <Border Classes="DebugToolbar" DockPanel.Dock="Top" Padding="12,10"
            BorderBrush="{DynamicResource HairlineBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <Button Classes="Primary"
                  Command="{Binding RunCommand}"
                  IsEnabled="{Binding CanRun}"
                  ToolTip.Tip="{Binding IsStopped, Converter={x:Static views:ScriptDebuggerWindow.RunTip}}">
            <Icon Type="Regular" Value="Play" />
          </Button>
          <Button Classes="Error" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" ToolTip.Tip="Stop (Shift+F5)">
            <Icon Type="Regular" Value="Stop" />
          </Button>

          <Border Classes="ToolbarDivider" />

          <Button Classes="Secondary" Command="{Binding StepOverCommand}" IsEnabled="{Binding CanStep}" ToolTip.Tip="Step Over (F10)">
            <Icon Type="Regular" Value="ArrowArcRight" />
          </Button>
          <Button Classes="Secondary" Command="{Binding StepIntoCommand}" ToolTip.Tip="Step Into, or run the selected script and break on its first line (F11)">
            <Icon Type="Regular" Value="ArrowLineDown" />
          </Button>
          <Button Classes="Secondary" Command="{Binding StepOutCommand}" IsEnabled="{Binding CanStep}" ToolTip.Tip="Step Out (Shift+F11)">
            <Icon Type="Regular" Value="ArrowLineUp" />
          </Button>

          <Border Classes="ToolbarDivider" />

          <Button Classes="Secondary" Command="{Binding SaveCommand}" IsEnabled="{Binding HasDocument}" ToolTip.Tip="Save (Ctrl+S)">
            <Icon Type="Regular" Value="FloppyDisk" />
          </Button>
          <Button Classes="Secondary" Command="{Binding DiscardDraftCommand}" IsVisible="{Binding CanDiscardDraft}" ToolTip.Tip="Discard Draft">
            <Icon Type="Regular" Value="Trash" />
          </Button>
          <Button Classes="Secondary" Command="{Binding UploadCommand}" IsVisible="{Binding CanUpload}"
                  ToolTip.Tip="Upload to Server: replace the server's copy of this script with the text in the editor">
            <Icon Type="Regular" Value="CloudArrowUp" />
          </Button>

          <Border Classes="ToolbarDivider" />

          <Button Classes="Secondary" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="Refresh">
            <Icon Type="Regular" Value="ArrowClockwise" />
          </Button>
          <!-- A toggle drawn with the launcher's button variants: accent while the pane is open -->
          <Button Classes.Secondary="{Binding !IsCommandsPaneVisible}"
                  Classes.Primary="{Binding IsCommandsPaneVisible}"
                  Command="{Binding ToggleCommandsPaneCommand}"
                  ToolTip.Tip="Commands">
            <Icon Type="Regular" Value="ListMagnifyingGlass" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="StatusTag Error" IsVisible="{Binding RemoteSessionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding RemoteSessionText}" />
          </Border>
          <Border Classes="StatusTag"
                  ToolTip.Tip="Any of this game's scripts that runs while this window is open (install, play, uninstall, name or key change) stops at its breakpoints.">
            <TextBlock Text="ATTACHED" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="12,6"
            BorderBrush="{DynamicResource HairlineBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="Caption" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" Classes="Caption" Margin="16,0" Text="{Binding Console.ProgressText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Classes="Caption" Margin="8,0" Foreground="{DynamicResource ErrorTextBrush}"
                   Text="{Binding ErrorCount, StringFormat='{}{0} parse error(s)'}"
                   IsVisible="{Binding ErrorCount, Converter={x:Static views:ScriptDebuggerWindow.IsPositive}}" />
        <TextBlock Grid.Column="3" Classes="Caption Mono" Margin="8,0" Text="{Binding CaretText}" />
        <TextBlock Grid.Column="4" Classes="Caption" Margin="8,0,0,0" Text="{Binding State}" />
      </Grid>
    </Border>

    <!-- Notices -->
    <Border Classes="Notice" DockPanel.Dock="Top" Margin="12,12,12,0" Padding="12,6" IsVisible="{Binding HasPendingDrafts}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{Binding PendingDraftCount, StringFormat='{}{0} draft(s) were saved before this game was installed and have not been applied to its scripts yet.'}" />
        <Button Grid.Column="1" Classes="Secondary" Margin="12,0,0,0" Padding="12,4" Content="Apply Drafts" Command="{Binding ApplyPendingDraftsCommand}" />
        <Button Grid.Column="2" Classes="Secondary" Margin="6,0,0,0" Padding="12,4" Content="Discard" Command="{Binding DiscardPendingDraftsCommand}" />
      </Grid>
    </Border>

    <Border Classes="Notice Warning" DockPanel.Dock="Top" Margin="12,12,12,0" Padding="12,6" IsVisible="{Binding HasUploadConflict}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="The server's copy of this script changed after it was opened here. Uploading replaces those changes." />
        <Button Grid.Column="1" Classes="Warning" Margin="12,0,0,0" Padding="12,4" Content="Overwrite Server Copy" Command="{Binding OverwriteUploadCommand}" />
        <Button Grid.Column="2" Classes="Secondary" Margin="6,0,0,0" Padding="12,4" Content="Cancel" Command="{Binding CancelUploadCommand}" />
      </Grid>
    </Border>

    <Grid Margin="12" ColumnDefinitions="320,12,*,Auto,Auto">

      <!-- Scripts -->
      <Border Grid.Column="0" Classes="Card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="Kicker PaneHeader" Text="SCRIPTS" />

          <Border DockPanel.Dock="Top" Classes="Notice" Margin="8,0,8,8" Padding="10,6" IsVisible="{Binding !IsInstalled}">
            <TextBlock TextWrapping="Wrap" Text="Not installed: showing the server's scripts. Edits are saved as drafts." />
          </Border>

          <Border DockPanel.Dock="Top" Classes="Notice Warning" Margin="8,0,8,8" Padding="10,6" IsVisible="{Binding HasWorkspaceMessage}">
            <TextBlock TextWrapping="Wrap" Text="{Binding WorkspaceMessage}" />
          </Border>

          <TextBlock DockPanel.Dock="Top" Classes="Caption" Margin="12,0,12,8" Text="Loading..." IsVisible="{Binding IsLoading}" />

          <TreeView x:Name="ScriptTree" Background="Transparent" Padding="6,0,6,8"
                    ItemsSource="{Binding Owners}"
                    SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
              </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:ScriptOwnerViewModel" ItemsSource="{Binding Scripts}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Classes="TreeLabel" FontWeight="SemiBold" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" Classes="TreeMeta" Margin="8,0,0,0" Text="{Binding KindLabel}" />
                </Grid>
              </TreeDataTemplate>
              <DataTemplate DataType="vm:ScriptItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningTextBrush}" VerticalAlignment="Center"
                             IsVisible="{Binding IsRunning}" ToolTip.Tip="Running" />
                    <TextBlock Classes="TreeLabel" Text="{Binding Name}" />
                    <TextBlock Classes="TreeLabel" Margin="-6,0,0,0" Text="*" IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved changes" />
                    <Border Classes="StatusTag">
                      <TextBlock Text="{Binding TypeLabel}" />
                    </Border>
                    <Border Classes="StatusTag Error" IsVisible="{Binding RequiresAdmin}"
                            ToolTip.Tip="Runs elevated. It is debugged in the elevated process over a pipe.">
                      <TextBlock Text="Admin" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="TreeMeta" Margin="8,0,0,0" Text="{Binding SourceLabel}"
                             IsVisible="{Binding !IsOnServer}" />
                  <Icon Grid.Column="2" Type="Regular" Value="Cloud" Width="14" Height="14" Margin="8,0,2,0"
                        Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsOnServer}"
                        ToolTip.Tip="On the server. Not installed yet; edits are saved as drafts." />
                </Grid>
              </DataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="12" VerticalAlignment="Stretch" />

      <!-- Editor and debug panels -->
      <Grid Grid.Column="2" RowDefinitions="*,12,300">

        <Border Grid.Row="0" Classes="Card" ClipToBounds="True">
          <views:EditorView />
        </Border>

        <GridSplitter Grid.Row="1" Height="12" HorizontalAlignment="Stretch" />

        <Grid Grid.Row="2" ColumnDefinitions="*,12,*">

          <Border Grid.Column="0" Classes="Card" ClipToBounds="True">
            <TabControl Margin="4,0" SelectedIndex="{Binding SelectedPanelIndex, Mode=TwoWay}">
              <TabItem Header="Variables">
                <views:VariablesView DataContext="{Binding Variables}" />
              </TabItem>
              <TabItem Header="Watch">
                <views:WatchView DataContext="{Binding Watch}" />
              </TabItem>
              <TabItem Header="Call Stack">
                <views:CallStackView DataContext="{Binding CallStack}" />
              </TabItem>
              <TabItem Header="Breakpoints">
                <views:BreakpointsView DataContext="{Binding Breakpoints}" />
              </TabItem>
            </TabControl>
          </Border>

          <GridSplitter Grid.Column="1" Width="12" VerticalAlignment="Stretch" />

          <Border Grid.Column="2" Classes="Card" ClipToBounds="True">
            <views:ConsoleView DataContext="{Binding Console}" />
          </Border>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Width="12" VerticalAlignment="Stretch"
                    IsVisible="{Binding IsCommandsPaneVisible}" />

      <!--
        The Border keeps the window view model as its DataContext, so IsVisible binds to the toggle while
        the pane itself binds to Commands. An Auto column collapses when its child is hidden.
      -->
      <Border Grid.Column="4" Classes="Card" Width="340" ClipToBounds="True" IsVisible="{Binding IsCommandsPaneVisible}">
        <views:CommandsView DataContext="{Binding Commands}" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
