<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.ScriptDebugger"
             xmlns:items="using:LANCommander.Launcher.ViewModels.ScriptDebugger.Items"
             x:Class="LANCommander.Launcher.Views.ScriptDebugger.VariablesView"
             x:DataType="vm:VariablesViewModel">

  <Grid>
    <TreeView Classes="dense" ItemsSource="{Binding Nodes}" Background="Transparent">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="items:VariableNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="items:VariableNodeViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" Foreground="#9CDCFE" FontFamily="Cascadia Code,Consolas,monospace" />
            <TextBlock Text="{Binding Value}" Foreground="#D4D4D4" FontFamily="Cascadia Code,Consolas,monospace" />
            <TextBlock Text="{Binding TypeName}" Foreground="#6A9955" FontStyle="Italic" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <TextBlock Text="{Binding EmptyMessage}" Margin="12" Foreground="#808080"
               IsVisible="{Binding IsEmpty}" />
  </Grid>
</UserControl>
