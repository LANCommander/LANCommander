<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LANCommander.Launcher.ViewModels.ScriptDebugger"
             xmlns:items="using:LANCommander.Launcher.ViewModels.ScriptDebugger.Items"
             x:Class="LANCommander.Launcher.Views.ScriptDebugger.VariablesView"
             x:DataType="vm:VariablesViewModel">

  <Grid>
    <TreeView ItemsSource="{Binding Nodes}" Background="Transparent" Padding="2,6">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="items:VariableNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="MinHeight" Value="24" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="items:VariableNodeViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="Code" Text="{Binding Name}" Foreground="#9CDCFE" VerticalAlignment="Center" />
            <TextBlock Classes="Code" Text="{Binding Value}" VerticalAlignment="Center" />
            <TextBlock Classes="TreeMeta" Text="{Binding TypeName}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <TextBlock Classes="Caption" Text="{Binding EmptyMessage}" Margin="12" IsVisible="{Binding IsEmpty}" />
  </Grid>
</UserControl>
