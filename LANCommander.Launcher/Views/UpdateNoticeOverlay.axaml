<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:LANCommander.Launcher.Controls"
             xmlns:components="using:LANCommander.Launcher.Views.Components"
             x:Class="LANCommander.Launcher.Views.UpdateNoticeOverlay"
             controls:AutoFocus.IsEnabled="True">

    <!-- After an update: what changed, or why it was undone -->
    <Grid Background="{DynamicResource ScrimBrush}">

        <Border Classes="Dialog"
                Width="560"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <DockPanel>
                <Border Classes="DialogHeader" DockPanel.Dock="Top">
                    <components:DialogTitleBar x:Name="TitleBar"
                                               Title="What's New"
                                               CloseRequested="TitleBar_CloseRequested" />
                </Border>

                <Border Classes="DialogFooter DialogFooterBar" DockPanel.Dock="Bottom">
                    <Button Content="OK"
                            Classes="Primary"
                            HorizontalAlignment="Right"
                            Click="OK_Click" />
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="20,18">
                        <!-- Why the update was undone -->
                        <Border x:Name="ErrorPanel"
                                Classes="Notice Warning"
                                IsVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Icon Type="Regular" Value="Warning" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="470" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="SummaryText"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   Opacity="0.85" />

                        <controls:MarkdownTextBlock x:Name="Notes"
                                                    IsVisible="False" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
