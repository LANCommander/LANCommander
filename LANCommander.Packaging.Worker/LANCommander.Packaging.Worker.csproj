<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Out-of-process API-hook monitor.

    DLL injection via CreateRemoteThread/LoadLibraryW only works when the injector and the
    target share a bitness. The launcher is the worker for its own architecture (it hosts
    LANCommander.Packaging.Worker.Core itself), so this executable only ships for the other one,
    under Data\Libraries\Packaging\{arch}\. The logic lives in Worker.Core; this is just the host.
  -->
  <PropertyGroup>
    <!-- WinExe, not Exe: the elevated worker is started with ShellExecute/runas, which ignores
         CreateNoWindow, so a console subsystem binary would flash a window on every launch. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>LANCommander.Packaging.Worker</RootNamespace>
    <AssemblyName>LANCommander.Packaging.Worker</AssemblyName>

    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- One native executable of a few MB. Native AOT links with MSVC, so it needs the "Desktop
         development with C++" workload and a Windows build machine; pass
         -p:PackagingWorkerAot=false to publish a self-contained single file instead. Neither
         extracts anything at run time. -->
    <PublishAot Condition="'$(PackagingWorkerAot)' != 'false'">true</PublishAot>
    <PublishSingleFile Condition="'$(PackagingWorkerAot)' == 'false'">true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(PackagingWorkerAot)' == 'false'">true</EnableCompressionInSingleFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- The launcher deploys the Interposer under Data\Libraries\Interposer\, which Program.cs
         points the worker at. -->
    <InterposerCopyNativeBinaries>false</InterposerCopyNativeBinaries>

    <!-- asInvoker; the worker escalates on demand rather than prompting every session.
         See app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced directly only to drop the package's own runtime native asset, which would
         otherwise land beside the executable as a second copy of the DLL. -->
    <PackageReference Include="LANCommander.Interposer" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.Packaging.Worker.Core\LANCommander.Packaging.Worker.Core.csproj" />
  </ItemGroup>

  <!-- CopyOutputSymbolsToPublishDirectory covers this project's symbols, not its references'. -->
  <Target Name="RemoveReferencedSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
