<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!--
    asInvoker, deliberately.

    The worker starts at whatever integrity level the launcher has and only escalates when it
    actually needs to: if launching or injecting fails with ERROR_ELEVATION_REQUIRED or
    ERROR_ACCESS_DENIED, it reports that upward and the launcher respawns it through UAC. A
    requireAdministrator manifest would force a consent prompt at the start of every packaging
    session, including the many installers that never need one.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
