<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sample plugin's PostgreSql migrations, generated with dotnet ef migrations add, run in this folder with this project as both project and startup project -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" PrivateAssets="all" />
    <!-- Lifts EF's design-time Roslyn to the version the repository pins -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin\LANCommander.Server.Tests.SamplePlugin.csproj" />
  </ItemGroup>

</Project>
