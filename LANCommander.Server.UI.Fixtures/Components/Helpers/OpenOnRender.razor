@using LANCommander.Server.UI.Services
@inject DialogService Dialogs
@inject AlertService Alerts
@inject NotificationService Notifications

@* Opens a dialog or notification as soon as it renders, so fixtures can capture overlays *@
@code {
    public enum Overlay
    {
        Dialog,
        Confirm,
        Notifications,
        DialogTitle,
        NotificationActions,
    }

    [Parameter] public Overlay What { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        switch (What)
        {
            case Overlay.Dialog:
                _ = Dialogs.OpenAsync<SampleDialog, SampleDialog.SampleOptions, string>("Add to Collection",
                    new SampleDialog.SampleOptions("Arena Blitz"), new DialogSettings { OkText = "Add" });
                break;

            case Overlay.Confirm:
                _ = Alerts.ConfirmAsync("Arena Blitz and its 2 archives will be deleted. This cannot be undone.",
                    "Delete game?", okText: "Delete", danger: true);
                break;

            case Overlay.DialogTitle:
                _ = Dialogs.OpenAsync<SampleDialog, SampleDialog.SampleOptions, string>("Download Cover",
                    new SampleDialog.SampleOptions("Arena Blitz"), new DialogSettings
                    {
                        OkText = "Select",
                        TitleContent = @<Tag Caps>Cover</Tag>,
                        Subtitle = "Arena Blitz",
                        FooterNote = "Entering manually opens a blank entry.",
                    });
                break;

            case Overlay.NotificationActions:
                Notifications.Success("Archive uploaded", "Arena Blitz 1.2 is ready to install.");
                Notifications.Warning("Metadata partly missing", "Arena Blitz has no logo artwork.", new NotificationAction("Open media editor", Href: "/Games"));
                Notifications.Error("Repack failed", "Checksum mismatch on pak0.pk3.", meta: "job 4f21c8 · 21:12");
                break;

            case Overlay.Notifications:
                Notifications.Success("Game saved");
                Notifications.Info("Import queued", "3 games are waiting to be imported");
                Notifications.Warning("Storage almost full");
                Notifications.Error("Could not start server", "Port 27960 is already in use");
                break;
        }
    }
}
