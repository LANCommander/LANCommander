@namespace LANCommander.Server.UI.Controls
@using LANCommander.Server.UI.Providers

<Result Warning Icon="IconType.MapTrifold" Title="@Title" SubTitle="@SubTitle">
    <Content>@Content</Content>
    <ChildContent>@ChildContent</ChildContent>
</Result>

@code {
    [Parameter] public string Title { get; set; } = "Not Found";

    [Parameter] public string SubTitle { get; set; } = QuipProvider.GetNotFoundQuip();

    [Parameter] public RenderFragment? Content { get; set; }

    /// <summary>Actions, e.g. a link back to a list page.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
