@namespace LANCommander.Server.UI.Controls
@inherits FormInputBase<string>

<RadzenPassword Name="@InputId"
                Value="@Value"
                ValueChanged="@((string? value) => SetValueAsync(value))"
                Immediate="Immediate"
                ReadOnly="ReadOnly"
                Disabled="IsDisabled"
                Placeholder="@Placeholder"
                AutoCompleteType="@(NewPassword ? AutoCompleteType.NewPassword : AutoCompleteType.CurrentPassword)"
                Style="@Style"
                Attributes='@InputAttributes.Build(this, AutoFocus, OnEnter, BuildClass("lc-password-input"))' />

@code {
    /// <summary>Update the bound value on every keystroke instead of when the input loses focus.</summary>
    [Parameter] public bool Immediate { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>A password being set rather than entered, so browsers offer to generate one instead of filling a saved one.</summary>
    [Parameter] public bool NewPassword { get; set; }

    /// <summary>Called when Enter is pressed.</summary>
    [Parameter] public EventCallback OnEnter { get; set; }
}
