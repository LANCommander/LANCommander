@namespace LANCommander.Server.UI.Controls
@typeparam TValue
@inherits FormInputBase<TValue>
@attribute [CascadingTypeParameter(nameof(TValue))]

@*
    A dropdown of choices given as Items and/or SelectOption children. Bind Value for one choice,
    or set Multiple and bind Values for several.
*@
<CascadingValue Value="this" IsFixed>
    @ChildContent
</CascadingValue>

@if (Multiple)
{
    <RadzenDropDown TValue="IEnumerable<TValue>"
                    Name="@InputId"
                    Data="_options"
                    TextProperty="@nameof(SelectItem<TValue>.Label)"
                    ValueProperty="@nameof(SelectItem<TValue>.Value)"
                    DisabledProperty="@nameof(SelectItem<TValue>.Disabled)"
                    Value="@Values"
                    ValueChanged="@((IEnumerable<TValue> values) => SetValuesAsync(values))"
                    Multiple="true"
                    Chips="true"
                    MaxSelectedLabels="MaxSelectedLabels"
                    SelectedItemsText="@SelectedItemsText"
                    ItemRender="@((DropDownItemRenderEventArgs<IEnumerable<TValue>> args) => RenderItem(args.Item, args))"
                    AllowFiltering="Searchable"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    AllowClear="Clearable"
                    Disabled="IsDisabled"
                    Placeholder="@Placeholder"
                    Style="@_style"
                    Template="ItemTemplate"
                    Attributes='@InputAttributes.Build(this, false, default, BuildClass(Small ? "lc-select lc-select-small" : "lc-select"))' />
}
else
{
    <RadzenDropDown TValue="TValue"
                    Name="@InputId"
                    Data="_options"
                    TextProperty="@nameof(SelectItem<TValue>.Label)"
                    ValueProperty="@nameof(SelectItem<TValue>.Value)"
                    DisabledProperty="@nameof(SelectItem<TValue>.Disabled)"
                    Value="@Value"
                    ValueChanged="@((TValue value) => SetValueAsync(value))"
                    ItemRender="@((DropDownItemRenderEventArgs<TValue> args) => RenderItem(args.Item, args))"
                    AllowFiltering="Searchable"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    AllowClear="Clearable"
                    Disabled="IsDisabled"
                    Placeholder="@Placeholder"
                    Style="@_style"
                    Template="ItemTemplate"
                    ValueTemplate="ItemTemplate"
                    Attributes='@InputAttributes.Build(this, false, default, BuildClass(Small ? "lc-select lc-select-small" : "lc-select"))' />
}

@code {
    /// <summary>The choices. Combine with, or use instead of, <see cref="SelectOption{TValue}"/> children.</summary>
    [Parameter] public IEnumerable<SelectItem<TValue>>? Items { get; set; }

    /// <summary><see cref="SelectOption{TValue}"/> children listing static choices.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Allow choosing several values, bound through <see cref="Values"/>.</summary>
    [Parameter] public bool Multiple { get; set; }

    [Parameter] public IEnumerable<TValue>? Values { get; set; }

    [Parameter] public EventCallback<IEnumerable<TValue>> ValuesChanged { get; set; }

    [Parameter] public System.Linq.Expressions.Expression<Func<IEnumerable<TValue>?>>? ValuesExpression { get; set; }

    /// <summary>Type to filter the choices.</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Shows a button that clears the selection.</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>A compact 24px select sized to its choice, e.g. beside a page title.</summary>
    [Parameter] public bool Small { get; set; }

    /// <summary>With <see cref="Multiple"/>, how many chips show before they collapse into <see cref="SelectedItemsText"/>.</summary>
    [Parameter] public int MaxSelectedLabels { get; set; } = 4;

    /// <summary>With <see cref="Multiple"/>, follows the count once the chips collapse: "3 items selected".</summary>
    [Parameter] public string SelectedItemsText { get; set; } = "items selected";

    readonly List<SelectItem<TValue>> _childOptions = [];
    List<SelectItem<TValue>> _options = [];

    // Group headings are rows of their own that can't be picked, told apart by reference
    readonly HashSet<SelectItem<TValue>> _headers = new(ReferenceEqualityComparer.Instance);
    FieldIdentifier? _valuesField;
    string? _style;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (ValuesExpression != null && _valuesField == null)
        {
            _valuesField = FieldIdentifier.Create(ValuesExpression);
            FormItem?.Register(_valuesField.Value);
        }

        RebuildOptions();

        _style = new StyleBuilder().Add("width", "100%").Add(Style).Build();
    }

    internal void AddOption(SelectItem<TValue> option)
    {
        _childOptions.Add(option);
        RebuildOptions();
        StateHasChanged();
    }

    internal void RemoveOption(SelectItem<TValue> option)
    {
        _childOptions.Remove(option);
        RebuildOptions();
        StateHasChanged();
    }

    void RebuildOptions()
    {
        List<SelectItem<TValue>> options = [.. Items ?? [], .. _childOptions];

        _headers.Clear();

        if (options.Any(o => o.Group != null))
        {
            // Ungrouped choices first, then each group under its heading, in the order groups first appear
            var grouped = new List<SelectItem<TValue>>(options.Where(o => o.Group == null));

            foreach (var group in options.Where(o => o.Group != null).GroupBy(o => o.Group!))
            {
                var header = new SelectItem<TValue>(default!, group.Key, Disabled: true);

                _headers.Add(header);
                grouped.Add(header);
                grouped.AddRange(group);
            }

            options = grouped;
        }

        _options = options;
        _hasImages = _options.Any(o => o.Image != null);
    }

    void RenderItem<T>(object? item, DropDownBaseItemRenderEventArgs<T> args)
    {
        if (item is not SelectItem<TValue> option)
            return;

        if (_headers.Contains(option))
        {
            args.Disabled = true;
            args.Attributes["data-lc-group-header"] = "";
            args.Attributes["role"] = "presentation";
            args.Attributes["aria-disabled"] = "true";
        }
        else if (option.Group != null)
            args.Attributes["data-lc-group"] = option.Group;
    }

    bool _hasImages;

    // Only swap in a template when some option has an image; plain labels render faster without one
    RenderFragment<dynamic>? ItemTemplate => _hasImages ? item => RenderOption((SelectItem<TValue>)item) : null;

    RenderFragment RenderOption(SelectItem<TValue> option) => @<span class="lc-select-option">
        @if (option.Image != null)
        {
            <img src="@option.Image" alt="" class="lc-select-option-image" />
        }
        <span>@option.Label</span>
    </span>;

    async Task SetValuesAsync(IEnumerable<TValue>? values)
    {
        // Select all can sweep up group headings; only real choices count
        if (values != null && _headers.Count > 0)
        {
            var choices = _options.Where(o => !_headers.Contains(o)).Select(o => o.Value).ToHashSet();

            values = values.Where(choices.Contains).ToList();
        }

        Values = values;

        await ValuesChanged.InvokeAsync(values ?? []);

        if (_valuesField != null)
            EditContext?.NotifyFieldChanged(_valuesField.Value);
    }

    public override void Dispose()
    {
        base.Dispose();

        if (_valuesField != null)
            FormItem?.Unregister(_valuesField.Value);
    }
}
