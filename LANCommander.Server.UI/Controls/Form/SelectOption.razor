@namespace LANCommander.Server.UI.Controls
@typeparam TValue
@implements IDisposable

@* A static choice inside a Select; renders nothing itself *@

@code {
    [Parameter, EditorRequired] public TValue Value { get; set; } = default!;

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }

    [CascadingParameter] Select<TValue>? Select { get; set; }

    SelectItem<TValue>? _registered;

    protected override void OnParametersSet()
    {
        var option = new SelectItem<TValue>(Value, Label, Disabled);

        if (option == _registered)
            return;

        if (_registered != null)
            Select?.RemoveOption(_registered);

        Select?.AddOption(option);
        _registered = option;
    }

    public void Dispose()
    {
        if (_registered != null)
            Select?.RemoveOption(_registered);
    }
}
