@namespace LANCommander.Server.UI.Controls
@inherits ControlBase

@* The padded body of a page, below its PageHeader. An error inside it is shown in place, leaving the header and navigation usable. *@
<div @attributes="AdditionalAttributes" class="@_class" style="@Style">
    <ErrorHandler Inline Title="@ErrorTitle">
        <Spin Loading="Loading" Tip="@LoadingText">
            @ChildContent
        </Spin>
    </ErrorHandler>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Covers the content with a spinner, e.g. while the page's data loads.</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public string? LoadingText { get; set; }

    [Parameter] public string? ErrorTitle { get; set; } = "This page could not be displayed";

    string? _class;

    protected override void OnParametersSet()
    {
        _class = new ClassBuilder().Add("lc-page-content").Add(Class).Build();
    }
}
