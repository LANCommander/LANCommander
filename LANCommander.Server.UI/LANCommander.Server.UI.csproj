<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- An unresolved component tag silently renders as a raw HTML element; fail the build instead -->
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
    <Authors>pathartl</Authors>
    <Company>LANCommander</Company>
    <Description>A Blazor component library for building UIs on the LANCommander platform</Description>
    <PackageProjectUrl>https://github.com/LANCommander/LANCommander</PackageProjectUrl>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/LANCommander/LANCommander</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>lancommander;blazor;components</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Inputs/Outputs let MSBuild skip these targets when nothing they depend on has changed -->
  <ItemGroup>
    <PowerShellCompletionsOutput Include="Components\MonacoCodeEditor\PowerShellCompletions.g.ts" />
    <!-- The generator reflects over the whole SDK assembly, so any SDK source change can alter its output -->
    <PowerShellCompletionsInput Include="..\LANCommander.CompletionGenerator\**\*.cs;..\LANCommander.CompletionGenerator\*.csproj" Exclude="..\LANCommander.CompletionGenerator\bin\**;..\LANCommander.CompletionGenerator\obj\**" />
    <PowerShellCompletionsInput Include="..\LANCommander.SDK\**\*.cs;..\LANCommander.SDK\**\*.csproj" Exclude="..\LANCommander.SDK\bin\**;..\LANCommander.SDK\obj\**" />
    <PowerShellCompletionsInput Include="..\Directory.Build.props" Condition="Exists('..\Directory.Build.props')" />
    <PowerShellCompletionsInput Include="..\Directory.Packages.props" Condition="Exists('..\Directory.Packages.props')" />

    <FrontendInput Include="**\*.ts;**\*.tsx;**\*.scss;**\*.css" Exclude="node_modules\**;wwwroot\**;bin\**;obj\**" />
    <FrontendInput Include="package.json;package-lock.json;tsconfig.json;webpack.config.js" />
    <!-- Rewritten by every npm install/ci, so dependency updates trigger a rebuild -->
    <FrontendInput Include="node_modules\.package-lock.json" Condition="Exists('node_modules\.package-lock.json')" />
    <FrontendOutput Include="wwwroot\bundle.js;wwwroot\ui.css;wwwroot\bootstrap-icons.svg" />
  </ItemGroup>

  <Target Name="GeneratePowerShellCompletions" BeforeTargets="CompileFrontendResources"
          Inputs="@(PowerShellCompletionsInput)"
          Outputs="@(PowerShellCompletionsOutput)">
    <Message Text="Generating PowerShell completion data" Importance="high" />
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\LANCommander.CompletionGenerator\LANCommander.CompletionGenerator.csproj&quot; -- &quot;$(MSBuildProjectDirectory)\Components\MonacoCodeEditor\PowerShellCompletions.g.ts&quot;" />
  </Target>

  <!-- PowerShellCompletions.g.ts is listed separately: it's generated after FrontendInput is evaluated, so the glob misses it on a clean checkout -->
  <Target Name="CompileFrontendResources" BeforeTargets="Compile;ResolveProjectStaticWebAssets"
          Inputs="@(FrontendInput);@(PowerShellCompletionsOutput)"
          Outputs="@(FrontendOutput)">
    <Message Text="Compiling frontend" Importance="high" />
    <Exec Command="npm run package" />
    <!-- webpack skips writing outputs whose content is unchanged; touch them so the target isn't considered stale forever -->
    <Touch Files="@(FrontendOutput)" />
    <!-- The wwwroot glob is evaluated before this runs, so on a clean checkout the bundle would be left out of the static web assets -->
    <!-- MSBuild still evaluates this ItemGroup when the target is skipped as up to date -->
    <ItemGroup>
      <Content Include="wwwroot\**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>
	
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the tag helpers that style the server's MVC views and Razor Pages -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" />
    <PackageReference Include="BootstrapBlazor.PdfReader" />
    <PackageReference Include="ByteSize" />
    <PackageReference Include="EasyMDE.Blazor" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="PSC.Blazor.Components.MarkdownEditor" />
    <!-- Compile assets stay private: consumers of LANCommander.Server.UI must use its Controls, never Radzen directly -->
    <PackageReference Include="Radzen.Blazor" PrivateAssets="compile" />
    <PackageReference Include="XtermBlazor" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json;tsconfig.json;webpack.config.js" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LANCommander.Server.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon geometry, written by Controls/Icon/generate-icons.py and read by IconData -->
    <EmbeddedResource Include="Controls\Icon\Resources\*.tsv.gz" LogicalName="LANCommander.Server.UI.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LANCommander.SDK\package-icon.png" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LANCommander.SDK\LANCommander.SDK.csproj" />
  </ItemGroup>

</Project>
