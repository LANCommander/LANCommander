@using LANCommander.SDK.PowerShell
@using LANCommander.SDK.Services
@using LANCommander.Server.Services.PowerShell
@using XtermBlazor
@using LogLevel = Microsoft.Extensions.Logging.LogLevel
@inject ScriptDebugger ScriptDebugger
@inject ScriptClient ScriptClient
@inject GameService GameService
@inject ToolService ToolService
@inject RedistributableService RedistributableService

@*
    Streams a script run over the debugger hub: output coloured by stream in the launcher's palette,
    under a header with the time the run has taken and Clear and Stop. The owner starts runs; this
    shows them.
*@
<div class="console">
    <div class="console-header">
        <span class="console-title">Console</span>
        @if (_startTime.HasValue)
        {
            <span class="console-elapsed">@FormatTimeSpan(Elapsed) elapsed</span>
        }
        <span class="console-header-spacer"></span>
        <Button Text ExtraSmall OnClick="ClearAsync">Clear</Button>
        <Button Danger ExtraSmall Disabled="@(State != ConsoleRunState.Running)" OnClick="StopAsync">Stop</Button>
    </div>

    <div class="console-body">
        <Terminal @ref="_terminal" Id="@Id.ToString()" Options="_options" />
        @if (Placeholder != null && State == ConsoleRunState.Idle)
        {
            <div class="console-placeholder">@Placeholder</div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<bool> ActiveChanged { get; set; }

    /// <summary>A run started, finished or was stopped.</summary>
    [Parameter] public EventCallback<ConsoleRunState> StateChanged { get; set; }

    /// <summary>Called every second while a run is going, e.g. to redraw an elapsed time elsewhere.</summary>
    [Parameter] public EventCallback OnTick { get; set; }

    /// <summary>Shown over the empty console before anything has run.</summary>
    [Parameter] public string? Placeholder { get; set; }

    public ConsoleRunState State { get; private set; } = ConsoleRunState.Idle;

    /// <summary>How long the current or last run took; zero before any.</summary>
    public TimeSpan Elapsed => _startTime.HasValue ? (_endTime ?? DateTime.UtcNow) - _startTime.Value : TimeSpan.Zero;

    private DateTime? _endTime;

    private Terminal? _terminal;
    private CancellationTokenSource? _cts;
    private DateTime? _startTime;
    private System.Threading.Timer? _elapsedTimer;

    private readonly TerminalOptions _options = ConsolePalette.CreateOptions(CursorStyle.Block);

    async Task SetActive(bool active)
    {
        Active = active;

        if (ActiveChanged.HasDelegate)
            await ActiveChanged.InvokeAsync(Active);
    }

    async Task SetStateAsync(ConsoleRunState state)
    {
        State = state;

        if (StateChanged.HasDelegate)
            await StateChanged.InvokeAsync(state);
    }

    private void InitializeDebugger()
    {
        ScriptDebugger.OnBreak = Break;
        ScriptDebugger.OnStart = Start;
        ScriptDebugger.OnEnd = End;
        ScriptDebugger.OnOutput = Output;

        ScriptClient.Debug = true;

        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        _startTime = DateTime.UtcNow;
        _endTime = null;

        _elapsedTimer = new System.Threading.Timer(
            _ => InvokeAsync(TickAsync),
            null,
            TimeSpan.Zero,
            TimeSpan.FromSeconds(1));
    }

    public async Task DebugPackagingScript(Guid gameId)
    {
        InitializeDebugger();
        await GameService.PackageAsync(gameId);
    }

    public async Task DebugToolPackagingScript(Guid toolId)
    {
        InitializeDebugger();
        await ToolService.PackageAsync(toolId);
    }

    public async Task DebugRedistributablePackagingScript(Guid redistributableId)
    {
        InitializeDebugger();
        await RedistributableService.PackageAsync(redistributableId);
    }

    public async Task Start(IScriptDebugContext context)
    {
        if (_terminal is null)
            return;

        await _terminal.Clear();
        await SetActive(true);
        await SetStateAsync(ConsoleRunState.Running);
        await InvokeAsync(StateHasChanged);

        await _terminal.Focus();
        await _terminal.FitAsync();
    }

    async Task TickAsync()
    {
        StateHasChanged();

        if (OnTick.HasDelegate)
            await OnTick.InvokeAsync();
    }

    /// <summary>Empties the console.</summary>
    public async Task ClearAsync()
    {
        if (_terminal != null)
            await _terminal.Clear();
    }

    public async Task End(IScriptDebugContext context)
    {
        StopTimer();

        if (_terminal != null && _startTime.HasValue)
            await _terminal.WriteLine($"\nCompleted in {FormatTimeSpan(Elapsed)}", ConsoleLineKind.System);

        await SetActive(false);

        if (State == ConsoleRunState.Running)
            await SetStateAsync(ConsoleRunState.Completed);

        await InvokeAsync(StateHasChanged);
    }

    public async Task Break(IScriptDebugContext context)
    {
        if (_terminal is null)
            return;

        while (true)
        {
            var input = await _terminal.ReadLineAsync(ConsolePalette.Format("> ", ConsoleLineKind.Prompt).First());

            if (input.Trim().Equals("exit", StringComparison.OrdinalIgnoreCase))
                break;

            if (input.StartsWith('$'))
                input = "Write-Host " + input;

            await context.ExecuteAsync(input);
        }
    }

    public async Task Output(IScriptDebugContext context, LogLevel level, string message)
    {
        if (_terminal is null)
            return;

        try
        {
            await _terminal.WriteLine(message, level);
        }
        catch (Exception)
        {
            // The terminal went away mid-run, e.g. the dialog closed; the run itself carries on
        }
    }

    /// <summary>Stops the run in progress.</summary>
    public async Task StopAsync()
    {
        _cts?.Cancel();
        StopTimer();

        if (_terminal != null)
            await _terminal.WriteLine("\nScript stopped by user.", ConsoleLineKind.System);

        await SetActive(false);
        await SetStateAsync(ConsoleRunState.Stopped);
        await InvokeAsync(StateHasChanged);
    }

    void StopTimer()
    {
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;

        if (_startTime.HasValue)
            _endTime ??= DateTime.UtcNow;
    }

    /// <summary>A run's length as the console and the running pill show it: 00:12, 1:02:03.</summary>
    public static string FormatTimeSpan(TimeSpan ts)
    {
        if (ts.TotalHours >= 1)
            return ts.ToString(@"h\:mm\:ss");

        return ts.ToString(@"mm\:ss");
    }
}
