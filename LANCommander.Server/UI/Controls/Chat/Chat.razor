@namespace LANCommander.Server.UI.Controls
@using LANCommander.Server.Clients
@using LANCommander.Server.Hubs
@inject ServerChatClient ChatClient
@inject ChatBroadcaster Broadcaster
@inject DialogService Dialogs
@inject NotificationService Notifications
@implements IDisposable

@* Chat threads down the side, the selected thread's conversation beside them *@
<div class="chat">
    <div class="chat-list">
        <Button Primary Block Icon="IconType.ChatCircleDots" OnClick="StartThreadAsync">New Thread</Button>

        <Divider />

        <ChatList Threads="_threads" CurrentUserId="_userId" @bind-SelectedThread="_thread" />
    </div>

    @if (_thread != null)
    {
        @* Keyed so switching threads starts a fresh view rather than reusing the last one's messages *@
        <ChatThread @key="_thread.Id" Id="_thread.Id" />
    }
    else
    {
        <div class="chat-thread chat-thread-empty">
            <Empty Description="Pick a thread, or start a new one" Icon="IconType.ChatsCircle" />
        </div>
    }
</div>

@code {
    IEnumerable<SDK.Models.ChatThread> _threads = [];
    SDK.Models.ChatThread? _thread;
    Guid? _userId;

    protected override async Task OnInitializedAsync()
    {
        Broadcaster.MessageSent += OnMessageSent;
        Broadcaster.ParticipantAdded += OnParticipantAdded;

        _userId = await ChatClient.GetCurrentUserIdAsync();

        await LoadThreadsAsync();
    }

    async Task LoadThreadsAsync()
    {
        try
        {
            _threads = await ChatClient.GetThreadsAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The chat threads could not be loaded");
        }
    }

    // Threads are listed by latest activity, so any message to one of ours reorders them
    void OnMessageSent(Guid threadId, SDK.Models.ChatMessage message, IReadOnlyCollection<Guid> participantIds)
    {
        if (_userId is { } userId && participantIds.Contains(userId))
            RefreshThreads();
    }

    void OnParticipantAdded(SDK.Models.ChatThread thread, Guid userId)
    {
        if (userId == _userId)
            RefreshThreads();
    }

    void RefreshThreads() => _ = InvokeAsync(async () =>
    {
        await LoadThreadsAsync();
        StateHasChanged();
    });

    async Task StartThreadAsync()
    {
        // Whoever starts a thread is added to it regardless, so they aren't offered themselves
        var users = (await ChatClient.GetUsersAsync()).Where(u => u.Id != _userId);

        var participants = await Dialogs.OpenAsync<ChatUsersDialog, IEnumerable<SDK.Models.User>, IEnumerable<SDK.Models.User>>("New Thread", users, new DialogSettings
        {
            OkText = "Start",
        });

        if (participants == null || !participants.Any())
            return;

        try
        {
            var threadId = await ChatClient.StartThreadAsync(participants.Select(u => u.Id.ToString()));

            await LoadThreadsAsync();

            _thread = _threads.FirstOrDefault(t => t.Id == threadId) ?? await ChatClient.GetThreadAsync(threadId);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The thread could not be started");
        }
    }

    public void Dispose()
    {
        Broadcaster.MessageSent -= OnMessageSent;
        Broadcaster.ParticipantAdded -= OnParticipantAdded;
    }
}
