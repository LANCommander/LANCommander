@namespace LANCommander.Server.UI.Controls
@using LANCommander.SDK.Services
@inject IChatClient ChatClient

@* One thread in the list: who is in it, its title and how many messages are unread.
   The list reloads its threads whenever a message arrives, which refreshes the count *@
<button type="button" class="@CssClass" role="listitem" aria-current="@(Active ? "true" : null)" @onclick="SelectAsync">
    <AvatarGroup Class="chat-list-thread-avatars" Overflow="@Math.Max(0, _others.Count - 3)">
        @foreach (var participant in _others.Take(3))
        {
            <Avatar Small Square Name="@participant.Name" ColorKey="@participant.Id.ToString()" Src="@ChatAvatar.Url(participant.UserName)" />
        }
    </AvatarGroup>

    <span class="chat-list-thread-title">@_title</span>

    @if (HasUnread)
    {
        <span class="chat-unread">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
    }
</button>

@code {
    [Parameter, EditorRequired] public SDK.Models.ChatThread Thread { get; set; } = default!;
    [Parameter] public EventCallback<SDK.Models.ChatThread> OnSelected { get; set; }
    [Parameter] public bool Active { get; set; }

    /// <summary>The viewer, left out of the avatars and title since they're in every thread they see</summary>
    [Parameter] public Guid? CurrentUserId { get; set; }

    int _unreadCount;
    List<SDK.Models.User> _others = [];
    string? _title;

    // The open thread is being read, so it has nothing unread to point out
    bool HasUnread => _unreadCount > 0 && !Active;

    // Built at render, after the unread count has come back
    string? CssClass => new ClassBuilder()
        .Add("chat-list-thread")
        .If(Active, "chat-list-thread-active")
        .If(HasUnread, "chat-list-thread-unread")
        .Build();

    protected override async Task OnParametersSetAsync()
    {
        _others = Thread.Participants.Where(p => p.Id != CurrentUserId).ToList();

        // A thread with only the viewer in it still shows them rather than nothing
        if (_others.Count == 0)
            _others = Thread.Participants.ToList();

        _title = string.IsNullOrWhiteSpace(Thread.Name)
            ? string.Join(", ", _others.Select(p => p.Name))
            : Thread.Name;

        await RefreshUnreadCountAsync();
    }

    async Task RefreshUnreadCountAsync()
    {
        try
        {
            _unreadCount = await ChatClient.GetUnreadMessageCountAsync(Thread.Id);
        }
        catch
        {
            // The count is a hint; a failed refresh keeps the last one
        }
    }

    async Task SelectAsync()
    {
        await OnSelected.InvokeAsync(Thread);
    }
}
