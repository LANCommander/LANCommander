@namespace LANCommander.Server.UI.Controls
@using LANCommander.SDK.Services
@inject ProfileClient ProfileClient

@* A run of messages from one person, under their name and when they started *@
<div class="chat-message-group">
    <Avatar Square Name="@UserName" Src="@(String.IsNullOrWhiteSpace(UserName) ? null : ProfileClient.GetAvatarUri(UserName).ToString())" />

    <div class="chat-message-group-body">
        <Flex Gap="Gap.Small" Align="Align.Center">
            <span class="chat-message-author">@UserName</span>
            <LocalTime Value="StartedOn" Class="chat-message-timestamp" />
        </Flex>

        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? UserName { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public DateTime StartedOn { get; set; }
}
