@namespace LANCommander.Server.UI.Controls
@using EasyMDE.Blazor
@using LANCommander.SDK.Services
@inject IChatClient ChatClient
@inject NotificationService Notifications
@implements IDisposable

@* Writes a message in Markdown beside a send button; Enter sends it, Ctrl+Enter starts a new line *@
<div class="chat-message-input">
    <EasyMdeEditor @bind-Value="_message"
                   @bind-Value:after="OnMessageChanged"
                   Class="chat-message-input-editor"
                   InterceptKeys="_keys"
                   OnKey="HandleKeyAsync"
                   ReadOnly="_sending"
                   Options="_options" />

    <Button Primary Icon="IconType.PaperPlaneTilt" OnClick="SendAsync" Disabled="ThreadId == null" title="Send" aria-label="Send" />
</div>

@code {
    [Parameter] public Guid? ThreadId { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    string _message = string.Empty;
    bool _sending;

    EasyMdeOptions _options = new();

    ChatTypingNotifier? _typing;

    // The editor reads its placeholder from the options, once, when it starts
    protected override void OnInitialized()
    {
        _options = new()
        {
            MinHeight = "0px",
            Toolbar = EasyMdeToolbar.Disabled,
            Status = EasyMdeStatus.Disabled,
            Placeholder = Placeholder,
        };

        _typing = new((threadId, typing) => ChatClient.SendTypingAsync(threadId, typing));
    }

    // Emptying the box (or sending it) counts as having stopped
    void OnMessageChanged()
    {
        if (ThreadId == null || string.IsNullOrWhiteSpace(_message))
            _typing?.Stop();
        else
            _typing?.Typed(ThreadId.Value);
    }

    readonly EasyMdeKeyRegistration[] _keys =
    [
        new() { Key = "Enter", NotifyDotNet = true },
        new() { Key = "Enter", Ctrl = true, NotifyDotNet = true },
    ];

    async ValueTask<bool> HandleKeyAsync(EasyMdeKeyEvent e)
    {
        if (e.Key is "Enter" && !e.Ctrl)
            await SendAsync();

        return true;
    }

    async Task SendAsync()
    {
        if (_sending || string.IsNullOrWhiteSpace(_message) || ThreadId == null)
            return;

        _sending = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await ChatClient.SendMessageAsync(ThreadId.Value, _message);

            _message = string.Empty;

            _typing?.Stop();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The message could not be sent");
        }
        finally
        {
            _sending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() => _typing?.Dispose();
}
