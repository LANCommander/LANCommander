@namespace LANCommander.Server.UI.Controls
@using System.Collections.ObjectModel
@using LANCommander.SDK.Models
@using LANCommander.Server.Clients
@using LANCommander.Server.Hubs
@using LANCommander.Server.UI.Components
@inject ServerChatClient ChatClient
@inject ChatBroadcaster Broadcaster
@inject NotificationService Notifications
@inject ChatUnreadState UnreadState
@implements IDisposable

@* One thread, as the launcher shows it: who is in it across the top, the messages (loaded as they
   scroll into view) in the middle and the box to write a new one pinned to the bottom.
   Its parent keys it by thread, so one instance only ever shows one thread *@
<section class="chat-thread">
    <header class="chat-thread-header">
        @if (_thread != null)
        {
            <AvatarGroup Class="chat-thread-header-avatars" Overflow="@Math.Max(0, _others.Count - 3)">
                @foreach (var participant in _others.Take(3))
                {
                    <Avatar Small Square Name="@participant.Name" ColorKey="@participant.Id.ToString()" Src="@ChatAvatar.Url(participant.UserName)" />
                }
            </AvatarGroup>

            <span class="chat-thread-title">@_title</span>
        }
    </header>

    <div class="chat-thread-messages">
        @if (_thread != null)
        {
            <InfiniteLoader
                @ref="_infiniteLoader"
                T="SDK.Models.ChatMessageGroup"
                KeySelector="g => g.Id.ToString()"
                Loader="LoadMessagesAsync"
                PageSize="10">
                <ChatMessageGroup
                    UserId="context.UserId"
                    UserName="@context.UserName"
                    StartedOn="context.StartedOn.DateTime">
                    @foreach (var message in context.Messages)
                    {
                        <ChatMessage @key="message.Id" Id="message.Id" Content="@message.Content" SentOn="message.SentOn" />
                    }
                </ChatMessageGroup>
            </InfiniteLoader>
        }
    </div>

    @* Created once the thread is known: the editor only takes its placeholder when it starts *@
    @if (_thread != null)
    {
        <ChatMessageInput ThreadId="@Id" Placeholder="@_placeholder" />
    }
</section>

@code {
    [Parameter, EditorRequired] public Guid Id { get; set; }

    /// <summary>Raised when a message arrives in this thread while it's open</summary>
    [Parameter] public EventCallback OnMessageReceived { get; set; }


    // A sender's messages within this long of each other share a group
    static readonly TimeSpan MaxGroupGap = TimeSpan.FromMinutes(5);

    SDK.Models.ChatThread? _thread;
    List<SDK.Models.User> _others = [];
    string? _title;
    string? _placeholder;
    InfiniteLoader<SDK.Models.ChatMessageGroup>? _infiniteLoader;
    readonly HashSet<Guid> _loadedMessageIds = new();

    protected override async Task OnInitializedAsync()
    {
        Broadcaster.MessageSent += OnMessageSent;

        try
        {
            _thread = await ChatClient.GetThreadAsync(Id);

            var userId = await ChatClient.GetCurrentUserIdAsync();

            _others = _thread.Participants.Where(p => p.Id != userId).ToList();

            // A thread with only the viewer in it still shows them rather than nothing
            if (_others.Count == 0)
                _others = _thread.Participants.ToList();

            _title = string.IsNullOrWhiteSpace(_thread.Name)
                ? string.Join(", ", _others.Select(p => p.Name))
                : _thread.Name;

            _placeholder = $"Message {_title}";
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The thread could not be opened");
        }
    }

    void OnMessageSent(Guid threadId, SDK.Models.ChatMessage message, IReadOnlyCollection<Guid> participantIds)
    {
        if (threadId != Id)
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await AppendMessageAsync(message);

                // It's on screen, so it's been read
                await ChatClient.UpdatedReadStatus(Id);
                await UnreadState.RefreshAsync();

                await OnMessageReceived.InvokeAsync();
            }
            catch (Exception ex)
            {
                Notifications.Error(ex, "A new message could not be shown");
            }
        });
    }

    async Task AppendMessageAsync(SDK.Models.ChatMessage message)
    {
        if (_infiniteLoader == null || !_loadedMessageIds.Add(message.Id))
            return;

        var lastGroup = _infiniteLoader.GetLastItem();

        var merge = lastGroup != null
            && lastGroup.UserId == message.UserId
            && lastGroup.Messages.Count > 0
            && message.SentOn - lastGroup.Messages.Last().SentOn <= MaxGroupGap;

        if (merge)
        {
            // Keep the group's ID so the loader treats it as the same item
            await _infiniteLoader.UpdateLastItemAsync(new SDK.Models.ChatMessageGroup
            {
                Id = lastGroup!.Id,
                UserId = lastGroup.UserId,
                UserName = lastGroup.UserName,
                Messages = new ObservableCollection<SDK.Models.ChatMessage>(lastGroup.Messages) { message },
            });
        }
        else
        {
            await _infiniteLoader.AddItemsAsync(GroupMessagesBySender([message]));
        }
    }

    async Task<InfiniteResponse<SDK.Models.ChatMessageGroup>> LoadMessagesAsync(SDK.Models.ChatMessageGroup? cursor, int pageSize)
    {
        // Page backwards from the oldest message shown so far
        var messageCursor = cursor?.Messages.MinBy(m => m.SentOn);

        var response = await ChatClient.GetMessagesAsync(Id, messageCursor?.Id, pageSize);

        // The service returns newest first; anything already shown (arrived live) is skipped
        var messages = (response.Items ?? [])
            .Where(m => !string.IsNullOrWhiteSpace(m.Content))
            .Where(m => _loadedMessageIds.Add(m.Id))
            .ToList();

        if (messages.Count > 0)
        {
            await ChatClient.UpdatedReadStatus(Id);
            await UnreadState.RefreshAsync();
        }

        return new InfiniteResponse<SDK.Models.ChatMessageGroup>
        {
            Items = GroupMessagesBySender(messages),
            HasMore = response.HasMore,
        };
    }

    /// <summary>
    /// Groups newest-first messages by sender and time, returning the groups newest first
    /// as the loader expects (it reverses each page so the oldest sits at the top)
    /// </summary>
    static List<SDK.Models.ChatMessageGroup> GroupMessagesBySender(IEnumerable<SDK.Models.ChatMessage> messages)
    {
        var groups = new List<SDK.Models.ChatMessageGroup>();
        SDK.Models.ChatMessageGroup? current = null;

        foreach (var message in messages.OrderBy(m => m.SentOn))
        {
            var startNew = current == null
                || message.UserId != current.UserId
                || message.SentOn - current.Messages.Last().SentOn > MaxGroupGap;

            if (startNew)
            {
                // The first message's ID keeps a group's identity stable across renders
                current = new SDK.Models.ChatMessageGroup
                {
                    Id = message.Id,
                    UserId = message.UserId,
                    UserName = message.UserName,
                    Messages = new ObservableCollection<SDK.Models.ChatMessage> { message },
                };

                groups.Add(current);
            }
            else
            {
                current!.Messages.Add(message);
            }
        }

        groups.Reverse();

        return groups;
    }

    public void Dispose() => Broadcaster.MessageSent -= OnMessageSent;
}
