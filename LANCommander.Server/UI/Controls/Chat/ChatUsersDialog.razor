@namespace LANCommander.Server.UI.Controls
@using LANCommander.SDK.Services
@inherits Dialog<IEnumerable<SDK.Models.User>, IEnumerable<SDK.Models.User>>
@inject ProfileClient ProfileClient

@* Picks who to start a thread with, from the users passed as the options *@
<Flex Vertical Gap="Gap.Medium">
    <TextInput @bind-Value="_search" Immediate Icon="IconType.MagnifyingGlass" Placeholder="Search" AutoFocus />

    <div class="chat-users">
        @foreach (var user in Filtered)
        {
            <label class="chat-user" @key="user.Id">
                <Checkbox Value="_selected.Contains(user)" ValueChanged="selected => Toggle(user, selected)" />
                <Avatar Small Name="@user.UserName" Src="@ProfileClient.GetAvatarUri(user.UserName).ToString()" />
                <span class="chat-user-name">@user.Name</span>
            </label>
        }
    </div>
</Flex>

@code {
    string? _search = "";
    readonly HashSet<SDK.Models.User> _selected = new();

    protected override bool CanConfirm => _selected.Any();

    IEnumerable<SDK.Models.User> Filtered =>
        Options.Where(u => string.IsNullOrWhiteSpace(_search) || u.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true);

    void Toggle(SDK.Models.User user, bool selected)
    {
        if (selected)
            _selected.Add(user);
        else
            _selected.Remove(user);
    }

    protected override Task<bool> OnOkAsync()
    {
        Result = _selected.ToList();

        return Task.FromResult(true);
    }
}
