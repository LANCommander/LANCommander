@using LANCommander.Server.Models
@using LANCommander.Server.UI.Components
@inject ArchiveService ArchiveService
@inject DialogService Dialogs

@*
    Opens a file browser over an archive (ArchiveId) or the server's disk (Root) and reports the
    chosen path. Renders nothing when there is neither.
*@
@if (HasArchive || !String.IsNullOrWhiteSpace(Root))
{
    <Button Primary="Primary" Text="Text" Icon="Icon" Disabled="@(Disabled || (HasArchive && !_archiveExists))" OnClick="BrowseAsync" title="@Title">
        @ChildContent
    </Button>
}

@code {
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    [Parameter] public Guid? ArchiveId { get; set; }
    [Parameter] public string Title { get; set; } = "Choose File";
    [Parameter] public string OkText { get; set; } = "Select File";
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string? Root { get; set; }
    [Parameter] public Func<IFileManagerEntry, bool> EntrySelectable { get; set; } = _ => true;
    [Parameter] public Func<IFileManagerEntry, bool> EntryVisible { get; set; } = _ => true;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public IconType Icon { get; set; } = IconType.FolderOpen;
    [Parameter] public bool Primary { get; set; }
    [Parameter] public bool Text { get; set; }
    [Parameter] public bool Disabled { get; set; }

    bool _archiveExists;
    Guid? _checkedArchiveId;

    bool HasArchive => ArchiveId != null && ArchiveId != Guid.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (HasArchive && ArchiveId != _checkedArchiveId)
        {
            _checkedArchiveId = ArchiveId;
            _archiveExists = await ArchiveService.FileExistsAsync(ArchiveId!.Value);
        }
    }

    async Task BrowseAsync()
    {
        var options = new FilePickerOptions
        {
            ArchiveId = ArchiveId,
            Root = Root,
            Select = true,
            Multiple = false,
            EntrySelectable = EntrySelectable,
            EntryVisible = EntryVisible,
        };

        var results = await Dialogs.OpenAsync<FilePickerDialog, FilePickerOptions, IEnumerable<IFileManagerEntry>>(Title, options, new DialogSettings
        {
            Size = DialogSize.Full,
            OkText = OkText,
        });

        var path = results?.FirstOrDefault()?.Path;

        if (path != null)
            await OnSelected.InvokeAsync(Prefix + path);
    }
}
