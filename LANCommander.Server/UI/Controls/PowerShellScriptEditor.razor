@using LANCommander.Server.UI.Components
@inject ScriptService ScriptService
@using GlobalVariable = LANCommander.SDK.Models.GlobalVariable
@inject ModuleService ModuleService

<Flex Gap="Gap.Small" Wrap Align="Align.Center" Style="margin-bottom: 16px">
    @foreach (var group in Snippets.Select(s => s.Group).Distinct())
    {
        <Dropdown>
            <Overlay>
                <Menu>
                    @foreach (var snippet in Snippets.Where(s => s.Group == group))
                    {
                        <MenuItem OnClick="() => InsertSnippet(snippet)">
                            @snippet.Name
                        </MenuItem>
                    }
                </Menu>
            </Overlay>

            <ChildContent>
                <Button Primary>@group</Button>
            </ChildContent>
        </Dropdown>
    }

    @if (Variables?.Any() == true || _globalVariables.Any())
    {
        <Dropdown>
            <Overlay>
                <Menu>
                    @if (Variables?.Any() == true)
                    {
                        <MenuGroup Title="Runs with">
                            @foreach (var variable in Variables)
                            {
                                <MenuItem OnClick="() => InsertText(variable)">
                                    @variable
                                </MenuItem>
                            }
                        </MenuGroup>
                    }
                    @if (_globalVariables.Any())
                    {
                        <MenuGroup Title="Global">
                            @foreach (var variable in _globalVariables)
                            {
                                <MenuItem OnClick="@(() => InsertText($"$var:{variable.Name}"))" title="@variable.Description">
                                    $var:@variable.Name
                                </MenuItem>
                            }
                        </MenuGroup>
                    }
                </Menu>
            </Overlay>

            <ChildContent>
                <Button Primary Icon="IconType.BracketsCurly">Variables</Button>
            </ChildContent>
        </Dropdown>
    }
</Flex>

<CodeInput @ref="_codeInput"
           Value="@Value"
           ValueChanged="@ValueChanged"
           Language="Languages.PowerShell"
           OnSave="OnSave"
           ModuleFunctions="@_moduleFunctions"
           GlobalVariables="@_globalVariableCompletions"
           Height="@Height" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public int Height { get; set; } = 500;
    [Parameter] public IEnumerable<string>? Variables { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    CodeInput? _codeInput;
    IEnumerable<Snippet> Snippets { get; set; } = [];
    List<ModuleFunctionCompletion> _moduleFunctions = new();
    List<GlobalVariable> _globalVariables = new();
    List<GlobalVariableCompletion> _globalVariableCompletions = new();

    protected override void OnInitialized()
    {
        Snippets = ScriptService.GetSnippets();

        _moduleFunctions = ModuleService.GetPublicFunctionCompletions()
            .Select(f => new ModuleFunctionCompletion(f.Name, string.IsNullOrWhiteSpace(f.Synopsis) ? null : f.Synopsis, f.Module))
            .ToList();

        _globalVariables = ScriptService.GetGlobalVariables().ToList();
        _globalVariableCompletions = _globalVariables
            .Select(v => new GlobalVariableCompletion(v.Name, string.IsNullOrWhiteSpace(v.Description) ? null : v.Description))
            .ToList();
    }

    public async Task LayoutAsync()
    {
        if (_codeInput != null)
            await _codeInput.LayoutAsync();
    }

    async Task InsertText(string text)
    {
        if (_codeInput != null)
            await _codeInput.InsertText(text);
    }

    async Task InsertSnippet(Snippet snippet)
    {
        if (_codeInput != null)
            await _codeInput.InsertSnippet(snippet.Content);
    }
}
