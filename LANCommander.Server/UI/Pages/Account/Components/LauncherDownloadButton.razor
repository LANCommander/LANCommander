@using LANCommander.Server.Settings.Enums
@inject UpdateService UpdateService
@inject NavigationManager NavigationManager
@inject ILogger<LauncherDownloadButton> Logger

@* The launcher downloads for this server's version, listed in a popover under one button *@
<div class="login-download-pane-container">
    <Popover MaxWidth="360">
        <Content>
            <Flex Vertical Gap="Gap.Small">
                @if (_loading)
                {
                    <Typography Secondary>Fetching launchers&hellip;</Typography>
                }
                else if (_failed)
                {
                    <Typography Danger>The launchers could not be listed.</Typography>
                }
                else if (!_links.Any())
                {
                    <Typography Secondary>No launchers available</Typography>
                }

                @foreach (var link in _links)
                {
                    <Button Text Block Icon="link.Icon" Class="login-download-link" OnClick="() => NavigationManager.NavigateTo(link.Url, true)">
                        <span class="login-download-link-name">@link.Name</span>

                        @foreach (var tag in link.Tags)
                        {
                            @switch (tag.Kind)
                            {
                                case DownloadTagKind.Nightly:
                                    <Tag Danger Icon="IconType.Fire">@tag.Name</Tag>
                                    break;
                                case DownloadTagKind.Prerelease:
                                    <Tag Warning>@tag.Name</Tag>
                                    break;
                                default:
                                    <Tag Success>@tag.Name</Tag>
                                    break;
                            }
                        }

                        @if (link.IsOnline)
                        {
                            <Icon Type="IconType.Cloud" title="Downloads from GitHub" />
                        }
                    </Button>
                }
            </Flex>
        </Content>
        <ChildContent>
            <Button Primary Large Icon="IconType.DownloadSimple" Loading="_loading">Download Launcher</Button>
        </ChildContent>
    </Popover>
</div>

@code {
    enum DownloadTagKind
    {
        Format,
        Prerelease,
        Nightly,
    }

    record DownloadTag(string Name, DownloadTagKind Kind);

    record DownloadLink(string Name, string Url, IconType Icon, DownloadTag[] Tags, bool IsOnline);

    bool _loading = true;
    bool _failed;
    List<DownloadLink> _links = [];

    static IconType PlatformIcon(LauncherPlatform platform) => platform switch
    {
        LauncherPlatform.Windows => IconType.WindowsLogo,
        LauncherPlatform.Linux => IconType.LinuxLogo,
        LauncherPlatform.macOS => IconType.AppleLogo,
        _ => IconType.Question,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var artifacts = (await UpdateService.GetLauncherArtifactsAsync()).ToList();

            _links = artifacts
                .OrderBy(a => a.Platform)
                .ThenBy(a => a.Architecture)
                .Select(a =>
                {
                    var tags = new List<DownloadTag>();

                    // Only label the format when there is more than one download for the platform
                    if (artifacts.Count(other => other.Platform == a.Platform && other.Architecture == a.Architecture) > 1)
                    {
                        if (a.Url.EndsWith(".exe", StringComparison.OrdinalIgnoreCase))
                            tags.Add(new DownloadTag("exe", DownloadTagKind.Format));
                        else if (a.Url.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                            tags.Add(new DownloadTag("zip", DownloadTagKind.Format));
                    }

                    if (a.IsNightly)
                        tags.Add(new DownloadTag("nightly", DownloadTagKind.Nightly));
                    else if (a.IsPrerelease)
                        tags.Add(new DownloadTag("pre", DownloadTagKind.Prerelease));

                    return new DownloadLink($"{a.Platform} ({a.Architecture})", a.Url, PlatformIcon(a.Platform), tags.ToArray(), a.IsOnline);
                })
                .ToList();
        }
        catch (Exception ex)
        {
            _failed = true;

            Logger.LogError(ex, "Could not list the launcher downloads");
        }
        finally
        {
            _loading = false;
        }
    }
}
