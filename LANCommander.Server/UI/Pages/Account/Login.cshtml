@page "/Login"
@using LANCommander.Server.Extensions
@using LANCommander.Server.Settings
@model LANCommander.Server.UI.Pages.Account.LoginModel
@inject SettingsProvider<Settings> SettingsProvider
@{ Layout = "/UI/Views/Shared/_LayoutBasic.cshtml"; }

@{
    ViewData["Title"] = "Log in";

    var providers = HttpContext.GetExternalProviders();
}

<div class="login-container">
    <div class="login-container-background" style="background-image: url('@Model.ScreenshotUrl')"></div>
    <div class="login-box">
        <div class="login-form-pane">
            <div class="login-box-logo">
                <img src="~/static/logo-dark.svg" alt="LANCommander"/>
            </div>

            <partial name="_ModelErrors" />

            @if (Model.AllowPassword)
            {
                <form id="account" method="post" autocomplete="off" class="lc-form lc-form-vertical">
                    <div class="lc-form-item">
                        <label asp-for="Model.Username" class="lc-form-item-label"></label>
                        <div class="lc-form-item-control">
                            <input asp-for="Model.Username" lc-input autocomplete="username" aria-required="true"/>
                        </div>
                    </div>

                    <div class="lc-form-item">
                        <label asp-for="Model.Password" class="lc-form-item-label"></label>
                        <div class="lc-form-item-control">
                            <input asp-for="Model.Password" lc-input autocomplete="current-password" aria-required="true"/>
                        </div>
                    </div>

                    <div class="login-actions">
                        <button id="login-submit" type="submit" lc-button lc-primary>Login</button>
                        @if (SettingsProvider.CurrentValue.Server.Authentication.AllowRegistration)
                        {
                            <a href="~/Register" lc-button>Register</a>
                        }
                    </div>
                </form>
            }

            @if (providers != null && providers.Count() > 0)
            {
                @if (Model.AllowPassword)
                {
                    <div class="lc-divider lc-divider-with-text" role="separator"><span class="lc-divider-text">Or</span></div>
                }

                <partial name="_ProviderButtons" model="@(new LANCommander.Server.Models.ProviderButtonsModel { Providers = providers, ReturnUrl = Model.ReturnUrl })"/>
            }
        </div>

        <div class="login-download-pane" style="background-image: url('@Model.ScreenshotUrl')">
            @(await Html.RenderComponentAsync<LANCommander.Server.UI.Pages.Account.Components.LauncherDownloadButton>(RenderMode.Server))
        </div>
    </div>
</div>
