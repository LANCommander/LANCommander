@model LANCommander.Server.Models.ProviderButtonsModel

<div class="authentication-provider-container">
    @foreach (var provider in Model.Providers)
    {
        <form method="post">
            <input type="hidden" name="Provider" value="@provider.Slug"/>
            <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl"/>

            <partial name="_ProviderButton" model="@(new LANCommander.Server.Models.ProviderButtonModel { Provider = provider, Text = $"Sign in using {provider.Name}" })" />
        </form>
    }
</div>
