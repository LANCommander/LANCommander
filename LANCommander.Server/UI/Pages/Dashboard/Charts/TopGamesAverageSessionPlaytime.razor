@inject PlaySessionService PlaySessionService

@* Horizontal bars give every title its own row; as columns, up to 20 titles collide on the axis *@
<AsyncContent T="List<Playtime>" Load="LoadAsync" LoadingText="Loading session lengths">
    <BarChart Items="context"
              Label="g => g.Label"
              Value="g => g.Seconds"
              ValueFormat="Playtime.Format"
              ValueTitle="Average Session Playtime"
              CategoryFormat="t => DashboardFormat.Abbreviate(t, 32)"
              Horizontal
              Height="@Math.Max(200, context.Count * 26 + 60)"
              EmptyText="No sessions have been played yet" />
</AsyncContent>

@code {
    async Task<List<Playtime>> LoadAsync()
    {
        var sessions = await PlaySessionService
            .AsNoTracking()
            .Include(ps => ps.Game)
            .GetAsync(ps => ps.GameId.HasValue && ps.GameId.Value != Guid.Empty);

        return sessions
            .GroupBy(s => s.GameId)
            .Select(game => new Playtime(game.First().Game?.Title ?? "Unknown", Playtime.Total(game) / game.Count()))
            .OrderByDescending(g => g.Time)
            .Take(20)
            .ToList();
    }
}
