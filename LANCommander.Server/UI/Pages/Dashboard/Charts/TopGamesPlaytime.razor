@inject PlaySessionService PlaySessionService

<AsyncContent T="List<Playtime>" Load="LoadAsync" LoadingText="Loading playtime">
    <PieChart Items="context"
              Label="g => g.Label"
              Value="g => g.Seconds"
              ValueFormat="Playtime.Format"
              ValueTitle="Total Playtime"
              EmptyText="No sessions have been played yet" />
</AsyncContent>

@code {
    async Task<List<Playtime>> LoadAsync()
    {
        var sessions = await PlaySessionService
            .AsNoTracking()
            .Include(ps => ps.Game)
            .GetAsync(ps => ps.GameId.HasValue && ps.GameId.Value != Guid.Empty);

        return sessions
            .GroupBy(s => s.GameId)
            .Select(game => new Playtime(game.First().Game?.Title ?? "Unknown", Playtime.Total(game)))
            .OrderByDescending(g => g.Time)
            .Take(10)
            .ToList();
    }
}
