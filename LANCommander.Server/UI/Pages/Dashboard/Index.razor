@page "/"
@page "/Dashboard"
@attribute [Authorize]

<PageHeader Title="Dashboard" />

<PageContent>
    <Row Gap="Gap.Medium" VerticalGap="Gap.Medium">
        <Column Xs="24" Md="12">
            <Card Title="Top 10 Total Playtime (By Player)">
                <ErrorHandler Inline>
                    <TopPlayersPlaytime />
                </ErrorHandler>
            </Card>
        </Column>

        <Column Xs="24" Md="12">
            <Card Title="Top 10 Total Playtime (By Game)">
                <ErrorHandler Inline>
                    <TopGamesPlaytime />
                </ErrorHandler>
            </Card>
        </Column>

        <Column Xs="24">
            <Card Title="Top Average Session Length (By Game)">
                <ErrorHandler Inline>
                    <TopGamesAverageSessionPlaytime />
                </ErrorHandler>
            </Card>
        </Column>
    </Row>
</PageContent>
