@page "/Dashboard/SessionPlaytime"
@attribute [Authorize]
@inject GameService GameService

<PageHeader Title="Session Playtime" />

<PageContent>
    <AsyncContent T="List<GameAverageSessionData>" Load="LoadAsync" LoadingText="Loading sessions" Context="rows">
        <Table TItem="GameAverageSessionData" Items="rows" PageSize="100" SettingsKey="session-playtime">
            <Columns>
                <TemplateColumn TItem="GameAverageSessionData" Title="Icon" Width="64px">
                    <Image Src="@GetIcon(context.Game)" Width="32" Height="32" />
                </TemplateColumn>
                <BoundColumn Property="d => d.Game.Title" Title="Game" Sortable />
                <BoundColumn Property="d => d.LastPlayed" Title="Last Played" Sortable>
                    <LocalTime Value="context.LastPlayed" />
                </BoundColumn>
                <BoundColumn Property="d => d.SessionCount" Title="Sessions" Sortable AlignEnd />
                <BoundColumn Property="d => d.TotalTime" Title="Total Time" Sortable AlignEnd>
                    @Playtime.Format(context.TotalTime.TotalSeconds)
                </BoundColumn>
                <BoundColumn Property="d => d.AverageTime" Title="Average Session" Sortable DefaultSort="ColumnSort.Descending" AlignEnd>
                    @Playtime.Format(context.AverageTime.TotalSeconds)
                </BoundColumn>
            </Columns>
        </Table>
    </AsyncContent>
</PageContent>

@code {
    async Task<List<GameAverageSessionData>> LoadAsync()
    {
        var games = await GameService
            .Include(g => g.PlaySessions)
            .Include(g => g.Media.Where(m => m.Type == SDK.Enums.MediaType.Icon))
            .GetAsync();

        return games.Select(game =>
        {
            var sessions = game.PlaySessions?.Where(s => s.Start != null && s.End != null).ToList() ?? [];
            var total = Playtime.Total(sessions);

            return new GameAverageSessionData
            {
                Game = game,
                LastPlayed = sessions.Count > 0 ? sessions.Max(s => s.End!.Value) : null,
                SessionCount = sessions.Count,
                TotalTime = total,
                AverageTime = sessions.Count > 0 ? total / sessions.Count : TimeSpan.Zero,
            };
        }).ToList();
    }

    static string GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == SDK.Enums.MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : "/favicon.ico";
    }

    public class GameAverageSessionData
    {
        public Game Game { get; set; } = default!;
        public DateTime? LastPlayed { get; set; }
        public TimeSpan TotalTime { get; set; }
        public int SessionCount { get; set; }
        public TimeSpan AverageTime { get; set; }
    }
}
