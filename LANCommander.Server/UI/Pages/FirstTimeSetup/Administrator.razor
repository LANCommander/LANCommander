@page "/FirstTimeSetup/Administrator"
@using LANCommander.Server.Services.Exceptions
@layout FirstTimeSetupLayout
@inject SetupService SetupService
@inject RoleService RoleService
@inject UserService UserService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@inject ILogger<Administrator> Logger

<PageTitle>Create Administrator User - First Time Setup</PageTitle>

<Form Model="Model" Loading="Loading" OnSubmit="CreateAdministratorAsync">
    <p>To get started, you will need to create an administrator user.</p>

    <FormItem Label="Username" Required>
        <TextInput @bind-Value="Model.Username" AutoFocus />
    </FormItem>
    <FormItem Label="Password" Required>
        <PasswordInput @bind-Value="Model.Password" />
    </FormItem>
    <FormItem Label="Confirm Password" Required>
        <PasswordInput @bind-Value="Model.PasswordConfirm" />
    </FormItem>

    <Flex Justify="Justify.End" Class="first-time-setup-actions">
        <Button Primary Submit Loading="Loading">Create</Button>
    </Flex>
</Form>

@code {
    [CascadingParameter] FirstTimeSetupLayout Layout { get; set; } = default!;

    FirstTimeSetupModel Model = new();

    bool Loading;

    protected override async Task OnInitializedAsync()
    {
        await Layout.ChangeCurrentStep(FirstTimeSetupStep.Administrator);

        if (await SetupService.IsSetupInitialized())
            NavigationManager.NavigateTo("/");
    }

    async Task CreateAdministratorAsync()
    {
        if (Model.Password != Model.PasswordConfirm)
        {
            Notifications.Error("Passwords do not match");
            return;
        }

        Loading = true;

        try
        {
            var role = await RoleService.GetAsync(RoleService.AdministratorRoleName)
                       ?? await RoleService.AddAsync(new Role { Name = RoleService.AdministratorRoleName });

            var administrators = await RoleService.GetUsersAsync(RoleService.AdministratorRoleName);

            if (administrators != null && administrators.Any())
            {
                NavigationManager.NavigateTo("/");
                return;
            }

            var user = Activator.CreateInstance<User>();

            user.Approved = true;
            user.ApprovedOn = DateTime.UtcNow;
            user.UserName = Model.Username;

            await UserService.AddAsync(user, bypassPasswordPolicy: true, Model.Password);
            await UserService.AddToRolesAsync(user.UserName, [role.Name]);

            Logger.LogInformation("Administrator created a new account with password.");

            Notifications.Success("Setup completed! Redirecting...");

            NavigationManager.NavigateTo("/");
        }
        catch (UserRegistrationException ex)
        {
            foreach (var error in ex.IdentityResult.Errors)
                Notifications.Error(error.Description);
        }
        catch (AddRoleException ex)
        {
            foreach (var error in ex.IdentityResult.Errors)
                Notifications.Error(error.Description);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not create administrator");
        }
        finally
        {
            Loading = false;
        }
    }
}
