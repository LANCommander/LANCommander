@inherits LayoutComponentBase
@layout BasicLayout

@* The setup wizard: its steps above whichever step page is showing *@
<div class="first-time-setup">
    <div class="first-time-setup-logo">
        <img src="/static/logo-dark.svg" alt="LANCommander" />
    </div>

    <Card Title="First Time Setup">
        <Steps Current="(int)CurrentStep" Small Class="first-time-setup-steps">
            @foreach (var step in Enum.GetValues<FirstTimeSetupStep>())
            {
                <Step Title="@step.ToString()" />
            }
        </Steps>

        <CascadingValue Value="this">
            @Body
        </CascadingValue>
    </Card>
</div>

@code {
    FirstTimeSetupStep CurrentStep = FirstTimeSetupStep.Database;

    internal async Task ChangeCurrentStep(FirstTimeSetupStep step)
    {
        CurrentStep = step;

        await InvokeAsync(StateHasChanged);
    }
}
