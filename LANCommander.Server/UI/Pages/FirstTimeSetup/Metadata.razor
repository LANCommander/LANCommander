@page "/FirstTimeSetup/Metadata"
@using LANCommander.Server.Settings
@using LANCommander.Server.UI.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@layout FirstTimeSetupLayout
@inject SetupService SetupService
@inject SettingsProvider<Settings> SettingsProvider
@inject IOptions<Settings> Settings
@inject IHqConnectionState HqConnection
@inject HqAuthorizationStateStore HqAuthorizationState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@inject IJSRuntime JS

<PageTitle>Metadata Connections - First Time Setup</PageTitle>

@switch (_choice)
{
    case MetadataChoice.None:
        <Flex Vertical Gap="Gap.Medium">
            <Typography>LANCommander can pull metadata and media from external sources. Choose how you'd like to get your metadata.</Typography>

            <Typography>Connect your server to LANCommander HQ for access to expanded metadata providers, faster lookups, and premium features. All through one account.</Typography>

            <HqFeatureCards />

            <Flex Justify="Justify.Center">
                <Button Primary Large OnClick="() => _choice = MetadataChoice.HQ">Use LANCommander HQ</Button>
            </Flex>

            <Divider />

            <Flex Vertical Align="Align.Center" Gap="Gap.Small">
                <Typography Secondary>Or configure IGDB and SteamGridDB with your own API keys.</Typography>
                <Button OnClick="() => _choice = MetadataChoice.OwnProviders">Use My Own Providers</Button>
            </Flex>

            <Flex Justify="Justify.End" Class="first-time-setup-actions">
                <Button OnClick="Next">Skip</Button>
            </Flex>
        </Flex>
        break;

    case MetadataChoice.HQ:
        <p>Connect your server to LANCommander HQ.</p>

        <HqConnectionProvider Context="connection" OnConnectionChanged="OnHqConnectionChanged">
            @if (connection.Status == HqConnectionStatus.Connected)
            {
                <Result Success Title="@(connection.IsPremium ? "Premium Account" : "Connected")" SubTitle="@(connection.IsPremium ? "Thank you for supporting LANCommander!" : "Your server is linked to LANCommander HQ.")">
                    <Button Danger OnClick="DisconnectHQAsync">Unlink</Button>
                </Result>

                <Flex Justify="Justify.SpaceBetween" Class="first-time-setup-actions">
                    <Button OnClick="() => _choice = MetadataChoice.None">Back</Button>
                    <Button Primary OnClick="Next">Next</Button>
                </Flex>
            }
            else
            {
                @if (connection.Status == HqConnectionStatus.Unauthorized)
                {
                    <Alert Warning Style="margin-bottom: 16px">Your LANCommander HQ session has expired. Connect again to continue.</Alert>
                }
                else if (connection.Status == HqConnectionStatus.Unreachable)
                {
                    <Alert Warning Style="margin-bottom: 16px">LANCommander HQ could not be reached. Check your internet connection and try again.</Alert>
                }
                else
                {
                    <Alert Info Style="margin-bottom: 16px">Not Connected</Alert>
                }

                <Flex Justify="Justify.Center" Style="margin-bottom: 16px">
                    <Button Primary Large Loading="_awaitingAuth" OnClick="ConnectHQAsync">Connect to HQ</Button>
                </Flex>

                <Flex Justify="Justify.SpaceBetween" Class="first-time-setup-actions">
                    <Button OnClick="() => _choice = MetadataChoice.None">Back</Button>
                    <Button OnClick="Next">Skip</Button>
                </Flex>
            }
        </HqConnectionProvider>
        break;

    case MetadataChoice.OwnProviders:
        <Form Model="Settings.Value" OnSubmit="SaveOwnProviders">
            <Divider>IGDB Credentials</Divider>

            <p>
                <Typography Secondary>In order to use IGDB metadata, you need a Twitch developer account. <a href="https://api-docs.igdb.com/#account-creation" target="_blank">Click here</a> for more details.</Typography>
            </p>

            <FormItem Label="Client ID">
                <TextInput @bind-Value="Settings.Value.Server.IGDB.ClientId" />
            </FormItem>
            <FormItem Label="Client Secret">
                <PasswordInput @bind-Value="Settings.Value.Server.IGDB.ClientSecret" autocomplete="off" />
            </FormItem>

            <Divider>SteamGridDB Credentials</Divider>

            <p>
                <Typography Secondary>In order to automatically search SteamGridDB for media, you need an API key. <a href="https://www.steamgriddb.com/profile/preferences/api" target="_blank">Click here</a> to get your key.</Typography>
            </p>

            <FormItem Label="API Key">
                <PasswordInput @bind-Value="Settings.Value.Server.Media.SteamGridDbApiKey" autocomplete="off" />
            </FormItem>

            <Flex Justify="Justify.SpaceBetween" Class="first-time-setup-actions">
                <Button OnClick="() => _choice = MetadataChoice.None">Back</Button>
                <Button Primary Submit>Save</Button>
            </Flex>
        </Form>
        break;
}

@code {
    [CascadingParameter] FirstTimeSetupLayout Layout { get; set; } = default!;

    MetadataChoice _choice = MetadataChoice.None;
    bool _awaitingAuth;

    enum MetadataChoice
    {
        None,
        HQ,
        OwnProviders,
    }

    protected override async Task OnInitializedAsync()
    {
        if (await SetupService.IsSetupInitialized())
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await Layout.ChangeCurrentStep(FirstTimeSetupStep.Metadata);
    }

    Task OnHqConnectionChanged(HqConnectionSnapshot connection)
    {
        // The callback endpoint verifies the new token before it responds, so this event is the
        // signal that the popup finished. It fires unconditionally for that path, so a retry that
        // fails exactly as the last one did still reaches us.
        if (_awaitingAuth)
        {
            _awaitingAuth = false;

            if (connection.Status == HqConnectionStatus.Connected)
                Notifications.Success("Successfully connected to LANCommander HQ!");
            else
                Notifications.Error(string.IsNullOrWhiteSpace(connection.LastError)
                    ? "Could not connect to LANCommander HQ. Check the server logs for details."
                    : connection.LastError);
        }

        return Task.CompletedTask;
    }

    async Task ConnectHQAsync()
    {
        try
        {
            var baseUrl = Settings.Value.Server.HQ.BaseUrl.TrimEnd('/');
            var callbackUrl = NavigationManager.BaseUri.TrimEnd('/') + "/api/HQ/Callback";
            var tokenRelayUrl = $"{baseUrl}/Auth/TokenRelay?returnUrl={Uri.EscapeDataString(callbackUrl)}";
            var loginUrl = $"{baseUrl}/Auth/Login?returnUrl={Uri.EscapeDataString(tokenRelayUrl)}";

            // Marks this administrator as having started the flow, which the callback requires
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            HqAuthorizationState.Issue(authState.User.Identity?.Name);

            _awaitingAuth = true;

            await JS.InvokeVoidAsync("open", loginUrl, "hq_auth", "width=600,height=700,menubar=no,toolbar=no");
        }
        catch (Exception ex)
        {
            _awaitingAuth = false;

            Notifications.Error(ex, "Could not start connecting to LANCommander HQ");
        }
    }

    async Task DisconnectHQAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            HqAuthorizationState.Revoke(authState.User.Identity?.Name);

            await HqConnection.DisconnectAsync();

            _awaitingAuth = false;

            Notifications.Success("Disconnected from LANCommander HQ.");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not disconnect from LANCommander HQ");
        }
    }

    void SaveOwnProviders()
    {
        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.IGDB.ClientId = Settings.Value.Server.IGDB.ClientId;
                s.Server.IGDB.ClientSecret = Settings.Value.Server.IGDB.ClientSecret;
                s.Server.Media.SteamGridDbApiKey = Settings.Value.Server.Media.SteamGridDbApiKey;
            });

            Next();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The provider settings could not be saved");
        }
    }

    void Next() => NavigationManager.NavigateTo("/FirstTimeSetup/Administrator");
}
