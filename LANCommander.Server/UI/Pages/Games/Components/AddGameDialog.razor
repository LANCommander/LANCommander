@using LANCommander.Server.Services.MediaGrabbers
@using LANCommander.Server.Settings
@inherits Dialog<bool>
@inject MediaAutoDownloadService MediaAutoDownloadService
@inject SettingsProvider<Settings> SettingsProvider
@inject NavigationManager NavigationManager

@*
    Adds a game by looking it up with a metadata provider, optionally fetching its art too, or
    sends the user to the blank General form to enter it by hand.
*@
<Segmented TValue="bool" Items="Modes" Value="false" ValueChanged="ModeChanged" Block Class="add-game-mode" />

<MetadataLookupPanel @ref="_panel" GameId="Guid.Empty" AutoFocus ShowCancel="false" OnImported="OnGameImportedAsync">
    <Checkbox Value="_autoDownloadMedia" ValueChanged="OnAutoDownloadMediaChanged" Style="margin-top: 8px">Automatically download art</Checkbox>
</MetadataLookupPanel>

@code {
    MetadataLookupPanel? _panel;
    bool _autoDownloadMedia;

    static readonly IReadOnlyList<SelectItem<bool>> Modes =
    [
        new(false, "Look up metadata"),
        new(true, "Enter manually"),
    ];

    async Task ModeChanged(bool manual)
    {
        if (!manual)
            return;

        await CloseAsync(false);

        NavigationManager.NavigateTo("/Games/Add");
    }

    protected override void OnInitialized()
    {
        _autoDownloadMedia = SettingsProvider.CurrentValue.Server.Media.AutoDownloadMedia;
    }

    void OnAutoDownloadMediaChanged(bool value)
    {
        _autoDownloadMedia = value;

        SettingsProvider.Update(s => s.Server.Media.AutoDownloadMedia = value);
    }

    async Task OnGameImportedAsync(Guid gameId)
    {
        if (_autoDownloadMedia)
            await DownloadMediaAsync(gameId);

        await CloseAsync(true);

        NavigationManager.NavigateTo($"/Games/{gameId}");
    }

    async Task DownloadMediaAsync(Guid gameId)
    {
        await MediaAutoDownloadService.DownloadMissingArtAsync(gameId, async mediaType =>
        {
            if (_panel != null)
                await _panel.UpdateStatusAsync($"Downloading {mediaType}...");
        });
    }
}
