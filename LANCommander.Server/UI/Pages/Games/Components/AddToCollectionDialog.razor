@using LANCommander.Server.Models
@inherits Dialog<AddToCollectionOptions, IEnumerable<Collection>>
@inject CollectionService CollectionService
@inject GameService GameService
@inject NotificationService Notifications

@* Adds the games in Options to one or more collections, which can also be created here *@
<Flex Vertical Gap="Gap.Medium">
    <Select TValue="Guid" Multiple Clearable Searchable Items="_collectionItems" @bind-Values="_selected" Placeholder="Select a Collection" />

    <InputGroup Block>
        <TextInput @bind-Value="_newCollectionName" Immediate Placeholder="New collection name" OnEnter="AddCollectionAsync" Style="flex: 1" />
        <Button Icon="IconType.Plus" Disabled="@(String.IsNullOrWhiteSpace(_newCollectionName))" OnClick="AddCollectionAsync">Add New Collection</Button>
    </InputGroup>
</Flex>

@code {
    IEnumerable<SelectItem<Guid>> _collectionItems = [];
    IEnumerable<Guid> _selected = [];
    string? _newCollectionName;

    protected override bool CanConfirm => _selected.Any();

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync()
    {
        var collections = await CollectionService.SortBy(c => c.Name).GetAsync();

        _collectionItems = collections.ToSelectItems(c => c.Id, c => c.Name).ToList();
    }

    async Task AddCollectionAsync()
    {
        if (String.IsNullOrWhiteSpace(_newCollectionName))
            return;

        try
        {
            var collection = await CollectionService.AddAsync(new Collection { Name = _newCollectionName });

            await LoadAsync();

            // Most likely the games should go in the collection just made
            _selected = [.. _selected, collection.Id];
            _newCollectionName = null;

            Notifications.Success("Collection added!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not add a new collection!");
        }
    }

    protected override async Task<bool> OnOkAsync()
    {
        var collections = await CollectionService
            .Include(c => c.Games)
            .GetAsync(c => _selected.Contains(c.Id));

        foreach (var collection in collections)
        {
            collection.Games ??= new List<Game>();

            foreach (var gameId in Options.GameIds.Where(id => !collection.Games.Any(g => g.Id == id)))
                collection.Games.Add(await GameService.GetAsync(gameId));

            await CollectionService.UpdateAsync(collection);
        }

        Notifications.Success(collections.Count > 1 ? "Added to collections!" : "Added to collection!");

        Result = collections;

        return true;
    }
}
