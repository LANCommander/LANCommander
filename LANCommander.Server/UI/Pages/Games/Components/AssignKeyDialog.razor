@inherits Dialog<Guid, bool>
@inject KeyService KeyService
@inject UserService UserService
@inject NotificationService Notifications

@* Allocates the key whose Id is passed as the options to a machine or a user *@
<Form Model="_model">
    <FormItem Label="Allocation Method">
        <EnumSelect TEnum="KeyAllocationMethod" @bind-Value="_model.KeyAllocationMethod" />
    </FormItem>

    @if (_model.KeyAllocationMethod == KeyAllocationMethod.MacAddress)
    {
        <FormItem Label="MAC Address" Required>
            <TextInput @bind-Value="_model.MacAddress" Placeholder="00:00:00:00:00:00" />
        </FormItem>
    }
    else if (_model.KeyAllocationMethod == KeyAllocationMethod.UserAccount)
    {
        <FormItem Label="User" Required>
            <Select TValue="Guid" Items="_users" @bind-Value="_model.SelectedUserId" Placeholder="Select a user" Searchable />
        </FormItem>
    }
</Form>

@code {
    AssignKeyDialogViewModel _model = new();

    IEnumerable<SelectItem<Guid>> _users = [];

    protected override async Task OnInitializedAsync()
    {
        var users = await UserService.GetAsync();

        _users = users.OrderBy(u => u.UserName).ToSelectItems(u => u.Id, u => u.UserName).ToList();
    }

    protected override async Task<bool> OnOkAsync()
    {
        var key = await KeyService.GetAsync(Options) ?? throw new InvalidOperationException("Key not found!");

        switch (_model.KeyAllocationMethod)
        {
            case KeyAllocationMethod.MacAddress:
                if (string.IsNullOrWhiteSpace(_model.MacAddress))
                    throw new InvalidOperationException("Please enter a MAC address.");

                await KeyService.AllocateAsync(key, _model.MacAddress);
                break;

            case KeyAllocationMethod.UserAccount:
                var user = _model.SelectedUserId != Guid.Empty
                    ? await UserService.GetAsync(_model.SelectedUserId)
                    : null;

                await KeyService.AllocateAsync(key, user ?? throw new InvalidOperationException("Please select a user."));
                break;
        }

        Notifications.Success("Key assigned!");

        Result = true;

        return true;
    }
}
