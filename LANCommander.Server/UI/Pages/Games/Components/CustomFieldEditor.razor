@inject GameCustomFieldService GameCustomFieldService
@inject NotificationService Notifications

@* Free-form name/value pairs stored with the game whose Id is cascaded *@
<Flex Vertical Gap="Gap.Large">
    <Table TItem="GameCustomField" Items="_customFields" Key="f => f" NoPaging EmptyText="No custom fields" SettingsKey="game-custom-fields">
        <Columns>
            <TemplateColumn TItem="GameCustomField" Title="Name">
                <TextInput @bind-Value="context.Name" />
            </TemplateColumn>
            <TemplateColumn TItem="GameCustomField" Title="Value">
                <TextInput @bind-Value="context.Value" />
            </TemplateColumn>
            <ActionsColumn TItem="GameCustomField">
                <Popconfirm OnConfirm="() => RemoveAsync(context)" Title="Are you sure you want to delete this custom field?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </Table>

    <Flex Justify="Justify.End">
        <Button Primary Icon="IconType.Plus" OnClick="Add">Add Field</Button>
    </Flex>
</Flex>

@code {
    [CascadingParameter(Name = "GameId")] public Guid GameId { get; set; }

    // Replaced rather than changed in place, so the table notices additions and removals
    List<GameCustomField> _customFields = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync() =>
        _customFields = (await GameCustomFieldService.GetAsync(cf => cf.GameId == GameId)).ToList();

    void Add() => _customFields = [.. _customFields, new GameCustomField { GameId = GameId }];

    async Task RemoveAsync(GameCustomField customField)
    {
        try
        {
            if (customField.Id != Guid.Empty)
                await GameCustomFieldService.DeleteAsync(customField);

            _customFields = _customFields.Where(f => f != customField).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The custom field could not be deleted");
        }
    }

    public async Task Save()
    {
        try
        {
            foreach (var customField in _customFields)
            {
                if (customField.Id == Guid.Empty)
                    await GameCustomFieldService.AddAsync(customField);
                else
                    await GameCustomFieldService.UpdateAsync(customField);
            }

            Notifications.Success("Custom fields updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save custom fields!");
        }

        await LoadAsync();
    }
}
