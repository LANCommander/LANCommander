@using Microsoft.Extensions.Options
@using LANCommander.Server.Settings
@using LANCommander.Server.Services.Abstractions
@using LANCommander.Server.Services.Models
@using Microsoft.EntityFrameworkCore
@using System.Net.Mime
@using LANCommander.Server.UI.Providers
@inject MediaService MediaService
@inject GameService GameService
@inject IMediaGrabberService MediaGrabberService
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject IOptions<Settings> Settings
@inject ScriptProvider ScriptProvider
@inject IDbContextFactory<LANCommander.Server.Data.DatabaseContext> DatabaseContextFactory
@inject ILogger<GameDetailPreview> Logger

@* The game as the launcher shows it, doubling as the media editor. Every slot keeps its label plate
   visible; its upload, search and remove buttons come up on hover. Media is saved as it is added. *@
<div class="game-detail-preview" style="@ToneStyle">
    <!-- ══ Hero: background slot, logo slot ══════════════════════════ -->
    <div class="game-detail-preview__hero">
        @{
            var bgMedia = GetMedia(MediaType.Background);
            var bgUrl = GetMediaUrl(bgMedia);
        }

        @if (bgUrl != null)
        {
            <img class="game-detail-preview__hero-bg" src="@bgUrl" alt="" />
        }

        <div class="game-detail-preview__hero-gradient-top"></div>
        <div class="game-detail-preview__hero-gradient-bottom"></div>

        <div class="game-detail-preview__slot game-detail-preview__slot--background">
            <div class="game-detail-preview__slot-actions">
                <InputFile id="@_bgInputId" OnChange="(e) => UploadMediaByType(e, MediaType.Background)" hidden accept=".jpg,.jpeg,.png,.gif,.webp" />
                <label class="game-detail-preview__overlay-btn" for="@_bgInputId" title="Upload background">
                    <Icon Type="IconType.UploadSimple" />
                </label>
                <button type="button" class="game-detail-preview__overlay-btn" @onclick="() => SearchMediaByType(MediaType.Background)" title="Search for a background">
                    <Icon Type="IconType.MagnifyingGlass" />
                </button>
                @if (bgMedia != null)
                {
                    <button type="button" class="game-detail-preview__overlay-btn game-detail-preview__overlay-btn--danger" @onclick="() => RemoveMediaByType(MediaType.Background)" title="Remove background">
                        <Icon Type="IconType.Trash" />
                    </button>
                }
            </div>
            <span class="game-detail-preview__slot-label">Background</span>
        </div>

        <div class="game-detail-preview__logo-area">
            @{
                var logoMedia = GetMedia(MediaType.Logo);
                var logoUrl = GetMediaUrl(logoMedia);
            }

            @if (logoUrl != null)
            {
                <img class="game-detail-preview__logo-img" src="@logoUrl" alt="@_game?.Title" />
            }
            else
            {
                <span class="game-detail-preview__title-fallback">@_game?.Title</span>
            }

            <div class="game-detail-preview__slot game-detail-preview__slot--logo">
                <span class="game-detail-preview__slot-label">Logo</span>
                <div class="game-detail-preview__slot-actions">
                    <InputFile id="@_logoInputId" OnChange="(e) => UploadMediaByType(e, MediaType.Logo)" hidden accept=".jpg,.jpeg,.png,.gif,.webp" />
                    <label class="game-detail-preview__overlay-btn" for="@_logoInputId" title="Upload logo">
                        <Icon Type="IconType.UploadSimple" />
                    </label>
                    <button type="button" class="game-detail-preview__overlay-btn" @onclick="() => SearchMediaByType(MediaType.Logo)" title="Search for a logo">
                        <Icon Type="IconType.MagnifyingGlass" />
                    </button>
                    @if (logoMedia != null)
                    {
                        <button type="button" class="game-detail-preview__overlay-btn game-detail-preview__overlay-btn--danger" @onclick="() => RemoveMediaByType(MediaType.Logo)" title="Remove logo">
                            <Icon Type="IconType.Trash" />
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ══ Content: the page, then the launcher's cover rail ═════════ -->
    <div class="game-detail-preview__content">
        <div class="game-detail-preview__left">
            @if (!string.IsNullOrWhiteSpace(_game?.Description))
            {
                <p class="game-detail-preview__description">@_game.Description</p>
            }

            @{
                var strip = GetMediaList(MediaType.Screenshot, MediaType.Video);
            }

            <div class="game-detail-preview__media-section">
                <div class="game-detail-preview__media-section-header">
                    <span class="game-detail-preview__kicker game-detail-preview__media-kicker">@GameEditFormat.MediaKicker(strip.Count(m => m.Type == MediaType.Screenshot), strip.Count(m => m.Type == MediaType.Video))</span>

                    <InputFile id="@_ssInputId" OnChange="(e) => UploadMediaByType(e, MediaType.Screenshot)" hidden accept=".jpg,.jpeg,.png,.gif,.webp" multiple />
                    <InputFile id="@_vidInputId" OnChange="(e) => UploadMediaByType(e, MediaType.Video)" hidden accept=".mp4,.webm,.mkv" multiple />

                    <Dropdown>
                        <Overlay>
                            <Menu>
                                <MenuItem Icon="IconType.UploadSimple" OnClick="() => ClickFileInput(_ssInputId)">Upload screenshots</MenuItem>
                                <MenuItem Icon="IconType.MagnifyingGlass" OnClick="() => SearchMediaByType(MediaType.Screenshot)">Search screenshots</MenuItem>
                                <MenuDivider />
                                <MenuItem Icon="IconType.UploadSimple" OnClick="() => ClickFileInput(_vidInputId)">Upload videos</MenuItem>
                                <MenuItem Icon="IconType.MagnifyingGlass" OnClick="() => SearchMediaByType(MediaType.Video)">Search videos</MenuItem>
                            </Menu>
                        </Overlay>
                        <ChildContent>
                            <Button ExtraSmall Icon="IconType.Plus" title="Add screenshots or videos">Add</Button>
                        </ChildContent>
                    </Dropdown>
                </div>

                <div class="game-detail-preview__carousel">
                    @foreach (var media in strip)
                    {
                        <div class="game-detail-preview__carousel-item" @key="media.Id">
                            @if (media.Type == MediaType.Video)
                            {
                                <video class="game-detail-preview__carousel-video" src="@GetMediaDownloadUrl(media)" muted loop></video>
                                <span class="game-detail-preview__carousel-video-badge" title="Video">
                                    <Icon Type="IconType.Play" Fill />
                                </span>
                            }
                            else
                            {
                                <img class="game-detail-preview__carousel-img" src="@GetMediaDownloadUrl(media)" alt="" />
                            }
                            <div class="game-detail-preview__carousel-item-overlay">
                                <button type="button" class="game-detail-preview__overlay-btn" @onclick="() => MoveMediaLeft(media)" title="Move left">
                                    <Icon Type="IconType.CaretLeft" />
                                </button>
                                <button type="button" class="game-detail-preview__overlay-btn" @onclick="() => MoveMediaRight(media)" title="Move right">
                                    <Icon Type="IconType.CaretRight" />
                                </button>
                                <Popconfirm Title="Remove this media?" OkText="Remove" Danger OnConfirm="() => RemoveMedia(media)">
                                    <button type="button" class="game-detail-preview__overlay-btn game-detail-preview__overlay-btn--danger" title="Remove">
                                        <Icon Type="IconType.Trash" />
                                    </button>
                                </Popconfirm>
                            </div>
                        </div>
                    }

                    @* Files dropped here (or picked by clicking) go through the same upload as Add; videos by their type, the rest as screenshots *@
                    <label class="@DropClass(strip.Count == 0)" title="Drop screenshots or videos here, or click to choose them">
                        <InputFile OnChange="UploadDroppedMedia"
                                   multiple
                                   accept=".jpg,.jpeg,.png,.gif,.webp,.mp4,.webm,.mkv"
                                   class="game-detail-preview__drop-input"
                                   aria-label="Add screenshots or videos"
                                   disabled="@_uploading"
                                   @ondragenter="() => _dragging = true"
                                   @ondragleave="() => _dragging = false" />
                        @if (_uploading)
                        {
                            <Spinner />
                        }
                        else
                        {
                            <Icon Type="IconType.ArrowUp" />
                        }
                        <span>@(strip.Count == 0 ? "Drop screenshots or videos" : "Drop")</span>
                    </label>
                </div>
            </div>

            @{
                var players = PlayerBadges().ToList();
                var runsWith = RunsWithBadges().ToList();
            }

            @if (players.Any() || runsWith.Any())
            {
                <div class="game-detail-preview__facts">
                    @if (players.Any())
                    {
                        <div class="game-detail-preview__badge-section">
                            <span class="game-detail-preview__kicker">Players</span>
                            <div class="game-detail-preview__badge-wrap">
                                @foreach (var badge in players)
                                {
                                    <span class="game-detail-preview__badge">@badge</span>
                                }
                            </div>
                        </div>
                    }

                    @if (runsWith.Any())
                    {
                        <div class="game-detail-preview__badge-section">
                            <span class="game-detail-preview__kicker">Runs with</span>
                            <div class="game-detail-preview__badge-wrap">
                                @foreach (var badge in runsWith)
                                {
                                    <span class="game-detail-preview__badge">@badge</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="game-detail-preview__right">
            <div class="game-detail-preview__cover-wrapper">
                @{
                    var coverMedia = GetMedia(MediaType.Cover);
                    var coverUrl = GetMediaUrl(coverMedia);
                }

                @if (coverUrl != null && coverMedia?.MimeType?.StartsWith("video/") == true)
                {
                    <video class="game-detail-preview__cover-img" src="@coverUrl" autoplay muted loop></video>
                }
                else if (coverUrl != null)
                {
                    <img class="game-detail-preview__cover-img" src="@coverUrl" alt="@_game?.Title" />
                }
                else
                {
                    <div class="game-detail-preview__cover-placeholder">
                        <span>@_game?.Title</span>
                    </div>
                }

                <div class="game-detail-preview__cover-scrim">
                    <div class="game-detail-preview__slot-actions">
                        <InputFile id="@_coverInputId" OnChange="(e) => UploadMediaByType(e, MediaType.Cover)" hidden accept=".jpg,.jpeg,.png,.gif,.webp,.apng,.mp4,.webm,.mkv" />
                        <label class="game-detail-preview__overlay-btn game-detail-preview__overlay-btn--large" for="@_coverInputId" title="Upload cover">
                            <Icon Type="IconType.UploadSimple" />
                        </label>
                        <button type="button" class="game-detail-preview__overlay-btn game-detail-preview__overlay-btn--large" @onclick="() => SearchMediaByType(MediaType.Cover)" title="Search for a cover">
                            <Icon Type="IconType.MagnifyingGlass" />
                        </button>
                        @if (coverMedia != null)
                        {
                            <button type="button" class="game-detail-preview__overlay-btn game-detail-preview__overlay-btn--large game-detail-preview__overlay-btn--danger" @onclick="() => RemoveMediaByType(MediaType.Cover)" title="Remove cover">
                                <Icon Type="IconType.Trash" />
                            </button>
                        }
                    </div>
                    <span class="game-detail-preview__slot-label">@CoverLabel</span>
                </div>
            </div>

            @foreach (var (title, names) in RailSections())
            {
                <div class="game-detail-preview__badge-section">
                    <span class="game-detail-preview__kicker">@title</span>
                    <div class="game-detail-preview__badge-wrap">
                        @foreach (var name in names)
                        {
                            <span class="game-detail-preview__badge">@name</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "GameId")] public Guid GameId { get; set; }

    readonly string _ssInputId = "ss-upload-" + Guid.NewGuid();
    readonly string _vidInputId = "vid-upload-" + Guid.NewGuid();
    readonly string _bgInputId = "bg-upload-" + Guid.NewGuid();
    readonly string _logoInputId = "logo-upload-" + Guid.NewGuid();
    readonly string _coverInputId = "cover-upload-" + Guid.NewGuid();

    bool _dragging;
    bool _uploading;

    /// <summary>What the game runs with beyond itself, for the RUNS WITH badges.</summary>
    record RunsWith(string? Engine, int Scripts, int Redistributables);

    RunsWith? _runsWith;

    string[] ValidImageMimeTypes = [
        MediaTypeNames.Image.Png,
        MediaTypeNames.Image.Jpeg,
        MediaTypeNames.Image.Gif,
        MediaTypeNames.Image.Webp,
        "image/apng",
    ];

    string[] ValidVideoMimeTypes = [
        "video/mp4",
        "video/webm",
        "video/x-matroska"
    ];

    string[] ValidCoverMimeTypes = [
        MediaTypeNames.Image.Png,
        MediaTypeNames.Image.Jpeg,
        MediaTypeNames.Image.Gif,
        MediaTypeNames.Image.Webp,
        "image/apng",
        "video/mp4",
        "video/webm",
        "video/x-matroska"
    ];

    List<Media> _media = new();
    Game? _game;
    IJSObjectReference? _domHelper;

    protected override async Task OnInitializedAsync()
    {
        _game = await GameService.Query(q =>
            {
                return q
                    .Include(g => g.Media)
                    .ThenInclude(m => m.StorageLocation)
                    .Include(g => g.Developers)
                    .Include(g => g.Publishers)
                    .Include(g => g.Genres)
                    .Include(g => g.Tags)
                    .Include(g => g.MultiplayerModes);
            })
            .GetAsync(GameId);

        _media = _game.Media?.ToList() ?? new();

        await LoadRunsWithAsync();
    }

    async Task LoadRunsWithAsync()
    {
        try
        {
            await using var context = await DatabaseContextFactory.CreateDbContextAsync();

            _runsWith = await context.Set<Game>()
                .Where(g => g.Id == GameId)
                .Select(g => new RunsWith(
                    g.Engine != null ? g.Engine.Name : null,
                    g.Scripts!.Count(),
                    g.Redistributables!.Count()))
                .FirstOrDefaultAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not count what game {GameId} runs with", GameId);
            _runsWith = null;
        }
    }

    /// <summary>The launcher's tone for a game without art, on the hero and the cover placeholder.</summary>
    string ToneStyle
    {
        get
        {
            var tone = GameTile.ToneOf(_game?.Title);

            return $"--preview-tone-light: var(--lc-cover-tone-{tone}-light); --preview-tone-dark: var(--lc-cover-tone-{tone}-dark)";
        }
    }

    /// <summary>"Cover · 600×900": the slot and the size covers are scaled to.</summary>
    string CoverLabel
    {
        get
        {
            var size = Settings.Value.Server.Media.GetMediaTypeConfig(MediaType.Cover)?.Thumbnails?.MaxSize;

            return size is { Width: > 0, Height: > 0 } ? $"Cover · {size.Width}×{size.Height}" : "Cover";
        }
    }

    string DropClass(bool empty) => new ClassBuilder()
        .Add("game-detail-preview__drop")
        .If(empty, "game-detail-preview__drop--wide")
        .If(_dragging, "game-detail-preview__drop--over")
        .If(_uploading, "game-detail-preview__drop--busy")
        .Build()!;

    /// <summary>Singleplayer, then each multiplayer mode: "LAN · 2–24 players".</summary>
    IEnumerable<string> PlayerBadges()
    {
        if (_game == null)
            yield break;

        if (_game.Singleplayer)
            yield return "Singleplayer";

        foreach (var mode in _game.MultiplayerModes ?? [])
        {
            yield return mode.MinPlayers > 0 && mode.MaxPlayers > 0
                ? $"{mode.Type.GetDisplayName()} · {mode.MinPlayers}–{mode.MaxPlayers} players"
                : mode.Type.GetDisplayName();
        }
    }

    /// <summary>The engine, then how many scripts and redistributables; kinds there are none of are left out.</summary>
    IEnumerable<string> RunsWithBadges()
    {
        if (_runsWith == null)
            yield break;

        if (!string.IsNullOrWhiteSpace(_runsWith.Engine))
            yield return _runsWith.Engine;

        if (_runsWith.Scripts > 0)
            yield return GameEditFormat.Count(_runsWith.Scripts, "script");

        if (_runsWith.Redistributables > 0)
            yield return GameEditFormat.Count(_runsWith.Redistributables, "redistributable");
    }

    /// <summary>The rail under the cover as drawn: genres, then developers; publishers and tags follow in the same style.</summary>
    IEnumerable<(string Title, List<string> Names)> RailSections()
    {
        if (_game == null)
            yield break;

        (string Singular, string Plural, IEnumerable<string>? Names)[] sections =
        [
            ("Genre", "Genres", _game.Genres?.Select(g => g.Name)),
            ("Developer", "Developers", _game.Developers?.Select(d => d.Name)),
            ("Publisher", "Publishers", _game.Publishers?.Select(p => p.Name)),
            ("Tag", "Tags", _game.Tags?.Select(t => t.Name)),
        ];

        foreach (var (singular, plural, names) in sections)
        {
            var list = names?.Where(n => !string.IsNullOrWhiteSpace(n)).ToList() ?? [];

            // Genres always read as a list, as in the launcher; a lone company reads as one
            if (list.Count > 0)
                yield return (list.Count == 1 && singular != "Genre" ? singular : plural, list);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _domHelper = await ScriptProvider.ImportModuleAsync("DomHelper");
    }

    async Task ClickFileInput(string inputId)
    {
        if (_domHelper != null)
            await _domHelper.InvokeVoidAsync("ClickElement", inputId);
    }

    Media? GetMedia(MediaType type) =>
        _media.FirstOrDefault(m => m.Type == type);

    string? GetMediaUrl(Media? media) =>
        media != null && MediaService.FileExists(media)
            ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}&v={media.UpdatedOn.Ticks}"
            : null;

    string GetMediaDownloadUrl(Media media) =>
        $"/api/Media/{media.Id}/Download?fileId={media.FileId}&v={media.UpdatedOn.Ticks}";

    List<Media> GetMediaList(params MediaType[] types) =>
        _media.Where(m => types.Contains(m.Type) && MediaService.FileExists(m))
              .OrderBy(m => m.SortOrder)
              .ToList();

    Task UploadMediaByType(InputFileChangeEventArgs e, MediaType type) =>
        UploadFilesAsync(e.GetMultipleFiles(maximumFileCount: 50).Select(f => (f, type)).ToList());

    /// <summary>Files dropped on the strip: videos by their type, anything else as screenshots.</summary>
    Task UploadDroppedMedia(InputFileChangeEventArgs e)
    {
        _dragging = false;

        return UploadFilesAsync(e.GetMultipleFiles(maximumFileCount: 50)
            .Select(f => (f, f.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ? MediaType.Video : MediaType.Screenshot))
            .ToList());
    }

    async Task UploadFilesAsync(IReadOnlyList<(IBrowserFile File, MediaType Type)> files)
    {
        var uploaded = new List<MediaType>();

        _uploading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            foreach (var (file, type) in files)
            {
                if (await UploadFileAsync(file, type))
                    uploaded.Add(type);
            }
        }
        finally
        {
            _uploading = false;
        }

        await RefreshMedia();

        if (uploaded.Count == 1)
            Notifications.Success($"{uploaded[0]} uploaded!");
        else if (uploaded.Count > 1)
            Notifications.Success($"{uploaded.Count} files uploaded!");
    }

    async Task<bool> UploadFileAsync(IBrowserFile file, MediaType type)
    {
        var validTypes = type switch
        {
            MediaType.Video => ValidVideoMimeTypes,
            MediaType.Cover => ValidCoverMimeTypes,
            _ => ValidImageMimeTypes
        };
        var config = Settings.Value.Server.Media.GetMediaTypeConfig(type);
        var isSingular = type != MediaType.Screenshot && type != MediaType.Video;

        if (!validTypes.Contains(file.ContentType))
        {
            Notifications.Error($"Unsupported file type: {file.Name}");
            return false;
        }

        if (file.Size > config.MaxFileSize)
        {
            Notifications.Error($"File size must be smaller than {ByteSizeLib.ByteSize.FromBytes(config.MaxFileSize)}: {file.Name}");
            return false;
        }

        try
        {
            // For singular types (Background, Logo, Cover), replace existing
            var existing = isSingular ? GetMedia(type) : null;

            if (existing != null)
            {
                existing.MimeType = file.ContentType;
                existing.SourceUrl = "";

                MediaService.DeleteLocalMediaFile(existing);
                var media = await MediaService.WriteToFileAsync(existing, file.OpenReadStream(maxAllowedSize: config.MaxFileSize));
                await MediaService.UpdateAsync(media);
            }
            else
            {
                var media = await MediaService.WriteToFileAsync(new Media
                {
                    GameId = GameId,
                    Type = type,
                    MimeType = file.ContentType,
                    SourceUrl = "",
                    StorageLocation = await MediaService.GetDefaultStorageLocationAsync(),
                    Crc32 = string.Empty,
                    SortOrder = GetNextSortOrder(type)
                }, file.OpenReadStream(maxAllowedSize: config.MaxFileSize));

                // So the next file of a batch sorts after this one
                _media.Add(media);
            }

            return true;
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"{file.Name} could not be uploaded");
            return false;
        }
    }

    async Task SearchMediaByType(MediaType type)
    {
        var multiSelect = type == MediaType.Screenshot || type == MediaType.Video;

        var downloadResult = await Dialogs.OpenAsync<MediaGrabberDialog, MediaGrabberOptions, MediaGrabberDownloadResult>($"Download {type}", new MediaGrabberOptions
        {
            Type = type,
            Search = _game?.Title ?? "",
            MultiSelect = multiSelect,
        }, new DialogSettings
        {
            Size = DialogSize.Full,
            Picker = true,
            OkText = "Select",
            Subtitle = _game?.Title,
        });

        if (downloadResult == null)
            return;

        try
        {
            if (multiSelect)
            {
                foreach (var entry in downloadResult.Results)
                {
                    using var download = entry.Download;

                    await MediaService.WriteToFileAsync(new Media
                    {
                        GameId = GameId,
                        Type = type,
                        SourceUrl = entry.Result.SourceUrl,
                        MimeType = download.MimeType,
                        StorageLocation = await MediaService.GetDefaultStorageLocationAsync(),
                        Crc32 = string.Empty,
                        SortOrder = GetNextSortOrder(type)
                    }, download.Stream);
                }
            }
            else if (downloadResult.Download != null)
            {
                using var singleDownload = downloadResult.Download;

                // Background, logo and cover are one of each: replace the existing one
                var existing = GetMedia(type);

                if (existing != null)
                {
                    existing.SourceUrl = downloadResult.Result.SourceUrl;
                    existing.MimeType = singleDownload.MimeType;

                    MediaService.DeleteLocalMediaFile(existing);
                    await MediaService.WriteToFileAsync(existing, singleDownload.Stream);
                }
                else
                {
                    await MediaService.WriteToFileAsync(new Media
                    {
                        GameId = GameId,
                        Type = type,
                        SourceUrl = downloadResult.Result.SourceUrl,
                        MimeType = singleDownload.MimeType,
                        StorageLocation = await MediaService.GetDefaultStorageLocationAsync(),
                        Crc32 = string.Empty,
                        SortOrder = GetNextSortOrder(type)
                    }, singleDownload.Stream);
                }
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"The {type} could not be saved");
        }

        await RefreshMedia();
    }

    async Task RemoveMediaByType(MediaType type)
    {
        var media = GetMedia(type);

        if (media != null)
            await RemoveMedia(media);
    }

    async Task RemoveMedia(Media media)
    {
        try
        {
            if (media.Id != Guid.Empty)
                await MediaService.DeleteAsync(media);

            _media.Remove(media);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The media could not be removed");
        }
    }

    int GetNextSortOrder(MediaType type)
    {
        var existing = _media.Where(m => m.Type == type).ToList();
        return existing.Any() ? existing.Max(m => m.SortOrder) + 1 : 0;
    }

    async Task NormalizeSortOrders()
    {
        var list = _media
            .Where(m => m.Type == MediaType.Screenshot || m.Type == MediaType.Video)
            .OrderBy(m => m.SortOrder)
            .ThenBy(m => m.CreatedOn)
            .ToList();

        for (int i = 0; i < list.Count; i++)
        {
            if (list[i].SortOrder != i)
            {
                list[i].SortOrder = i;
                await MediaService.UpdateAsync(list[i]);
            }
        }
    }

    async Task MoveMediaLeft(Media media)
    {
        await NormalizeSortOrders();

        var list = GetMediaList(MediaType.Screenshot, MediaType.Video);
        var index = list.IndexOf(media);

        if (index <= 0)
            return;

        // Swap sort orders
        (list[index].SortOrder, list[index - 1].SortOrder) = (list[index - 1].SortOrder, list[index].SortOrder);

        await MediaService.UpdateAsync(list[index]);
        await MediaService.UpdateAsync(list[index - 1]);
        await RefreshMedia();
    }

    async Task MoveMediaRight(Media media)
    {
        await NormalizeSortOrders();

        var list = GetMediaList(MediaType.Screenshot, MediaType.Video);
        var index = list.IndexOf(media);

        if (index < 0 || index >= list.Count - 1)
            return;

        // Swap sort orders
        (list[index].SortOrder, list[index + 1].SortOrder) = (list[index + 1].SortOrder, list[index].SortOrder);

        await MediaService.UpdateAsync(list[index]);
        await MediaService.UpdateAsync(list[index + 1]);
        await RefreshMedia();
    }

    async Task RefreshMedia()
    {
        _media = (await MediaService.Include(m => m.StorageLocation).GetAsync(m => m.GameId == GameId)).ToList();
        await InvokeAsync(StateHasChanged);
    }
}
