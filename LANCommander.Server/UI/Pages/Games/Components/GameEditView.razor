@using Microsoft.EntityFrameworkCore
@inject GameService GameService
@inject GameVersionService GameVersionService
@inject NavigationManager NavigationManager

<SideLayout>
    <Side>
        <Menu>
            <MenuItem Icon="IconType.Info" Href="@(Id == Guid.Empty ? "/Games/Add" : $"/Games/{Id}/General")" Exact>General</MenuItem>

            @if (Id != Guid.Empty)
            {
                <MenuItem Icon="IconType.Eye" Href="@($"/Games/{Id}/Preview")">Preview</MenuItem>
                <MenuItem Icon="IconType.Image" Href="@($"/Games/{Id}/Media")">Media</MenuItem>
                <MenuItem Icon="IconType.Archive" Href="@($"/Games/{Id}/Archives")">Archives</MenuItem>
                <MenuItem Icon="IconType.GitBranch" Href="@($"/Games/{Id}/Versions")">Versions</MenuItem>
                <MenuItem Icon="IconType.Play" Href="@($"/Games/{Id}/Actions")">Actions</MenuItem>
                <MenuItem Icon="IconType.UsersThree" Href="@($"/Games/{Id}/Multiplayer")">Multiplayer</MenuItem>
                <MenuItem Icon="IconType.FloppyDisk" Href="@($"/Games/{Id}/SavePaths")">Save Paths</MenuItem>
                <MenuItem Icon="IconType.Key" Href="@($"/Games/{Id}/Keys")">Keys</MenuItem>
                <MenuItem Icon="IconType.Package" Href="@($"/Games/{Id}/Redistributables")">Redistributables</MenuItem>
                <MenuItem Icon="IconType.SlidersHorizontal" Href="@($"/Games/{Id}/Options")">Options</MenuItem>
                <MenuItem Icon="IconType.Code" Href="@($"/Games/{Id}/Scripts")">Scripts</MenuItem>
                <MenuItem Icon="IconType.ListPlus" Href="@($"/Games/{Id}/CustomFields")">Custom Fields</MenuItem>

                @if (Game.DependentGames?.Any(g => g.Type == GameType.Expansion) == true)
                {
                    <MenuItem Icon="IconType.PuzzlePiece" Href="@($"/Games/{Id}/Expansions")">Expansions</MenuItem>
                }

                @if (Game.DependentGames?.Any(g => g.Type == GameType.Mod) == true)
                {
                    <MenuItem Icon="IconType.Wrench" Href="@($"/Games/{Id}/Mods")">Mods</MenuItem>
                }

                <MenuItem Icon="IconType.Clock" Href="@($"/Games/{Id}/PlaySessions")">Play Sessions</MenuItem>
                <MenuItem Icon="IconType.CloudArrowUp" Href="@($"/Games/{Id}/Saves")">Saves</MenuItem>
            }
        </Menu>
    </Side>

    <ChildContent>
        <PageHeader>
            <TitleTemplate>
                @if (TitleTemplate != null)
                {
                    @TitleTemplate(Game)
                }
                else
                {
                    @Title
                }

                @if (!String.IsNullOrWhiteSpace(_latestVersionNumber))
                {
                    <Tag Primary Class="game-version-tag">@_latestVersionNumber</Tag>
                }
            </TitleTemplate>
            <Extra>
                @TitleExtraTemplate?.Invoke(Game)
            </Extra>
        </PageHeader>

        @* PageContent catches errors, so a failing section leaves the menu and header usable *@
        <PageContent Loading="_loading">
            @if (!_loading && Game.Id == Id)
            {
                <CascadingValue Value="Game.Id" Name="GameId">
                    @ChildContent?.Invoke(Game)
                </CascadingValue>
            }
        </PageContent>
    </ChildContent>
</SideLayout>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment<Game>? TitleTemplate { get; set; }
    [Parameter] public RenderFragment<Game>? TitleExtraTemplate { get; set; }
    [Parameter] public RenderFragment<Game>? ChildContent { get; set; }

    /// <summary>Also loads the game's related records, for sections that edit them.</summary>
    [Parameter] public bool LoadRelationships { get; set; }

    Game Game { get; set; } = new();
    Guid? _id;
    bool _loading = true;
    string _latestVersionNumber = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (_id == Id)
            return;

        _id = Id;
        _loading = true;

        if (Id == Guid.Empty)
        {
            Game = new Game();
        }
        else
        {
            var query = GameService
                .AsSplitQuery()
                .Include(g => g.DependentGames);

            if (LoadRelationships)
                query = query
                    .Include(g => g.Actions)
                    .Include(g => g.BaseGame)
                    .Include(g => g.Categories)
                    .Include(g => g.Collections)
                    .Include(g => g.CreatedBy)
                    .Include(g => g.Developers)
                    .Include(g => g.Engine)
                    .Include(g => g.ExternalIds)
                    .Include(g => g.Genres)
                    .Include(g => g.Media)
                    .Include(g => g.MultiplayerModes)
                    .Include(g => g.Platforms)
                    .Include(g => g.Publishers)
                    .Include(g => g.Redistributables)
                    .Include(g => g.SavePaths)
                    .Include(g => g.Tags)
                    .Include(g => g.UpdatedBy);

            var game = await query.GetAsync(Id);

            if (game == null)
            {
                NavigationManager.NavigateTo("/Games");
                return;
            }

            Game = game;
        }

        await RefreshVersionAsync();

        _loading = false;
    }

    /// <summary>Shows the latest version number again, e.g. after a new version is added.</summary>
    public async Task RefreshVersionAsync()
    {
        _latestVersionNumber = Id != Guid.Empty
            ? await GameVersionService.GetLatestVersionNumberAsync(Id) ?? string.Empty
            : string.Empty;

        await InvokeAsync(StateHasChanged);
    }
}
