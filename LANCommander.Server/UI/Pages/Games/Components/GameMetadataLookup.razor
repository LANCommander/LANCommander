@inject MetadataService MetadataService
@inject DialogService Dialogs

@* A title input with a button that looks the title up with a metadata provider and imports the result *@
<Flex Gap="Gap.Small">
    <TextInput Value="@Value" ValueChanged="ValueChangedAsync" Immediate OnEnter="OpenLookupAsync" AutoFocus="AutoFocus" Style="flex: 1" />
    <Button Primary Icon="IconType.MagnifyingGlass" Disabled="@(String.IsNullOrWhiteSpace(Value) || !_hasProviders)" OnClick="OpenLookupAsync">@ButtonText</Button>
</Flex>

@code {
    [Parameter] public Guid GameId { get; set; }
    [Parameter] public EventCallback<Guid> OnImported { get; set; }
    [Parameter] public string ButtonText { get; set; } = "Lookup";
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    bool _hasProviders;

    protected override void OnInitialized()
    {
        _hasProviders = MetadataService.GetProviderNames().Any();
    }

    async Task ValueChangedAsync(string? value)
    {
        Value = value;

        await ValueChanged.InvokeAsync(value);
    }

    async Task OpenLookupAsync()
    {
        if (String.IsNullOrWhiteSpace(Value) || !_hasProviders)
            return;

        var gameId = await Dialogs.OpenAsync<GameMetadataLookupDialog, GameMetadataLookupOptions, Guid?>("Game Metadata Lookup", new GameMetadataLookupOptions(GameId, Value), new DialogSettings
        {
            Size = DialogSize.ExtraLarge,
            NoFooter = true,
        });

        if (gameId is { } id)
            await OnImported.InvokeAsync(id);
    }
}
