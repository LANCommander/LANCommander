@inject KeyService KeyService
@inject DialogService Dialogs
@inject NotificationService Notifications

@* The CD keys of the game whose Id is cascaded, and who each is allocated to *@
<Flex Vertical Gap="Gap.Medium">
    <Row Class="keys-statistics">
        <Column Span="8"><Statistic Title="Available" Value="@((_keys.Count - _allocatedKeys).ToString())" /></Column>
        <Column Span="8"><Statistic Title="Allocated" Value="@_allocatedKeys.ToString()" /></Column>
        <Column Span="8"><Statistic Title="Total" Value="@_keys.Count.ToString()" /></Column>
    </Row>

    <DataTable @ref="_dataTable" TItem="Key" Small SettingsKey="game-keys" Query="k => k.GameId == GameId">
        <RightToolbar>
            <Button Icon="IconType.PencilSimple" OnClick="EditAsync">Edit</Button>
            <Button Primary OnClick="SaveValuesAsync">Save</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="k => k.Value" Sortable>
                <PasswordInput @bind-Value="context.Value" @bind-Value:after="() => _changed.Add(context)" Small />
            </BoundColumn>
            <BoundColumn Property="k => k.AllocationMethod" Title="Allocation Method" Sortable>
                @context.AllocationMethod?.GetDisplayName()
            </BoundColumn>
            <TemplateColumn TItem="Key" Title="Claimed By" Include="ClaimedByUser">
                @switch (context.AllocationMethod)
                {
                    case KeyAllocationMethod.MacAddress:
                        @context.ClaimedByMacAddress
                        break;

                    case KeyAllocationMethod.UserAccount:
                        @context.ClaimedByUser?.UserName
                        break;
                }
            </TemplateColumn>
            <BoundColumn Property="k => k.ClaimedOn" Title="Claimed" Sortable>
                @if (context.ClaimedOn.HasValue)
                {
                    <LocalTime Value="context.ClaimedOn" Relative />
                }
            </BoundColumn>
            <ActionsColumn TItem="Key">
                <Dropdown>
                    <Overlay>
                        <Menu>
                            @if (!context.IsAllocated())
                            {
                                <MenuItem Icon="IconType.UserPlus" OnClick="() => AssignAsync(context)">Assign</MenuItem>
                            }
                            else
                            {
                                <MenuItem Icon="IconType.UserMinus" OnClick="() => ReleaseAsync(context)">Release</MenuItem>
                            }
                            <MenuItem Icon="IconType.Trash" Danger OnClick="() => RemoveAsync(context)">Remove</MenuItem>
                        </Menu>
                    </Overlay>
                    <ChildContent>
                        <Button Text Icon="IconType.DotsThree" title="More" />
                    </ChildContent>
                </Dropdown>
            </ActionsColumn>
        </Columns>
    </DataTable>
</Flex>

@code {
    [CascadingParameter(Name = "GameId")] public Guid GameId { get; set; }

    ICollection<Key> _keys = new List<Key>();
    readonly HashSet<Key> _changed = new();

    Guid _loadedGameId;
    int _allocatedKeys;

    DataTable<Key>? _dataTable;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedGameId == GameId)
            return;

        _loadedGameId = GameId;

        await LoadKeysAsync();
    }

    async Task LoadKeysAsync()
    {
        _keys = await KeyService.GetAsync(k => k.GameId == GameId);
        _allocatedKeys = _keys.Count(k => k.IsAllocated());
    }

    async Task ReloadAsync()
    {
        _changed.Clear();

        await LoadKeysAsync();

        if (_dataTable != null)
            await _dataTable.ReloadAsync();
    }

    // Keys edited in the table
    async Task SaveValuesAsync()
    {
        try
        {
            foreach (var key in _changed)
                await KeyService.UpdateAsync(key);

            Notifications.Success(_changed.Count == 1 ? "Key updated!" : "Keys updated!");

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not update keys!");
        }
    }

    // Every key at once, one per line
    async Task EditAsync()
    {
        var text = await Dialogs.OpenAsync<KeysEditDialog, string, string>("Edit Keys", String.Join('\n', _keys.Select(k => k.Value)), new DialogSettings
        {
            Size = DialogSize.Large,
            OkText = "Save",
        });

        if (text == null)
            return;

        try
        {
            var keys = text
                .Split('\n')
                .Select(k => k.Trim())
                .Where(k => !String.IsNullOrWhiteSpace(k))
                .Distinct()
                .ToList();

            foreach (var key in _keys.Where(k => !keys.Contains(k.Value)).ToList())
                await KeyService.DeleteAsync(key);

            foreach (var key in keys.Where(k => !_keys.Any(gk => gk.Value == k)))
                await KeyService.AddAsync(new Key { GameId = GameId, Value = key });

            Notifications.Success("Keys updated!");

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not update keys!");
        }
    }

    async Task AssignAsync(Key key)
    {
        if (await Dialogs.OpenAsync<AssignKeyDialog, Guid, bool>("Assign Key", key.Id, new DialogSettings { OkText = "Assign" }))
            await ReloadAsync();
    }

    async Task RemoveAsync(Key key)
    {
        try
        {
            await KeyService.DeleteAsync(key);

            Notifications.Success("Key was removed!");

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The key could not be removed");
        }
    }

    async Task ReleaseAsync(Key key)
    {
        try
        {
            await KeyService.ReleaseAsync(key);

            Notifications.Success("Key was unallocated!");

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The key could not be released");
        }
    }
}
