@using System.Net.Mime
@using LANCommander.Server.Services.Abstractions
@using LANCommander.Server.Services.Models
@using LANCommander.Server.Settings
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@inject MediaService MediaService
@inject GameService GameService
@inject IMediaGrabberService MediaGrabberService
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject IOptions<Settings> Settings

@* The art, videos and manuals of the game whose Id is cascaded: upload, grab from the web, retype or delete them *@
<Flex Vertical Gap="Gap.Large" Class="media-editor">
    <Spin Loading="_game == null">
        <Table TItem="Media" Items="_media" Key="m => m.Id" Selectable @bind-Values="_selected" NoPaging EmptyText="No media yet" SettingsKey="game-media">
            <RightToolbar>
                @if (_selected.Any())
                {
                    <Typography Secondary>@_selected.Count selected</Typography>
                }
                <Popconfirm Disabled="!_selected.Any()" OnConfirm="DeleteSelectedAsync" Title="Are you sure you want to delete all selected media?" OkText="Delete" Danger>
                    <Button Danger Icon="IconType.Trash" Disabled="!_selected.Any()">Delete</Button>
                </Popconfirm>
            </RightToolbar>
            <Columns>
                <TemplateColumn TItem="Media" Title="Preview" Width="130px">
                    @if (MediaService.FileExists(context))
                    {
                        var originalPath = $"/api/Media/{context.Id}/Download?fileId={context.FileId}";
                        var thumbnailPath = context.Thumbnail != null
                            ? $"/api/Media/{context.Thumbnail.Id}/Download?fileId={context.Thumbnail.FileId}"
                            : $"/api/Media/{context.Id}/Thumbnail?fileId={context.FileId}";

                        if (context.Type == MediaType.Manual)
                        {
                            <button type="button" class="media-editor-manual" title="Read manual" @onclick="() => OpenManualAsync(context)">
                                <Image Src="@thumbnailPath" Width="100" Alt="@context.Name" />
                            </button>
                        }
                        else if (context.Type == MediaType.Video)
                        {
                            <video width="100" src="@originalPath" class="media-editor-video" controls></video>
                        }
                        else
                        {
                            <Image Src="@thumbnailPath" PreviewSrc="@originalPath" Width="100" Alt="@context.Type.ToString()" />
                        }
                    }
                </TemplateColumn>
                <TemplateColumn TItem="Media" Title="Type" Width="180px">
                    <EnumSelect TEnum="MediaType" @bind-Value="context.Type" @bind-Value:after="() => UpdateAsync(context)" Only="AllowedMediaTypes" />
                </TemplateColumn>
                <TemplateColumn TItem="Media" Title="Name">
                    @if (context.Type == MediaType.Manual)
                    {
                        <TextInput @bind-Value="context.Name" @bind-Value:after="() => UpdateAsync(context)" />
                    }
                </TemplateColumn>
                <ActionsColumn TItem="Media" Width="150px">
                    <InputFile id="@($"media-upload-{context.Id}")" OnChange="e => UploadAsync(e, context)" hidden accept="@GetAcceptedExtensions(context)" />
                    <label for="@($"media-upload-{context.Id}")" class="media-editor-upload" title="Upload">
                        <Icon Type="IconType.UploadSimple" />
                    </label>

                    @if (String.IsNullOrWhiteSpace(Settings.Value.Server.Media.SteamGridDbApiKey)
                         && context.Type != MediaType.Video
                         && context.Type != MediaType.Screenshot)
                    {
                        <Popconfirm OnConfirm="NavigateToSettings" Title="Invalid SteamGridDB credentials. Setup now?" OkText="Setup">
                            <Button Text Icon="IconType.MagnifyingGlass" title="Search" />
                        </Popconfirm>
                    }
                    else
                    {
                        <Button Text Icon="IconType.MagnifyingGlass" title="Search" OnClick="() => SearchAsync(context)" />
                    }

                    <Popconfirm OnConfirm="() => RemoveAsync(context)" Title="Are you sure you want to delete this media?" OkText="Delete" Danger>
                        <Button Text Danger Icon="IconType.X" title="Delete" />
                    </Popconfirm>
                </ActionsColumn>
            </Columns>
        </Table>
    </Spin>

    <Flex Justify="Justify.End">
        <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Media</Button>
    </Flex>
</Flex>

@code {
    [CascadingParameter(Name = "GameId")] public Guid GameId { get; set; }

    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    IList<Media> _selected = new List<Media>();

    static readonly MediaType[] AllowedMediaTypes =
    [
        MediaType.Icon,
        MediaType.Cover,
        MediaType.Background,
        MediaType.Grid,
        MediaType.Logo,
        MediaType.Manual,
        MediaType.Screenshot,
        MediaType.Video,
    ];

    static readonly string[] ValidMimeTypes =
    [
        MediaTypeNames.Image.Png,
        MediaTypeNames.Image.Jpeg,
        MediaTypeNames.Image.Gif,
        MediaTypeNames.Image.Webp,
        MediaTypeNames.Application.Pdf,
        MediaTypeNames.Image.Icon,
        "video/mp4",
        "video/webm",
        "video/x-matroska",
    ];

    const string AcceptedExtensions = ".jpg,.jpeg,.png,.gif,.webp,.pdf,.ico,.mp4,.webm,.mkv";

    static string GetAcceptedExtensions(Media media) =>
        media.Type == MediaType.Icon ? $"{AcceptedExtensions},.exe" : AcceptedExtensions;

    static bool IsExecutable(IBrowserFile file) =>
        Path.GetExtension(file.Name).Equals(".exe", StringComparison.OrdinalIgnoreCase);

    // Replaced rather than changed in place, so the table notices additions and removals
    List<Media> _media = new();
    Game? _game;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _game = await GameService
                .Query(q => q.Include(g => g.Media).ThenInclude(m => m.StorageLocation))
                .GetAsync(GameId);

            _media = _game.Media.ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The game's media could not be loaded");
        }
    }

    async Task ReloadAsync() =>
        _media = (await MediaService.GetAsync(m => m.GameId == GameId)).ToList();

    async Task UpdateAsync(Media media)
    {
        if (media.Id == Guid.Empty)
            return;

        try
        {
            await MediaService.UpdateAsync(media);

            Notifications.Success($"{media.Type} updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"{media.Type} could not be updated.");
        }
    }

    async Task AddAsync()
    {
        try
        {
            var nextType = Enum.GetValues<MediaType>().FirstOrDefault(t => !_media.Any(m => m.Type == t) && AllowedMediaTypes.Contains(t));

            var media = await MediaService.AddAsync(new Media
            {
                GameId = GameId,
                Type = nextType == MediaType.Icon && _media.Any(m => m.Type == MediaType.Icon) ? MediaType.Manual : nextType,
                StorageLocation = await MediaService.GetDefaultStorageLocationAsync(),
                Crc32 = String.Empty,
            });

            _media = [.. _media, media];
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not add new media!");
        }
    }

    async Task SearchAsync(Media media)
    {
        var downloadResult = await Dialogs.OpenAsync<MediaGrabberDialog, MediaGrabberOptions, MediaGrabberDownloadResult>($"Download {media.Type}", new MediaGrabberOptions
        {
            Type = media.Type,
            Search = _game?.Title ?? "",
        }, new DialogSettings
        {
            Size = DialogSize.Full,
            OkText = "Select",
        });

        if (downloadResult?.Download == null)
            return;

        try
        {
            using var download = downloadResult.Download;

            media.SourceUrl = downloadResult.Result.SourceUrl;
            media.MimeType = download.MimeType;

            if (media.Id != Guid.Empty)
                MediaService.DeleteLocalMediaFile(media);

            await MediaService.WriteToFileAsync(media, download.Stream);

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The download could not be saved");
        }
    }

    async Task UploadAsync(InputFileChangeEventArgs e, Media media)
    {
        if (IsExecutable(e.File))
        {
            await UploadIconFromExecutableAsync(e.File, media);
            return;
        }

        if (!ValidMimeTypes.Contains(e.File.ContentType))
        {
            Notifications.Error("Unsupported file type", e.File.ContentType);
            return;
        }

        var config = Settings.Value.Server.Media.GetMediaTypeConfig(media.Type);

        if (e.File.Size > config.MaxFileSize)
        {
            Notifications.Error($"File size must be smaller than {ByteSizeLib.ByteSize.FromBytes(config.MaxFileSize)}");
            return;
        }

        try
        {
            media.SourceUrl = "";
            media.MimeType = e.File.ContentType;

            if (media.Id == Guid.Empty)
            {
                media = await MediaService.WriteToFileAsync(media, e.File.OpenReadStream(maxAllowedSize: config.MaxFileSize));

                await MediaService.AddAsync(media);
            }
            else
            {
                MediaService.DeleteLocalMediaFile(media);

                media = await MediaService.WriteToFileAsync(media, e.File.OpenReadStream(maxAllowedSize: config.MaxFileSize));

                await MediaService.UpdateAsync(media);
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The file could not be uploaded");
        }
    }

    async Task UploadIconFromExecutableAsync(IBrowserFile file, Media media)
    {
        if (media.Type != MediaType.Icon)
        {
            Notifications.Error("Executables can only be used as a source for icons");
            return;
        }

        if (file.Size > MediaService.MaxIconSourceExecutableSize)
        {
            Notifications.Error($"File size must be smaller than {ByteSizeLib.ByteSize.FromBytes(MediaService.MaxIconSourceExecutableSize).ToBinaryString()}");
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: MediaService.MaxIconSourceExecutableSize);

            await MediaService.WriteIconFromExecutableAsync(media, stream);

            Notifications.Success($"Extracted icon from {file.Name}");

            await ReloadAsync();
        }
        catch (InvalidDataException ex)
        {
            Notifications.Error(ex, ex.Message);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not extract an icon from the executable");
        }
    }

    async Task DeleteSelectedAsync()
    {
        if (!_selected.Any())
            return;

        try
        {
            await MediaService.DeleteRangeAsync(_selected);

            _media = _media.Except(_selected).ToList();
            _selected = new List<Media>();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The selected media could not be deleted");
        }
    }

    async Task RemoveAsync(Media media)
    {
        try
        {
            if (media.Id != Guid.Empty)
                await MediaService.DeleteAsync(media);

            _media = _media.Where(m => m != media).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The media could not be deleted");
        }
    }

    Task OpenManualAsync(Media media) =>
        Dialogs.OpenAsync<PdfReaderDialog, Media, bool>(media.Name ?? "Manual", media, new DialogSettings
        {
            Size = DialogSize.Full,
            NoFooter = true,
        });

    void NavigateToSettings() => NavigationManager.NavigateTo("/Settings/Integrations/SteamGridDB");
}
