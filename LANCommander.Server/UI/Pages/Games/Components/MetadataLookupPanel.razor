@using LANCommander.Server.ImportExport.Factories
@using LANCommander.Server.Services.Providers.Metadata
@using ManifestGame = LANCommander.SDK.Models.Manifest.Game
@inject MetadataService MetadataService
@inject GameService GameService
@inject ImportContextFactory ImportContextFactory
@inject NotificationService Notifications
@inject ILogger<MetadataLookupPanel> Logger

@*
    Searches a metadata provider for a game, then lets the user choose which of the fetched fields
    to import over the game's own (or to create a new game when GameId is empty).
*@
<Spin Loading="_importing" Tip="@_importStatus">
    <Flex Gap="Gap.Small" Style="margin-bottom: 12px">
        <TextInput @bind-Value="Search" Immediate OnEnter="() => SearchForGameAsync(Search)" AutoFocus="AutoFocus" Icon="IconType.MagnifyingGlass" Style="flex: 1" />
        <Button Primary Loading="_loading && _stage == Stage.Search" Disabled="@(String.IsNullOrWhiteSpace(Search) || !_availableProviders.Any())" OnClick="() => SearchForGameAsync(Search)">Search</Button>
    </Flex>

    @if (_stage == Stage.Search)
    {
        @if (_errorMessage != null)
        {
            <Result Danger Title="Search Failed" SubTitle="@_errorMessage">
                <Button OnClick="() => _errorMessage = null">Dismiss</Button>
            </Result>
        }
        else if (_hasSearched)
        {
            <Spin Loading="_loading">
                <Table TItem="MetadataSearchResult<ManifestGame>"
                       Items="_resultRows"
                       Key="r => r.Id"
                       NoPaging
                       Small
                       EmptyText="No games were found"
                       SettingsKey="metadata-lookup-results"
                       OnRowClick="BeginMergeAsync">
                    <Columns>
                        <TemplateColumn TItem="MetadataSearchResult<ManifestGame>" Title="Title">
                            <Typography Strong>@context.Data.Title</Typography>
                        </TemplateColumn>
                        <TemplateColumn TItem="MetadataSearchResult<ManifestGame>" Title="Released" Width="110px">
                            @(context.Data.ReleasedOn != default ? context.Data.ReleasedOn.ToString("MM/dd/yyyy") : "—")
                        </TemplateColumn>
                        <TemplateColumn TItem="MetadataSearchResult<ManifestGame>" Title="Platforms">
                            @string.Join(", ", context.Data.Platforms?.Select(p => p.Name) ?? [])
                        </TemplateColumn>
                        <TemplateColumn TItem="MetadataSearchResult<ManifestGame>" Title="Developers">
                            @string.Join(", ", context.Data.Developers?.Select(d => d.Name) ?? [])
                        </TemplateColumn>
                    </Columns>
                </Table>
            </Spin>

            @if (_results?.More ?? false)
            {
                <Button Block Primary Style="margin-top: 8px" OnClick="ShowMoreAsync">Show More</Button>
            }
        }

        <Flex Gap="Gap.Small" Justify="Justify.End" Style="margin-top: 12px">
            <Select TValue="string" Items="_providerItems" Value="_selectedProvider" ValueChanged="OnProviderChangedAsync" Style="min-width: 160px" />
            @if (_subProviderItems.Any())
            {
                <Select TValue="string" Items="_subProviderItems" Value="_selectedSubProvider" ValueChanged="OnSubProviderChangedAsync" Style="min-width: 160px" />
            }
            @if (ShowCancel)
            {
                <Button OnClick="CancelAsync">Cancel</Button>
            }
        </Flex>

        @ChildContent
    }
    else
    {
        @if (_errorMessage != null)
        {
            <Result Danger Title="Import Failed" SubTitle="@_errorMessage">
                <Button OnClick="() => _errorMessage = null">Dismiss</Button>
            </Result>
        }
        else
        {
            <Table TItem="MergeField" Items="_mergeFields" Key="f => f.Name" NoPaging Small SettingsKey="metadata-lookup-merge">
                <Columns>
                    <TemplateColumn TItem="MergeField" Title="Import" Width="80px">
                        <Checkbox @bind-Value="context.Import" aria-label="@($"Import {context.Name}")" />
                    </TemplateColumn>
                    <TemplateColumn TItem="MergeField" Title="Field" Width="160px">
                        @context.Name
                    </TemplateColumn>
                    <TemplateColumn TItem="MergeField" Title="Value">
                        <div class="metadata-merge-value">@context.Value</div>
                    </TemplateColumn>
                </Columns>
            </Table>
        }

        <Flex Gap="Gap.Small" Justify="Justify.End" Style="margin-top: 12px">
            <Button Primary Loading="_loading" OnClick="ImportWithMergeAsync">Import</Button>
            <Button Disabled="_loading" OnClick="BackToSearch">Back</Button>
            @if (ShowCancel)
            {
                <Button Disabled="_loading" OnClick="CancelAsync">Cancel</Button>
            }
        </Flex>
    }
</Spin>

@code {
    enum Stage { Search, Merge }

    /// <summary>One field of the fetched metadata, and whether to take it.</summary>
    sealed class MergeField(string name, bool import, RenderFragment value)
    {
        public string Name { get; } = name;

        public bool Import { get; set; } = import;

        public RenderFragment Value { get; } = value;
    }

    [Parameter] public Guid GameId { get; set; }
    [Parameter] public EventCallback<Guid> OnImported { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool AutoFocus { get; set; }
    [Parameter] public bool ShowCancel { get; set; } = true;
    [Parameter] public string? Search { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    MetadataSearchResultsCollection<ManifestGame>? _results;
    List<MetadataSearchResult<ManifestGame>> _resultRows = new();
    IReadOnlyCollection<SDK.Models.Manifest.GameExternalId> _externalIds = [];

    bool _loading;
    bool _hasSearched;
    int _limit = 10;
    int _offset;

    string _selectedProvider = string.Empty;
    IEnumerable<string> _availableProviders = [];
    IEnumerable<SelectItem<string>> _providerItems = [];

    string? _selectedSubProvider;
    IEnumerable<SelectItem<string>> _subProviderItems = [];

    Stage _stage = Stage.Search;
    string? _errorMessage;
    ManifestGame? _fetchedManifest;
    List<MergeField> _mergeFields = new();

    bool _importing;
    string _importStatus = "Importing...";

    protected override async Task OnInitializedAsync()
    {
        _availableProviders = MetadataService.GetProviderNames().ToList();
        _providerItems = _availableProviders.ToSelectItems(p => p, p => p).ToList();
        _selectedProvider = _availableProviders.FirstOrDefault() ?? string.Empty;

        if (GameId != Guid.Empty)
        {
            try
            {
                _externalIds = (await GameService.GetManifestAsync(GameId))?.ExternalIds?.ToList() ?? [];
            }
            catch (Exception ex)
            {
                // Seeding from a store ID is a convenience on top of the title search, so it must
                // never stop the panel from opening.
                Logger.LogWarning(ex, "Could not read external IDs for game {GameId}", GameId);
            }
        }

        await UpdateSubProvidersAsync();
    }

    async Task OnProviderChangedAsync(string? provider)
    {
        _selectedProvider = provider ?? string.Empty;
        _errorMessage = null;

        await UpdateSubProvidersAsync();

        if (!string.IsNullOrWhiteSpace(Search))
            await SearchForGameAsync(Search);
    }

    async Task OnSubProviderChangedAsync(string? subProvider)
    {
        _selectedSubProvider = subProvider;
        _errorMessage = null;

        if (!string.IsNullOrWhiteSpace(Search))
            await SearchForGameAsync(Search);
    }

    async Task UpdateSubProvidersAsync()
    {
        var provider = MetadataService.GetProvider(_selectedProvider);
        var subProviders = provider is null ? null : await provider.GetSubProvidersAsync();

        _subProviderItems = subProviders?.Select(sp => new SelectItem<string>(sp.Slug, sp.Name)).ToList() ?? [];
        _selectedSubProvider = subProviders?.FirstOrDefault().Slug;
    }

    async Task SearchForGameAsync(string? title, bool newSearch = true)
    {
        if (string.IsNullOrWhiteSpace(title))
            return;

        var provider = MetadataService.GetProvider(_selectedProvider);

        if (provider is null)
        {
            Notifications.Error($"Provider \"{_selectedProvider}\" is not available");
            return;
        }

        try
        {
            _loading = true;
            _hasSearched = true;
            _errorMessage = null;

            if (newSearch)
            {
                _results = null;
                _offset = 0;
            }

            _results = _subProviderItems.Any()
                ? await provider.SearchGamesAsync(title, _selectedSubProvider, _limit, _offset)
                : await provider.SearchGamesAsync(title, _limit, _offset);

            if (newSearch)
                await SeedFromExternalIdsAsync(provider);

            _resultRows = _results?.Results.ToList() ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred searching {Provider}", _selectedProvider);

            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// When the game already carries an ID from another store, ask the provider to resolve it
    /// directly and float that result to the top. A store ID is an exact match, where matching on
    /// title is a guess.
    /// </summary>
    async Task SeedFromExternalIdsAsync(IMetadataProvider provider)
    {
        foreach (var externalId in _externalIds)
        {
            if (string.IsNullOrWhiteSpace(externalId.Provider) || string.IsNullOrWhiteSpace(externalId.ExternalId))
                continue;

            var resolved = await provider.ResolveByExternalIdAsync(externalId.Provider, externalId.ExternalId);

            if (resolved is null)
                continue;

            var results = _results?.Results.ToList() ?? [];
            var existingIndex = results.FindIndex(r => r.Id == resolved.Id);

            // Prefer the search result if the page is already there; it carries the release date
            // and developers that the ID lookup doesn't return.
            if (existingIndex >= 0)
            {
                resolved = results[existingIndex];
                results.RemoveAt(existingIndex);
            }

            results.Insert(0, resolved);

            _results = new MetadataSearchResultsCollection<ManifestGame>(results, _results?.More ?? false, _limit, _offset);

            return;
        }
    }

    async Task BeginMergeAsync(MetadataSearchResult<ManifestGame> selected)
    {
        var provider = MetadataService.GetProvider(_selectedProvider);

        if (provider is null)
            return;

        _loading = true;
        _errorMessage = null;

        try
        {
            var manifest = await provider.GetGameAsync(selected.Id);

            if (manifest is null)
            {
                _errorMessage = "Could not retrieve game metadata from the provider.";
                return;
            }

            _fetchedManifest = manifest;
            _mergeFields = MergeFields(manifest);
            _stage = Stage.Merge;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred fetching metadata from {Provider}", _selectedProvider);

            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    static RenderFragment Tags(IEnumerable<string>? names) => __builder =>
    {
        foreach (var name in names ?? [])
        {
            <Tag>@name</Tag>
        }
    };

    // Fields with nothing to import start unchecked, so they don't blank the game's own values
    static List<MergeField> MergeFields(ManifestGame manifest) =>
    [
        new("Title", true, @<text>@manifest.Title</text>),
        new("Description", !string.IsNullOrWhiteSpace(manifest.Description), @<span class="metadata-merge-truncate">@manifest.Description</span>),
        new("Released On", manifest.ReleasedOn != default, @<text>@manifest.ReleasedOn.ToString("MM/dd/yyyy")</text>),
        new("Singleplayer", true, @<text>@(manifest.Singleplayer ? "Yes" : "No")</text>),
        new("Engine", manifest.Engine != null, @<text>@(manifest.Engine?.Name ?? "—")</text>),
        new("Developers", manifest.Developers?.Any() == true, Tags(manifest.Developers?.Select(d => d.Name))),
        new("Publishers", manifest.Publishers?.Any() == true, Tags(manifest.Publishers?.Select(p => p.Name))),
        new("Genres", manifest.Genres?.Any() == true, Tags(manifest.Genres?.Select(g => g.Name))),
        new("Tags", manifest.Tags?.Any() == true, Tags(manifest.Tags?.Select(t => t.Name))),
        new("Multiplayer Modes", manifest.MultiplayerModes?.Any() == true, @<text>@(manifest.MultiplayerModes?.Count ?? 0) mode(s)</text>),
        new("Save Paths", manifest.SavePaths?.Any() == true, @<text>@(manifest.SavePaths?.Count ?? 0) path(s)</text>),
        new("External IDs", manifest.ExternalIds?.Any() == true, Tags(manifest.ExternalIds?.Select(e => $"{e.Provider}: {e.ExternalId}"))),
    ];

    bool Importing(string field) => _mergeFields.FirstOrDefault(f => f.Name == field)?.Import ?? false;

    async Task ImportWithMergeAsync()
    {
        if (_fetchedManifest is null)
            return;

        _loading = true;
        _importing = true;
        _importStatus = "Importing...";
        _errorMessage = null;

        try
        {
            ManifestGame? existing = GameId != Guid.Empty ? await GameService.GetManifestAsync(GameId) : null;

            var manifest = _fetchedManifest;
            manifest.Id = GameId == Guid.Empty ? Guid.NewGuid() : GameId;

            if (!Importing("Title") && existing != null)
                manifest.Title = existing.Title;

            if (!Importing("Description") && existing != null)
                manifest.Description = existing.Description;

            if (!Importing("Released On") && existing != null)
                manifest.ReleasedOn = existing.ReleasedOn;

            if (!Importing("Singleplayer") && existing != null)
                manifest.Singleplayer = existing.Singleplayer;

            if (!Importing("Engine"))
                manifest.Engine = existing?.Engine;

            if (!Importing("Developers"))
                manifest.Developers = existing?.Developers ?? new List<SDK.Models.Manifest.Company>();

            if (!Importing("Publishers"))
                manifest.Publishers = existing?.Publishers ?? new List<SDK.Models.Manifest.Company>();

            if (!Importing("Genres"))
                manifest.Genres = existing?.Genres ?? new List<SDK.Models.Manifest.Genre>();

            if (!Importing("Tags"))
                manifest.Tags = existing?.Tags ?? new List<SDK.Models.Manifest.Tag>();

            if (!Importing("Multiplayer Modes"))
                manifest.MultiplayerModes = existing?.MultiplayerModes ?? new List<SDK.Models.Manifest.MultiplayerMode>();

            if (!Importing("Save Paths"))
                manifest.SavePaths = existing?.SavePaths ?? new List<SDK.Models.Manifest.SavePath>();

            if (!Importing("External IDs"))
                manifest.ExternalIds = existing?.ExternalIds ?? new List<SDK.Models.Manifest.GameExternalId>();

            using (var context = ImportContextFactory.Create())
            {
                await context.InitializeMetadataUpdateAsync(manifest);
                await context.ImportQueueAsync();
            }

            await OnImported.InvokeAsync(manifest.Id);

            Reset();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "An error occurred importing metadata from {Provider}", _selectedProvider);

            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
            _importing = false;
        }
    }

    /// <summary>Shows progress over the panel, e.g. while art is downloaded after an import.</summary>
    public async Task UpdateStatusAsync(string status)
    {
        _importing = true;
        _importStatus = status;

        await InvokeAsync(StateHasChanged);
    }

    void BackToSearch()
    {
        _stage = Stage.Search;
        _errorMessage = null;
        _fetchedManifest = null;
    }

    void Reset()
    {
        _results = null;
        _resultRows = new();
        _offset = 0;
        _hasSearched = false;
        _stage = Stage.Search;
        _errorMessage = null;
        _fetchedManifest = null;
    }

    async Task CancelAsync()
    {
        Reset();

        await OnCancel.InvokeAsync();
    }

    async Task ShowMoreAsync()
    {
        _offset += _results?.Limit ?? _limit;

        await SearchForGameAsync(Search, false);
    }
}
