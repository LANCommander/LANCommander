@inject MultiplayerModeService MultiplayerModeService
@inject NotificationService Notifications

@* The ways the game whose Id is cascaded can be played together *@
<Flex Vertical Gap="Gap.Large">
    <Table TItem="MultiplayerMode" Items="_multiplayerModes" Key="m => m" NoPaging EmptyText="No multiplayer modes" SettingsKey="game-multiplayer-modes">
        <Columns>
            <TemplateColumn TItem="MultiplayerMode" Title="Type">
                <EnumSelect TEnum="MultiplayerType" @bind-Value="context.Type" />
            </TemplateColumn>
            <TemplateColumn TItem="MultiplayerMode" Title="Min Players" Width="130px">
                <NumberInput @bind-Value="context.MinPlayers" Min="2" />
            </TemplateColumn>
            <TemplateColumn TItem="MultiplayerMode" Title="Max Players" Width="130px">
                <NumberInput @bind-Value="context.MaxPlayers" Min="2" />
            </TemplateColumn>
            <TemplateColumn TItem="MultiplayerMode" Title="Protocol">
                <EnumSelect TEnum="NetworkProtocol" @bind-Value="context.NetworkProtocol" />
            </TemplateColumn>
            <TemplateColumn TItem="MultiplayerMode" Title="Description">
                <TextInput @bind-Value="context.Description" />
            </TemplateColumn>
            <ActionsColumn TItem="MultiplayerMode" Width="64px">
                <Button Text Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveAsync(context)" />
            </ActionsColumn>
        </Columns>
    </Table>

    <Flex Justify="Justify.End">
        <Button Primary Icon="IconType.Plus" OnClick="Add">Add Mode</Button>
    </Flex>
</Flex>

@code {
    [CascadingParameter(Name = "GameId")] public Guid GameId { get; set; }

    // Replaced rather than changed in place, so the table notices additions and removals
    List<MultiplayerMode> _multiplayerModes = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync() =>
        _multiplayerModes = (await MultiplayerModeService.GetAsync(mm => mm.GameId == GameId)).ToList();

    void Add() => _multiplayerModes = [.. _multiplayerModes, new MultiplayerMode { GameId = GameId, MinPlayers = 2, MaxPlayers = 2 }];

    async Task RemoveAsync(MultiplayerMode mode)
    {
        try
        {
            if (mode.Id != Guid.Empty)
                await MultiplayerModeService.DeleteAsync(mode);

            _multiplayerModes = _multiplayerModes.Where(m => m != mode).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The multiplayer mode could not be removed");
        }
    }

    public async Task Save()
    {
        try
        {
            foreach (var mode in _multiplayerModes)
            {
                if (mode.Id == Guid.Empty)
                    await MultiplayerModeService.AddAsync(mode);
                else
                    await MultiplayerModeService.UpdateAsync(mode);
            }

            Notifications.Success("Multiplayer modes updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save multiplayer modes!");
        }

        await LoadAsync();
    }
}
