@using LANCommander.Server.Models
@inject SavePathService SavePathService
@inject ArchiveService ArchiveService
@inject GameVersionService GameVersionService
@inject DialogService Dialogs
@inject NotificationService Notifications

@* Where the game whose Id is cascaded keeps its saves, so they can be backed up and restored *@
<Flex Vertical Gap="Gap.Large">
    <Table TItem="SavePath" Items="_savePaths" Key="p => p" NoPaging EmptyText="No save paths" SettingsKey="game-save-paths">
        <Columns>
            <TemplateColumn TItem="SavePath" Title="Type" Width="130px">
                <EnumSelect TEnum="SavePathType" @bind-Value="context.Type" />
            </TemplateColumn>
            <TemplateColumn TItem="SavePath" Title="Path">
                @if (context.Type == SavePathType.Registry)
                {
                    <InputRegistry @bind-Value="context.Path" />
                }
                else
                {
                    <Flex Gap="Gap.Small" Align="Align.Center">
                        <FilePicker @bind-Value="context.Path" ArchiveId="@(_archive?.Id ?? Guid.Empty)" Title="Select Save Path" />
                        <Button Text Small Icon="IconType.BracketsCurly" title="Insert variables" OnClick="() => PickVariablesAsync(context, nameof(SavePath.Path))" />
                    </Flex>
                }
            </TemplateColumn>
            <TemplateColumn TItem="SavePath" Title="Working Directory">
                <Flex Gap="Gap.Small" Align="Align.Center">
                    <FilePicker @bind-Value="context.WorkingDirectory" Disabled="@(context.Type == SavePathType.Registry)" ArchiveId="@(_archive?.Id ?? Guid.Empty)" Title="Select Working Directory" />
                    <Button Text Small Icon="IconType.BracketsCurly" title="Insert variables" Disabled="@(context.Type == SavePathType.Registry)" OnClick="() => PickVariablesAsync(context, nameof(SavePath.WorkingDirectory))" />
                </Flex>
            </TemplateColumn>
            <TemplateColumn TItem="SavePath" Title="Regex" Width="80px">
                <Checkbox @bind-Value="context.IsRegex" Disabled="@(context.Type == SavePathType.Registry)" aria-label="Regex" />
            </TemplateColumn>
            <TemplateColumn TItem="SavePath" Title="Platforms" Width="160px">
                <RuntimePlatformSelect @bind-Value="context.Platforms" Style="width: 100%" />
            </TemplateColumn>
            <ActionsColumn TItem="SavePath" Width="64px">
                <Button Text Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveAsync(context)" />
            </ActionsColumn>
        </Columns>
    </Table>

    <Flex Justify="Justify.End">
        <Button Primary Icon="IconType.Plus" OnClick="Add">Add Path</Button>
    </Flex>
</Flex>

@code {
    [CascadingParameter(Name = "GameId")] public Guid GameId { get; set; }

    Archive? _archive;

    // Replaced rather than changed in place, so the table notices additions and removals
    List<SavePath> _savePaths = new();

    // Save paths belong to the game's latest version rather than the game itself
    Guid? _gameVersionId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (GameId != Guid.Empty)
                _gameVersionId = await GameVersionService.GetOrCreateLatestIdAsync(GameId);

            _archive = await ArchiveService.GetLatestArchiveAsync(a => a.GameId == GameId);

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The save paths could not be loaded");
        }
    }

    async Task LoadAsync() =>
        _savePaths = (await SavePathService.GetAsync(p => p.GameVersionId == _gameVersionId)).ToList();

    void Add() => _savePaths = [.. _savePaths, new SavePath { GameId = GameId, WorkingDirectory = "{InstallDir}" }];

    async Task RemoveAsync(SavePath path)
    {
        try
        {
            // Unsaved paths only need dropping from the list
            if (path.Id != Guid.Empty)
                await SavePathService.DeleteAsync(path);

            _savePaths = _savePaths.Where(p => p != path).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The save path could not be removed");
        }
    }

    async Task PickVariablesAsync(SavePath savePath, string fieldName)
    {
        var current = fieldName == nameof(SavePath.Path) ? savePath.Path : savePath.WorkingDirectory;

        var result = await Dialogs.OpenAsync<VariablePickerDialog, VariablePickerOptions, string>($"Edit {fieldName}", new VariablePickerOptions
        {
            Value = current ?? "",
            FieldName = fieldName,
        }, new DialogSettings { OkText = "Apply" });

        if (result == null)
            return;

        if (fieldName == nameof(SavePath.Path))
            savePath.Path = result;
        else
            savePath.WorkingDirectory = result;
    }

    public async Task Save()
    {
        try
        {
            foreach (var savePath in _savePaths)
            {
                if (savePath.Id == Guid.Empty)
                    await SavePathService.AddAsync(savePath);
                else
                    await SavePathService.UpdateAsync(savePath);
            }

            Notifications.Success("Save paths updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not update save paths!");
        }

        await LoadAsync();
    }
}
