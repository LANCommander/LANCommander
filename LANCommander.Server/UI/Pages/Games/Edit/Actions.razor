@page "/Games/{id:guid}/Actions"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<GameEditView Id="Id" Title="Actions" Versioned>
    <TitleExtraTemplate>
        <Button Primary OnClick="() => _actionEditor?.Save() ?? Task.CompletedTask">Save</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <ActionEditor @ref="_actionEditor" />
    </ChildContent>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    ActionEditor? _actionEditor;
}
