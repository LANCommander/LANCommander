@page "/Games/{id:guid}/General"
@page "/Games/{id:guid}"
@page "/Games/Add"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@using LANCommander.Server.Models
@using PSC.Blazor.Components.MarkdownEditor
@inject CollectionService CollectionService
@inject CompanyService CompanyService
@inject EngineService EngineService
@inject GameService GameService
@inject GenreService GenreService
@inject PlatformService PlatformService
@inject TagService TagService
@inject NotificationService Notifications
@inject DialogService Dialogs
@inject NavigationManager NavigationManager

<GameEditView @ref="_view" Id="Id" LoadRelationships OnLoaded="OnGameLoaded" ContentClass="game-general-content">
    <TitleExtraTemplate>
        @if (IsDirty(context))
        {
            <span class="game-edit-unsaved" role="status">
                <span class="game-edit-unsaved-dot" aria-hidden="true"></span>
                Unsaved changes
            </span>
        }

        @if (context.Id != Guid.Empty)
        {
            <Button Text Icon="IconType.Export" OnClick="() => OpenExportDialogAsync(context)">Export</Button>
        }

        <Button Disabled="@(!IsDirty(context) || _saving)" OnClick="DiscardAsync">Discard</Button>
        <Button Primary Loading="_saving" OnClick="() => SaveAsync(context)">Save</Button>
    </TitleExtraTemplate>

    <ChildContent>
        @* As drawn: the fields the launcher shows first, in pairs; then the depot switches; then the rest in the same style *@
        <Form @ref="_form" Model="context" OnSubmit="() => SaveAsync(context)" Class="game-general-form">
            <div class="game-form-pair">
                <FormItem Label="Title" Required>
                    <GameMetadataLookup ButtonText="Lookup"
                                        AutoFocus="context.Id == Guid.Empty"
                                        @bind-Value="context.Title"
                                        GameId="@context.Id"
                                        OnImported="OnGameImported" />
                </FormItem>
                <FormItem Label="Sort title" Help="Used for ordering in the launcher when it differs from the display title.">
                    <TextInput @bind-Value="context.SortTitle" />
                </FormItem>
            </div>
            <div class="game-form-pair">
                <FormItem Label="Released on">
                    <DatePicker TValue="DateTime?" @bind-Value="context.ReleasedOn" Format="yyyy-MM-dd" Clearable Class="game-general-date" />
                </FormItem>
                <FormItem Label="Type">
                    <EnumSelect TEnum="GameType" @bind-Value="context.Type" />
                </FormItem>
            </div>
            @if (context.Type != GameType.MainGame)
            {
                <FormItem Label="Base game" Required>
                    <Flex Gap="Gap.Small">
                        <Select TValue="Guid?"
                                Items="BaseGameItems(context)"
                                @bind-Value="context.BaseGameId"
                                Placeholder="Select a game"
                                Searchable
                                Style="flex: 1" />

                        <Button Icon="IconType.PencilSimple"
                                Disabled="@(context.BaseGameId == null || context.BaseGameId == Guid.Empty)"
                                Href="@($"/Games/{context.BaseGameId}")"
                                NewTab>
                            Edit
                        </Button>
                    </Flex>
                </FormItem>
            }
            @* Description is Markdown, which the launcher renders: a plain field by default, the editor on demand *@
            <FormItem Label="Description">
                <ChildContent>
                    @if (_descriptionEditor)
                    {
                        <MarkdownEditor @bind-Value="context.Description" SpellChecker="false" MinHeight="300px" />
                    }
                    else
                    {
                        <TextArea @bind-Value="context.Description" Immediate Class="game-general-description" />
                    }
                </ChildContent>
                <HelpTemplate>
                    Written in Markdown.
                    <button type="button" class="game-general-link" @onclick="() => _descriptionEditor = !_descriptionEditor">
                        @(_descriptionEditor ? "Use the plain field" : "Open the Markdown editor")
                    </button>
                </HelpTemplate>
            </FormItem>
            <div class="game-form-pair">
                <FormItem Label="Developers">
                    <TaxonomyInput DataService="CompanyService" @bind-Values="context.Developers" Placeholder="Add a developer…" />
                </FormItem>
                <FormItem Label="Publishers">
                    <TaxonomyInput DataService="CompanyService" @bind-Values="context.Publishers" Placeholder="Add a publisher…" />
                </FormItem>
            </div>

            <Divider Class="game-general-divider" />

            <Switch @bind-Value="context.Published" Class="game-general-switch">
                <span class="game-general-switch-title">Show in depot</span>
                <span class="game-general-switch-help">Players can install this title from the launcher.</span>
            </Switch>
            <Switch @bind-Value="context.Singleplayer" Class="game-general-switch">
                <span class="game-general-switch-title">Singleplayer</span>
                <span class="game-general-switch-help">Lists single-player as a way to play; the launcher can filter by it.</span>
            </Switch>

            <Divider Class="game-general-divider" />

            <div class="game-form-pair">
                <FormItem Label="Engine">
                    <Select TValue="Guid?" Items="EngineItems" @bind-Value="context.EngineId" Placeholder="Select an engine" Searchable Clearable />
                </FormItem>
                <FormItem Label="Key allocation method">
                    <EnumSelect TEnum="KeyAllocationMethod" @bind-Value="context.KeyAllocationMethod" />
                </FormItem>
            </div>
            <div class="game-form-pair">
                <FormItem Label="Platforms">
                    <TaxonomyInput DataService="PlatformService" @bind-Values="context.Platforms" Placeholder="Add a platform…" />
                </FormItem>
                <FormItem Label="Genres">
                    <TaxonomyInput DataService="GenreService" @bind-Values="context.Genres" Placeholder="Add a genre…" />
                </FormItem>
            </div>
            <div class="game-form-pair">
                <FormItem Label="Tags">
                    <TaxonomyInput DataService="TagService" @bind-Values="context.Tags" Placeholder="Add a tag…" />
                </FormItem>
                <FormItem Label="Collections">
                    <TaxonomyInput DataService="CollectionService" @bind-Values="context.Collections" Placeholder="Add to a collection…" />
                </FormItem>
            </div>
            <FormItem Label="Notes">
                <MarkdownEditor @bind-Value="context.Notes" SpellChecker="false" MinHeight="200px" />
            </FormItem>
            <FormItem Label="External IDs">
                <Flex Vertical Gap="Gap.Small">
                    @foreach (var externalId in context.ExternalIds?.ToList() ?? [])
                    {
                        <Flex Gap="Gap.Small" @key="externalId">
                            <TextInput @bind-Value="externalId.Provider" Placeholder="Provider (e.g. Steam, GOG, IGDB)" Style="width: 220px" />
                            <TextInput @bind-Value="externalId.ExternalId" Placeholder="ID" Style="flex: 1" />
                            <Button Text Danger Icon="IconType.X" title="Remove" OnClick="() => context.ExternalIds?.Remove(externalId)" />
                        </Flex>
                    }
                    <Flex Justify="Justify.End">
                        <Button Small Icon="IconType.Plus" OnClick="() => AddExternalId(context)">Add</Button>
                    </Flex>
                </Flex>
            </FormItem>
        </Form>
    </ChildContent>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    bool _loaded;
    bool _saving;
    bool _descriptionEditor;

    GameEditView? _view;

    /// <summary>The fields as loaded or last saved; the header's "Unsaved changes" compares against it.</summary>
    GameEditSnapshot? _saved;

    IEnumerable<SelectItem<Guid?>> EngineItems = [];
    IEnumerable<Game> Games = new List<Game>();

    Form? _form;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
            return;

        var allowedTypes = new List<GameType> { GameType.MainGame, GameType.StandaloneExpansion, GameType.StandaloneMod };

        var engines = await EngineService.SortBy(e => e.Name).GetAsync();

        EngineItems = engines.ToSelectItems(e => (Guid?)e.Id, e => e.Name).ToList();

        Games = (await GameService
                .Include(g => g.Media.Where(m => m.Type == MediaType.Icon))
                .GetAsync(g => allowedTypes.Contains(g.Type)))
            .OrderByTitle(g => String.IsNullOrWhiteSpace(g.SortTitle) ? g.Title : g.SortTitle)
            .ToList();

        _loaded = true;
    }

    void OnGameLoaded(Game game)
    {
        _saved = GameEditSnapshot.Of(game);
        _form?.MarkAsUnmodified();
    }

    bool IsDirty(Game game) => _saved != null && GameEditSnapshot.Of(game) != _saved;

    async Task DiscardAsync()
    {
        _saved = null;

        if (_view != null)
            await _view.ReloadAsync();
    }

    IEnumerable<SelectItem<Guid?>> BaseGameItems(Game game) =>
        Games.Where(g => g.Id != game.Id).ToSelectItems(g => (Guid?)g.Id, g => g.Title, image: GetIcon);

    static string? GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : null;
    }

    async Task SaveAsync(Game game)
    {
        if (_form?.Validate() == false)
        {
            Notifications.Error("Could not save! Check fields and try again");
            return;
        }

        _saving = true;

        try
        {
            if (game.Id != Guid.Empty)
            {
                // The model writes BaseGameId; the referenced game is loaded again on update
                game.BaseGame = null;

                await GameService.UpdateAsync(game);

                _saved = GameEditSnapshot.Of(game);
                _form?.MarkAsUnmodified();

                Notifications.Success("Game updated!");
            }
            else
            {
                game = await GameService.AddAsync(game);

                Notifications.Success("Game added!");

                NavigationManager.NavigateTo($"/Games/{game.Id}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save game!");
        }
        finally
        {
            _saving = false;
        }
    }

    void OnGameImported(Guid gameId) => NavigationManager.NavigateTo($"/Games/{gameId}", true);

    static void AddExternalId(Game game)
    {
        game.ExternalIds ??= new List<GameExternalId>();
        game.ExternalIds.Add(new GameExternalId());
    }

    Task OpenExportDialogAsync(Game game) =>
        Dialogs.OpenAsync<ExportDialog, ExportDialogOptions, bool>($"Export {game.Title}", new ExportDialogOptions
        {
            RecordId = game.Id,
            RecordType = ImportExportRecordType.Game,
        }, new DialogSettings { OkText = "Export" });
}
