@page "/Games/{id:guid}/Mods"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject GameService GameService
@inject NotificationService Notifications

<GameEditView Id="Id" Title="Mods" Context="game">
    <DataTable TItem="Game" @ref="_table" Small SettingsKey="game-mods" Query="g => g.BaseGameId == Id && g.Type == GameType.Mod">
        <Columns>
            <BoundColumn Property="g => g.Title" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="g => g.SortTitle" Title="Sort Title" Sortable />
            <BoundColumn Property="g => g.ReleasedOn" Title="Released On" Sortable FormatString="MM/dd/yyyy" />
            <BoundColumn Property="g => g.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="g => g.CreatedBy != null ? g.CreatedBy.UserName : String.Empty" Title="Created By" Include="CreatedBy" Sortable />
            <BoundColumn Property="g => g.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="g => g.UpdatedBy != null ? g.UpdatedBy.UserName : String.Empty" Title="Updated By" Include="UpdatedBy" Sortable />
            <ActionsColumn TItem="Game">
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Games/{context.Id}")" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this mod?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    DataTable<Game>? _table;

    async Task DeleteAsync(Game game)
    {
        try
        {
            await GameService.DeleteAsync(game);

            Notifications.Success($"Deleted {game.Title}");

            if (_table != null)
                await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete the mod!");
        }
    }
}
