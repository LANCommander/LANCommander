@page "/Games/{id:guid}/Options"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<GameEditView Id="Id" Title="Options" Versioned>
    <TitleExtraTemplate>
        <Button Primary OnClick="() => _editor?.SaveAsync() ?? Task.CompletedTask">Save</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <GameOptionSchemaEditor @ref="_editor" />
    </ChildContent>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    GameOptionSchemaEditor? _editor;
}
