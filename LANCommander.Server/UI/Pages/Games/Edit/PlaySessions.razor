@page "/Games/{id:guid}/PlaySessions"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject PlaySessionService PlaySessionService
@inject NotificationService Notifications

<GameEditView Id="Id" Title="Play Sessions" Context="game">
    <DataTable TItem="PlaySession" @ref="_table" Small SettingsKey="game-play-sessions" Query="ps => ps.GameId == Id">
        <Columns>
            <BoundColumn Property="ps => ps.Start" Sortable>
                <LocalTime Value="context.Start" />
            </BoundColumn>
            <BoundColumn Property="ps => ps.End" Sortable DefaultSort="ColumnSort.Descending">
                <LocalTime Value="context.End" />
            </BoundColumn>
            <BoundColumn Property="ps => ps.Duration" Sortable>
                @if (context.Duration is { } duration)
                {
                    @($"{(int)duration.TotalHours}:{duration.Minutes:D2}:{duration.Seconds:D2}")
                }
            </BoundColumn>
            <BoundColumn Property="ps => ps.User != null ? ps.User.UserName : String.Empty" Title="User" Include="User" Sortable />
            <ActionsColumn TItem="PlaySession">
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this session?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    DataTable<PlaySession>? _table;

    async Task DeleteAsync(PlaySession session)
    {
        try
        {
            await PlaySessionService.DeleteAsync(session);

            Notifications.Success("Session deleted");

            if (_table != null)
                await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete the play session!");
        }
    }
}
