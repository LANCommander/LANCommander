@page "/Games/{id:guid}/SavePaths"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<GameEditView Id="Id" Title="Save Paths">
    <TitleExtraTemplate>
        <Button Primary OnClick="() => _savePathEditor?.Save() ?? Task.CompletedTask">Save</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <SavePathEditor @ref="_savePathEditor" />
    </ChildContent>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    SavePathEditor? _savePathEditor;
}
