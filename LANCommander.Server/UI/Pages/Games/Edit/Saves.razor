@page "/Games/{id:guid}/Saves"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject GameSaveService GameSaveService
@inject NotificationService Notifications

<GameEditView Id="Id" Title="Saves" Context="game">
    <DataTable TItem="GameSave" @ref="_table" Small SettingsKey="game-saves" Query="gs => gs.GameId == Id">
        <Columns>
            <BoundColumn Property="gs => gs.User != null ? gs.User.UserName : String.Empty" Title="User" Include="User" Sortable />
            <BoundColumn Property="gs => gs.CreatedOn" Title="Created On" Sortable DefaultSort="ColumnSort.Descending">
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="gs => gs.Size" Sortable>
                <ByteSize Value="context.Size" />
            </BoundColumn>
            <ActionsColumn TItem="GameSave">
                <Button Text Icon="IconType.DownloadSimple" Href="@($"/Download/Save/{context.Id}")" NewTab title="Download" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this game save?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    DataTable<GameSave>? _table;

    async Task DeleteAsync(GameSave gameSave)
    {
        try
        {
            await GameSaveService.DeleteAsync(gameSave);

            Notifications.Success("Game save deleted");

            if (_table != null)
                await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete the game save!");
        }
    }
}
