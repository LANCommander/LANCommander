@page "/Games/{id:guid}/Versions"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<GameEditView @ref="_view" Id="Id" Title="Versions">
    <TitleExtraTemplate>
        <Button Primary Icon="IconType.Plus" OnClick="() => _editor?.OpenCreateVersion() ?? Task.CompletedTask">New Version</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <VersionEditor @ref="_editor" OnVersionCreated="OnVersionCreatedAsync" />
    </ChildContent>
</GameEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    GameEditView? _view;
    VersionEditor? _editor;

    async Task OnVersionCreatedAsync()
    {
        if (_view != null)
            await _view.RefreshVersionAsync();
    }
}
