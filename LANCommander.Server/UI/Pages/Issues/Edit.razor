@page "/Issues/{id:guid}"
@page "/Issues/Add"
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject GameService GameService
@inject IssueService IssueService
@inject IssueAttachmentService IssueAttachmentService
@inject UserService UserService
@inject NotificationService Notifications
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageHeader Title="@(Id == Guid.Empty ? "Add New Issue" : "Edit Issue")">
    <Extra>
        @if (Id != Guid.Empty)
        {
            <Button Icon="IconType.PushPin" OnClick="TogglePinnedAsync" Loading="_pinning"
                    title="Pinned issues are listed first on the game's Issues tab in the launcher">@(_issue.IsPinned ? "Unpin" : "Pin")</Button>
            <Button Icon="IconType.CheckCircle" OnClick="ResolveAsync" Disabled="IsResolved" Loading="_resolving">Resolve</Button>
        }
        <Button Primary Icon="IconType.FloppyDisk" OnClick="SaveAsync" Disabled="IsResolved" Loading="_saving">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="_loading">
    @if (_issue.ResolvedOn != null)
    {
        <Alert Success>
            This issue was resolved on <LocalTime Value="_issue.ResolvedOn" /> by @_issue.ResolvedBy?.UserName
            and was reported by @_issue.CreatedBy?.UserName on <LocalTime Value="_issue.CreatedOn" />.
        </Alert>
    }
    else if (Id != Guid.Empty)
    {
        <Alert Info>This issue was reported by @_issue.CreatedBy?.UserName on <LocalTime Value="_issue.CreatedOn" />.</Alert>
    }

    <Form Model="_issue" Disabled="IsResolved" OnSubmit="SaveAsync">
        <FormItem Label="Game" Required>
            <Flex Gap="Gap.Medium">
                <Select @bind-Value="_issue.GameId" Items="_games" Searchable Placeholder="Select a Game" Style="flex: 1" />
                <Button Primary Href="@($"/Games/{_issue.GameId}")" NewTab Disabled="@(_issue.GameId == Guid.Empty)">Edit</Button>
            </Flex>
        </FormItem>
        <FormItem Label="Title">
            <TextInput @bind-Value="_issue.Title" MaxLength="128" AutoFocus />
        </FormItem>
        <FormItem Label="Description">
            <TextArea @bind-Value="_issue.Description" Counter Rows="20" />
        </FormItem>
    </Form>

    @if (_issue.Attachments?.Any() == true)
    {
        <FormItem Label="Attachments">
            <Flex Vertical Gap="Gap.Small">
                @foreach (var attachment in _issue.Attachments.OrderBy(a => a.CreatedOn))
                {
                    var url = $"/api/Issue/Attachments/{attachment.Id}/Download";

                    <Flex Gap="Gap.Small" Align="Align.Center">
                        <Icon Type="@(SDK.Helpers.IssueAttachmentRules.IsImage(attachment.FileName) ? IconType.Image : IconType.Paperclip)" />
                        <a href="@url" target="_blank" rel="noopener">@attachment.FileName</a>
                        <span style="opacity: 0.6"><ByteSize Value="attachment.Size" /></span>
                        <Popconfirm OnConfirm="() => DeleteAttachmentAsync(attachment)" Title="Delete this attachment?" OkText="Delete" Danger>
                            <Button Text Danger Icon="IconType.X" title="Delete attachment" />
                        </Popconfirm>
                    </Flex>

                    @if (SDK.Helpers.IssueAttachmentRules.IsImage(attachment.FileName))
                    {
                        <a href="@url" target="_blank" rel="noopener">
                            <img src="@url" alt="@attachment.FileName" style="max-width: 480px; max-height: 270px; border-radius: 4px;" />
                        </a>
                    }
                }
            </Flex>
        </FormItem>
    }
</PageContent>

@code {
    [Parameter] public Guid Id { get; set; }

    Issue _issue = new();
    IEnumerable<SelectItem<Guid>> _games = [];
    bool _loading = true;
    bool _saving;
    bool _resolving;
    bool _pinning;

    bool IsResolved => _issue.ResolvedOn != null;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;

        try
        {
            if (Id != Guid.Empty)
                _issue = await IssueService
                    .Include(i => i.Game, i => i.CreatedBy, i => i.UpdatedBy, i => i.ResolvedBy, i => i.Attachments!)
                    .GetAsync(Id);

            var games = await GameService.Include(g => g.Media.Where(m => m.Type == SDK.Enums.MediaType.Icon)).GetAsync();

            _games = games
                .OrderBy(g => String.IsNullOrWhiteSpace(g.SortTitle) ? g.Title : g.SortTitle)
                .ToSelectItems(g => g.Id, g => g.Title, image: GetIcon)
                .ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not load the issue!");
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (_issue.Id != Guid.Empty)
            {
                _issue = await IssueService.UpdateAsync(_issue);

                Notifications.Success("Issue updated!");
            }
            else
            {
                _issue = await IssueService.AddAsync(_issue);

                Notifications.Success("Issue added!");

                NavigationManager.NavigateTo($"/Issues/{_issue.Id}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save issue!");
        }
        finally
        {
            _saving = false;
        }
    }

    async Task ResolveAsync()
    {
        _resolving = true;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = await UserService.GetAsync(authState.User.Identity!.Name!);

            await IssueService.ResolveAsync(_issue.Id, user.Id);

            Notifications.Success("Issue resolved!");

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not resolve issue!");
        }
        finally
        {
            _resolving = false;
        }
    }

    // Attachments can hold anything a user's machine logged, so admins can remove them on their own
    async Task DeleteAttachmentAsync(IssueAttachment attachment)
    {
        try
        {
            await IssueAttachmentService.DeleteAsync(attachment);

            _issue.Attachments = _issue.Attachments?.Where(a => a.Id != attachment.Id).ToList();

            Notifications.Success("Attachment deleted!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete the attachment!");
        }
    }

    // Pinning works on resolved issues too, so it saves just the flag rather than the whole form
    async Task TogglePinnedAsync()
    {
        _pinning = true;

        try
        {
            var pinned = !_issue.IsPinned;

            await IssueService.SetPinnedAsync(_issue.Id, pinned);

            _issue.IsPinned = pinned;

            Notifications.Success(pinned ? "Issue pinned!" : "Issue unpinned!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not change the issue's pin!");
        }
        finally
        {
            _pinning = false;
        }
    }

    static string GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == SDK.Enums.MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : "/favicon.ico";
    }
}
