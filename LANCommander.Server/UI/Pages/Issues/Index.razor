@page "/Issues"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject IssueService IssueService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications

<PageHeader Title="Issues" />

<PageContent>
    <DataTable TItem="Issue"
               @ref="_table"
               Small
               SearchProperty="i => i.Game.Title"
               OnRowDoubleClick="@(issue => NavigationManager.NavigateTo($"/Issues/{issue.Id}"))">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" Href="/Issues/Add">Add Issue</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="i => i.Game.Title" Title="Game" Include="Game" Sortable />
            <BoundColumn Property="i => i.CreatedOn" Title="Opened" Sortable DefaultSort="ColumnSort.Descending">
                <LocalTime Value="context.CreatedOn" Relative />
            </BoundColumn>
            <BoundColumn Property="i => i.CreatedBy != null ? i.CreatedBy.UserName : String.Empty" Title="Created By" Include="CreatedBy" Sortable />
            <BoundColumn Property="i => i.ResolvedOn" Title="Resolved" Sortable>
                <LocalTime Value="context.ResolvedOn" />
            </BoundColumn>
            <BoundColumn Property="i => i.ResolvedBy != null ? i.ResolvedBy.UserName : String.Empty" Title="Resolved By" Include="ResolvedBy" Sortable />
            <BoundColumn Property="i => i.ResolvedOn != null" Title="Status" Sortable>
                @if (context.ResolvedOn == null)
                {
                    <Badge Info>Open</Badge>
                }
                else
                {
                    <Badge Success>Resolved</Badge>
                }
            </BoundColumn>
            <ActionsColumn TItem="Issue">
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Issues/{context.Id}")" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this issue?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Issue> _table = default!;

    async Task DeleteAsync(Issue issue)
    {
        try
        {
            await IssueService.DeleteAsync(issue);

            Notifications.Success("Issue was successfully deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete issue!");
        }
    }
}
