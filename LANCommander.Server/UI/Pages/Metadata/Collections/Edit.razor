@page "/Metadata/Collections/{id:guid}"
@page "/Metadata/Collections/Add"
@using Microsoft.EntityFrameworkCore
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject CollectionService CollectionService
@inject NotificationService Notifications
@inject NavigationManager NavigationManager

<PageHeader>
    <TitleTemplate>
        <TextInput Large @bind-Value="_collection.Name" Placeholder="Collection name" />
    </TitleTemplate>
    <Extra>
        <Button Primary Icon="IconType.FloppyDisk" Loading="_saving" OnClick="SaveAsync">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="_loading">
    <Table TItem="Game" Items="_collection.Games" NoPaging EmptyText="No games in this collection" SettingsKey="collection-games">
        <Columns>
            <TemplateColumn TItem="Game" Title="Icon" Width="64px">
                <Image Src="@GetIcon(context)" Width="32" Height="32" />
            </TemplateColumn>
            <BoundColumn Property="g => g.Title" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="g => g.ReleasedOn" Title="Released On" FormatString="MM/dd/yyyy" Sortable />
            <BoundColumn Property="g => g.Singleplayer" Sortable>
                <Checkbox Value="context.Singleplayer" Disabled />
            </BoundColumn>
            <TemplateColumn TItem="Game" Title="Multiplayer">
                <Checkbox Value="context.MultiplayerModes?.Count > 0" Disabled />
            </TemplateColumn>
            <TemplateColumn TItem="Game" Title="Developers">
                @foreach (var developer in context.Developers ?? [])
                {
                    <Tag>@developer.Name</Tag>
                }
            </TemplateColumn>
            <TemplateColumn TItem="Game" Title="Publishers">
                @foreach (var publisher in context.Publishers ?? [])
                {
                    <Tag>@publisher.Name</Tag>
                }
            </TemplateColumn>
            <TemplateColumn TItem="Game" Title="Genres">
                @foreach (var genre in context.Genres ?? [])
                {
                    <Tag>@genre.Name</Tag>
                }
            </TemplateColumn>
            <TemplateColumn TItem="Game" Title="Multiplayer Modes">
                @foreach (var mode in context.MultiplayerModes?.Select(mm => mm.Type).Distinct() ?? [])
                {
                    <Tag>@mode.GetDisplayName()</Tag>
                }
            </TemplateColumn>
            <ActionsColumn TItem="Game">
                <Popconfirm OnConfirm="() => RemoveGameAsync(context)" Title="Are you sure you want to remove this game from the collection?" OkText="Remove" Danger>
                    <Button Text Danger Icon="IconType.X" title="Remove from collection" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </Table>
</PageContent>

@code {
    [Parameter] public Guid Id { get; set; }

    Collection _collection = new() { Games = [] };
    bool _loading = true;
    bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (Id != Guid.Empty)
                _collection = await CollectionService
                    .Query(q => q
                        .Include(c => c.Games).ThenInclude(g => g.Media)
                        .Include(c => c.Games).ThenInclude(g => g.Developers)
                        .Include(c => c.Games).ThenInclude(g => g.Publishers)
                        .Include(c => c.Games).ThenInclude(g => g.Genres)
                        .Include(c => c.Games).ThenInclude(g => g.MultiplayerModes))
                    .AsSplitQuery()
                    .GetAsync(Id);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not load the collection!");
        }
        finally
        {
            _loading = false;
        }
    }

    async Task SaveAsync()
    {
        _saving = true;

        try
        {
            if (_collection.Id != Guid.Empty)
            {
                _collection = await CollectionService.UpdateAsync(_collection);

                Notifications.Success("Collection updated!");
            }
            else
            {
                _collection = await CollectionService.AddAsync(_collection);

                Notifications.Success("Collection added!");

                NavigationManager.NavigateTo($"/Metadata/Collections/{_collection.Id}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save!");
        }
        finally
        {
            _saving = false;
        }
    }

    async Task RemoveGameAsync(Game game)
    {
        try
        {
            _collection.Games.Remove(game);

            await CollectionService.UpdateAsync(_collection);

            // New list instance so the table shows the change
            _collection.Games = _collection.Games.ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Game could not be removed from the collection!");
        }
    }

    static string GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == SDK.Enums.MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : "/favicon.ico";
    }
}
