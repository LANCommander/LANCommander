@page "/Metadata/Collections"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject CollectionService CollectionService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@inject AlertService Alerts

<PageHeader Title="Collections" />

<PageContent>
    <DataTable TItem="Collection"
               @ref="_table"
               Small
               SearchProperty="c => c.Name"
               OnRowDoubleClick="@(collection => NavigationManager.NavigateTo($"/Metadata/Collections/{collection.Id}"))">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Collection</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="c => c.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="c => c.Games.Count" Title="Games" Sortable Include="Games" />
            <BoundColumn Property="c => c.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="c => c.CreatedBy != null ? c.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="c => c.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="c => c.UpdatedBy != null ? c.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Collection">
                <Button Text Icon="IconType.PencilSimple" OnClick="@(() => NavigationManager.NavigateTo($"/Metadata/Collections/{context.Id}"))" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this collection?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Collection> _table = default!;

    async Task AddAsync()
    {
        var name = await Alerts.PromptAsync("New Collection", "Name", okText: "Add");

        if (name == null)
            return;

        try
        {
            await CollectionService.AddMissingAsync(x => x.Name == name, new Collection { Name = name });

            Notifications.Success($"{name} was added!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not add {name}!");
        }
    }

    async Task DeleteAsync(Collection collection)
    {
        try
        {
            await CollectionService.DeleteAsync(collection);

            Notifications.Success("Collection deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete collection!");
        }
    }
}
