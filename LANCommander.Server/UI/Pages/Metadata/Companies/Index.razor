@page "/Metadata/Companies"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject CompanyService CompanyService
@inject NotificationService Notifications
@inject AlertService Alerts

<PageHeader Title="Companies" />

<PageContent>
    <DataTable TItem="Company"
               @ref="_table"
               Small
               SearchProperty="c => c.Name"
               OnRowDoubleClick="EditAsync">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Company</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="c => c.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="c => c.DevelopedGames.Count" Title="Developed Games" Sortable Include="DevelopedGames" />
            <BoundColumn Property="c => c.PublishedGames.Count" Title="Published Games" Sortable Include="PublishedGames" />
            <BoundColumn Property="c => c.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="c => c.CreatedBy != null ? c.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="c => c.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="c => c.UpdatedBy != null ? c.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Company">
                <Button Text Icon="IconType.PencilSimple" OnClick="() => EditAsync(context)" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this company?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Company> _table = default!;

    async Task AddAsync()
    {
        var name = await Alerts.PromptAsync("New Company", "Name", okText: "Add");

        if (name == null)
            return;

        try
        {
            await CompanyService.AddMissingAsync(x => x.Name == name, new Company { Name = name });

            Notifications.Success($"{name} was added!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not add {name}!");
        }
    }

    async Task EditAsync(Company company)
    {
        var name = await Alerts.PromptAsync("Edit Company", "Name", company.Name, okText: "Save");

        if (name == null || name == company.Name)
            return;

        try
        {
            var existing = await CompanyService.GetAsync(company.Id);

            existing.Name = name;

            await CompanyService.UpdateAsync(existing);

            Notifications.Success($"{name} was updated!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not update {name}!");
        }
    }

    async Task DeleteAsync(Company company)
    {
        try
        {
            await CompanyService.DeleteAsync(company);

            Notifications.Success("Company deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete company!");
        }
    }
}
