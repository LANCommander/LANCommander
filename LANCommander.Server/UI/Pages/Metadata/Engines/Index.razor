@page "/Metadata/Engines"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject EngineService EngineService
@inject NotificationService Notifications
@inject AlertService Alerts

<PageHeader Title="Engines" />

<PageContent>
    <DataTable TItem="Engine"
               @ref="_table"
               Small
               SearchProperty="e => e.Name"
               OnRowDoubleClick="EditAsync">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Engine</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="e => e.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="e => e.Games.Count" Title="Games" Sortable Include="Games" />
            <BoundColumn Property="e => e.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="e => e.CreatedBy != null ? e.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="e => e.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="e => e.UpdatedBy != null ? e.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Engine">
                <Button Text Icon="IconType.PencilSimple" OnClick="() => EditAsync(context)" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this engine?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Engine> _table = default!;

    async Task AddAsync()
    {
        var name = await Alerts.PromptAsync("New Engine", "Name", okText: "Add");

        if (name == null)
            return;

        try
        {
            await EngineService.AddMissingAsync(x => x.Name == name, new Engine { Name = name });

            Notifications.Success($"{name} was added!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not add {name}!");
        }
    }

    async Task EditAsync(Engine engine)
    {
        var name = await Alerts.PromptAsync("Edit Engine", "Name", engine.Name, okText: "Save");

        if (name == null || name == engine.Name)
            return;

        try
        {
            var existing = await EngineService.GetAsync(engine.Id);

            existing.Name = name;

            await EngineService.UpdateAsync(existing);

            Notifications.Success($"{name} was updated!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not update {name}!");
        }
    }

    async Task DeleteAsync(Engine engine)
    {
        try
        {
            await EngineService.DeleteAsync(engine);

            Notifications.Success("Engine deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete engine!");
        }
    }
}
