@page "/Metadata/Genres"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject GenreService GenreService
@inject NotificationService Notifications
@inject AlertService Alerts

<PageHeader Title="Genres" />

<PageContent>
    <DataTable TItem="Genre"
               @ref="_table"
               Small
               SearchProperty="g => g.Name"
               OnRowDoubleClick="EditAsync">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Genre</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="g => g.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="g => g.Games.Count" Title="Games" Sortable Include="Games" />
            <BoundColumn Property="g => g.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="g => g.CreatedBy != null ? g.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="g => g.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="g => g.UpdatedBy != null ? g.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Genre">
                <Button Text Icon="IconType.PencilSimple" OnClick="() => EditAsync(context)" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this genre?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Genre> _table = default!;

    async Task AddAsync()
    {
        var name = await Alerts.PromptAsync("New Genre", "Name", okText: "Add");

        if (name == null)
            return;

        try
        {
            await GenreService.AddMissingAsync(x => x.Name == name, new Genre { Name = name });

            Notifications.Success($"{name} was added!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not add {name}!");
        }
    }

    async Task EditAsync(Genre genre)
    {
        var name = await Alerts.PromptAsync("Edit Genre", "Name", genre.Name, okText: "Save");

        if (name == null || name == genre.Name)
            return;

        try
        {
            var existing = await GenreService.GetAsync(genre.Id);

            existing.Name = name;

            await GenreService.UpdateAsync(existing);

            Notifications.Success($"{name} was updated!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not update {name}!");
        }
    }

    async Task DeleteAsync(Genre genre)
    {
        try
        {
            await GenreService.DeleteAsync(genre);

            Notifications.Success("Genre deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete genre!");
        }
    }
}
