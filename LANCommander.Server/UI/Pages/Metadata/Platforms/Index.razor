@page "/Metadata/Platforms"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject PlatformService PlatformService
@inject NotificationService Notifications
@inject AlertService Alerts

<PageHeader Title="Platforms" />

<PageContent>
    <DataTable TItem="Platform"
               @ref="_table"
               Small
               SearchProperty="p => p.Name"
               OnRowDoubleClick="EditAsync">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Platform</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="p => p.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="p => p.Games.Count" Title="Games" Sortable Include="Games" />
            <BoundColumn Property="p => p.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="p => p.CreatedBy != null ? p.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="p => p.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="p => p.UpdatedBy != null ? p.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Platform">
                <Button Text Icon="IconType.PencilSimple" OnClick="() => EditAsync(context)" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this platform?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Platform> _table = default!;

    async Task AddAsync()
    {
        var name = await Alerts.PromptAsync("New Platform", "Name", okText: "Add");

        if (name == null)
            return;

        try
        {
            await PlatformService.AddMissingAsync(x => x.Name == name, new Platform { Name = name });

            Notifications.Success($"{name} was added!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not add {name}!");
        }
    }

    async Task EditAsync(Platform platform)
    {
        var name = await Alerts.PromptAsync("Edit Platform", "Name", platform.Name, okText: "Save");

        if (name == null || name == platform.Name)
            return;

        try
        {
            var existing = await PlatformService.GetAsync(platform.Id);

            existing.Name = name;

            await PlatformService.UpdateAsync(existing);

            Notifications.Success($"{name} was updated!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not update {name}!");
        }
    }

    async Task DeleteAsync(Platform platform)
    {
        try
        {
            await PlatformService.DeleteAsync(platform);

            Notifications.Success("Platform deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete platform!");
        }
    }
}
