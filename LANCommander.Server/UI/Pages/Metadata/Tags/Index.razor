@page "/Metadata/Tags"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject TagService TagService
@inject NotificationService Notifications
@inject AlertService Alerts

<PageHeader Title="Tags" />

<PageContent>
    <DataTable TItem="Data.Models.Tag"
               @ref="_table"
               Small
               SearchProperty="t => t.Name"
               OnRowDoubleClick="EditAsync">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="AddAsync">Add Tag</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="t => t.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="t => t.Games.Count" Title="Games" Sortable Include="Games" />
            <BoundColumn Property="t => t.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="t => t.CreatedBy != null ? t.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="t => t.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="t => t.UpdatedBy != null ? t.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Data.Models.Tag">
                <Button Text Icon="IconType.PencilSimple" OnClick="() => EditAsync(context)" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this tag?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Data.Models.Tag> _table = default!;

    async Task AddAsync()
    {
        var name = await Alerts.PromptAsync("New Tag", "Name", okText: "Add");

        if (name == null)
            return;

        try
        {
            await TagService.AddMissingAsync(x => x.Name == name, new Data.Models.Tag { Name = name });

            Notifications.Success($"{name} was added!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not add {name}!");
        }
    }

    async Task EditAsync(Data.Models.Tag tag)
    {
        var name = await Alerts.PromptAsync("Edit Tag", "Name", tag.Name, okText: "Save");

        if (name == null || name == tag.Name)
            return;

        try
        {
            var existing = await TagService.GetAsync(tag.Id);

            existing.Name = name;

            await TagService.UpdateAsync(existing);

            Notifications.Success($"{name} was updated!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not update {name}!");
        }
    }

    async Task DeleteAsync(Data.Models.Tag tag)
    {
        try
        {
            await TagService.DeleteAsync(tag);

            Notifications.Success("Tag deleted!");

            await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete tag!");
        }
    }
}
