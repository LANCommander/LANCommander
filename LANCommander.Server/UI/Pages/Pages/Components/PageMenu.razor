@using LANCommander.Server.Services.Models
@inject PageService PageService
@inject NavigationManager NavigationManager

<AsyncContent T="IReadOnlyList<PageMenuNode>" Load="PageService.GetMenuAsync" Context="nodes">
    <Tree TItem="PageMenuNode"
          Items="nodes"
          Children="n => n.Children"
          Key="n => n.Route"
          Text="n => n.Title"
          Value="@Find(nodes, CurrentRoute)"
          ValueChanged="NavigateAsync"
          ExpandAll
          Class="page-nav-tree" />
</AsyncContent>

@code {
    [Parameter] public string? CurrentRoute { get; set; }

    static PageMenuNode? Find(IEnumerable<PageMenuNode> nodes, string? route)
    {
        if (string.IsNullOrEmpty(route))
            return null;

        foreach (var node in nodes)
        {
            if (string.Equals(node.Route, route, StringComparison.OrdinalIgnoreCase))
                return node;

            if (node.Children != null && Find(node.Children, route) is { } match)
                return match;
        }

        return null;
    }

    Task NavigateAsync(PageMenuNode? node)
    {
        if (string.IsNullOrEmpty(node?.Route))
            return Task.CompletedTask;

        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');

        if (!string.Equals(currentPath, node.Route.Trim('/'), StringComparison.OrdinalIgnoreCase))
            NavigationManager.NavigateTo($"/{node.Route}");

        return Task.CompletedTask;
    }
}
