@inject PageService PageService

<Flex Gap="Gap.Small" Align="Align.Center">
    @if (!_editing)
    {
        <a href="/@FullRoute" target="_blank">@ParentRoute<strong>@Page.Slug</strong></a>
        <Button Small Icon="IconType.PencilSimple" OnClick="() => _editing = true">Edit</Button>
    }
    else
    {
        <TextInput Small @bind-Value="Page.Slug" Prefix="@ParentRoute" OnEnter="SaveAsync" AutoFocus />
        <Button Small Primary OnClick="SaveAsync">Save</Button>
    }
</Flex>

@code {
    [Parameter, EditorRequired] public Page Page { get; set; } = default!;

    [Parameter] public EventCallback<Page> PageChanged { get; set; }

    bool _editing;

    string ParentRoute => "/" + (Page.Parent?.Route ?? "Pages") + "/";

    string FullRoute => (Page.Parent?.Route ?? "Pages") + "/" + Page.Slug;

    async Task SaveAsync()
    {
        Page.Slug = (Page.Slug ?? "").ToRouteSlug();
        Page.Route = PageService.RenderRoute(Page);

        await PageChanged.InvokeAsync(Page);

        _editing = false;
    }
}
