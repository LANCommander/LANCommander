@page "/Pages/Edit"
@page "/Pages/Edit/{id:guid}"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@using PSC.Blazor.Components.MarkdownEditor
@using PSC.Blazor.Components.MarkdownEditor.Models
@using LANCommander.Server.Services.Pages
@using LANCommander.Server.UI.Pages.Pages.Components
@inject MediaService MediaService
@inject PageService PageService
@inject PageRenderService PageRenderService
@inject DialogService Dialogs
@inject IJSRuntime JS
@inject GameService GameService
@inject RedistributableService RedistributableService
@inject ServerService ServerService
@inject AlertService Alerts
@inject NavigationManager NavigationManager
@inject NotificationService Notifications

<PageHeader Title="Pages">
    <Extra>
        @if (_selectedPage != null)
        {
            <Button Icon="IconType.ArrowSquareOut" Href="@($"/{_selectedPage.Route}")" NewTab>View</Button>
            <Button Primary Icon="IconType.FloppyDisk" Loading="_saving" OnClick="SaveAsync">Save</Button>
            <Dropdown>
                <ChildContent><Button Icon="IconType.DotsThree" aria-label="More actions" /></ChildContent>
                <Overlay>
                    <Menu>
                        <MenuItem Icon="IconType.Plus" OnClick="AddNewPageAsync">New Page</MenuItem>
                        <MenuItem Icon="IconType.Copy" OnClick="() => DuplicatePageAsync(_selectedPage)">Duplicate</MenuItem>
                        <MenuItem Icon="IconType.Trash" Danger OnClick="() => DeletePageAsync(_selectedPage)">Delete</MenuItem>
                    </Menu>
                </Overlay>
            </Dropdown>
        }
        else
        {
            <Button Primary Icon="IconType.Plus" OnClick="AddNewPageAsync">New Page</Button>
        }
    </Extra>
</PageHeader>

<SplitPane Class="page-editor-body">
    <Pane Size="25%" Class="page-editor-tree-pane">
        <Tree TItem="Page"
              Items="_pages"
              Children="p => p.Children?.OrderBy(c => c.SortOrder)"
              Key="p => p.Id"
              Value="_selectedPage"
              ValueChanged="SelectPageAsync"
              ExpandAll
              Draggable
              OnDrop="MoveAsync">
            @{
                var node = context;
            }
            <Dropdown ContextMenu Class="page-editor-tree-title">
                <ChildContent>
                    <Flex Align="Align.Center" Justify="Justify.SpaceBetween">
                        <span>@node.Title</span>
                        @* A nested click-triggered menu with the same actions; stopPropagation keeps it from selecting the row *@
                        <span class="page-editor-tree-action" @onclick:stopPropagation="true">
                            <Dropdown Overlay="PageMenuFor(node)">
                                <Button Small Text Icon="IconType.DotsThree" aria-label="Page actions" />
                            </Dropdown>
                        </span>
                    </Flex>
                </ChildContent>
                <Overlay>@PageMenuFor(node)</Overlay>
            </Dropdown>
        </Tree>
    </Pane>

    <Pane Size="75%" Class="page-editor-markdown-pane">
        @if (_selectedPage != null)
        {
            <Form @ref="_form" Model="_selectedPage">
                <FormItem Required RequiredMessage="Title is required">
                    <TextInput @bind-Value="_selectedPage.Title" @bind-Value:after="SyncSlugFromTitle" Large Placeholder="Page Title" AutoFocus />
                </FormItem>

                <FormItem Label="Slug">
                    <SlugEditorInput @bind-Page="_selectedPage" />
                </FormItem>

                <Flex Gap="Gap.Medium" Wrap>
                    <FormItem Label="Games" Style="flex: 1; min-width: 200px">
                        <Select TValue="Guid" Multiple Clearable Searchable Items="_gameItems" @bind-Values="_linkedGameIds" Placeholder="Link games" />
                    </FormItem>

                    <FormItem Label="Redistributables" Style="flex: 1; min-width: 200px">
                        <Select TValue="Guid" Multiple Clearable Searchable Items="_redistributableItems" @bind-Values="_linkedRedistributableIds" Placeholder="Link redistributables" />
                    </FormItem>

                    <FormItem Label="Servers" Style="flex: 1; min-width: 200px">
                        <Select TValue="Guid" Multiple Clearable Searchable Items="_serverItems" @bind-Values="_linkedServerIds" Placeholder="Link servers" />
                    </FormItem>
                </Flex>

                <Flex Justify="Justify.SpaceBetween" Align="Align.Center" Class="page-editor-toolbar">
                    <Segmented TValue="bool" Items="EditorModes" Value="_preview" ValueChanged="SetPreviewAsync" Small aria-label="Editor mode" />

                    <Dropdown>
                        <ChildContent><Button Small Icon="IconType.Plus" Disabled="_preview">Insert</Button></ChildContent>
                        <Overlay>
                            <Menu>
                                <MenuItem Icon="IconType.GameController" OnClick="@(() => InsertEmbedAsync("game"))">Game</MenuItem>
                                <MenuItem Icon="IconType.HardDrives" OnClick="@(() => InsertEmbedAsync("server"))">Server</MenuItem>
                                <MenuItem Icon="IconType.Package" OnClick="@(() => InsertEmbedAsync("redistributable"))">Redistributable</MenuItem>
                                <MenuItem Icon="IconType.Link" OnClick="@(() => InsertEmbedAsync("page"))">Link to Page</MenuItem>
                                <MenuDivider />
                                <MenuItem Icon="IconType.TreeStructure" OnClick="@(() => InsertEmbedAsync("children"))">Child Pages</MenuItem>
                                <MenuItem Icon="IconType.ListBullets" OnClick="@(() => InsertEmbedAsync("toc"))">Table of Contents</MenuItem>
                            </Menu>
                        </Overlay>
                    </Dropdown>
                </Flex>

                @if (_preview)
                {
                    @* Rendered by the server exactly as visitors see it, embeds included *@
                    <div class="page-editor-preview page-view-content">
                        @((MarkupString)_previewHtml)
                    </div>

                    <link rel="stylesheet" href="css/pages.css" />
                }
                else
                {
                    <FormItem>
                        @* Wrapped so pages-editor.js can find this editor to insert embeds *@
                        <div id="@EditorHostId">
                            <MarkdownEditor @bind-Value="_selectedPage.Contents"
                                            UploadImage="true"
                                            ImageUploadEndpoint="/api/Media/Upload/PageImage"
                                            CustomImageUpload="UploadImageAsync"
                                            SpellChecker="false"
                                            MinHeight="500px" />
                        </div>
                    </FormItem>
                }
            </Form>
        }
        else
        {
            <Empty Description="No page is selected">
                <Button Primary Icon="IconType.Plus" OnClick="AddNewPageAsync">New Page</Button>
            </Empty>
        }
    </Pane>
</SplitPane>

@code {
    [Parameter] public Guid Id { get; set; }

    Form? _form;
    Page? _selectedPage;
    ICollection<Page> _pages = new List<Page>();
    bool _saving;

    // What the page looked like when loaded or last saved, to detect unsaved changes
    string? _savedSnapshot;

    IEnumerable<SelectItem<Guid>> _gameItems = [];
    IEnumerable<SelectItem<Guid>> _redistributableItems = [];
    IEnumerable<SelectItem<Guid>> _serverItems = [];

    IEnumerable<Guid> _linkedGameIds = [];
    IEnumerable<Guid> _linkedRedistributableIds = [];
    IEnumerable<Guid> _linkedServerIds = [];

    // The title the current slug was derived from, so the slug follows the title until customized
    string? _lastTitle;

    const string EditorHostId = "page-editor-markdown";

    bool _preview;
    string _previewHtml = "";

    static readonly IEnumerable<SelectItem<bool>> EditorModes =
    [
        new(false, "Write", Icon: IconType.PencilSimple),
        new(true, "Preview", Icon: IconType.Eye),
    ];

    RenderFragment PageMenuFor(Page page) => @<Menu>
        <MenuItem Icon="IconType.Plus" OnClick="() => CreatePageAsync(page.ParentId)">New Page</MenuItem>
        <MenuItem Icon="IconType.TreeStructure" OnClick="() => CreatePageAsync(page.Id)">Add Child Page</MenuItem>
        <MenuItem Icon="IconType.Copy" OnClick="() => DuplicatePageAsync(page)">Duplicate</MenuItem>
        <MenuItem Icon="IconType.Trash" Danger OnClick="() => DeletePageAsync(page)">Delete</MenuItem>
    </Menu>;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        try
        {
            _gameItems = (await GameService.SortBy(g => g.Title).GetAsync()).ToSelectItems(g => g.Id, g => g.Title).ToList();
            _redistributableItems = (await RedistributableService.SortBy(r => r.Name).GetAsync()).ToSelectItems(r => r.Id, r => r.Name).ToList();
            _serverItems = (await ServerService.SortBy(s => s.Name).GetAsync()).ToSelectItems(s => s.Id, s => s.Name).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not load games, redistributables and servers to link!");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == Guid.Empty)
            return;

        // Include the parent so RenderRoute produces the nested route on save
        _selectedPage = await PageService
            .Include(p => p.Parent, p => p.Games, p => p.Redistributables, p => p.Servers)
            .FirstOrDefaultAsync(p => p.Id == Id);

        if (_selectedPage == null)
        {
            NavigationManager.NavigateTo("/Pages/Edit");
            return;
        }

        _linkedGameIds = _selectedPage.Games?.Select(g => g.Id).ToList() ?? [];
        _linkedRedistributableIds = _selectedPage.Redistributables?.Select(r => r.Id).ToList() ?? [];
        _linkedServerIds = _selectedPage.Servers?.Select(s => s.Id).ToList() ?? [];

        _savedSnapshot = Snapshot();
        _lastTitle = _selectedPage.Title;
        _preview = false;
    }

    async Task SetPreviewAsync(bool preview)
    {
        if (preview && _selectedPage != null)
        {
            try
            {
                _previewHtml = await PageRenderService.RenderAsync(_selectedPage.Contents, new PageRenderOptions
                {
                    PageId = _selectedPage.Id,
                    IsAdministrator = true,
                });
            }
            catch (Exception ex)
            {
                Notifications.Error(ex, "Could not render the preview!");
                return;
            }
        }

        _preview = preview;
    }

    async Task InsertEmbedAsync(string kind)
    {
        var embed = PageRenderService.Kinds.TryGetValue(kind, out var needsItem) && needsItem
            ? await Dialogs.OpenAsync<InsertEmbedDialog, string, string>(InsertTitle(kind), kind, new DialogSettings { OkText = "Insert" })
            : PageMarkdown.Embed(kind);

        if (String.IsNullOrEmpty(embed))
            return;

        try
        {
            if (!await JS.InvokeAsync<bool>("pagesEditor.insertBlock", EditorHostId, embed))
                throw new InvalidOperationException("The editor isn't ready");
        }
        catch (Exception ex)
        {
            // Still usable by hand if the editor couldn't be reached
            _selectedPage!.Contents = (_selectedPage.Contents ?? "").TrimEnd() + "\n\n" + embed + "\n";

            Notifications.Warning("The embed was added to the end of the page", ex.Message);
        }
    }

    static string InsertTitle(string kind) => kind switch
    {
        "page" => "Link to Page",
        "redistributable" => "Insert Redistributable",
        _ => $"Insert {Char.ToUpperInvariant(kind[0])}{kind[1..]}",
    };

    // Covers every field the editor changes, so any of them counts as an unsaved change
    string Snapshot() => _selectedPage == null ? "" : String.Join('\n',
        _selectedPage.Title,
        _selectedPage.Slug,
        _selectedPage.Contents,
        String.Join(',', _linkedGameIds.Order()),
        String.Join(',', _linkedRedistributableIds.Order()),
        String.Join(',', _linkedServerIds.Order()));

    void SyncSlugFromTitle()
    {
        if (_selectedPage == null)
            return;

        var autoSlug = (_lastTitle ?? "").ToRouteSlug();

        if (String.IsNullOrEmpty(_selectedPage.Slug) || _selectedPage.Slug == autoSlug)
        {
            _selectedPage.Slug = _selectedPage.Title.ToRouteSlug();
            _selectedPage.Route = PageService.RenderRoute(_selectedPage);
        }

        _lastTitle = _selectedPage.Title;
    }

    async Task LoadAsync()
    {
        try
        {
            var allPages = await PageService.SortBy(p => p.SortOrder).GetAsync();
            var childrenByParent = allPages.ToLookup(p => p.ParentId);

            foreach (var page in allPages)
            {
                page.Children = childrenByParent[page.Id].ToList();

                foreach (var child in page.Children)
                    child.Parent = page;
            }

            _pages = childrenByParent[null].ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not load pages!");
        }
    }

    async Task MoveAsync(TreeDrop<Page> drop)
    {
        try
        {
            if (drop.Position == TreeDropPosition.Inside)
            {
                var order = drop.Target.Children?.Select(c => c.Id).Where(id => id != drop.Item.Id).ToList() ?? [];

                order.Insert(0, drop.Item.Id);

                await PageService.UpdateOrderAsync(drop.Target.Id, order);
            }
            else
            {
                var parentId = drop.Target.Parent?.Id ?? Guid.Empty;
                var siblings = drop.Target.Parent?.Children ?? _pages;
                var order = siblings.OrderBy(p => p.SortOrder).Select(p => p.Id).Where(id => id != drop.Item.Id).ToList();

                var targetIndex = order.IndexOf(drop.Target.Id);

                order.Insert(drop.Position == TreeDropPosition.After ? targetIndex + 1 : targetIndex, drop.Item.Id);

                await PageService.UpdateOrderAsync(parentId, order);
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not move the page!");
        }
    }

    async Task AddNewPageAsync()
    {
        Guid? parentId = null;

        if (_selectedPage != null)
            parentId = _selectedPage.ParentId is Guid id && id != Guid.Empty ? id : _selectedPage.Id;

        await CreatePageAsync(parentId);
    }

    async Task CreatePageAsync(Guid? parentId)
    {
        try
        {
            // Created directly beneath its parent so the slug is made unique among its real siblings
            var newPage = await PageService.AddAsync(new Page
            {
                Title = "New Page",
                Slug = "new-page",
                Contents = "",
                ParentId = parentId is Guid pid && pid != Guid.Empty ? pid : null,
            });

            await LoadAsync();

            NavigationManager.NavigateTo($"/Pages/Edit/{newPage.Id}");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Error adding new page!");
        }
    }

    async Task DeletePageAsync(Page? page)
    {
        if (page == null)
            return;

        // Deleting a page also deletes everything beneath it, so say so up front
        var descendants = await PageService.CountDescendantsAsync(page.Id);

        var message = descendants switch
        {
            0 => $"Delete \"{page.Title}\"?",
            1 => $"Delete \"{page.Title}\" and the page beneath it?",
            _ => $"Delete \"{page.Title}\" and the {descendants} pages beneath it?",
        };

        if (!await Alerts.ConfirmAsync(message, "Delete Page", okText: "Delete", danger: true))
            return;

        try
        {
            var parentId = page.ParentId ?? Guid.Empty;

            await PageService.DeleteAsync(await PageService.GetAsync(page.Id));

            Notifications.Success("Page deleted!");

            await LoadAsync();

            // Only navigate away if the deleted page was the one being edited
            if (_selectedPage?.Id == page.Id)
                NavigationManager.NavigateTo(parentId != Guid.Empty ? $"/Pages/Edit/{parentId}" : "/Pages/Edit");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Error deleting page!");
        }
    }

    async Task SaveAsync()
    {
        if (_selectedPage == null || (_form != null && !_form.Validate()))
            return;

        _saving = true;

        try
        {
            // Freshly loaded, not id-only stubs: the relationship update copies these entities'
            // values onto the stored rows, so a stub would blank out every linked item.
            var gameIds = _linkedGameIds.ToList();
            var redistributableIds = _linkedRedistributableIds.ToList();
            var serverIds = _linkedServerIds.ToList();

            _selectedPage.Games = await GameService.GetAsync(g => gameIds.Contains(g.Id));
            _selectedPage.Redistributables = await RedistributableService.GetAsync(r => redistributableIds.Contains(r.Id));
            _selectedPage.Servers = await ServerService.GetAsync(s => serverIds.Contains(s.Id));

            await PageService.UpdateAsync(_selectedPage);

            Notifications.Success("Page updated!");

            // Reset the change-tracking baseline so navigating away doesn't prompt
            _savedSnapshot = Snapshot();
            _lastTitle = _selectedPage.Title;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save page!");
        }
        finally
        {
            _saving = false;
        }
    }

    async Task SelectPageAsync(Page? page)
    {
        if (page == null || !await ConfirmLeaveAsync())
            return;

        NavigationManager.NavigateTo($"/Pages/Edit/{page.Id}");
    }

    /// <summary>
    /// Offers to save or discard unsaved changes before moving to another page. False means stay.
    /// </summary>
    async Task<bool> ConfirmLeaveAsync()
    {
        if (_selectedPage == null || Snapshot() == _savedSnapshot)
            return true;

        switch (await Alerts.ConfirmUnsavedChangesAsync("You are about to leave this page with unsaved changes."))
        {
            case UnsavedChangesChoice.Save:
                await SaveAsync();
                return true;

            case UnsavedChangesChoice.Discard:
                await LoadAsync();
                return true;

            default:
                return false;
        }
    }

    async Task DuplicatePageAsync(Page? page)
    {
        // The copy is made from what's saved, so offer to save edits to it first
        if (page == null || !await ConfirmLeaveAsync())
            return;

        try
        {
            var copy = await PageService.DuplicateAsync(page.Id);

            Notifications.Success("Page duplicated!");

            await LoadAsync();

            NavigationManager.NavigateTo($"/Pages/Edit/{copy.Id}");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not duplicate the page!");
        }
    }

    async Task<FileEntry> UploadImageAsync(MarkdownEditor editor, FileEntry entry)
    {
        var stream = new MemoryStream(Convert.FromBase64String(entry.ContentBase64));

        var media = await MediaService.AddAsync(new Media
        {
            Type = SDK.Enums.MediaType.PageImage,
            MimeType = entry.Type,
            Crc32 = "",
        });

        media = await MediaService.WriteToFileAsync(media, stream);
        media = await MediaService.UpdateAsync(media);

        entry.UploadUrl = $"/api/Media/{media.Id}/Download?fileId={media.FileId}";

        return entry;
    }
}
