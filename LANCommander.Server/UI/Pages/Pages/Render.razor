@page "/Pages/{*route}"
@using LANCommander.SDK.Extensions
@using LANCommander.Server.UI.Pages.Pages.Components
@using Markdig
@using Microsoft.AspNetCore.Components.Authorization
@using ZiggyCreatures.Caching.Fusion
@using LANCommander.Server.Services.Abstractions
@inject PageService PageService
@inject IFusionCache Cache
@inject NavigationManager NavigationManager
@inject IVersionProvider VersionProvider
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (Page != null)
{
    <SplitPane Class="page-view">
        <Pane Size="25%" Class="page-nav">
            <PageMenu CurrentRoute="@Page.Route" />
        </Pane>

        <Pane Size="75%">
            @if (Ancestors.Any())
            {
                <Breadcrumb Class="page-view-breadcrumb">
                    @foreach (var ancestor in Ancestors)
                    {
                        <BreadcrumbItem Href="@($"/{ancestor.Route}")">@ancestor.Title</BreadcrumbItem>
                    }
                    <BreadcrumbItem>@Page.Title</BreadcrumbItem>
                </Breadcrumb>
            }

            <PageHeader Title="@Page.Title" />

            <PageContent Class="page-view-content">
                @((MarkupString)Markdig.Markdown.ToHtml(Page.Contents ?? "", PagePipeline))

                @if (Related.Any())
                {
                    <div class="page-view-related">
                        <Divider Left>Related</Divider>

                        <Flex Gap="Gap.Small" Wrap>
                            @foreach (var item in Related)
                            {
                                @* Edit pages are admin-only, so other visitors just see the name *@
                                @if (IsAdministrator)
                                {
                                    <a href="@item.Href"><Tag Icon="@item.Icon">@item.Name</Tag></a>
                                }
                                else
                                {
                                    <Tag Icon="@item.Icon">@item.Name</Tag>
                                }
                            }
                        </Flex>
                    </div>
                }
            </PageContent>
        </Pane>
    </SplitPane>
}
else if (NotFoundResult)
{
    <NotFound Title="Page Not Found">
        <Button Primary Href="/Pages">Back to Pages</Button>
    </NotFound>
}

<link rel="stylesheet" href="~/css/pages.css?v=@(VersionProvider.GetCurrentVersion())" />

@code {
    // Markdown from page contents is rendered as raw markup, so raw HTML is stripped
    // to prevent stored XSS from executing for public visitors.
    static readonly MarkdownPipeline PagePipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .UseAdvancedExtensions()
        .Build();

    [Parameter] public string Route { get; set; }

    record RelatedItem(string Name, string Href, IconType Icon);

    Page Page;
    bool NotFoundResult;
    List<Page> Ancestors = new();
    List<RelatedItem> Related = new();
    bool IsAdministrator;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        IsAdministrator = authState.User.IsInRole(RoleService.AdministratorRoleName);
    }

    protected override async Task OnParametersSetAsync()
    {
        Page = null;
        NotFoundResult = false;
        Ancestors = new();
        Related = new();

        if (Route == null)
        {
            var firstParent = await PageService.Query(q =>
            {
                return q.OrderBy(p => p.SortOrder);
            }).FirstOrDefaultAsync(p => p.Parent == null);

            if (firstParent == null)
                NavigationManager.NavigateTo("/");
            else
                NavigationManager.NavigateTo($"/{firstParent.Route}");
        }
        else
        {
            var route = Route.TrimEnd('/');

            Page = await Cache.GetOrSetAsync<Page>(PageService.GetCacheKey(route), async _ =>
            {
                // Routes are stored in PascalCase; match case-insensitively so the incoming
                // URL casing doesn't have to be exact.
                var target = $"Pages/{route}".ToLower();

                return await PageService.FirstOrDefaultAsync(p => p.Route.ToLower() == target);
            });

            if (Page == null)
                NotFoundResult = true;
            else
            {
                await LoadAncestorsAsync();
                await LoadRelatedAsync();
            }
        }
    }

    // Loaded outside the page cache so renamed games and servers show their current names
    async Task LoadRelatedAsync()
    {
        var linked = await PageService
            .Include(p => p.Games, p => p.Redistributables, p => p.Servers)
            .FirstOrDefaultAsync(p => p.Id == Page.Id);

        if (linked == null)
            return;

        Related = [
            .. (linked.Games ?? []).OrderBy(g => g.Title).Select(g => new RelatedItem(g.Title, $"/Games/{g.Id}", IconType.GameController)),
            .. (linked.Redistributables ?? []).OrderBy(r => r.Name).Select(r => new RelatedItem(r.Name, $"/Redistributables/{r.Id}", IconType.Package)),
            .. (linked.Servers ?? []).OrderBy(s => s.Name).Select(s => new RelatedItem(s.Name, $"/Servers/{s.Id}", IconType.HardDrives)),
        ];
    }

    async Task LoadAncestorsAsync()
    {
        var chain = new List<Page>();
        var parentId = Page.ParentId;

        while (parentId != null && parentId != Guid.Empty)
        {
            var ancestor = await PageService.GetAsync(parentId.Value);

            if (ancestor == null)
                break;

            chain.Insert(0, ancestor);
            parentId = ancestor.ParentId;
        }

        Ancestors = chain;
    }
}
