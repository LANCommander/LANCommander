@page "/Profile/ChangePassword"
@using LANCommander.Server.Settings
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject UserService UserService
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<Settings> Settings
@attribute [Authorize]

<PageHeader Title="Change Password" />

<PageContent Loading="User == null">
    @if (!AllowPassword)
    {
        <Alert Info>Password authentication is disabled by the administrator.</Alert>
    }
    else if (User != null)
    {
        <Form Model="Model" OnSubmit="ChangeAsync" Loading="_saving">
            @if (HasPassword)
            {
                <FormItem Label="Current Password" Required>
                    <PasswordInput @bind-Value="Model.CurrentPassword" />
                </FormItem>
            }

            <FormItem Label="New Password" Required>
                <PasswordInput @bind-Value="Model.NewPassword" />
            </FormItem>

            <FormItem Label="Confirm Password" Required>
                <PasswordInput @bind-Value="Model.NewPasswordConfirm" />
            </FormItem>

            <FormItem>
                <Button Primary Submit>Change</Button>
            </FormItem>
        </Form>
    }
</PageContent>

@code {
    User? User;
    ChangePasswordModel Model = new();
    bool _saving;

    bool AllowPassword => Settings.Value.Server.Authentication.AllowPassword;

    bool HasPassword => !String.IsNullOrWhiteSpace(User?.PasswordHash);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
            User = await UserService.GetAsync(authState.User.Identity.Name);

        User ??= new();
    }

    async Task ChangeAsync()
    {
        if (!AllowPassword || User == null)
        {
            Notifications.Error("Password authentication is disabled by the administrator.");
            return;
        }

        if (Model.NewPassword != Model.NewPasswordConfirm)
        {
            Notifications.Error("Passwords don't match!");
            return;
        }

        _saving = true;

        try
        {
            if (HasPassword && !await UserService.CheckPassword(User.UserName, Model.CurrentPassword))
            {
                Notifications.Error("Incorrect password!");
                return;
            }

            var result = await UserService.ChangePassword(User.UserName, Model.CurrentPassword, Model.NewPassword);

            if (result.Succeeded)
            {
                Notifications.Success("Password changed!");

                Model = new();
            }
            else
                Notifications.Error(String.Join(" ", result.Errors.Select(e => e.Description)));
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Password could not be changed!");
        }
        finally
        {
            _saving = false;
        }
    }

    public class ChangePasswordModel
    {
        public string? CurrentPassword { get; set; }
        public string? NewPassword { get; set; }
        public string? NewPasswordConfirm { get; set; }
    }
}
