@using LANCommander.Server.Services.Models
@inherits Dialog<NewAccessTokenOptions, NewAccessTokenRequest>

@* Names a new personal access token and decides how long it lasts and what it may reach *@
<Form @ref="_form" Model="_model" OnSubmit="ConfirmAsync">
    <FormItem Label="Name" Required RequiredMessage="Name is required" Help="What the token is for, e.g. the MCP client or script that uses it">
        <TextInput @bind-Value="_model.Name" Immediate AutoFocus MaxLength="128" Placeholder="e.g. Claude Desktop" />
    </FormItem>

    <FormItem Label="Expiration">
        <Select TValue="int" @bind-Value="_model.ExpiresInDays" Items="ExpirationItems" />
    </FormItem>

    <FormItem Label="Access" Help="@AccessHelp">
        <Segmented TValue="TokenAccess" Dialog @bind-Value="_model.Access" Items="AccessItems" />
    </FormItem>

    @if (_model.Access == TokenAccess.Plugins)
    {
        <FormItem Label="Plugins" Required>
            <Select TValue="string"
                    Multiple
                    @bind-Values="_model.Plugins"
                    Items="PluginItems"
                    Placeholder="@(PluginItems.Any() ? "Select plugins" : "No plugins provide endpoints")" />
        </FormItem>
    }
</Form>

@code {
    static readonly IEnumerable<SelectItem<int>> ExpirationItems =
    [
        new(7, "7 days"),
        new(30, "30 days"),
        new(90, "90 days"),
        new(365, "1 year"),
        new(0, "Never"),
    ];

    enum TokenAccess
    {
        FullApi,
        Plugins,
        ReportMatches,
        ReadMatches,
    }

    static readonly IEnumerable<SelectItem<TokenAccess>> AccessItems =
    [
        new(TokenAccess.FullApi, "Full API"),
        new(TokenAccess.Plugins, "Specific plugins"),
        new(TokenAccess.ReportMatches, "Report matches"),
        new(TokenAccess.ReadMatches, "Read matches"),
    ];

    Form? _form;
    Model _model = new();

    IEnumerable<SelectItem<string>> PluginItems => Options.PluginRoutePrefixes.Select(p => new SelectItem<string>(p, p));

    string AccessHelp => _model.Access switch
    {
        TokenAccess.Plugins => "The token only works on the chosen plugins' endpoints, under /api/Plugins",
        TokenAccess.ReportMatches => "The token only works on /api/Matches, for a game server or tool that reports matches. Reports are trusted as far as your account is",
        TokenAccess.ReadMatches => "The token can only read /api/Matches, for dashboards such as Grafana",
        _ => "The token can make any API request your account can",
    };

    protected override bool CanConfirm =>
        !string.IsNullOrWhiteSpace(_model.Name) && (_model.Access != TokenAccess.Plugins || _model.Plugins.Any());

    protected override Task<bool> OnOkAsync()
    {
        if (_form?.Validate() == false || !CanConfirm)
            return Task.FromResult(false);

        Result = new NewAccessTokenRequest(
            _model.Name!.Trim(),
            _model.Access switch
            {
                TokenAccess.Plugins => PersonalAccessTokenScopes.ForPlugins(_model.Plugins),
                TokenAccess.ReportMatches => PersonalAccessTokenScopes.ForMatches(report: true),
                TokenAccess.ReadMatches => PersonalAccessTokenScopes.ForMatches(report: false),
                _ => PersonalAccessTokenScopes.FullApi,
            },
            _model.ExpiresInDays > 0 ? DateTime.UtcNow.AddDays(_model.ExpiresInDays) : null);

        return Task.FromResult(true);
    }

    sealed class Model
    {
        public string? Name { get; set; }
        public int ExpiresInDays { get; set; } = 30;
        public TokenAccess Access { get; set; }
        public IEnumerable<string> Plugins { get; set; } = [];
    }
}
