@using LANCommander.Server.Services.Models
@inherits Dialog<NewAccessTokenOptions, NewAccessTokenRequest>

@* Names a new personal access token and decides how long it lasts and what it may reach *@
<Form @ref="_form" Model="_model" OnSubmit="ConfirmAsync">
    <FormItem Label="Name" Required RequiredMessage="Name is required" Help="What the token is for, e.g. the MCP client or script that uses it">
        <TextInput @bind-Value="_model.Name" Immediate AutoFocus MaxLength="128" Placeholder="e.g. Claude Desktop" />
    </FormItem>

    <FormItem Label="Expiration">
        <Select TValue="int" @bind-Value="_model.ExpiresInDays" Items="ExpirationItems" />
    </FormItem>

    <FormItem Label="Access" Help="@AccessHelp">
        <Segmented TValue="bool" Dialog @bind-Value="_model.PluginsOnly" Items="AccessItems" />
    </FormItem>

    @if (_model.PluginsOnly)
    {
        <FormItem Label="Plugins" Required>
            <Select TValue="string"
                    Multiple
                    @bind-Values="_model.Plugins"
                    Items="PluginItems"
                    Placeholder="@(PluginItems.Any() ? "Select plugins" : "No plugins provide endpoints")" />
        </FormItem>
    }
</Form>

@code {
    static readonly IEnumerable<SelectItem<int>> ExpirationItems =
    [
        new(7, "7 days"),
        new(30, "30 days"),
        new(90, "90 days"),
        new(365, "1 year"),
        new(0, "Never"),
    ];

    static readonly IEnumerable<SelectItem<bool>> AccessItems =
    [
        new(false, "Full API"),
        new(true, "Specific plugins"),
    ];

    Form? _form;
    Model _model = new();

    IEnumerable<SelectItem<string>> PluginItems => Options.PluginRoutePrefixes.Select(p => new SelectItem<string>(p, p));

    string AccessHelp => _model.PluginsOnly
        ? "The token only works on the chosen plugins' endpoints, under /api/Plugins"
        : "The token can make any API request your account can";

    protected override bool CanConfirm =>
        !string.IsNullOrWhiteSpace(_model.Name) && (!_model.PluginsOnly || _model.Plugins.Any());

    protected override Task<bool> OnOkAsync()
    {
        if (_form?.Validate() == false || !CanConfirm)
            return Task.FromResult(false);

        Result = new NewAccessTokenRequest(
            _model.Name!.Trim(),
            _model.PluginsOnly ? PersonalAccessTokenScopes.ForPlugins(_model.Plugins) : PersonalAccessTokenScopes.FullApi,
            _model.ExpiresInDays > 0 ? DateTime.UtcNow.AddDays(_model.ExpiresInDays) : null);

        return Task.FromResult(true);
    }

    sealed class Model
    {
        public string? Name { get; set; }
        public int ExpiresInDays { get; set; } = 30;
        public bool PluginsOnly { get; set; }
        public IEnumerable<string> Plugins { get; set; } = [];
    }
}
