@page "/Profile/ConnectedAccounts"
@using LANCommander.Server.Settings
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject UserService UserService
@inject UserCustomFieldService UserCustomFieldService
@inject IOptions<Settings> Settings
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageHeader Title="Connected Accounts" />

<PageContent Loading="_loading">
    @if (!Providers.Any())
    {
        <Empty Description="No authentication providers are configured" />
    }
    else
    {
        <div class="connected-accounts">
            @foreach (var provider in Providers)
            {
                var customField = CustomFields.FirstOrDefault(cf => cf.Name == provider.GetCustomFieldName());

                <div class="connected-account">
                    <Flex Align="Align.Center" Gap="Gap.Large">
                        @if (!String.IsNullOrWhiteSpace(provider.Icon))
                        {
                            <BootstrapIcon Type="@provider.Icon" Width="32px" Height="32px" Color="@(String.IsNullOrWhiteSpace(provider.Color) ? "currentColor" : provider.Color)" />
                        }

                        <h3>@provider.Name</h3>
                    </Flex>

                    @if (customField != null)
                    {
                        var wouldLockOut = !HasPassword && CustomFields.Count <= 1;

                        <Tooltip Title="@(wouldLockOut ? "You can't unlink your only sign-in method. Set a password first." : null)">
                            <Button Primary Disabled="wouldLockOut" OnClick="() => UnlinkAsync(customField)">Unlink</Button>
                        </Tooltip>
                    }
                    else
                    {
                        <Button Primary OnClick="@(() => NavigationManager.NavigateTo($"/AccountLink?Provider={provider.Slug}&ReturnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", true))">
                            Link
                        </Button>
                    }
                </div>
            }
        </div>
    }
</PageContent>

@code {
    User User = new();
    List<UserCustomField> CustomFields = new();
    bool _loading = true;

    IEnumerable<LANCommander.Server.Settings.Models.AuthenticationProvider> Providers => Settings.Value.Server.Authentication.AuthenticationProviders ?? [];

    bool HasPassword => !String.IsNullOrEmpty(User.PasswordHash);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
            User = await UserService.GetAsync(authState.User.Identity.Name) ?? new();

        await LoadDataAsync();
    }

    async Task LoadDataAsync()
    {
        var customFields = new List<UserCustomField>();

        foreach (var provider in Providers)
        {
            var customField = await UserCustomFieldService.FirstOrDefaultAsync(cf => cf.Name == provider.GetCustomFieldName() && cf.UserId == User.Id);

            if (customField != null)
                customFields.Add(customField);
        }

        CustomFields = customFields;
        _loading = false;
    }

    async Task UnlinkAsync(UserCustomField customField)
    {
        // Prevent locking the user out: a passwordless account must retain at least one linked provider.
        if (!HasPassword && CustomFields.Count <= 1)
        {
            Notifications.Error("You can't unlink your only sign-in method. Set a password first.");
            return;
        }

        try
        {
            await UserCustomFieldService.DeleteAsync(customField.UserId!.Value, customField.Name);

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The account could not be unlinked");
        }
    }
}
