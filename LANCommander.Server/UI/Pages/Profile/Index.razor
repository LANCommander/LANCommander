@page "/Profile"
@page "/Profile/General"
@using LANCommander.Server.Settings
@using LANCommander.Server.Settings.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject UserService UserService
@inject NotificationService Notifications
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IOptions<Settings> Settings
@attribute [Authorize]

<PageHeader Title="Profile">
    <Extra>
        <Button Primary Disabled="!(_form?.IsModified ?? false)" Loading="_saving" OnClick="SaveAsync">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="User == null">
    @if (User != null)
    {
        <Form @ref="_form" Model="User" OnFieldChanged="StateHasChanged" OnSubmit="SaveAsync">
            <FormItem Label="Avatar">
                <AvatarUploader UserId="User.Id" Disabled="!AuthSettings.AllowAvatarUpload" />
            </FormItem>

            <FormItem Label="Username" Help="Username changes require a relog">
                <TextInput @bind-Value="User.UserName" Disabled="!AuthSettings.AllowUsernameChange" />
            </FormItem>

            @if (AuthSettings.AllowAliasChange)
            {
                <FormItem Label="Alias">
                    <TextInput @bind-Value="User.Alias" />
                </FormItem>
            }

            <FormItem Label="Email Address" Help="Email changes require a relog">
                <TextInput @bind-Value="User.Email" Disabled="!AuthSettings.AllowEmailChange" />
            </FormItem>
        </Form>
    }
</PageContent>

@code {
    User? User;
    Form? _form;
    bool _saving;

    AuthenticationSettings AuthSettings => Settings.Value.Server.Authentication;

    string? _originalUserName;
    string? _originalEmail;
    string? _originalAlias;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
            User = await UserService.GetAsync(authState.User.Identity.Name);

        User ??= new();

        _originalUserName = User.UserName;
        _originalEmail = User.Email;
        _originalAlias = User.Alias;
    }

    async Task SaveAsync()
    {
        if (User == null || _form == null || !_form.IsModified)
            return;

        _saving = true;

        try
        {
            // Enforce administrator restrictions server-side regardless of UI state.
            if (!AuthSettings.AllowUsernameChange)
                User.UserName = _originalUserName;
            if (!AuthSettings.AllowEmailChange)
                User.Email = _originalEmail;
            if (!AuthSettings.AllowAliasChange)
                User.Alias = _originalAlias;

            await UserService.UpdateAsync(User);

            Notifications.Success("Profile updated!");

            NavigationManager.NavigateTo("/Logout?force=true", true);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Your profile could not be saved");
        }
        finally
        {
            _saving = false;
        }
    }
}
