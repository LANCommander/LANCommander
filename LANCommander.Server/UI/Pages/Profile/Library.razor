@page "/Profile/Library"
@using Microsoft.AspNetCore.Components.Authorization
@inject LibraryService LibraryService
@inject UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService Notifications
@attribute [Authorize]

<PageHeader Title="My Library" />

<PageContent Loading="User == null">
    @if (User != null)
    {
        <DataTable TItem="Game"
                   @ref="_table"
                   Query="g => g.Libraries.Any(l => l.UserId == User.Id)"
                   SearchProperty="g => g.Title">
            <Columns>
                <TemplateColumn TItem="Game" Title="Icon" Include="Media" Width="64px">
                    <Image Src="@GetIcon(context)" Width="32" Height="32" />
                </TemplateColumn>
                <BoundColumn Property="g => g.Title" Sortable DefaultSort="ColumnSort.Ascending" />
                <BoundColumn Property="g => g.PlaySessions.Count(ps => ps.UserId == User.Id)" Title="Play Sessions" Include="PlaySessions" Sortable />
                <BoundColumn Property="g => g.GameSaves.Count(gs => gs.UserId == User.Id)" Title="Saves" Include="GameSaves" Sortable />
                <ActionsColumn TItem="Game">
                    <Popconfirm OnConfirm="() => RemoveFromLibraryAsync(context)" Title="Are you sure you want to remove this game from your library?" OkText="Remove" Danger>
                        <Button Text Danger Icon="IconType.X" title="Remove from library" />
                    </Popconfirm>
                </ActionsColumn>
            </Columns>
        </DataTable>
    }
</PageContent>

@code {
    DataTable<Game>? _table;
    User? User;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
            User = await UserService.GetAsync(authState.User.Identity.Name);

        User ??= new();
    }

    async Task RemoveFromLibraryAsync(Game game)
    {
        try
        {
            await LibraryService.RemoveFromLibraryAsync(User!.Id, game.Id);

            Notifications.Success($"Removed {game.Title} from your library!");

            if (_table != null)
                await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not remove from your library!");
        }
    }

    static string GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == SDK.Enums.MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : "/favicon.ico";
    }
}
