@page "/Profile/Saves"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject UserService UserService
@inject GameSaveService GameSaveService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NotificationService Notifications
@attribute [Authorize]

<PageHeader Title="Game Saves" />

<PageContent Loading="User == null">
    @if (User != null)
    {
        <DataTable TItem="GameSave"
                   @ref="_table"
                   Query="gs => gs.UserId == User.Id && gs.Game != null && (GameId == Guid.Empty || gs.Game.Id == GameId)"
                   SearchProperty="gs => gs.Game.Title">
            <RightToolbar>
                <Select TValue="Guid"
                        Value="GameId"
                        ValueChanged="FilterAsync"
                        Items="GameItems"
                        Placeholder="Select a Game"
                        Searchable
                        Clearable
                        Style="width: 250px" />
            </RightToolbar>
            <Columns>
                <BoundColumn Property="gs => gs.Game.Title" Title="Game" Include="Game" Sortable />
                <BoundColumn Property="gs => gs.CreatedOn" Title="Created On" Sortable DefaultSort="ColumnSort.Descending">
                    <LocalTime Value="context.CreatedOn" />
                </BoundColumn>
                <BoundColumn Property="gs => gs.Size" Title="Size" Sortable>
                    <ByteSize Value="context.Size" />
                </BoundColumn>
                <ActionsColumn TItem="GameSave">
                    <Button Text Icon="IconType.DownloadSimple" Href="@($"/Download/Save/{context.Id}")" NewTab title="Download" />
                    <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this game save?" OkText="Delete" Danger>
                        <Button Text Danger Icon="IconType.X" title="Delete" />
                    </Popconfirm>
                </ActionsColumn>
            </Columns>
        </DataTable>
    }
</PageContent>

@code {
    DataTable<GameSave>? _table;
    User? User;
    IEnumerable<SelectItem<Guid>> GameItems = [];
    Guid GameId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
            User = await UserService.GetAsync(authState.User.Identity.Name);

        User ??= new();

        await LoadGamesAsync();
    }

    async Task LoadGamesAsync()
    {
        var saves = await GameSaveService
            .Query(q => q
                .Include(gs => gs.Game)
                .ThenInclude(g => g.Media))
            .GetAsync(gs => gs.UserId == User!.Id);

        GameItems = saves
            .Where(gs => gs.Game != null)
            .Select(gs => gs.Game)
            .DistinctBy(g => g.Id)
            .OrderBy(g => String.IsNullOrWhiteSpace(g.SortTitle) ? g.Title : g.SortTitle)
            .ToSelectItems(g => g.Id, g => g.Title, image: GetIcon)
            .ToList();
    }

    async Task FilterAsync(Guid gameId)
    {
        GameId = gameId;

        if (_table != null)
            await _table.ReloadAsync();
    }

    async Task DeleteAsync(GameSave gameSave)
    {
        try
        {
            await GameSaveService.DeleteAsync(gameSave);

            Notifications.Success("Game save deleted");

            await LoadGamesAsync();

            if (_table != null)
                await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The game save could not be deleted");
        }
    }

    static string GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == SDK.Enums.MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : "/favicon.ico";
    }
}
