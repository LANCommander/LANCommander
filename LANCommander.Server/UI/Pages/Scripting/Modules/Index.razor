@page "/Scripting/Modules"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject ModuleService ModuleService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications

<PageHeader Title="Modules">
    <Extra>
        <Button Primary Icon="IconType.Plus" Href="/Scripting/Modules/Add">Add Module</Button>
    </Extra>
</PageHeader>

<PageContent>
    <Table TItem="Module" Items="_modules" Small NoPaging EmptyText="No modules yet"
           OnRowDoubleClick="@(module => NavigationManager.NavigateTo($"/Scripting/Modules/{module.Name}"))">
        <Columns>
            <BoundColumn Property="m => m.Name" Title="Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <ActionsColumn TItem="Module">
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Scripting/Modules/{context.Name}")" title="Edit" />
                <Popconfirm OnConfirm="() => Delete(context)" Title="Are you sure you want to delete this module?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </Table>
</PageContent>

@code {
    List<Module> _modules = [];

    protected override void OnInitialized() => Load();

    void Load()
    {
        try
        {
            _modules = ModuleService.GetModules().ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not load modules!");
        }
    }

    void Delete(Module module)
    {
        try
        {
            ModuleService.DeleteModule(module.Name);

            Load();

            Notifications.Success("Module deleted!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete module!");
        }
    }
}
