@page "/Scripting/Snippets"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject ScriptService ScriptService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications

<PageHeader Title="Snippets">
    <Extra>
        <Button Primary Icon="IconType.Plus" Href="/Scripting/Snippets/Add">Add Snippet</Button>
    </Extra>
</PageHeader>

<PageContent>
    <Table TItem="Snippet" Items="_snippets" Small NoPaging EmptyText="No snippets yet"
           OnRowDoubleClick="@(snippet => NavigationManager.NavigateTo(EditUrl(snippet)))">
        <Columns>
            <BoundColumn Property="s => s.Group" Title="Group" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="s => s.Name" Title="Name" Sortable />
            <ActionsColumn TItem="Snippet">
                <Button Text Icon="IconType.PencilSimple" Href="@EditUrl(context)" title="Edit" />
                <Popconfirm OnConfirm="() => Delete(context)" Title="Are you sure you want to delete this snippet?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </Table>
</PageContent>

@code {
    List<Snippet> _snippets = [];

    static string EditUrl(Snippet snippet) => $"/Scripting/Snippets/{snippet.Group}/{snippet.Name}";

    protected override void OnInitialized() => Load();

    void Load()
    {
        try
        {
            _snippets = ScriptService.GetSnippets().OrderBy(s => s.Group).ThenBy(s => s.Name).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not load snippets!");
        }
    }

    void Delete(Snippet snippet)
    {
        try
        {
            ScriptService.DeleteSnippet(snippet.Group, snippet.Name);

            Load();

            Notifications.Success("Snippet deleted!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete snippet!");
        }
    }
}
