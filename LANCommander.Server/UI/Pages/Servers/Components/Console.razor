@using LANCommander.SDK.Enums
@using Microsoft.AspNetCore.SignalR.Client
@using XtermBlazor
@inject ServerConsoleService ServerConsoleService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@implements IAsyncDisposable

@* Follows a server's process output, or one of its log file consoles, as it is written *@
@if (_serverConsole?.Type == ServerConsoleType.RCON)
{
    <Alert Info>Sending commands to RCON consoles isn't available yet.</Alert>
}
else
{
    <div class="server-console">
        <Xterm @ref="_terminal" Options="_options" AddonIds="_addons" />
    </div>
}

@code {
    [Parameter] public Guid ServerId { get; set; }

    /// <summary>A log file console to follow instead of the process's own output.</summary>
    [Parameter] public Guid ServerConsoleId { get; set; }

    Xterm? _terminal;
    HubConnection? _hub;
    ServerConsole? _serverConsole;

    readonly TerminalOptions _options = new()
    {
        CursorBlink = true,
        CursorStyle = CursorStyle.Block,
    };

    readonly string[] _addons = ["xterm-addon-fit"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ServerConsoleId != Guid.Empty)
                _serverConsole = await ServerConsoleService.GetAsync(ServerConsoleId);

            if (_serverConsole?.Type == ServerConsoleType.RCON)
                return;

            _hub = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/gameserver"))
                .WithAutomaticReconnect()
                .Build();

            if (_serverConsole == null)
            {
                _hub.On<Guid, string>("Log", (serverId, message) =>
                {
                    if (serverId == ServerId)
                        _ = WriteAsync(message);
                });
            }
            else
            {
                _hub.On<Guid, Guid, string>("Log", (serverId, logId, message) =>
                {
                    if (serverId == ServerId && logId == ServerConsoleId)
                        _ = WriteAsync(message);
                });
            }

            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not connect to the server's output");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _terminal == null)
            return;

        // Let the terminal lay out before fitting it to its container
        await Task.Delay(100);

        try
        {
            await _terminal.Addon("xterm-addon-fit").InvokeVoidAsync("fit");

            if (_serverConsole != null)
            {
                foreach (var line in await ServerConsoleService.ReadLogAsync(ServerConsoleId))
                    await _terminal.WriteLine(line);
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The log could not be read");
        }
    }

    Task WriteAsync(string message) => InvokeAsync(async () =>
    {
        if (_terminal != null)
            await _terminal.WriteLine(message);
    });

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}
