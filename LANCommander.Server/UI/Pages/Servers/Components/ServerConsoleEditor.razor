@using LANCommander.SDK.Enums
@inject ServerConsoleService ServerConsoleService
@inject NotificationService Notifications

@* A server's extra consoles: log files to follow, or RCON connections *@
<Flex Vertical Gap="Gap.Large">
    @if (!_consoles.Any())
    {
        <Empty Description="No consoles have been added" />
    }

    @foreach (var console in _consoles)
    {
        <Card Small Title="@(String.IsNullOrWhiteSpace(console.Name) ? "New Console" : console.Name)" @key="console">
            <Extra>
                <Button Text Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveAsync(console)" />
            </Extra>
            <ChildContent>
                <Form Model="console">
                    <Row Gap="Gap.Medium">
                        <Column Span="8">
                            <FormItem Label="Type">
                                <EnumSelect TEnum="ServerConsoleType" @bind-Value="console.Type" />
                            </FormItem>
                            <FormItem Label="Name">
                                <TextInput @bind-Value="console.Name" Immediate />
                            </FormItem>
                        </Column>

                        <Column Span="16">
                            @if (console.Type == ServerConsoleType.RCON)
                            {
                                <FormItem Label="Server">
                                    <InputGroup Block>
                                        <TextInput @bind-Value="console.Host" Placeholder="Host" Style="flex: 3" />
                                        <NumberInput TValue="int?" @bind-Value="console.Port" Placeholder="Port" Min="0" Max="65535" NoButtons Style="flex: 1" />
                                    </InputGroup>
                                </FormItem>
                                <FormItem Label="Password">
                                    <PasswordInput @bind-Value="console.Password" Placeholder="Password" />
                                </FormItem>
                            }
                            else
                            {
                                <FormItem Label="Path">
                                    <TextInput @bind-Value="console.Path" />
                                </FormItem>
                            }
                        </Column>
                    </Row>
                </Form>
            </ChildContent>
        </Card>
    }

    <Flex Justify="Justify.End">
        <Button Primary Icon="IconType.Plus" OnClick="Add">Add Console</Button>
    </Flex>
</Flex>

@code {
    [Parameter] public Guid ServerId { get; set; }

    List<ServerConsole> _consoles = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    async Task LoadAsync() =>
        _consoles = (await ServerConsoleService.GetAsync(c => c.ServerId == ServerId)).ToList();

    public async Task Save()
    {
        try
        {
            foreach (var console in _consoles)
            {
                if (console.Id == Guid.Empty)
                    await ServerConsoleService.AddAsync(console);
                else
                    await ServerConsoleService.UpdateAsync(console);
            }

            await LoadAsync();

            Notifications.Success("Consoles updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not update consoles!");
        }
    }

    void Add() => _consoles.Add(new ServerConsole { ServerId = ServerId });

    async Task RemoveAsync(ServerConsole console)
    {
        try
        {
            // Saved consoles are deleted straight away, like removed HTTP paths
            if (console.Id != Guid.Empty)
                await ServerConsoleService.DeleteAsync(console);

            _consoles.Remove(console);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The console could not be removed");
        }
    }
}
