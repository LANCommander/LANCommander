@using LANCommander.Server.Services.Enums
@using Microsoft.AspNetCore.SignalR.Client
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@implements IAsyncDisposable

@* A server's live status, with a button to start or stop it *@
<Flex Gap="Gap.Medium" Align="Align.Center" Class="server-control">
    @switch (Status)
    {
        case ServerProcessStatus.Running:
            <Badge Success>Running</Badge>
            break;

        case ServerProcessStatus.Starting:
            <Badge Processing>Starting</Badge>
            break;

        case ServerProcessStatus.Error:
            <Badge Danger>Error</Badge>
            break;

        case ServerProcessStatus.Stopped:
            <Badge>Stopped</Badge>
            break;

        case ServerProcessStatus.Stopping:
            <Badge Danger>Stopping</Badge>
            break;

        default:
            <Badge Warning>Retrieving</Badge>
            break;
    }

    @if (Status != ServerProcessStatus.Running)
    {
        <Button Primary Small Icon="IconType.Play" OnClick="StartAsync" Disabled="Status != ServerProcessStatus.Stopped && Status != ServerProcessStatus.Error">Start</Button>
    }
    else
    {
        <Popconfirm OnConfirm="StopAsync" Title="Are you sure you want to kill this server process?" OkText="Stop" Danger>
            <Button Primary Small Danger Icon="IconType.Stop">Stop</Button>
        </Popconfirm>
    }
</Flex>

@code {
    [Parameter] public Guid ServerId { get; set; }

    HubConnection? _hub;
    CancellationTokenSource? _polling;

    ServerProcessStatus Status = ServerProcessStatus.Retrieving;

    protected override async Task OnInitializedAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/gameserver"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<string>("OnConnected", async _ => await _hub.InvokeAsync("GetStatus", ServerId));

        _hub.On<ServerProcessStatus, Guid>("StatusUpdate", (status, serverId) =>
        {
            if (ServerId == serverId && Status != status)
            {
                Status = status;
                _ = InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            await _hub.StartAsync();
        }
        catch
        {
            // The status stays "Retrieving"; the hub reconnects on its own
        }

        // The hub only pushes changes, so ask for the status every second
        _polling = new CancellationTokenSource();

        _ = PollAsync(_polling.Token);
    }

    async Task PollAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(1000, cancellationToken);

                if (_hub?.State == HubConnectionState.Connected)
                    await _hub.SendAsync("UpdateStatusAsync", ServerId.ToString(), cancellationToken);
            }
        }
        catch
        {
            // Stopped when disposed
        }
    }

    async Task StartAsync()
    {
        if (_hub?.State != HubConnectionState.Connected)
        {
            Notifications.Error("Not connected to the server manager");
            return;
        }

        Status = ServerProcessStatus.Starting;

        try
        {
            await _hub.InvokeAsync("StartServer", ServerId);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The server could not be started");
        }
    }

    async Task StopAsync()
    {
        if (_hub?.State != HubConnectionState.Connected)
        {
            Notifications.Error("Not connected to the server manager");
            return;
        }

        Status = ServerProcessStatus.Stopping;

        try
        {
            await _hub.InvokeAsync("StopServer", ServerId);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The server could not be stopped");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _polling?.Cancel();
        _polling?.Dispose();

        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}
