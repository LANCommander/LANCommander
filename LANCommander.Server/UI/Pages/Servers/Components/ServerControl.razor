@using LANCommander.Server.Services.Enums
@inject ServerManager ServerManager
@inject NotificationService Notifications
@inject ILogger<ServerControl> Logger
@implements IDisposable

@*
    Starts and stops a server. In a list row it shows the live status beside a small Start or Stop
    button; in a server's header (Header) it is the 36px Restart and Stop pair, or Start when the
    server isn't running, and the header shows the status itself.
*@
@if (Header)
{
    @if (Status is ServerProcessStatus.Stopped or ServerProcessStatus.Error)
    {
        <Button Icon="IconType.Play" Loading="_busy" OnClick="StartAsync">Start</Button>
    }
    else
    {
        <Popconfirm OnConfirm="RestartAsync" Title="Restart this server?" Description="Anyone playing on it is disconnected." OkText="Restart" Disabled="Status != ServerProcessStatus.Running || _busy">
            <Button Icon="IconType.ArrowsClockwise" Loading="_restarting" Disabled="Status != ServerProcessStatus.Running || _busy">Restart</Button>
        </Popconfirm>
        <Popconfirm OnConfirm="StopAsync" Title="Stop this server?" Description="This kills the server process." OkText="Stop" Danger Disabled="!CanStop">
            <Button Danger Icon="IconType.Stop" Loading="Status == ServerProcessStatus.Stopping" Disabled="!CanStop">Stop</Button>
        </Popconfirm>
    }
}
else
{
    <Flex Gap="Gap.Medium" Align="Align.Center" Class="server-control">
        @switch (Status)
        {
            case ServerProcessStatus.Running:
                <Badge Success>Running</Badge>
                break;

            case ServerProcessStatus.Starting:
                <Badge Processing>Starting</Badge>
                break;

            case ServerProcessStatus.Error:
                <Badge Danger>Error</Badge>
                break;

            case ServerProcessStatus.Stopped:
                <Badge>Stopped</Badge>
                break;

            case ServerProcessStatus.Stopping:
                <Badge Danger>Stopping</Badge>
                break;

            default:
                <Badge Warning>Retrieving</Badge>
                break;
        }

        @if (Status != ServerProcessStatus.Running)
        {
            <Button Primary Small Icon="IconType.Play" OnClick="StartAsync" Disabled="Status != ServerProcessStatus.Stopped && Status != ServerProcessStatus.Error">Start</Button>
        }
        else
        {
            <Popconfirm OnConfirm="StopAsync" Title="Are you sure you want to kill this server process?" OkText="Stop" Danger>
                <Button Small Danger Icon="IconType.Stop">Stop</Button>
            </Popconfirm>
        }
    </Flex>
}

@code {
    [Parameter] public Guid ServerId { get; set; }

    /// <summary>The header's Restart/Stop (or Start) buttons, without the status badge.</summary>
    [Parameter] public bool Header { get; set; }

    /// <summary>
    /// The status, when the page already follows it (as the server header does). Without it the
    /// control asks the server manager every second itself.
    /// </summary>
    [Parameter] public ServerProcessStatus? CurrentStatus { get; set; }

    /// <summary>Raised when a button changes the status ahead of the next poll, e.g. to Starting.</summary>
    [Parameter] public EventCallback<ServerProcessStatus> CurrentStatusChanged { get; set; }

    ServerProcessStatus _polled = ServerProcessStatus.Retrieving;
    ServerProcessStatus? _pending;
    Timer? _poll;
    bool _busy;
    bool _restarting;

    ServerProcessStatus Status => _pending ?? CurrentStatus ?? _polled;

    bool CanStop => !_busy && Status is ServerProcessStatus.Running or ServerProcessStatus.Starting;

    protected override void OnParametersSet()
    {
        // A fresh status from the page replaces the guess made when a button was pressed
        if (CurrentStatus != null)
            _pending = null;
    }

    protected override void OnInitialized()
    {
        if (CurrentStatus != null)
            return;

        _poll = new Timer(_ => InvokeAsync(async () =>
        {
            try
            {
                var status = await ServerManager.GetStatusAsync(ServerId);

                if (status != _polled || _pending != null)
                {
                    _polled = status;
                    _pending = null;
                    StateHasChanged();
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Could not read the status of server {ServerId}", ServerId);
            }
        }), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    async Task SetPendingAsync(ServerProcessStatus status)
    {
        _pending = status;

        await CurrentStatusChanged.InvokeAsync(status);
    }

    async Task StartAsync()
    {
        await SetPendingAsync(ServerProcessStatus.Starting);

        // The engine's start runs for the server's whole lifetime, so it isn't awaited
        _ = Task.Run(async () =>
        {
            try
            {
                await ServerManager.StartAsync(ServerId);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Could not start server {ServerId}", ServerId);

                await InvokeAsync(() => Notifications.Error(ex, "The server could not be started"));
            }
        });
    }

    async Task StopAsync()
    {
        await SetPendingAsync(ServerProcessStatus.Stopping);

        try
        {
            await ServerManager.StopAsync(ServerId);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The server could not be stopped");
        }
    }

    async Task RestartAsync()
    {
        _busy = true;
        _restarting = true;

        try
        {
            await ServerManager.RestartAsync(ServerId);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The server could not be restarted");
        }
        finally
        {
            _busy = false;
            _restarting = false;
        }
    }

    public void Dispose() => _poll?.Dispose();
}
