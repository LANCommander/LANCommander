@using LANCommander.SDK.Enums
@using Microsoft.EntityFrameworkCore
@inject ServerService ServerService
@inject NavigationManager NavigationManager

<SideLayout>
    <Side>
        <Menu>
            <MenuItem Icon="IconType.Info" Href="@(Id == Guid.Empty ? "/Servers/Add" : $"/Servers/{Id}/General")" Exact>General</MenuItem>

            @if (Id != Guid.Empty)
            {
                <MenuItem Icon="IconType.Play" Href="@($"/Servers/{Id}/Actions")">Actions</MenuItem>
                <MenuItem Icon="IconType.Power" Href="@($"/Servers/{Id}/Autostart")">Autostart</MenuItem>
                <MenuItem Icon="IconType.Globe" Href="@($"/Servers/{Id}/HTTP")">HTTP</MenuItem>
                <MenuItem Icon="IconType.TerminalWindow" Href="@($"/Servers/{Id}/Consoles")">Consoles</MenuItem>

                @if (LogConsoles.Any())
                {
                    <SubMenu Icon="IconType.Monitor" Title="Monitor">
                        <MenuItem Href="@($"/Servers/{Id}/Monitor/Console")">Process Output</MenuItem>
                        @foreach (var console in LogConsoles)
                        {
                            <MenuItem Href="@($"/Servers/{Id}/Monitor/{console.Id}")">@console.Name</MenuItem>
                        }
                    </SubMenu>
                }
                else
                {
                    <MenuItem Icon="IconType.Monitor" Href="@($"/Servers/{Id}/Monitor")">Monitor</MenuItem>
                }

                <MenuItem Icon="IconType.Code" Href="@($"/Servers/{Id}/Scripts")">Scripts</MenuItem>
            }
        </Menu>
    </Side>

    <ChildContent>
        <PageHeader>
            <TitleTemplate>
                @if (TitleTemplate != null)
                {
                    @TitleTemplate(Server)
                }
                else
                {
                    @Title
                }
            </TitleTemplate>
            <Extra>
                @if (ShowControl && Server.Id != Guid.Empty)
                {
                    <ServerControl ServerId="Server.Id" />
                }
                @TitleExtraTemplate?.Invoke(Server)
            </Extra>
        </PageHeader>

        @* PageContent catches errors, so a failing section leaves the menu and header usable *@
        <PageContent Loading="_loading">
            @if (!_loading && Server.Id == Id)
            {
                <CascadingValue Value="Server.Id" Name="ServerId">
                    @ChildContent?.Invoke(Server)
                </CascadingValue>
            }
        </PageContent>
    </ChildContent>
</SideLayout>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment<Server>? TitleTemplate { get; set; }
    [Parameter] public RenderFragment<Server>? TitleExtraTemplate { get; set; }
    [Parameter] public RenderFragment<Server>? ChildContent { get; set; }

    /// <summary>Shows the server's status and start/stop button in the header.</summary>
    [Parameter] public bool ShowControl { get; set; } = true;

    Server Server { get; set; } = new();
    Guid? _id;
    bool _loading = true;

    IEnumerable<ServerConsole> LogConsoles => Server.ServerConsoles?.Where(c => c.Type == ServerConsoleType.LogFile) ?? [];

    protected override async Task OnParametersSetAsync()
    {
        if (_id == Id)
            return;

        _id = Id;
        _loading = true;

        if (Id != Guid.Empty)
        {
            var server = await ServerService
                .Query(query => query
                    .Include(s => s.Actions)
                    .Include(s => s.Game)
                    .ThenInclude(g => g.Archives)
                    .Include(s => s.HttpPaths)
                    .Include(s => s.Scripts)
                    .Include(s => s.ServerConsoles))
                .GetAsync(Id);

            if (server == null)
            {
                NavigationManager.NavigateTo("/Servers");
                return;
            }

            Server = server;
        }
        else
            Server = new Server();

        _loading = false;
    }
}
