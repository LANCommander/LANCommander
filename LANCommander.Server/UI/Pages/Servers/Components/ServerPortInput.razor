@inject ServerService ServerService

@* A port number, checked against the other servers' ports as it changes *@
<NumberInput TValue="int" Value="Value" ValueChanged="ChangedAsync" Min="0" Max="65535" />

@code {
    [Parameter] public Guid ServerId { get; set; }
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public bool PortInUse { get; set; }
    [Parameter] public EventCallback<bool> PortInUseChanged { get; set; }

    protected override Task OnInitializedAsync() => CheckAsync(Value);

    async Task ChangedAsync(int value)
    {
        Value = value;

        await ValueChanged.InvokeAsync(value);
        await CheckAsync(value);
    }

    async Task CheckAsync(int value)
    {
        if (value <= 0)
            return;

        PortInUse = await ServerService.ExistsAsync(s => s.Port == value && s.Id != ServerId);

        await PortInUseChanged.InvokeAsync(PortInUse);
    }
}
