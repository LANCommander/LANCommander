@page "/Servers/{id:guid}/Consoles"
@using LANCommander.Server.UI.Pages.Servers.Components
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<ServerEditView Id="Id" Title="Consoles">
    <TitleExtraTemplate>
        <Button Primary OnClick="() => _serverConsoleEditor?.Save() ?? Task.CompletedTask">Save</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <ServerConsoleEditor @ref="_serverConsoleEditor" ServerId="Id" />
    </ChildContent>
</ServerEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    ServerConsoleEditor? _serverConsoleEditor;
}
