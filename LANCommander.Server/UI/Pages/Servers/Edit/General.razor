@page "/Servers/Add"
@page "/Servers/{id:guid}"
@page "/Servers/{id:guid}/General"
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@using System.Runtime.InteropServices
@using LANCommander.SDK.Enums
@using LANCommander.Server.Models
@using LANCommander.Server.Services.ServerEngines
@using LANCommander.Server.Settings
@using LANCommander.Server.Settings.Enums
@using LANCommander.Server.Settings.Models
@using LANCommander.Server.UI.Components
@using LANCommander.Server.UI.Pages.Servers.Components
@using Microsoft.Extensions.Options
@inject ServerService ServerService
@inject GameService GameService
@inject DockerServerEngine DockerServerEngine
@inject RemoteServerEngine RemoteServerEngine
@inject IOptions<Settings> Settings
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@inject DialogService Dialogs

<ServerEditView Id="Id">
    <TitleTemplate>
        @(context.Id == Guid.Empty ? "Add New Server" : "General")
    </TitleTemplate>
    <TitleExtraTemplate>
        @if (context.Id != Guid.Empty)
        {
            <Button Icon="IconType.Export" OnClick="() => OpenExportDialogAsync(context)">Export</Button>
        }

        <Button Primary OnClick="() => SaveAsync(context)">Save</Button>
    </TitleExtraTemplate>

    <ChildContent>
        <Form Model="context" OnSubmit="() => SaveAsync(context)">
            <FormItem Label="Name" Required>
                <TextInput @bind-Value="context.Name" AutoFocus="context.Id == Guid.Empty" />
            </FormItem>

            <FormItem Label="Game">
                <Select TValue="Guid?" Items="GameItems" @bind-Value="context.GameId" Placeholder="Select a Game" Searchable Clearable />
            </FormItem>

            <FormItem Label="Engine">
                <EnumSelect TEnum="ServerEngine" @bind-Value="context.Engine" />
            </FormItem>

            @if (context.Engine == ServerEngine.Docker)
            {
                <FormItem Label="Docker Host">
                    <Select TValue="Guid?" Items="HostItems(ServerEngine.Docker)" @bind-Value="context.DockerHostId" @bind-Value:after="() => LoadContainersAsync(context)" />
                </FormItem>

                <FormItem Label="Container">
                    <Select TValue="string" Items="ContainerItems" Disabled="!ContainerItems.Any()" @bind-Value="context.ContainerId" />
                </FormItem>
            }

            @if (context.Engine == ServerEngine.Remote)
            {
                <FormItem Label="Remote Host">
                    <Select TValue="Guid?" Items="HostItems(ServerEngine.Remote)" @bind-Value="context.RemoteHostId" @bind-Value:after="() => LoadRemoteServersAsync(context)" />
                </FormItem>

                <FormItem Label="Remote Server">
                    <Select TValue="Guid?" Items="RemoteServerItems" Disabled="!RemoteServerItems.Any()" @bind-Value="context.RemoteServerId" />
                </FormItem>
            }

            @if (context.Engine != ServerEngine.Remote)
            {
                <FormItem Label="Executable Path">
                    <FilePicker Root="@RootPath" EntrySelectable="x => x is FileManagerFile" @bind-Value="context.Path" OnSelected="path => context.WorkingDirectory = Path.GetDirectoryName(path)" />
                </FormItem>
                <FormItem Label="Arguments">
                    <TextInput @bind-Value="context.Arguments" />
                </FormItem>
                <FormItem Label="Working Directory">
                    <FilePicker Root="@RootPath" Title="Choose Working Directory" OkText="Select Directory" EntrySelectable="x => x is FileManagerDirectory" @bind-Value="context.WorkingDirectory" />
                </FormItem>
            }

            <FormItem Label="Host">
                <TextInput @bind-Value="context.Host" />
            </FormItem>

            <FormItem Label="Port">
                <ChildContent>
                    <ServerPortInput @bind-Value="context.Port" @bind-PortInUse="PortInUse" ServerId="context.Id" />
                </ChildContent>
                <HelpTemplate>
                    @if (PortInUse)
                    {
                        <Typography Warning>Another server may already be bound to this port</Typography>
                    }
                </HelpTemplate>
            </FormItem>

            @if (context.Engine != ServerEngine.Remote)
            {
                <FormItem>
                    <LabelTemplate>
                        <HelpButton>
                            <ChildContent>Use Shell Execute</ChildContent>
                            <Description>Run the server through the shell. Some servers need this because they have a UI or don't write their logs to stdout.</Description>
                        </HelpButton>
                    </LabelTemplate>
                    <ChildContent>
                        <Switch @bind-Value="context.UseShellExecute" />
                    </ChildContent>
                </FormItem>

                <FormItem Label="Termination Method">
                    <EnumSelect TEnum="ProcessTerminationMethod" @bind-Value="context.ProcessTerminationMethod" Only="AllowedProcessTerminationMethods" />
                </FormItem>
            }
        </Form>
    </ChildContent>
</ServerEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    IEnumerable<SelectItem<Guid?>> GameItems = [];
    IEnumerable<SelectItem<string>> ContainerItems = [];
    IEnumerable<SelectItem<Guid?>> RemoteServerItems = [];

    string RootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());
    bool PortInUse;

    static IEnumerable<ProcessTerminationMethod> AllowedProcessTerminationMethods =>
        RuntimeInformation.IsOSPlatform(OSPlatform.Linux) || RuntimeInformation.IsOSPlatform(OSPlatform.OSX)
            ? [ProcessTerminationMethod.SIGHUP, ProcessTerminationMethod.SIGINT, ProcessTerminationMethod.SIGKILL, ProcessTerminationMethod.SIGTERM]
            : [ProcessTerminationMethod.Close, ProcessTerminationMethod.Kill];

    IEnumerable<SelectItem<Guid?>> HostItems(ServerEngine type) =>
        Settings.Value.Server.GameServers.ServerEngines
            .Where(e => e.Type == type)
            .Select(e => new SelectItem<Guid?>(e.Id, e.Name))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        var games = await GameService.Include(g => g.Media).GetAsync();

        GameItems = games
            .OrderBy(g => String.IsNullOrWhiteSpace(g.SortTitle) ? g.Title : g.SortTitle)
            .ToSelectItems(g => (Guid?)g.Id, g => g.Title, image: GetIcon)
            .ToList();
    }

    static string? GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : null;
    }

    async Task LoadContainersAsync(Server server)
    {
        try
        {
            ContainerItems = server.DockerHostId is { } hostId
                ? (await DockerServerEngine.GetContainersAsync(hostId)).ToSelectItems(c => c.Id, c => c.Name).ToList()
                : [];
        }
        catch (Exception ex)
        {
            ContainerItems = [];
            Notifications.Error(ex, "The Docker host's containers could not be listed");
        }
    }

    async Task LoadRemoteServersAsync(Server server)
    {
        try
        {
            RemoteServerItems = server.RemoteHostId is { } hostId
                ? (await RemoteServerEngine.GetRemoteServersAsync(hostId)).ToSelectItems(s => (Guid?)s.Id, s => s.Name).ToList()
                : [];
        }
        catch (Exception ex)
        {
            RemoteServerItems = [];
            Notifications.Error(ex, "The remote host's servers could not be listed");
        }
    }

    async Task SaveAsync(Server server)
    {
        try
        {
            if (server.Id != Guid.Empty)
            {
                await ServerService.UpdateAsync(server);

                Notifications.Success("Server updated!");
            }
            else
            {
                server = await ServerService.AddAsync(server);

                Notifications.Success("Server added!");

                NavigationManager.NavigateTo($"/Servers/{server.Id}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not save!");
        }
    }

    Task OpenExportDialogAsync(Server server) =>
        Dialogs.OpenAsync<ExportDialog, ExportDialogOptions, bool>($"Export {server.Name}", new ExportDialogOptions
        {
            RecordId = server.Id,
            RecordType = ImportExportRecordType.Server,
        }, new DialogSettings { OkText = "Export" });
}
