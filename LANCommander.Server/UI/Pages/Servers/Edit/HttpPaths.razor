@page "/Servers/{id:guid}/HTTP"
@using LANCommander.Server.UI.Pages.Servers.Components
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<ServerEditView Id="Id" Title="HTTP Paths">
    <TitleExtraTemplate>
        <Button Primary OnClick="() => _httpPathEditor?.Save() ?? Task.CompletedTask">Save</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <p class="edit-form-intro">HTTP paths are a way to host static files such as maps and other assets. Engines such as Source, id Tech 3, and Unreal can utilize HTTP for faster downloads when connecting to a server.</p>
        <ServerHttpPathEditor @ref="_httpPathEditor" ServerId="Id" WorkingDirectory="@context.WorkingDirectory" />
    </ChildContent>
</ServerEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    ServerHttpPathEditor? _httpPathEditor;
}
