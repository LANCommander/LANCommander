@page "/Servers/{id:guid}/Monitor"
@page "/Servers/{id:guid}/Monitor/{logId}"
@using LANCommander.Server.UI.Pages.Servers.Components
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<ServerEditView Id="Id" Title="Monitor">
    @* "Console" (or no log) is the server process's own output; otherwise the Id of a log file console *@
    @if (LogId == null || LogId == "Console")
    {
        <Console ServerId="@context.Id" />
    }
    else if (Guid.TryParse(LogId, out var consoleId) && consoleId != Guid.Empty)
    {
        <Console @key="consoleId" ServerId="@context.Id" ServerConsoleId="consoleId" />
    }
    else
    {
        <NotFound SubTitle="This server has no such console." />
    }
</ServerEditView>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? LogId { get; set; }
}
