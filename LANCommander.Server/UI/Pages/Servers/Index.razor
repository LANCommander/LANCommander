@page "/Servers"
@using LANCommander.Server.Models
@using LANCommander.Server.Services.Abstractions
@using LANCommander.Server.UI.Pages.Servers.Components
@using ManifestType = LANCommander.SDK.Enums.ManifestType
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject ServerService ServerService
@inject NavigationManager NavigationManager
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject IServiceProvider ServiceProvider

<PageHeader Title="Servers" Subtitle="@Total.ToString()" />

<PageContent>
    <DataTable TItem="Server"
               @ref="Table"
               Small
               ColumnPicker
               Selectable
               @bind-Values="SelectedServers"
               @bind-Total="Total"
               SearchProperty="s => s.Name"
               OnRowDoubleClick="@(server => NavigationManager.NavigateTo($"/Servers/{server.Id}"))">
        <RightToolbar>
            @if (SelectedServers.Any())
            {
                <Button Primary Icon="IconType.Play" OnClick="StartServersAsync">Start</Button>
                <Popconfirm OnConfirm="StopServersAsync" Title="Are you sure you want to kill these server processes?" OkText="Stop" Danger>
                    <Button Primary Danger Icon="IconType.Stop">Stop</Button>
                </Popconfirm>
            }

            <Button Icon="IconType.UploadSimple" OnClick="OpenImportDialogAsync">Import</Button>
            <Button Primary Icon="IconType.Plus" Href="/Servers/Add">Add Server</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="s => s.Game != null ? s.Game.Title : String.Empty" Title="Game" Include="Game,Game.Media" Sortable>
                @if (context.Game != null)
                {
                    <Flex Align="Align.Center" Gap="Gap.Small">
                        <Image Src="@GetIcon(context.Game)" Width="32" Height="32" />
                        <span>@context.Game.Title</span>
                    </Flex>
                }
            </BoundColumn>
            <BoundColumn Property="s => s.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="s => s.Port" Sortable />
            <BoundColumn Property="s => s.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="s => s.CreatedBy != null ? s.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="s => s.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="s => s.UpdatedBy != null ? s.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Server" Width="300px">
                <ServerControl ServerId="context.Id" />
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Servers/{context.Id}")" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this server?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<Server> Table = default!;

    int Total;

    IList<Server> SelectedServers = new List<Server>();

    async Task DeleteAsync(Server server)
    {
        try
        {
            await ServerService.DeleteAsync(server);

            Notifications.Success($"Deleted {server.Name}");

            await Table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete the server!");
        }
    }

    static string GetIcon(Game game)
    {
        var media = game.Media?.FirstOrDefault(m => m.Type == SDK.Enums.MediaType.Icon);

        return media != null ? $"/api/Media/{media.Id}/Download?fileId={media.FileId}" : "/favicon.ico";
    }

    async Task StartServersAsync()
    {
        foreach (var engine in ServiceProvider.GetServices<IServerEngine>())
        {
            foreach (var server in SelectedServers.Where(s => engine.IsManaging(s.Id)))
            {
                try
                {
                    await engine.StartAsync(server.Id);
                }
                catch (Exception ex)
                {
                    Notifications.Error(ex, $"{server.Name} could not be started");
                }
            }
        }
    }

    async Task StopServersAsync()
    {
        foreach (var engine in ServiceProvider.GetServices<IServerEngine>())
        {
            foreach (var server in SelectedServers.Where(s => engine.IsManaging(s.Id)))
            {
                try
                {
                    await engine.StopAsync(server.Id);
                }
                catch (Exception ex)
                {
                    Notifications.Error(ex, $"{server.Name} could not be stopped");
                }
            }
        }
    }

    async Task OpenImportDialogAsync()
    {
        await Dialogs.OpenAsync<ImportUploadDialog, ImportDialogOptions, bool>("Import Server", new ImportDialogOptions
        {
            Hint = "Only LCX files are supported for importing servers",
            ManifestType = ManifestType.Server,
        }, new DialogSettings { NoFooter = true, Size = DialogSize.Large });

        await Table.ReloadAsync();
    }
}
