@page "/Settings/Appearance"
@inject DialogService Dialogs
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Appearance" />

<PageContent>
    <h3>Custom Stylesheet</h3>
    <p>Modify the appearance of the web UI using a custom stylesheet.</p>
    <Button Primary OnClick="@(() => EditStylesheetAsync("custom.css", "Custom Stylesheet"))">Edit</Button>

    <Divider />

    <h3>Pages Stylesheet</h3>
    <p>Define a custom stylesheet to be used in <a href="/Pages/Edit">Pages</a>.</p>
    <Button Primary OnClick="@(() => EditStylesheetAsync("pages.css", "Pages Stylesheet"))">Edit</Button>
</PageContent>

@code {
    Task EditStylesheetAsync(string fileName, string title) =>
        Dialogs.OpenAsync<StylesheetEditorDialog, string, bool>(title, fileName, new DialogSettings
        {
            Size = DialogSize.Full,
            OkText = "Save",
        });
}
