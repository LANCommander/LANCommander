@page "/Settings/Archives"
@using LANCommander.Server.Settings
@using Microsoft.Extensions.Options
@inject StorageLocationService StorageLocationService
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Archives" />

<PageContent Loading="StorageLocations == null">
    @if (StorageLocations != null)
    {
        <Form Model="Settings.Value" OnSubmit="SaveAsync" Loading="_saving">
            <FormItem Label="Allow Insecure Downloads">
                <Switch @bind-Value="Settings.Value.Server.Archives.AllowInsecureDownloads" />
            </FormItem>

            <FormItem Label="Max Upload Chunk Size (MB)">
                <NumberInput @bind-Value="Settings.Value.Server.Archives.MaxChunkSize" Min="1" />
            </FormItem>

            <FormItem Label="Storage Paths">
                <Flex Vertical Gap="Gap.Medium">
                    <Table TItem="StorageLocation" Items="StorageLocations" Key="l => l" NoPaging SettingsKey="settings-archive-storage">
                        <Columns>
                            <TemplateColumn TItem="StorageLocation" Title="Path">
                                <FilePicker @bind-Value="context.Path" Title="Select Storage Location" Root="@RootPath" OnSelected="path => OnPathSelected(context, path)" />
                            </TemplateColumn>
                            <TemplateColumn TItem="StorageLocation" Title="Default" Width="100px">
                                <Checkbox @bind-Value="context.Default" />
                            </TemplateColumn>
                            <ActionsColumn TItem="StorageLocation">
                                <Popconfirm OnConfirm="() => RemoveStorageLocation(context)" Title="Are you sure you want to remove this storage location?" OkText="Remove" Danger>
                                    <Button Text Danger Icon="IconType.X" title="Remove" />
                                </Popconfirm>
                            </ActionsColumn>
                        </Columns>
                    </Table>

                    <Flex Justify="Justify.End">
                        <Button Primary OnClick="AddStorageLocation">Add Path</Button>
                    </Flex>
                </Flex>
            </FormItem>

            <FormItem>
                <Button Primary Submit>Save</Button>
            </FormItem>
        </Form>
    }
</PageContent>

@code {
    List<StorageLocation>? StorageLocations;
    bool _saving;

    string RootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    protected override async Task OnInitializedAsync()
    {
        StorageLocations = (await StorageLocationService.GetAsync(l => l.Type == SDK.Enums.StorageLocationType.Archive)).ToList();
    }

    async Task SaveAsync()
    {
        _saving = true;

        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.Archives = Settings.Value.Server.Archives;
            });

            if (StorageLocations!.Count > 0 && !StorageLocations.Any(l => l.Default))
                StorageLocations[0].Default = true;

            foreach (var storageLocation in StorageLocations)
            {
                storageLocation.Type = SDK.Enums.StorageLocationType.Archive;

                if (storageLocation.Id != Guid.Empty)
                    await StorageLocationService.UpdateAsync(storageLocation);
                else
                    await StorageLocationService.AddAsync(storageLocation);
            }

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
        finally
        {
            _saving = false;
        }
    }

    void OnPathSelected(StorageLocation storageLocation, string path)
    {
        var appPath = Directory.GetCurrentDirectory();

        if (path != null && path.StartsWith(appPath))
            path = path.Substring(appPath.Length).TrimStart(Path.DirectorySeparatorChar).TrimEnd(Path.DirectorySeparatorChar);

        storageLocation.Path = path;
    }

    // New lists so the table notices the change
    void AddStorageLocation() =>
        StorageLocations = [.. StorageLocations!, new StorageLocation { Type = SDK.Enums.StorageLocationType.Archive }];

    void RemoveStorageLocation(StorageLocation storageLocation) =>
        StorageLocations = StorageLocations!.Where(l => l != storageLocation).ToList();
}
