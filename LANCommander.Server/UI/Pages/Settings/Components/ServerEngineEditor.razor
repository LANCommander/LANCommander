@using LANCommander.Server.Services.ServerEngines
@using LANCommander.Server.Settings.Enums
@using LANCommander.Server.Settings.Models
@using LANCommander.Server.Plugins
@inject RemoteServerEngine RemoteServerEngine
@inject PluginServerEngines PluginEngines

<Flex Vertical Gap="Gap.Large">
    @if (!Shown.Any() && !PluginSettings.Any())
    {
        <Empty Description="No engines have been configured" />
    }

    <Collapse>
        @foreach (var serverEngine in Shown)
        {
            <Panel Header="@serverEngine.Name">
                <Extra>
                    <Button Text Small Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveAsync(serverEngine)" />
                </Extra>
                <ChildContent>
                    <Form Model="serverEngine">
                        <FormItem Label="Name">
                            <TextInput @bind-Value="serverEngine.Name" Immediate />
                        </FormItem>

                        @if (serverEngine.Type == ServerEngine.Remote)
                        {
                            var state = _remoteStates[serverEngine.Id];

                            <FormItem Label="Address">
                                <TextInput @bind-Value="serverEngine.Address" Placeholder="http://other-server:1337" />
                            </FormItem>

                            <FormItem Label="Status">
                                @if (!string.IsNullOrWhiteSpace(serverEngine.AccessToken) && serverEngine.TokenExpiration > DateTime.UtcNow)
                                {
                                    <Tag Success>Connected</Tag>
                                }
                                else
                                {
                                    <Tag>Not Connected</Tag>
                                }
                            </FormItem>

                            @if (string.IsNullOrWhiteSpace(serverEngine.AccessToken) || serverEngine.TokenExpiration > DateTime.UtcNow)
                            {
                                <FormItem Label="Username">
                                    <TextInput @bind-Value="state.Username" />
                                </FormItem>

                                <FormItem Label="Password">
                                    <PasswordInput @bind-Value="state.Password" />
                                </FormItem>
                            }

                            @if (!string.IsNullOrWhiteSpace(state.Error))
                            {
                                <Alert Danger>@state.Error</Alert>
                            }

                            <FormItem>
                                <Button Primary Loading="state.Connecting" OnClick="() => ConnectAsync(serverEngine)">Connect</Button>
                            </FormItem>
                        }
                    </Form>
                </ChildContent>
            </Panel>
        }

        @* Plugins' engines configure themselves, and are saved with the page through their context *@
        @foreach (var extension in PluginSettings)
        {
            <Panel Header="@extension.Name" Class="server-engine-extension" data-engine="@extension.Id">
                <Extra>
                    <Tag>Plugin</Tag>
                </Extra>
                <ChildContent>
                    <ErrorHandler Inline Title="@($"The {extension.Name} engine's settings could not be displayed")">
                        <DynamicComponent @key="extension.Id" Type="extension.SettingsComponent" Parameters="SettingsParameters(extension)" />
                    </ErrorHandler>
                </ChildContent>
            </Panel>
        }
    </Collapse>

    <Flex Justify="Justify.Center" Gap="Gap.Small">
        <Button OnClick="() => AddAsync(ServerEngine.Local)">Add Local</Button>
        <Button Primary OnClick="() => AddAsync(ServerEngine.Remote)">Add Remote</Button>
    </Flex>
</Flex>

@code {
    [Parameter] public IEnumerable<ServerEngineConfiguration> Values { get; set; } = [];
    [Parameter] public EventCallback<IEnumerable<ServerEngineConfiguration>> ValuesChanged { get; set; }
    [Parameter] public EventCallback Save { get; set; }

    class RemoteEngineState
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Error { get; set; } = string.Empty;
        public bool Connecting { get; set; }
    }

    List<ServerEngineConfiguration> ServerEngines = new();

    // Docker hosts are kept until the Docker plugin takes them over, but are its to manage now
    IEnumerable<ServerEngineConfiguration> Shown => ServerEngines.Where(e => e.Type != ServerEngine.Docker);

    Dictionary<Guid, RemoteEngineState> _remoteStates = new();

    // Plugins' engines that have something to configure, after the built-in ones
    IEnumerable<IServerEngineExtension> PluginSettings => PluginEngines.Extensions
        .Where(e => e.SettingsComponent != null)
        .OrderBy(e => e.Name, StringComparer.CurrentCultureIgnoreCase);

    // What each plugin engine's settings component has asked to run when the page is saved, by engine id
    readonly Dictionary<string, List<Func<CancellationToken, Task>>> _saveHandlers = new(StringComparer.OrdinalIgnoreCase);
    readonly Dictionary<string, Dictionary<string, object?>> _settingsParameters = new(StringComparer.OrdinalIgnoreCase);

    // Kept per engine so the component isn't handed a new context, and re-rendered, on every render
    Dictionary<string, object?> SettingsParameters(IServerEngineExtension extension)
    {
        if (!_settingsParameters.TryGetValue(extension.Id, out var parameters))
        {
            parameters = new()
            {
                ["Context"] = new ServerEngineSettingsContext(save => Register(extension.Id, save)),
            };

            _settingsParameters[extension.Id] = parameters;
        }

        return parameters;
    }

    IDisposable Register(string engineId, Func<CancellationToken, Task> save)
    {
        if (!_saveHandlers.TryGetValue(engineId, out var handlers))
            _saveHandlers[engineId] = handlers = new();

        handlers.Add(save);

        return new Registration(() => handlers.Remove(save));
    }

    sealed class Registration(System.Action remove) : IDisposable
    {
        System.Action? _remove = remove;

        public void Dispose() => Interlocked.Exchange(ref _remove, null)?.Invoke();
    }

    /// <summary>
    /// Saves the plugin engines' settings, each regardless of whether the others could be. Returns
    /// those that couldn't be, by engine name.
    /// </summary>
    public async Task<IReadOnlyList<(string Engine, Exception Error)>> SaveExtensionsAsync(CancellationToken cancellationToken = default)
    {
        var failures = new List<(string, Exception)>();

        foreach (var extension in PluginSettings)
        {
            if (!_saveHandlers.TryGetValue(extension.Id, out var handlers))
                continue;

            // A handler may unregister itself while saving
            foreach (var save in handlers.ToList())
            {
                try
                {
                    await save(cancellationToken);
                }
                catch (Exception ex)
                {
                    failures.Add((extension.Name, ex));
                }
            }
        }

        return failures;
    }

    protected override void OnParametersSet()
    {
        ServerEngines = (Values ?? []).OrderBy(e => e.Type).ThenBy(e => e.Name).ToList();

        foreach (var engine in ServerEngines.Where(e => e.Type == ServerEngine.Remote))
            _remoteStates.TryAdd(engine.Id, new RemoteEngineState());
    }

    async Task AddAsync(ServerEngine type)
    {
        var newEngine = new ServerEngineConfiguration
        {
            Type = type,
            Name = type.ToString()
        };

        ServerEngines.Add(newEngine);

        if (type == ServerEngine.Remote)
            _remoteStates[newEngine.Id] = new RemoteEngineState();

        await ValuesChanged.InvokeAsync(ServerEngines);
    }

    async Task RemoveAsync(ServerEngineConfiguration serverEngine)
    {
        ServerEngines.Remove(serverEngine);

        _remoteStates.Remove(serverEngine.Id);

        await ValuesChanged.InvokeAsync(ServerEngines);

        await Save.InvokeAsync();
    }

    async Task ConnectAsync(ServerEngineConfiguration serverEngine)
    {
        var state = _remoteStates[serverEngine.Id];

        state.Connecting = true;
        state.Error = string.Empty;

        try
        {
            await Save.InvokeAsync();

            var error = await RemoteServerEngine.AuthenticateAsync(serverEngine.Id, state.Username, state.Password);

            if (!string.IsNullOrWhiteSpace(error))
                state.Error = error;
        }
        catch (Exception ex)
        {
            state.Error = ex.Message;
        }
        finally
        {
            state.Connecting = false;
        }
    }
}
