@using LANCommander.Server.Services.ServerEngines
@using LANCommander.Server.Settings.Enums
@using LANCommander.Server.Settings.Models
@inject RemoteServerEngine RemoteServerEngine

<Flex Vertical Gap="Gap.Large">
    @if (!ServerEngines.Any())
    {
        <Empty Description="No engines have been configured" />
    }

    <Collapse>
        @foreach (var serverEngine in ServerEngines)
        {
            <Panel Header="@serverEngine.Name">
                <Extra>
                    <Button Text Small Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveAsync(serverEngine)" />
                </Extra>
                <ChildContent>
                    <Form Model="serverEngine">
                        <FormItem Label="Name">
                            <TextInput @bind-Value="serverEngine.Name" Immediate />
                        </FormItem>

                        @if (serverEngine.Type == ServerEngine.Docker)
                        {
                            <FormItem Label="Address">
                                <TextInput @bind-Value="serverEngine.Address" />
                            </FormItem>
                        }

                        @if (serverEngine.Type == ServerEngine.Remote)
                        {
                            var state = _remoteStates[serverEngine.Id];

                            <FormItem Label="Address">
                                <TextInput @bind-Value="serverEngine.Address" Placeholder="http://other-server:1337" />
                            </FormItem>

                            <FormItem Label="Status">
                                @if (!string.IsNullOrWhiteSpace(serverEngine.AccessToken) && serverEngine.TokenExpiration > DateTime.UtcNow)
                                {
                                    <Tag Success>Connected</Tag>
                                }
                                else
                                {
                                    <Tag>Not Connected</Tag>
                                }
                            </FormItem>

                            @if (string.IsNullOrWhiteSpace(serverEngine.AccessToken) || serverEngine.TokenExpiration > DateTime.UtcNow)
                            {
                                <FormItem Label="Username">
                                    <TextInput @bind-Value="state.Username" />
                                </FormItem>

                                <FormItem Label="Password">
                                    <PasswordInput @bind-Value="state.Password" />
                                </FormItem>
                            }

                            @if (!string.IsNullOrWhiteSpace(state.Error))
                            {
                                <Alert Danger>@state.Error</Alert>
                            }

                            <FormItem>
                                <Button Primary Loading="state.Connecting" OnClick="() => ConnectAsync(serverEngine)">Connect</Button>
                            </FormItem>
                        }
                    </Form>
                </ChildContent>
            </Panel>
        }
    </Collapse>

    <Flex Justify="Justify.Center" Gap="Gap.Small">
        <Button OnClick="() => AddAsync(ServerEngine.Local)">Add Local</Button>
        <Button OnClick="() => AddAsync(ServerEngine.Docker)">Add Docker</Button>
        <Button Primary OnClick="() => AddAsync(ServerEngine.Remote)">Add Remote</Button>
    </Flex>
</Flex>

@code {
    [Parameter] public IEnumerable<ServerEngineConfiguration> Values { get; set; } = [];
    [Parameter] public EventCallback<IEnumerable<ServerEngineConfiguration>> ValuesChanged { get; set; }
    [Parameter] public EventCallback Save { get; set; }

    class RemoteEngineState
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Error { get; set; } = string.Empty;
        public bool Connecting { get; set; }
    }

    List<ServerEngineConfiguration> ServerEngines = new();

    Dictionary<Guid, RemoteEngineState> _remoteStates = new();

    protected override void OnParametersSet()
    {
        ServerEngines = (Values ?? []).OrderBy(e => e.Type).ThenBy(e => e.Name).ToList();

        foreach (var engine in ServerEngines.Where(e => e.Type == ServerEngine.Remote))
            _remoteStates.TryAdd(engine.Id, new RemoteEngineState());
    }

    async Task AddAsync(ServerEngine type)
    {
        var newEngine = new ServerEngineConfiguration
        {
            Type = type,
            Name = type.ToString()
        };

        ServerEngines.Add(newEngine);

        if (type == ServerEngine.Remote)
            _remoteStates[newEngine.Id] = new RemoteEngineState();

        await ValuesChanged.InvokeAsync(ServerEngines);
    }

    async Task RemoveAsync(ServerEngineConfiguration serverEngine)
    {
        ServerEngines.Remove(serverEngine);

        _remoteStates.Remove(serverEngine.Id);

        await ValuesChanged.InvokeAsync(ServerEngines);

        await Save.InvokeAsync();
    }

    async Task ConnectAsync(ServerEngineConfiguration serverEngine)
    {
        var state = _remoteStates[serverEngine.Id];

        state.Connecting = true;
        state.Error = string.Empty;

        try
        {
            await Save.InvokeAsync();

            var error = await RemoteServerEngine.AuthenticateAsync(serverEngine.Id, state.Username, state.Password);

            if (!string.IsNullOrWhiteSpace(error))
                state.Error = error;
        }
        catch (Exception ex)
        {
            state.Error = ex.Message;
        }
        finally
        {
            state.Connecting = false;
        }
    }
}
