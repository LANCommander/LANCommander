@using LANCommander.Server.Services.Enums
@using LANCommander.Steam.Abstractions
@using LANCommander.Steam.Enums
@inject ISteamCmdService SteamCmdService
@inject NotificationService Notifications

<Spin Loading="_connectionStatus == SteamCmdConnectionStatus.Unknown">
    @if (_connectionStatus == SteamCmdConnectionStatus.Unauthenticated)
    {
        <Form Model="this" OnSubmit="AuthenticateAsync" Disabled="_processingLogin">
            <Flex Gap="Gap.Medium" Align="Align.End">
                <FormItem Label="Username" Style="flex-grow: 1">
                    <TextInput Value="@Username" ValueChanged="UsernameChanged" />
                </FormItem>
                <FormItem Label="Password" Style="flex-grow: 1">
                    <PasswordInput @bind-Value="_password" />
                </FormItem>
                <FormItem>
                    <Button Primary Submit Loading="_processingLogin">Login</Button>
                </FormItem>
            </Flex>
        </Form>
    }

    <Form Model="this">
        @if (_connectionStatus != SteamCmdConnectionStatus.Unauthenticated)
        {
            <FormItem Label="Username">
                <TextInput Value="@Username" Disabled />
            </FormItem>
        }

        <FormItem Label="Install Directory">
            <FilePicker Value="@InstallDirectory" ValueChanged="InstallDirectoryChanged" Root="@_rootPath" />
        </FormItem>
    </Form>
</Spin>

@code {
    [Parameter] public string? Username { get; set; }
    [Parameter] public EventCallback<string?> UsernameChanged { get; set; }
    [Parameter] public string? InstallDirectory { get; set; }
    [Parameter] public EventCallback<string?> InstallDirectoryChanged { get; set; }
    [Parameter] public EventCallback OnAuthenticated { get; set; }

    string _rootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    SteamCmdConnectionStatus _connectionStatus = SteamCmdConnectionStatus.Unknown;

    bool _processingLogin;
    string? _password = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!String.IsNullOrWhiteSpace(Username))
                _connectionStatus = await SteamCmdService.GetConnectionStatusAsync(Username);
            else
                _connectionStatus = SteamCmdConnectionStatus.Unauthenticated;
        }
        catch (Exception ex)
        {
            _connectionStatus = SteamCmdConnectionStatus.Unauthenticated;

            Notifications.Error(ex, "The Steam connection could not be checked");
        }
    }

    async Task AuthenticateAsync()
    {
        _processingLogin = true;

        var progress = Notifications.ShowPersistent(NotificationLevel.Info, "Logging into Steam...", "Check the Steam mobile app to confirm this login");

        try
        {
            var status = await SteamCmdService.LoginToSteamAsync(Username, _password);

            progress.Close();

            if (status == SteamCmdStatus.Success)
            {
                _connectionStatus = await SteamCmdService.GetConnectionStatusAsync(Username);

                Notifications.Success("Successfully authenticated to Steam!");

                _password = String.Empty;

                await UsernameChanged.InvokeAsync(Username);
                await InstallDirectoryChanged.InvokeAsync(InstallDirectory);
                await OnAuthenticated.InvokeAsync();
            }
            else
            {
                Notifications.Error(status switch
                {
                    SteamCmdStatus.InvalidUsername or SteamCmdStatus.InvalidPassword => "Invalid username or password",
                    SteamCmdStatus.ExecutableNotFound => "SteamCMD executable not found",
                    SteamCmdStatus.PathNotConfigured => "SteamCMD path not configured",
                    SteamCmdStatus.Error => "SteamCMD returned an error, check logs for info.",
                    _ => "An unknown error occurred, check logs for more info",
                });
            }
        }
        catch (Exception ex)
        {
            progress.Close();

            Notifications.Error(ex, "Could not log into Steam");
        }
        finally
        {
            _processingLogin = false;
        }
    }
}
