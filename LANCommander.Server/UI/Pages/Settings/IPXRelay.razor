@page "/Settings/IPXRelay"
@using LANCommander.Server.Settings
@using Microsoft.Extensions.Options
@inject IPXRelayService IPXRelayService
@inject NotificationService Notifications
@inject ILogger<IPXRelay> Logger
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="IPX Relay" />

<PageContent>
    <Form Model="Settings.Value" OnSubmit="SaveAsync" Loading="_saving">
        <FormItem Label="Enable">
            <Switch @bind-Value="Settings.Value.Server.IPXRelay.Enabled" />
        </FormItem>

        <FormItem Label="Host">
            <Typography Secondary>Use this to customize the host that is broadcasted to clients.</Typography>
            <TextInput @bind-Value="Settings.Value.Server.IPXRelay.Host" />
        </FormItem>

        <FormItem Label="Port">
            <NumberInput @bind-Value="Settings.Value.Server.IPXRelay.Port" Min="0" Max="65535" />
        </FormItem>

        <FormItem Label="Logging">
            <Switch @bind-Value="Settings.Value.Server.IPXRelay.Logging" />
        </FormItem>

        <FormItem>
            <Button Primary Submit>Save</Button>
        </FormItem>
    </Form>
</PageContent>

@code {
    bool _saving;

    async Task SaveAsync()
    {
        _saving = true;

        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.IPXRelay = Settings.Value.Server.IPXRelay;
            });

            Notifications.Success("Settings saved!");

            await IPXRelayService.StopAsync();

            IPXRelayService.Init(Logger);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The IPX relay could not be restarted");
        }
        finally
        {
            _saving = false;
        }
    }
}
