@page "/Settings/Integrations/HQ"
@using LANCommander.Server.Settings
@using LANCommander.Server.UI.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject IHqConnectionState HqConnection
@inject HqAuthorizationStateStore HqAuthorizationState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject NotificationService Notifications
@inject IJSRuntime JS
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="LANCommander HQ">
    <Extra>
        <Button Text Icon="IconType.Question" Href="https://lancommander.app/HQ" NewTab title="About HQ" />
        <Button Primary OnClick="Save">Save</Button>
    </Extra>
</PageHeader>

<PageContent>
    @* Named context so it does not collide with other templates on the page. *@
    <HqConnectionProvider Context="connection" OnConnectionChanged="OnConnectionChanged">
        @switch (connection.Status)
        {
            case HqConnectionStatus.Unknown:
                <Flex Justify="Justify.Center" Style="padding: 32px">
                    <Spin Tip="Checking your connection to LANCommander HQ..." />
                </Flex>
                break;

            case HqConnectionStatus.Connected when connection.IsPremium:
                <Result Success Title="Premium Account" SubTitle="@($"Thank you for supporting LANCommander{(connection.Username is null ? "" : $", {connection.Username}")}!")">
                    <Button Primary Href="https://hq.lancommander.app/Account">Account</Button>
                    <Button Danger OnClick="DisconnectAsync">Unlink</Button>
                </Result>
                break;

            case HqConnectionStatus.Connected:
                <Result Success Title="Basic Account" SubTitle="@connection.Username">
                    <Content>
                        <Typography>Your server is linked to a basic account. Upgrade your account to access the following features:</Typography>
                        <ul>
                            <li>Access premium metadata providers</li>
                            <li>Curated/enhanced metadata</li>
                            <li>Support future LANCommander development!</li>
                        </ul>
                    </Content>
                    <ChildContent>
                        <Button Primary Href="https://hq.lancommander.app/Account">Upgrade</Button>
                        <Button Danger OnClick="DisconnectAsync">Unlink</Button>
                    </ChildContent>
                </Result>
                break;

            case HqConnectionStatus.Unauthorized:
                <Result Warning Title="Reconnect to LANCommander HQ" SubTitle="@UnauthorizedSubtitle">
                    <Content>
                        <Typography Secondary>@connection.LastError</Typography>
                    </Content>
                    <ChildContent>
                        <Button Primary OnClick="ConnectAsync" Loading="_awaitingAuth">Reconnect</Button>
                        <Button Danger OnClick="DisconnectAsync">Unlink</Button>
                    </ChildContent>
                </Result>
                break;

            case HqConnectionStatus.Unreachable:
                @* The credential is not implicated here, so it is deliberately left in place. *@
                <Result Warning Title="Can't reach LANCommander HQ" SubTitle="@UnreachableSubtitle(connection)">
                    <Content>
                        <Typography Secondary>@connection.LastError</Typography>
                    </Content>
                    <ChildContent>
                        <Button Primary OnClick="RetryAsync" Loading="_retrying">Retry</Button>
                        <Button Danger OnClick="DisconnectAsync">Unlink</Button>
                    </ChildContent>
                </Result>
                break;

            default:
                <Flex Vertical Gap="Gap.Medium">
                    <Typography>Connect your server to LANCommander HQ for access to expanded metadata providers, faster lookups, and premium features. All through one account.</Typography>

                    <Alert Info>Not Connected</Alert>

                    <HqFeatureCards />

                    <Flex Justify="Justify.Center">
                        <Button Block Primary OnClick="ConnectAsync" Loading="_awaitingAuth" Style="max-width: 33%">Connect to HQ</Button>
                    </Flex>
                </Flex>
                break;
        }
    </HqConnectionProvider>

    <Divider>Advanced</Divider>

    <Form Model="Settings.Value" OnSubmit="Save">
        <FormItem Label="Base URL">
            <TextInput @bind-Value="Settings.Value.Server.HQ.BaseUrl" />
        </FormItem>
    </Form>
</PageContent>

@code {
    bool _awaitingAuth;
    bool _retrying;

    // Deliberately not phrased around the access token expiring — that is renewed automatically
    // now. Reaching this state means the session itself ended: revoked from the account page,
    // idled out, or invalidated because the credential was used from somewhere else.
    const string UnauthorizedSubtitle =
        "This server's connection to LANCommander HQ has ended and must be set up again.";

    static string UnreachableSubtitle(HqConnectionSnapshot connection) =>
        connection.Username is null
            ? "Your credentials are still stored and will be used once HQ is reachable again."
            : $"Still linked to {connection.Username}. Your credentials are stored and will be used once HQ is reachable again.";

    Task OnConnectionChanged(HqConnectionSnapshot connection)
    {
        // The callback endpoint verifies before it responds, so this event is the signal that the
        // popup finished. It fires unconditionally for that path, so a retry that fails exactly as
        // the last one did still reaches us. This replaces polling the stored token every two
        // seconds.
        if (_awaitingAuth)
        {
            _awaitingAuth = false;

            if (connection.Status == HqConnectionStatus.Connected)
            {
                Notifications.Success("Successfully connected to LANCommander HQ!");
            }
            else
            {
                // Not "connected but unverified" — the exchange itself can fail, in which case the
                // server never connected at all. Disconnected lands here too; it used to fall
                // through silently and leave the administrator with no feedback whatsoever.
                Notifications.Error(string.IsNullOrWhiteSpace(connection.LastError)
                    ? "Could not connect to LANCommander HQ. Check the server logs for details."
                    : connection.LastError);
            }
        }

        return Task.CompletedTask;
    }

    async Task ConnectAsync()
    {
        try
        {
            var baseUrl = Settings.Value.Server.HQ.BaseUrl.TrimEnd('/');
            var callbackUrl = NavigationManager.BaseUri.TrimEnd('/') + "/api/HQ/Callback";
            var tokenRelayUrl = $"{baseUrl}/Auth/TokenRelay?returnUrl={Uri.EscapeDataString(callbackUrl)}";
            var loginUrl = $"{baseUrl}/Auth/Login?returnUrl={Uri.EscapeDataString(tokenRelayUrl)}";

            // Marks this administrator as having started the flow. The callback rejects tokens that
            // don't correspond to a login someone deliberately began here.
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            HqAuthorizationState.Issue(authState.User.Identity?.Name);

            _awaitingAuth = true;

            await JS.InvokeVoidAsync("open", loginUrl, "hq_auth", "width=600,height=700,menubar=no,toolbar=no");
        }
        catch (Exception ex)
        {
            _awaitingAuth = false;

            Notifications.Error(ex, "Could not start connecting to LANCommander HQ");
        }
    }

    async Task RetryAsync()
    {
        _retrying = true;

        try
        {
            await HqConnection.VerifyAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Failed to verify connection to LANCommander HQ");
        }
        finally
        {
            _retrying = false;
        }
    }

    async Task DisconnectAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            HqAuthorizationState.Revoke(authState.User.Identity?.Name);

            await HqConnection.DisconnectAsync();

            _awaitingAuth = false;

            Notifications.Success("Disconnected from LANCommander HQ.");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not disconnect from LANCommander HQ");
        }
    }

    void Save()
    {
        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.HQ.BaseUrl = Settings.Value.Server.HQ.BaseUrl;
            });

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
    }
}
