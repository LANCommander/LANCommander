@page "/Settings/Integrations/HQ"
@using LANCommander.Server.Settings
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject IHqConnectionState HqConnection
@inject HqAuthorizationStateStore HqAuthorizationState
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IMessageService MessageService
@inject IJSRuntime JS
@inject ILogger<HQ> Logger
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="LANCommander HQ">
    <PageHeaderExtra>
        <a class="ant-btn ant-btn-text ant-btn-icon-only" href="https://lancommander.app/HQ">
            <Icon Type="question" Theme="IconThemeType.Outline"/>
        </a>
        <Button OnClick="Save" Type="@ButtonType.Primary">Save</Button>
    </PageHeaderExtra>
</PageHeader>

<PageContent>
    @* Named context so it does not collide with the settings Form's context below. *@
    <HqConnectionProvider Context="connection" OnConnectionChanged="OnConnectionChanged">
        @switch (connection.Status)
        {
            case HqConnectionStatus.Unknown:
                <Flex Justify="FlexJustify.Center" Style="padding: 32px;">
                    <Spin Tip="Checking your connection to LANCommander HQ..." />
                </Flex>
                break;

            case HqConnectionStatus.Connected when connection.IsPremium:
                <Result Status="ResultStatus.Success" Title="Premium Account" SubTitle="@($"Thank you for supporting LANCommander{(connection.Username is null ? "" : $", {connection.Username}")}!")">
                    <Extra>
                        <a href="https://hq.lancommander.app/Account" class="ant-btn ant-btn-primary">Account</a>
                        <Button Danger OnClick="Disconnect">Unlink</Button>
                    </Extra>
                </Result>
                break;

            case HqConnectionStatus.Connected:
                <Result Status="ResultStatus.Success" Title="Basic Account" SubTitle="@connection.Username">
                    <ChildContent>
                        <Text>Your server is linked to a basic account. Upgrade your account to access the following features:</Text>
                        <ul>
                            <li>Access premium metadata providers</li>
                            <li>Curated/enhanced metadata</li>
                            <li>Support future LANCommander development!</li>
                        </ul>
                    </ChildContent>
                    <Extra>
                        <a href="https://hq.lancommander.app/Account" class="ant-btn ant-btn-primary">Upgrade</a>
                        <Button Danger OnClick="Disconnect">Unlink</Button>
                    </Extra>
                </Result>
                break;

            case HqConnectionStatus.Unauthorized:
                <Result Status="ResultStatus.Warning" Title="Reconnect to LANCommander HQ" SubTitle="@UnauthorizedSubtitle">
                    <ChildContent>
                        <Text Type="TextElementType.Secondary">@connection.LastError</Text>
                    </ChildContent>
                    <Extra>
                        <Button Type="ButtonType.Primary" OnClick="Connect" Loading="_awaitingAuth">Reconnect</Button>
                        <Button Danger OnClick="Disconnect">Unlink</Button>
                    </Extra>
                </Result>
                break;

            case HqConnectionStatus.Unreachable:
                @* The credential is not implicated here, so it is deliberately left in place. *@
                <Result Status="ResultStatus.Warning" Title="Can't reach LANCommander HQ" SubTitle="@UnreachableSubtitle(connection)">
                    <ChildContent>
                        <Text Type="TextElementType.Secondary">@connection.LastError</Text>
                    </ChildContent>
                    <Extra>
                        <Button Type="ButtonType.Primary" OnClick="Retry" Loading="_retrying">Retry</Button>
                        <Button Danger OnClick="Disconnect">Unlink</Button>
                    </Extra>
                </Result>
                break;

            default:
                <Flex Direction="FlexDirection.Vertical" Gap="FlexGap.Middle">
                    <Text>Connect your server to LANCommander HQ for access to expanded metadata providers, faster lookups, and premium features. All through one account.</Text>

                    <Alert Type="AlertType.Info" Message="Not Connected" ShowIcon="true" />

                    <Flex Gap="FlexGap.Middle" Justify="FlexJustify.Center">
                        <Card Title="Basic" Class="hq-feature-card hq-feature-card-basic">
                            <Flex Direction="FlexDirection.Vertical" Gap="FlexGap.Small">
                                <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                    <Icon Type="check" Theme="IconThemeType.Outline"/>
                                    <Text>Access more metadata providers</Text>
                                </Flex>
                                <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                    <Icon Type="check" Theme="IconThemeType.Outline"/>
                                    <Text>Faster metadata lookups</Text>
                                </Flex>
                                <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                    <Icon Type="check" Theme="IconThemeType.Outline"/>
                                    <Text>One-time authentication</Text>
                                </Flex>
                                <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                    <Icon Type="check" Theme="IconThemeType.Outline"/>
                                    <Text>No additional server setup</Text>
                                </Flex>
                            </Flex>
                        </Card>

                        <Card Title="Premium" Class="hq-feature-card hq-feature-card-premium">
                            <Extra>
                                $5/mo
                            </Extra>
                            <ChildContent>
                                <Flex Direction="FlexDirection.Vertical" Gap="FlexGap.Small">
                                    <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                        <Icon Type="check" Theme="IconThemeType.Outline"/>
                                        <Text>Everything in Basic</Text>
                                    </Flex>
                                    <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                        <Icon Type="check" Theme="IconThemeType.Outline"/>
                                        <Text>Premium metadata providers</Text>
                                    </Flex>
                                    <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                        <Icon Type="check" Theme="IconThemeType.Outline"/>
                                        <Text>Curated & enhanced metadata</Text>
                                    </Flex>
                                    <Flex Gap="FlexGap.Small" Align="FlexAlign.Center">
                                        <Icon Type="check" Theme="IconThemeType.Outline"/>
                                        <Text>Supports LANCommander development</Text>
                                    </Flex>
                                </Flex>
                            </ChildContent>
                        </Card>
                    </Flex>

                    <Flex Justify="FlexJustify.Center">
                        <Button Block Type="ButtonType.Primary" OnClick="Connect" Loading="_awaitingAuth" Style="max-width: 33%">Connect to HQ</Button>
                    </Flex>
                </Flex>
                break;
        }
    </HqConnectionProvider>

    <Divider Text="Advanced" />

    <Form Model="Settings.Value" Layout="@FormLayout.Vertical">
        <FormItem Label="Base URL">
            <Input @bind-Value="context.Server.HQ.BaseUrl" />
        </FormItem>
    </Form>
</PageContent>

@code {
    bool _awaitingAuth;
    bool _retrying;

    // Deliberately not phrased around the access token expiring — that is renewed automatically
    // now. Reaching this state means the session itself ended: revoked from the account page,
    // idled out, or invalidated because the credential was used from somewhere else.
    const string UnauthorizedSubtitle =
        "This server's connection to LANCommander HQ has ended and must be set up again.";

    static string UnreachableSubtitle(HqConnectionSnapshot connection) =>
        connection.Username is null
            ? "Your credentials are still stored and will be used once HQ is reachable again."
            : $"Still linked to {connection.Username}. Your credentials are stored and will be used once HQ is reachable again.";

    Task OnConnectionChanged(HqConnectionSnapshot connection)
    {
        // The callback endpoint verifies before it responds, so this event is the signal that the
        // popup finished. It fires unconditionally for that path, so a retry that fails exactly as
        // the last one did still reaches us. This replaces polling the stored token every two
        // seconds.
        if (_awaitingAuth)
        {
            _awaitingAuth = false;

            if (connection.Status == HqConnectionStatus.Connected)
            {
                MessageService.Success("Successfully connected to LANCommander HQ!");
            }
            else
            {
                // Not "connected but unverified" — the exchange itself can fail, in which case the
                // server never connected at all. Disconnected lands here too; it used to fall
                // through silently and leave the administrator with no feedback whatsoever.
                MessageService.Error(string.IsNullOrWhiteSpace(connection.LastError)
                    ? "Could not connect to LANCommander HQ. Check the server logs for details."
                    : connection.LastError);
            }
        }

        return Task.CompletedTask;
    }

    async Task Connect()
    {
        var baseUrl = Settings.Value.Server.HQ.BaseUrl.TrimEnd('/');
        var callbackUrl = NavigationManager.BaseUri.TrimEnd('/') + "/api/HQ/Callback";
        var tokenRelayUrl = $"{baseUrl}/Auth/TokenRelay?returnUrl={Uri.EscapeDataString(callbackUrl)}";
        var loginUrl = $"{baseUrl}/Auth/Login?returnUrl={Uri.EscapeDataString(tokenRelayUrl)}";

        // Marks this administrator as having started the flow. The callback rejects tokens that
        // don't correspond to a login someone deliberately began here.
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        HqAuthorizationState.Issue(authState.User.Identity?.Name);

        _awaitingAuth = true;

        await JS.InvokeVoidAsync("open", loginUrl, "hq_auth", "width=600,height=700,menubar=no,toolbar=no");
    }

    async Task Retry()
    {
        _retrying = true;

        try
        {
            await HqConnection.VerifyAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to verify connection to LANCommander HQ.");
        }
        finally
        {
            _retrying = false;
        }
    }

    async Task Disconnect()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        HqAuthorizationState.Revoke(authState.User.Identity?.Name);

        await HqConnection.DisconnectAsync();

        _awaitingAuth = false;

        MessageService.Success("Disconnected from LANCommander HQ.");
    }

    void Save()
    {
        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.HQ.BaseUrl = Settings.Value.Server.HQ.BaseUrl;
            });

            MessageService.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            MessageService.Error("An unknown error occurred.");
            Logger.LogError(ex, "An unknown error occurred.");
        }
    }
}
