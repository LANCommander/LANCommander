@page "/Settings/Integrations/IGDB"
@using LANCommander.Server.Settings
@using Microsoft.Extensions.Options
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="IGDB">
    <Extra>
        <Button Primary OnClick="Save">Save</Button>
    </Extra>
</PageHeader>

<PageContent>
    <Typography Secondary>In order to use IGDB metadata, you need a Twitch developer account. <a href="https://api-docs.igdb.com/#account-creation" target="_blank">Click here</a> for more details.</Typography>

    <Form Model="Settings.Value" OnSubmit="Save">
        <FormItem Label="Client ID">
            <TextInput @bind-Value="Settings.Value.Server.IGDB.ClientId" />
        </FormItem>

        <FormItem Label="Client Secret">
            <PasswordInput @bind-Value="Settings.Value.Server.IGDB.ClientSecret" />
        </FormItem>
    </Form>
</PageContent>

@code {
    void Save()
    {
        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.IGDB = Settings.Value.Server.IGDB;
            });

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
    }
}
