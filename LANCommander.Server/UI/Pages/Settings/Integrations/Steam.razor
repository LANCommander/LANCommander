@page "/Settings/Integrations/Steam"
@using LANCommander.Server.Settings
@using LANCommander.Server.UI.Pages.Settings.Components
@using LANCommander.Steam.Abstractions
@using LANCommander.Steam.Models
@using Microsoft.Extensions.Options
@inject ISteamCmdService SteamCmdService
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Steam">
    <Extra>
        <Button Primary OnClick="SaveAsync">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="_profiles == null">
    <Form Model="Settings.Value" OnSubmit="SaveAsync">
        <FormItem Label="SteamCMD Path">
            <FilePicker @bind-Value="SteamCmdService.ExecutablePath" Title="Choose SteamCMD Executable Path" Root="@_rootPath">
                <After>
                    <Tooltip Title="Auto Detect">
                        <Button Icon="IconType.MagnifyingGlass" Loading="_detecting" OnClick="AutoDetectPathAsync" aria-label="Auto detect" />
                    </Tooltip>
                </After>
            </FilePicker>
        </FormItem>
    </Form>

    <h2>Profiles</h2>

    <Flex Vertical Gap="Gap.Large">
        <Collapse>
            @foreach (var profile in _profiles ?? [])
            {
                <Panel Header="@(String.IsNullOrWhiteSpace(profile.Username) ? "New Profile" : profile.Username)">
                    <Extra>
                        <Button Text Small Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveProfileAsync(profile)" />
                    </Extra>
                    <ChildContent>
                        <SteamProfileEditor @bind-Username="profile.Username"
                                            @bind-InstallDirectory="profile.InstallDirectory"
                                            OnAuthenticated="SaveAsync" />
                    </ChildContent>
                </Panel>
            }
        </Collapse>

        <Flex Justify="Justify.End">
            <Button OnClick="AddProfile">Add Profile</Button>
        </Flex>
    </Flex>
</PageContent>

@code {
    string _rootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    List<SteamCmdProfile>? _profiles;
    bool _detecting;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profiles = (await SteamCmdService.GetProfilesAsync()).ToList();
        }
        catch (Exception ex)
        {
            _profiles = [];

            Notifications.Error(ex, "The Steam profiles could not be loaded");
        }

        if (!_profiles.Any())
            AddProfile();
    }

    void AddProfile() => _profiles!.Add(new SteamCmdProfile());

    async Task RemoveProfileAsync(SteamCmdProfile profile)
    {
        if (!string.IsNullOrWhiteSpace(profile.Username))
        {
            var progress = Notifications.ShowPersistent(NotificationLevel.Info, "Logging out of Steam...");

            try
            {
                await SteamCmdService.LogoutAsync(profile.Username);
                await SteamCmdService.DeleteProfileAsync(profile.Username);

                _profiles = (await SteamCmdService.GetProfilesAsync()).ToList();

                progress.Close();

                Notifications.Success("Successfully logged out from Steam!");
            }
            catch (Exception ex)
            {
                progress.Close();

                Notifications.Error(ex, "Could not log out of Steam");
            }
        }
        else
            _profiles!.Remove(profile);

        if (!_profiles!.Any())
            AddProfile();
    }

    async Task SaveAsync()
    {
        try
        {
            foreach (var profile in _profiles ?? [])
                await SteamCmdService.SaveProfileAsync(profile);

            SettingsProvider.Update(s => s.Steam.Path = SteamCmdService.ExecutablePath);

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
    }

    async Task AutoDetectPathAsync()
    {
        _detecting = true;

        try
        {
            var path = await SteamCmdService.AutoDetectSteamCmdPathAsync();

            if (!string.IsNullOrWhiteSpace(path))
            {
                SteamCmdService.ExecutablePath = path;

                SettingsProvider.Update(s =>
                {
                    s.Steam.Path = path;
                });
            }
            else
                Notifications.Error("Could not automatically find SteamCMD! Is it installed?");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not look for SteamCMD");
        }
        finally
        {
            _detecting = false;
        }
    }
}
