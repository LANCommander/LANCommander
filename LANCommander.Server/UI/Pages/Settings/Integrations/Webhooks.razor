@page "/Settings/Integrations/Webhooks"
@using LANCommander.Server.Services.Events
@using LANCommander.Server.Plugins.Messaging
@inject WebhookService WebhookService
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Webhooks">
    <Extra>
        <Button OnClick="RefreshAsync">Refresh</Button>
        <Button Primary OnClick="New">New subscription</Button>
    </Extra>
</PageHeader>

<PageContent>
    <Typography Secondary>
        Deliver signed lifecycle events to an HTTP endpoint. Use HTTPS outside a trusted LAN.
        Signing secrets are encrypted and never returned. Failed deliveries retry automatically.
    </Typography>
    <Table TItem="WebhookInformation" Items="_subscriptions" Key="s => s.Id" NoPaging EmptyText="No webhook subscriptions">
        <Columns>
            <TemplateColumn Title="Name">@context.Name</TemplateColumn>
            <TemplateColumn Title="Endpoint">@context.Endpoint</TemplateColumn>
            <TemplateColumn Title="Enabled">@(context.Enabled ? "Yes" : "No")</TemplateColumn>
            <TemplateColumn Title="Actions">
                <Button OnClick="@(() => Edit(context))">Edit</Button>
                <Button Disabled="@(!context.Enabled)" OnClick="@(() => TestAsync(context.Id))">Test</Button>
                <Button OnClick="@(() => HistoryAsync(context.Id))">Deliveries</Button>
                <Button Danger OnClick="@(() => DeleteAsync(context.Id))">Delete</Button>
            </TemplateColumn>
        </Columns>
    </Table>

    @if (_edit != null)
    {
        <Typography Strong>@(_editingId.HasValue ? "Edit subscription" : "New subscription")</Typography>
        <Form Model="_edit" OnSubmit="SaveAsync">
            <FormItem Label="Name"><TextInput @bind-Value="_edit.Name" /></FormItem>
            <FormItem Label="Endpoint"><TextInput @bind-Value="_edit.Endpoint" /></FormItem>
            <FormItem Label="Signing secret" Help="32-1024 characters. Leave blank when editing to keep the current secret.">
                <PasswordInput @bind-Value="_edit.Secret" autocomplete="new-password" />
            </FormItem>
            <FormItem Label="Enabled"><Checkbox @bind-Value="_edit.Enabled" /></FormItem>
            <FormItem Label="Timeout (seconds)"><NumberInput @bind-Value="_edit.TimeoutSeconds" Min="1" Max="30" /></FormItem>
            <FormItem Label="Maximum attempts"><NumberInput @bind-Value="_edit.MaxAttempts" Min="1" Max="10" /></FormItem>
            <FormItem Label="Event types">
                @foreach (var type in ServerEventTypes.All)
                {
                    <div><Checkbox Value="@_edit.EventTypes.Contains(type)" ValueChanged="@((bool selected) => Toggle(type, selected))">@type</Checkbox></div>
                }
            </FormItem>
            <Button Primary Submit>Save</Button>
            <Button OnClick="Cancel">Cancel</Button>
        </Form>
    }

    @if (_historyId.HasValue)
    {
        <Typography Strong>Latest 100 deliveries</Typography>
        <Typography Secondary>Refresh to update pending attempts. Deleting a subscription also deletes its history.</Typography>
        <Table TItem="WebhookDeliveryInformation" Items="_deliveries" Key="d => d.Id" NoPaging EmptyText="No deliveries">
            <Columns>
                <TemplateColumn Title="Created (UTC)">@context.CreatedOn.ToString("u")</TemplateColumn>
                <TemplateColumn Title="Event">@context.EventType</TemplateColumn>
                <TemplateColumn Title="Delivery ID">@context.Id</TemplateColumn>
                <TemplateColumn Title="Status">@context.Status</TemplateColumn>
                <TemplateColumn Title="Attempts">@context.Attempts</TemplateColumn>
                <TemplateColumn Title="Next attempt (UTC)">@(context.Status == Data.Models.WebhookDeliveryStatus.Pending ? context.NextAttemptOn.ToString("u") : "-")</TemplateColumn>
                <TemplateColumn Title="HTTP / error">@context.StatusCode @context.Error</TemplateColumn>
            </Columns>
        </Table>
    }
</PageContent>

@code {
    IReadOnlyList<WebhookInformation> _subscriptions = [];
    IReadOnlyList<WebhookDeliveryInformation> _deliveries = [];
    WebhookEdit? _edit;
    Guid? _editingId;
    Guid? _historyId;

    protected override Task OnInitializedAsync() => RefreshAsync();

    async Task RefreshAsync()
    {
        try
        {
            _subscriptions = await WebhookService.GetAsync();
            if (_historyId.HasValue)
                _deliveries = await WebhookService.GetDeliveriesAsync(_historyId.Value);
        }
        catch
        {
            Notifications.Error("Could not load webhooks. Check the server database and migrations.");
        }
    }

    void New()
    {
        _editingId = null;
        _edit = new WebhookEdit();
    }

    void Edit(WebhookInformation subscription)
    {
        _editingId = subscription.Id;
        _edit = new WebhookEdit
        {
            Name = subscription.Name, Endpoint = subscription.Endpoint, Enabled = subscription.Enabled,
            EventTypes = subscription.EventTypes.ToArray(), TimeoutSeconds = subscription.TimeoutSeconds,
            MaxAttempts = subscription.MaxAttempts,
        };
    }

    void Cancel() => _edit = null;

    void Toggle(string type, bool selected) =>
        _edit!.EventTypes = selected ? _edit.EventTypes.Append(type).Distinct().ToArray() : _edit.EventTypes.Where(t => t != type).ToArray();

    async Task SaveAsync()
    {
        try
        {
            await WebhookService.SaveAsync(_editingId, _edit!);
            _edit = null;
            await RefreshAsync();
            Notifications.Success("Webhook saved.");
        }
        catch (ArgumentException ex)
        {
            Notifications.Error(ex.Message);
        }
        catch
        {
            Notifications.Error("Could not save the webhook.");
        }
    }

    async Task TestAsync(Guid id)
    {
        try
        {
            await WebhookService.TestAsync(id);
            await HistoryAsync(id);
            Notifications.Success("Test queued. Refresh deliveries to see the result.");
        }
        catch (ArgumentException ex)
        {
            Notifications.Error(ex.Message);
        }
        catch
        {
            Notifications.Error("Could not queue the test webhook.");
        }
    }

    async Task HistoryAsync(Guid id)
    {
        _historyId = id;
        await RefreshAsync();
    }

    async Task DeleteAsync(Guid id)
    {
        try
        {
            await WebhookService.DeleteAsync(id);
            if (_historyId == id)
                _historyId = null;
            await RefreshAsync();
        }
        catch
        {
            Notifications.Error("Could not delete the webhook.");
        }
    }
}
