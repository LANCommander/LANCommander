@page "/Settings/Launcher"
@using LANCommander.Server.Jobs.Background
@using LANCommander.Server.Settings
@using LANCommander.Server.Settings.Enums
@using LANCommander.Server.UI.Components
@using Microsoft.Extensions.Options
@inject NotificationService Notifications
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Launcher">
    <Extra>
        <Button OnClick="DownloadLaunchers" Disabled="!Settings.Value.Server.Launcher.HostUpdates">Download Launchers</Button>
    </Extra>
</PageHeader>

<PageContent>
    <Form Model="Settings.Value" OnSubmit="Save">
        <FormItem Label="Storage Path">
            <FilePicker Root="@RootPath" EntrySelectable="x => x is FileManagerDirectory" @bind-Value="Settings.Value.Server.Launcher.StoragePath" OkText="Select Path" Title="Choose Path" OnSelected="OnPathSelected" />
        </FormItem>

        <FormItem Label="Host Client Updates">
            <Switch @bind-Value="Settings.Value.Server.Launcher.HostUpdates" />
        </FormItem>

        <FormItem Label="Always include Online Updates">
            <Switch @bind-Value="Settings.Value.Server.Launcher.IncludeOnlineUpdates" />
        </FormItem>

        <FormItem Label="Architectures">
            <EnumSelect TEnum="LauncherArchitecture" Multiple Disabled="!Settings.Value.Server.Launcher.HostUpdates" @bind-Values="Settings.Value.Server.Launcher.Architectures" />
        </FormItem>

        <FormItem Label="Platforms">
            <EnumSelect TEnum="LauncherPlatform" Multiple Disabled="!Settings.Value.Server.Launcher.HostUpdates" @bind-Values="Settings.Value.Server.Launcher.Platforms" />
        </FormItem>

        <FormItem>
            <Button Primary Submit>Save</Button>
        </FormItem>
    </Form>
</PageContent>

@code {
    string RootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    void Save()
    {
        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.Launcher = Settings.Value.Server.Launcher;
            });

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
    }

    void OnPathSelected(string path)
    {
        var appPath = Directory.GetCurrentDirectory();

        if (path != null && path.StartsWith(appPath))
            path = path.Substring(appPath.Length).TrimStart(Path.DirectorySeparatorChar).TrimEnd(Path.DirectorySeparatorChar);

        Settings.Value.Server.Launcher.StoragePath = path;
    }

    void DownloadLaunchers()
    {
        try
        {
            Hangfire.BackgroundJob.Enqueue<DownloadLauncherArtifacts>(x => x.ExecuteAsync());

            Notifications.Success("Launchers will be downloaded in the background!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The download could not be started");
        }
    }
}
