@using LANCommander.Server.Logging
@using XtermBlazor
@inject NotificationService Notifications
@inject LogStream LogStream
@implements IDisposable

<Terminal @ref="_terminal" Options="_options" OnFirstRender="@OnFirstRender" />

@code {
    Terminal? _terminal;
    bool _subscribed;

    TerminalOptions _options = ConsolePalette.CreateOptions();

    async Task OnFirstRender()
    {
        if (_terminal is not null)
            await _terminal.FitAsync();

        try
        {
            await Connect();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Log viewer failed to connect");
        }
    }

    async Task Connect()
    {
        foreach (var entry in await LogStream.ReadHistoryAsync())
            await Write(entry);

        await Write(new LogEntry("Connected to server logging provider!", Microsoft.Extensions.Logging.LogLevel.Information, DateTime.Now));

        LogStream.Logged += OnLogged;
        _subscribed = true;
    }

    void OnLogged(LogEntry entry)
    {
        _ = InvokeAsync(() => Write(entry));
    }

    async Task Write(LogEntry entry)
    {
        if (_terminal is null)
            return;

        string[] parts =
        [
            TerminalColor.BrightBlack,
            "[",
            TerminalColor.White,
            entry.Timestamp.ToString("HH:mm:ss"),
            TerminalColor.BrightBlack,
            "]",
            GetColorCode(entry.Level),
            " ",
            entry.Message,
            TerminalColor.Default
        ];

        try
        {
            await _terminal.WriteLine(String.Join("", parts));
        }
        catch
        {
            // The circuit may have gone away mid-write
        }
    }

    string GetColorCode(Microsoft.Extensions.Logging.LogLevel level)
    {
        return level switch
        {
            Microsoft.Extensions.Logging.LogLevel.Trace => TerminalColor.BrightBlack,
            Microsoft.Extensions.Logging.LogLevel.Debug => TerminalColor.BrightCyan,
            Microsoft.Extensions.Logging.LogLevel.Information => TerminalColor.BrightGreen,
            Microsoft.Extensions.Logging.LogLevel.Warning => TerminalColor.BrightYellow,
            Microsoft.Extensions.Logging.LogLevel.Error => TerminalColor.BrightRed,
            Microsoft.Extensions.Logging.LogLevel.Critical => TerminalColor.BrightMagenta,
            _ => TerminalColor.Default,
        };
    }

    public void Dispose()
    {
        if (_subscribed)
            LogStream.Logged -= OnLogged;
    }
}
