@using LANCommander.Server.Parsers
@using LANCommander.Server.Settings.Enums
@using LANCommander.Server.Settings.Models
@using LANCommander.Server.UI.Components

<Form Model="Provider" OnFieldChanged="OnChangedAsync">
    <FormItem Label="Name">
        <TextInput @bind-Value="Provider.Name" Immediate />
    </FormItem>
    <FormItem Label="Type">
        <EnumSelect TEnum="LoggingProviderType" @bind-Value="Provider.Type" @bind-Value:after="ProviderTypeChanged" />
    </FormItem>
    <FormItem Label="Minimum Level">
        <EnumSelect TEnum="LogLevel" @bind-Value="Provider.MinimumLevel" />
    </FormItem>

    @if (Provider.Type == LoggingProviderType.File)
    {
        <FormItem Label="Path">
            <FilePicker Root="@_rootPath" EntrySelectable="x => x is FileManagerDirectory" @bind-Value="Provider.ConnectionString" OkText="Select Path" Title="Choose Path" OnSelected="OnPathSelected" />
        </FormItem>
        <FormItem Label="Archive Every">
            <Select TValue="LogInterval?" Items="Intervals" @bind-Value="Provider.ArchiveEvery" Placeholder="Day" Clearable />
        </FormItem>
        <FormItem Label="Max Archive Files">
            <NumberInput @bind-Value="Provider.MaxArchiveFiles" Min="0" />
        </FormItem>
    }

    @if (Provider.Type == LoggingProviderType.Seq || Provider.Type == LoggingProviderType.ElasticSearch)
    {
        <FormItem Label="Connection String">
            <TextInput @bind-Value="Provider.ConnectionString" />
        </FormItem>
    }
</Form>

@code {
    [Parameter, EditorRequired] public LoggingProvider Provider { get; set; } = default!;
    [Parameter] public EventCallback<LoggingProvider> ProviderChanged { get; set; }

    static readonly SelectItem<LogInterval?>[] Intervals = Enum.GetValues<LogInterval>()
        .Select(i => new SelectItem<LogInterval?>(i, i.ToString()))
        .ToArray();

    string _rootPath = Path.GetPathRoot(Directory.GetCurrentDirectory()) ?? string.Empty;

    Task OnChangedAsync() => ProviderChanged.InvokeAsync(Provider);

    void ProviderTypeChanged()
    {
        if (Provider.Type == LoggingProviderType.Seq)
            Provider.ConnectionString = SeqOptions.DefaultConnectionString;
    }

    void OnPathSelected(string path)
    {
        var appPath = Directory.GetCurrentDirectory();

        if (path != null && path.StartsWith(appPath))
            path = path.Substring(appPath.Length).TrimStart(Path.DirectorySeparatorChar).TrimEnd(Path.DirectorySeparatorChar);

        Provider.ConnectionString = path ?? string.Empty;
    }
}
