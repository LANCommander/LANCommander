@using LANCommander.SDK.Enums
@using LANCommander.Server.Settings.Models

@if (Value != null)
{
    <Panel Header="@Value.Type.ToString()">
        <Form Model="Value" OnFieldChanged="OnChangeAsync">
            <FormItem Label="Enabled">
                <Switch @bind-Value="Value.Thumbnails.Enabled" />
            </FormItem>
            <FormItem Label="Max File Size">
                <ByteSizeInput @bind-Value="Value.MaxFileSize" />
            </FormItem>

            <Divider>Animated Images</Divider>

            <FormItem Label="Convert APNG to Video">
                <Switch @bind-Value="Value.AnimatedImage.ConvertToVideo" />
            </FormItem>

            <FormItem Label="Video Quality (CRF — lower = higher quality, 0 lossless, 23 default, 51 worst)">
                <NumberInput @bind-Value="Value.AnimatedImage.Quality" Min="0" Max="51" />
            </FormItem>

            <Divider>Thumbnails</Divider>

            <FormItem Label="Minimum Size">
                <InputGroup>
                    <NumberInput @bind-Value="Value.Thumbnails.MinSize.Width" Min="0" NoButtons Style="width: 120px" />
                    <InputAddon>x</InputAddon>
                    <NumberInput @bind-Value="Value.Thumbnails.MinSize.Height" Min="0" NoButtons Style="width: 120px" />
                </InputGroup>
            </FormItem>

            <FormItem Label="Maximum Size">
                <InputGroup>
                    <NumberInput @bind-Value="Value.Thumbnails.MaxSize.Width" Min="0" NoButtons Style="width: 120px" />
                    <InputAddon>x</InputAddon>
                    <NumberInput @bind-Value="Value.Thumbnails.MaxSize.Height" Min="0" NoButtons Style="width: 120px" />
                </InputGroup>
            </FormItem>

            <FormItem Label="Scale">
                <NumberInput @bind-Value="Value.Thumbnails.Scale" />
            </FormItem>

            <FormItem Label="Quality">
                <NumberInput @bind-Value="Value.Thumbnails.Quality" />
            </FormItem>
        </Form>
    </Panel>
}

@code {
    [Parameter] public MediaTypeSettings? Value { get; set; }
    [Parameter] public EventCallback<MediaTypeSettings?> ValueChanged { get; set; }

    Task OnChangeAsync() => ValueChanged.InvokeAsync(Value);
}
