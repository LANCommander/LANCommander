@page "/Settings/Media"
@using LANCommander.SDK.Enums
@using LANCommander.Server.Settings
@using LANCommander.Server.Settings.Models
@using LANCommander.Server.UI.Components
@using LANCommander.Server.UI.Pages.Settings.Media.Components
@using Microsoft.Extensions.Options
@inject StorageLocationService StorageLocationService
@inject MediaToolService MediaToolService
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Media">
    <Extra>
        <Button Primary OnClick="SaveAsync">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="StorageLocation == null">
    <h3>Required Tools</h3>
    <p>yt-dlp and ffmpeg are required for downloading and processing video media.</p>

    <Table TItem="ToolRow" Items="_tools" Key="t => t.Name" NoPaging SettingsKey="settings-media-tools" Style="margin-bottom: 16px">
        <Columns>
            <TemplateColumn TItem="ToolRow" Title="Tool" Width="120px">
                <Typography Strong>@context.Name</Typography>
            </TemplateColumn>
            <TemplateColumn TItem="ToolRow" Title="Status" Width="140px">
                @if (context.Status == null)
                {
                    <Spin Small />
                }
                else if (context.Status.Installed)
                {
                    <Tag Success>Installed</Tag>
                }
                else
                {
                    <Tag Danger>Not Installed</Tag>
                }
            </TemplateColumn>
            <TemplateColumn TItem="ToolRow" Title="Version" Width="160px">
                @(context.Status?.Version ?? "—")
            </TemplateColumn>
            <TemplateColumn TItem="ToolRow" Title="Path">
                <span class="media-tool-path">@(context.Status?.Path ?? "—")</span>
            </TemplateColumn>
            <ActionsColumn TItem="ToolRow" Width="120px">
                @if (context.Status != null && !context.Status.Installed)
                {
                    <Button Primary Small Loading="context.Installing" OnClick="() => InstallAsync(context)">Install</Button>
                }
                else
                {
                    <Button Small Disabled="context.Status == null" OnClick="RefreshToolStatusAsync">Refresh</Button>
                }
            </ActionsColumn>
        </Columns>
    </Table>

    <Divider />

    @if (StorageLocation != null)
    {
        <Form Model="Settings.Value" OnSubmit="SaveAsync">
            <FormItem Label="Storage Path">
                <FilePicker Root="@RootPath" EntrySelectable="x => x is FileManagerDirectory" @bind-Value="StorageLocation.Path" OkText="Select Path" Title="Choose Path" OnSelected="OnPathSelected" />
            </FormItem>
        </Form>

        <Collapse Style="margin-bottom: 24px">
            @foreach (var mediaType in Enum.GetValues<MediaType>())
            {
                if (_mediaTypeSettings.ContainsKey(mediaType))
                {
                    <MediaTypeSettingsEditor @bind-Value="_mediaTypeSettings[mediaType]" />
                }
            }
        </Collapse>
    }
</PageContent>

@code {
    sealed class ToolRow(string name, Func<Task> install)
    {
        public string Name { get; } = name;

        public Func<Task> Install { get; } = install;

        public MediaToolService.ToolStatus? Status { get; set; }

        public bool Installing { get; set; }
    }

    string RootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    StorageLocation? StorageLocation;

    Dictionary<MediaType, MediaTypeSettings> _mediaTypeSettings = new();

    List<ToolRow> _tools = new();

    ToolRow YtDlp => _tools[0];
    ToolRow Ffmpeg => _tools[1];

    protected override async Task OnInitializedAsync()
    {
        _tools =
        [
            new("yt-dlp", MediaToolService.InstallYtDlpAsync),
            new("ffmpeg", MediaToolService.InstallFfmpegAsync),
        ];

        _mediaTypeSettings = Settings.Value.Server.Media.MediaTypes.DistinctBy(m => m.Type).ToDictionary(m => m.Type, m => m);

        try
        {
            StorageLocation = await StorageLocationService.FirstOrDefaultAsync(l => l.Default && l.Type == StorageLocationType.Media)
                              ?? await StorageLocationService.AddAsync(new StorageLocation
                              {
                                  Default = true,
                                  Path = "Media",
                                  Type = StorageLocationType.Media
                              });
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The media storage location could not be loaded");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Checking the tools runs them, which can take a moment; the page shows first
        if (firstRender)
            await RefreshToolStatusAsync();
    }

    async Task RefreshToolStatusAsync()
    {
        YtDlp.Status = null;
        Ffmpeg.Status = null;
        StateHasChanged();

        try
        {
            YtDlp.Status = await MediaToolService.GetYtDlpStatusAsync();
            Ffmpeg.Status = await MediaToolService.GetFfmpegStatusAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Failed to check tool status");
        }

        StateHasChanged();
    }

    async Task InstallAsync(ToolRow tool)
    {
        tool.Installing = true;

        try
        {
            await tool.Install();

            Notifications.Success($"{tool.Name} installed successfully!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Failed to install {tool.Name}. Check logs for details.");
        }
        finally
        {
            tool.Installing = false;
        }

        await RefreshToolStatusAsync();
    }

    async Task SaveAsync()
    {
        try
        {
            Settings.Value.Server.Media.MediaTypes = _mediaTypeSettings.Values;

            SettingsProvider.Update(s =>
            {
                s.Server.Media = Settings.Value.Server.Media;
            });

            if (StorageLocation != null)
                await StorageLocationService.UpdateAsync(StorageLocation);

            Notifications.Success("Settings saved!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The settings could not be saved");
        }
    }

    void OnPathSelected(string path)
    {
        var appPath = Directory.GetCurrentDirectory();

        if (path != null && path.StartsWith(appPath))
            path = path.Substring(appPath.Length).TrimStart(Path.DirectorySeparatorChar).TrimEnd(Path.DirectorySeparatorChar);

        StorageLocation!.Path = path;
    }
}
