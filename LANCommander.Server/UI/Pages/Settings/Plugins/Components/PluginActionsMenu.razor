@* A plugin row's menu: its settings page, its release notes, its links off the site, and uninstalling it. Nothing shows when there is none of these. *@
@if (_hasSettings || _hasReleaseNotes || _hasLinks || _canUninstall)
{
    <Dropdown @ref="_dropdown">
        <ChildContent>
            <Button Text Icon="IconType.DotsThreeVertical" aria-label="@($"More actions for {Name}")" title="More actions" />
        </ChildContent>
        <Overlay>
            <Menu>
                @if (_hasSettings)
                {
                    <MenuItem Icon="IconType.Gear" Href="@SettingsHref">Settings</MenuItem>
                }

                @if (_hasReleaseNotes)
                {
                    <MenuItem Icon="IconType.Notebook" OnClick="ShowReleaseNotesAsync">Release notes</MenuItem>
                }

                @if ((_hasSettings || _hasReleaseNotes) && _hasLinks)
                {
                    <MenuDivider />
                }

                @if (_sourceCode != null)
                {
                    <MenuItem Icon="IconType.Code" Href="@_sourceCode" NewTab>Source code</MenuItem>
                }
                @if (_website != null)
                {
                    <MenuItem Icon="IconType.Globe" Href="@_website" NewTab>Project website</MenuItem>
                }

                @if (_canUninstall)
                {
                    @if (_hasSettings || _hasReleaseNotes || _hasLinks)
                    {
                        <MenuDivider />
                    }

                    <MenuItem Icon="IconType.Trash" Danger OnClick="UninstallAsync">Uninstall</MenuItem>
                }
            </Menu>
        </Overlay>
    </Dropdown>
}

@code {
    /// <summary>The plugin's name, for the button's accessible label.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>The package's repository URL.</summary>
    [Parameter] public string? RepositoryUrl { get; set; }

    /// <summary>The package's project URL.</summary>
    [Parameter] public string? ProjectUrl { get; set; }

    /// <summary>The plugin's settings page, when it has one and is running.</summary>
    [Parameter] public string? SettingsHref { get; set; }

    /// <summary>Removes the plugin; the item is offered only when this is set. The handler confirms first.</summary>
    [Parameter] public EventCallback OnUninstall { get; set; }

    /// <summary>Shows the package's release notes; the item is offered only when this is set.</summary>
    [Parameter] public EventCallback OnShowReleaseNotes { get; set; }

    Dropdown? _dropdown;
    string? _sourceCode;
    string? _website;
    bool _hasSettings;
    bool _hasReleaseNotes;
    bool _hasLinks;
    bool _canUninstall;

    protected override void OnParametersSet()
    {
        _sourceCode = WebUrl(RepositoryUrl);
        _website = WebUrl(ProjectUrl);

        // Many packages, the official ones among them, give the repository as their project URL too
        if (_website != null && _sourceCode != null && string.Equals(Normalize(_website), Normalize(_sourceCode), StringComparison.OrdinalIgnoreCase))
            _website = null;

        _hasSettings = SettingsHref != null;
        _hasReleaseNotes = OnShowReleaseNotes.HasDelegate;
        _hasLinks = _sourceCode != null || _website != null;
        _canUninstall = OnUninstall.HasDelegate;
    }

    // The menu closes only after an item's handler returns, so close it before the handler's confirmation opens
    async Task UninstallAsync()
    {
        if (_dropdown != null)
            await _dropdown.CloseAsync();

        await OnUninstall.InvokeAsync();
    }

    async Task ShowReleaseNotesAsync()
    {
        if (_dropdown != null)
            await _dropdown.CloseAsync();

        await OnShowReleaseNotes.InvokeAsync();
    }

    /// <summary>A repository URL without the trailing slash or ".git" that often differs from the project URL.</summary>
    static string Normalize(string url)
    {
        var uri = new Uri(url);
        var path = uri.AbsolutePath.TrimEnd('/');

        if (path.EndsWith(".git", StringComparison.OrdinalIgnoreCase))
            path = path[..^4];

        return $"{uri.Host}{path}";
    }

    /// <summary>The URL when it is an absolute http(s) link, so package metadata can't inject other schemes.</summary>
    static string? WebUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
            ? uri.ToString()
            : null;
}
