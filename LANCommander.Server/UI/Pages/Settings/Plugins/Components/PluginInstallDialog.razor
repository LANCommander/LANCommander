@using LANCommander.PluginManagement
@using LANCommander.Server.Plugins.Installation
@inherits Dialog<PluginInstallRequest, string>
@inject PluginPackageService PluginPackages
@inject LauncherPluginCache LauncherPlugins

@* Picks the version of a package found on a source, and stages it to install at the next restart, or
   for a launcher plugin, downloads it for launchers to install *@
<Flex Vertical Gap="Gap.Medium">
    <Flex Gap="Gap.Medium" Align="Align.Center">
        <Avatar Src="@Listing.IconUrl" Name="@Listing.DisplayName" Icon="IconType.PuzzlePiece" Square Large />
        <Flex Vertical>
            <span>
                <Typography Strong>@Listing.DisplayName</Typography>
                @if (Listing.IsOfficial)
                {
                    <OfficialPluginTag />
                }
            </span>
            <Typography Secondary Small>
                @Listing.Id
                @if (!String.IsNullOrWhiteSpace(Listing.Authors))
                {
                    <text> · by @Listing.Authors</text>
                }
                <text> · @Listing.SourceName</text>
            </Typography>
        </Flex>
    </Flex>

    @if (!String.IsNullOrWhiteSpace(Listing.Description))
    {
        <Typography>@Listing.Description</Typography>
    }

    @if (!String.IsNullOrWhiteSpace(Listing.ProjectUrl))
    {
        <a href="@Listing.ProjectUrl" target="_blank" rel="noopener noreferrer">Project website</a>
    }

    <Flex Vertical Gap="Gap.Small">
        <Typography Strong>Version</Typography>
        @if (_error != null)
        {
            <Alert Danger Title="The versions could not be listed">@_error</Alert>
        }
        else if (_versions == null)
        {
            <Spin />
        }
        else
        {
            <Select TValue="string" Items="_versions" @bind-Value="_version" @bind-Value:after="StateHasChanged" Searchable />
        }
    </Flex>

    @if (Options.ForLaunchers)
    {
        <Typography Secondary Small>The package is checked and downloaded now, and launchers can install it straight away.</Typography>
    }
    else
    {
        <Typography Secondary Small>The package is checked now and installed when the server restarts.</Typography>
    }
</Flex>

@code {
    PluginPackageListing Listing => Options.Listing;

    IEnumerable<SelectItem<string>>? _versions;
    string? _version;
    string? _error;

    protected override bool CanConfirm => _version != null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var versions = await PluginPackages.GetVersionsAsync(Listing.SourceUrl, Listing.Id);

            _versions = versions.Select(v => new SelectItem<string>(v, v == Listing.Version ? $"{v} (latest)" : v)).ToList();
            _version = versions.Contains(Listing.Version) ? Listing.Version : versions.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    protected override async Task<bool> OnOkAsync()
    {
        Result = Options.ForLaunchers
            ? (await LauncherPlugins.AddAsync(Listing.SourceUrl, Listing.Id, _version!)).Version
            : (await PluginPackages.InstallAsync(Listing.SourceUrl, Listing.Id, _version!)).Package.Version;

        return true;
    }
}
