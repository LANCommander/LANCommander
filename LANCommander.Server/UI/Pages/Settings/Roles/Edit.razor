@page "/Settings/Roles/{id:guid}"
@using Microsoft.EntityFrameworkCore
@inject RoleService RoleService
@inject CollectionService CollectionService
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Edit Role">
    <Extra>
        <Button Primary Loading="_saving" OnClick="SaveAsync">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="!_loaded">
    @if (Role == null)
    {
        <NotFound SubTitle="This role does not exist." />
    }
    else
    {
        <Form Model="Role" OnSubmit="SaveAsync">
            <FormItem Label="Name">
                <TextInput @bind-Value="Role.Name" />
            </FormItem>
            <FormItem Label="Collections">
                <Transfer TItem="Collection" Items="Collections" @bind-Values="SelectedCollections" Text="c => c.Name" SourceTitle="Available" TargetTitle="Allowed" Searchable Style="height: 320px" />
            </FormItem>
            <FormItem Label="Storage Quota (MB)" Help="0 or blank = unlimited">
                <NumberInput TValue="int?" @bind-Value="Role.StorageQuotaMB" Min="0" />
            </FormItem>
            <FormItem Label="Download Speed (KB/s)" Help="0 or blank = unlimited">
                <NumberInput TValue="int?" @bind-Value="Role.DownloadSpeedKBps" Min="0" />
            </FormItem>
            <FormItem Label="Cloud Saves" Help="Disable cloud saves for users in this role">
                <Select TValue="bool?" Items="SaveOptions" @bind-Value="Role.EnableSaves" />
            </FormItem>
        </Form>
    }
</PageContent>

@code {
    [Parameter] public Guid Id { get; set; }

    static readonly SelectItem<bool?>[] SaveOptions =
    [
        new(null, "Not set"),
        new(true, "Enabled"),
        new(false, "Disabled"),
    ];

    Role? Role;
    IEnumerable<Collection> Collections = new List<Collection>();
    IEnumerable<Collection> SelectedCollections = new List<Collection>();
    bool _loaded;
    bool _saving;

    protected override async Task OnInitializedAsync()
    {
        Role = await RoleService
            .AsNoTracking()
            .Query(q => q
                .Include(r => r.UserRoles)
                .ThenInclude(ur => ur.User))
            .Include(r => r.Collections)
            .GetAsync(Id);

        if (Role != null)
        {
            SelectedCollections = Role.Collections;

            Collections = await CollectionService.GetAsync();
        }

        _loaded = true;
    }

    async Task SaveAsync()
    {
        _saving = true;

        try
        {
            await RoleService.UpdateAsync(Role!);
            await RoleService.AssignCollections(Id, SelectedCollections.Select(c => c.Id));

            Notifications.Success("Role updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Role could not be updated!");
        }
        finally
        {
            _saving = false;
        }
    }
}
