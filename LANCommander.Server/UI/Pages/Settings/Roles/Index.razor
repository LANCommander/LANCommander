@page "/Settings/Roles"
@using LANCommander.Server.Settings
@using Microsoft.Extensions.Options
@inject RoleService RoleService
@inject NavigationManager NavigationManager
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@inject NotificationService Notifications
@inject AlertService Alerts
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Roles" />

<PageContent>
    <DataTable TItem="Role"
               @ref="Table"
               Small
               ColumnPicker
               SearchProperty="r => r.Name"
               OnRowDoubleClick="@(role => NavigationManager.NavigateTo($"/Settings/Roles/{role.Id}"))">
        <RightToolbar>
            <Flex Justify="Justify.End" Align="Align.Center" Gap="Gap.Small">
                <span class="nowrap">Default Role:</span>
                <Select TValue="Guid" Items="RoleItems" Value="_defaultRoleId" ValueChanged="DefaultRoleChanged" Disabled="Loading" Style="min-width: 160px" />
                <Button Primary Icon="IconType.Plus" OnClick="AddRoleAsync">Add Role</Button>
            </Flex>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="r => r.Name" Title="Name" Sortable DefaultSort="ColumnSort.Ascending" />

            <ActionsColumn TItem="Role">
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Settings/Roles/{context.Id}")" title="Edit" />

                @if (context.Name != RoleService.AdministratorRoleName)
                {
                    <Popconfirm OnConfirm="() => DeleteRoleAsync(context)" Title="Are you sure you want to delete this role?" OkText="Delete" Danger>
                        <Button Text Danger Icon="IconType.X" title="Delete" />
                    </Popconfirm>
                }
                else
                {
                    <Tooltip Title="The administrator role cannot be deleted.">
                        <Button Text Icon="IconType.X" Disabled aria-label="Delete" />
                    </Tooltip>
                }
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    bool Loading = true;

    Guid _defaultRoleId;

    IEnumerable<SelectItem<Guid>> RoleItems = [];

    DataTable<Role> Table = default!;

    protected override async Task OnInitializedAsync()
    {
        _defaultRoleId = Settings.Value.Server.Roles.DefaultRoleId;

        await LoadRolesAsync();

        Loading = false;
    }

    async Task LoadRolesAsync()
    {
        var roles = await RoleService.AsNoTracking().SortBy(r => r.Name).GetAsync();

        RoleItems = roles.ToSelectItems(r => r.Id, r => r.Name).ToList();
    }

    async Task DeleteRoleAsync(Role role)
    {
        try
        {
            var dbRole = await RoleService.FirstOrDefaultAsync(r => r.Name == role.Name);

            if (dbRole == null || dbRole.Name == RoleService.AdministratorRoleName)
            {
                Notifications.Error("Cannot delete the administrator role!");
                return;
            }

            await RoleService.DeleteAsync(dbRole);

            await Table.ReloadAsync();
            await LoadRolesAsync();

            Notifications.Success($"Deleted {dbRole.Name}!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not delete {role.Name}");
        }
    }

    async Task AddRoleAsync()
    {
        var name = await Alerts.PromptAsync("Add a Role", "Name", okText: "Add");

        if (String.IsNullOrWhiteSpace(name))
            return;

        try
        {
            if (await RoleService.ExistsAsync(r => r.Name == name))
            {
                Notifications.Error("A role with that name already exists!");
                return;
            }

            await RoleService.AddAsync(new Role { Name = name });

            await Table.ReloadAsync();
            await LoadRolesAsync();

            Notifications.Success("Role added!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not add role!");
        }
    }

    void DefaultRoleChanged(Guid defaultRoleId)
    {
        if (Loading || defaultRoleId == Guid.Empty || defaultRoleId == Settings.Value.Server.Roles.DefaultRoleId)
            return;

        try
        {
            _defaultRoleId = defaultRoleId;

            SettingsProvider.Update(s =>
            {
                s.Server.Roles.DefaultRoleId = defaultRoleId;
            });

            Notifications.Success("Default role updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The default role could not be changed");
        }
    }
}
