@page "/Settings/Servers"
@using LANCommander.Server.Settings
@using LANCommander.Server.UI.Components
@using LANCommander.Server.UI.Pages.Settings.Components
@using Microsoft.Extensions.Options
@inject NotificationService Notifications
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Servers">
    <Extra>
        <Button Primary OnClick="Save">Save</Button>
    </Extra>
</PageHeader>

<PageContent>
    <Form Model="Settings.Value" OnSubmit="Save">
        <FormItem Label="Storage Path">
            <FilePicker Root="@RootPath" EntrySelectable="x => x is FileManagerDirectory" @bind-Value="Settings.Value.Server.GameServers.StoragePath" OkText="Select Path" Title="Choose Path" OnSelected="OnPathSelected" />
        </FormItem>
        <FormItem Label="Autostop Delay" Help="Seconds to wait after the last player stops a game before stopping its on-player-activity servers. Debounces stop/start thrash when players relaunch.">
            <NumberInput @bind-Value="Settings.Value.Server.GameServers.AutostopDelay" Min="0" />
        </FormItem>
    </Form>

    <Divider>Server Engines</Divider>

    <ServerEngineEditor @ref="_engineEditor" @bind-Values="Settings.Value.Server.GameServers.ServerEngines" Save="Save" />
</PageContent>

@code {
    string RootPath = Path.GetPathRoot(Directory.GetCurrentDirectory());

    ServerEngineEditor? _engineEditor;

    // Saves the built-in settings and every plugin engine's, each regardless of the others
    async Task Save()
    {
        var saved = true;

        try
        {
            SettingsProvider.Update(s =>
            {
                s.Server.GameServers = Settings.Value.Server.GameServers;
            });
        }
        catch (Exception ex)
        {
            saved = false;

            Notifications.Error(ex, "The settings could not be saved");
        }

        if (_engineEditor != null)
        {
            foreach (var (engine, error) in await _engineEditor.SaveExtensionsAsync())
            {
                saved = false;

                Notifications.Error(error, $"The {engine} engine's settings could not be saved");
            }
        }

        if (saved)
            Notifications.Success("Settings saved!");
    }

    void OnPathSelected(string path)
    {
        var appPath = Directory.GetCurrentDirectory();

        if (path != null && path.StartsWith(appPath))
            path = path.Substring(appPath.Length).TrimStart(Path.DirectorySeparatorChar).TrimEnd(Path.DirectorySeparatorChar);

        Settings.Value.Server.GameServers.StoragePath = path;
    }
}
