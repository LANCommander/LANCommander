@page "/Settings/Tools/ActiveSessions"
@inject PlaySessionService PlaySessionService
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Active Sessions" />

<PageContent>
    <p>
        These play sessions are considered active because they never ended. This may cause servers set to autostart with "Player Activity" to not stop when a player has quit a game.
    </p>

    <DataTable TItem="PlaySession" @ref="_table" Query="ps => !ps.End.HasValue" Small>
        <Columns>
            <BoundColumn Property="ps => ps.Game.Title" Title="Game" Include="Game" Sortable />
            <BoundColumn Property="ps => ps.Start" Title="Start" Sortable>
                <LocalTime Value="context.Start" />
            </BoundColumn>
            <BoundColumn Property="ps => ps.End" Title="End">
                <LocalTime Value="context.End" />
            </BoundColumn>
            <BoundColumn Property="ps => ps.CreatedOn" Title="Created On" Sortable DefaultSort="ColumnSort.Descending">
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="ps => ps.CreatedBy != null ? ps.CreatedBy.UserName : String.Empty" Title="Created By" Include="CreatedBy" Sortable />
            <ActionsColumn TItem="PlaySession">
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this session?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<PlaySession>? _table;

    async Task DeleteAsync(PlaySession playSession)
    {
        try
        {
            await PlaySessionService.DeleteAsync(playSession);

            Notifications.Success("Session deleted!");

            if (_table != null)
                await _table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Session could not be deleted.");
        }
    }
}
