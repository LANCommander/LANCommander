@page "/Settings/Tools"
@using Hangfire
@using LANCommander.Helpers
@using LANCommander.Server.Jobs.Background
@using LANCommander.Server.Services.Exceptions
@using ZiggyCreatures.Caching.Fusion
@inject ArchiveService ArchiveService
@inject PageService PageService
@inject UpdateService UpdateService
@inject StorageLocationService StorageLocationService
@inject NotificationService Notifications
@inject IFusionCache FusionCache
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Tools" />

<PageContent>
    <h3>Recalculate File Sizes</h3>
    <p>
        Some file sizes are cached in the database. Click the button below to scan through all files and recalculate their size.
    </p>
    <Button Primary OnClick="RecalculateFileSizesAsync" Loading="RecalculatingFileSizes">Recalculate</Button>

    <Divider />

    <h3>Clear Cache</h3>
    <p>
        A cached list of games is sent to the clients on import. Click the button below to bust this cache if you don't see your changes.
    </p>
    <Button Primary OnClick="ClearCacheAsync">Clear Cache</Button>

    <Divider />

    <h3>Download Clients</h3>
    <p>Check for any client releases for the current version and download them to this server.</p>
    <Button Primary OnClick="DownloadLaunchersAsync" Loading="DownloadingLaunchers">Download</Button>

    <Divider />

    <h3>Missing Archives</h3>
    <p>List and fix all archives that are missing their backing files.</p>
    <Button Primary Href="/Settings/Tools/MissingArchives">View Missing Archives</Button>

    <Divider />

    <h3>Orphaned Files</h3>
    <p>Find and delete any files that don't exist in the database and may be taking up unnecessary disk space.</p>
    <Button Primary Href="/Settings/Tools/OrphanedFiles">View Orphaned Files</Button>

    <Divider />

    <h3>Active Sessions</h3>
    <p>List and delete any active user play sessions.</p>
    <Button Primary Href="/Settings/Tools/ActiveSessions">View Active Sessions</Button>

    <Divider />

    <h3>Long Sessions</h3>
    <p>Find and delete any play sessions that ran longer than a configurable threshold.</p>
    <Button Primary Href="/Settings/Tools/LongSessions">View Long Sessions</Button>

    <Divider />

    <h3>Regenerate Page Routes</h3>
    <p>Fix any page routes that seem to be out of date or corrupt.</p>
    <Button Primary OnClick="FixPageRoutesAsync" Loading="FixingPageRoutes">Fix Routes</Button>

    <Divider />

    <h3>Regenerate Thumbnails</h3>
    <p>Clear out the existing thumbnail cache and generate replacements.</p>
    <Button Primary OnClick="RegenerateThumbnailsAsync" Loading="RegeneratingThumbnails">Regenerate</Button>

    <Divider />

    <h3>Optimize Images</h3>
    <p>Convert opaque PNG art to JPEG, downscale oversized media, and strip metadata to reclaim disk space while preserving quality.</p>
    <Button Primary Href="/Settings/Tools/OptimizeImages">Optimize Images</Button>
</PageContent>

@code {
    bool RecalculatingFileSizes;
    bool DownloadingLaunchers;
    bool FixingPageRoutes;
    bool RegeneratingThumbnails;

    async Task RecalculateFileSizesAsync()
    {
        RecalculatingFileSizes = true;

        try
        {
            var archives = await ArchiveService.AsNoTracking().GetAsync();

            var results = new List<bool>();

            foreach (var archive in archives)
                results.Add(await ArchiveService.RecalculateFileSizeArchiveAsync(archive));

            if (results.All(x => x))
                Notifications.Success("File sizes recalculated!");
            else
                Notifications.Warning("File sizes recalculated but some failed!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "File sizes could not be recalculated");
        }
        finally
        {
            RecalculatingFileSizes = false;
        }
    }

    async Task ClearCacheAsync()
    {
        try
        {
            await FusionCache.RemoveByTagAsync("Games");
            await FusionCache.RemoveByTagAsync("Depot");
            await FusionCache.RemoveByTagAsync("Library");
            await FusionCache.RemoveByTagAsync("Archives");

            Notifications.Success("Cache cleared!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The cache could not be cleared");
        }
    }

    async Task DownloadLaunchersAsync()
    {
        DownloadingLaunchers = true;

        try
        {
            await UpdateService.DownloadLatestLauncherReleaseAsync();

            Notifications.Success("Launchers downloaded!");
        }
        catch (ReleaseNotFoundException ex)
        {
            Notifications.Error($"Launchers could not be downloaded, unknown release {ex.Version}");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The launchers could not be downloaded");
        }
        finally
        {
            DownloadingLaunchers = false;
        }
    }

    async Task FixPageRoutesAsync()
    {
        FixingPageRoutes = true;

        try
        {
            await PageService.FixRoutesAsync();

            Notifications.Success("Routes fixed!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not fix all routes!");
        }
        finally
        {
            FixingPageRoutes = false;
        }
    }

    async Task RegenerateThumbnailsAsync()
    {
        RegeneratingThumbnails = true;

        try
        {
            var storageLocations = await StorageLocationService.GetAsync();

            foreach (var storageLocation in storageLocations.Where(l => l.Type == SDK.Enums.StorageLocationType.Media))
            {
                var thumbnailFiles = Directory.GetFiles(storageLocation.Path).Where(f => f.EndsWith(".Thumb"));

                foreach (var thumbnailFile in thumbnailFiles)
                    FileHelpers.DeleteIfExists(thumbnailFile);
            }

            BackgroundJob.Enqueue<GenerateThumbnailsJob>(x => x.ExecuteAsync());

            Notifications.Success("Cache has been cleared and is being regenerated in the background");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Thumbnails could not be regenerated");
        }
        finally
        {
            RegeneratingThumbnails = false;
        }
    }
}
