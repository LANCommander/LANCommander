@page "/Settings/Tools/MissingArchives"
@inject ArchiveService ArchiveService
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Missing Archives" />

<PageContent Loading="Archives == null" LoadingText="Checking every archive's file">
    <p>
        These archives are missing their backing file in the "Upload" directory of your server. This may result in broken downloads for clients. To fix, either upload a new file or delete the offending archive.
    </p>

    <Table TItem="Archive" Items="Archives" SettingsKey="settings-missing-archives">
        <Columns>
            <BoundColumn Property="a => a.Version" Sortable />
            <BoundColumn Property="a => a.Game != null ? a.Game.Title : String.Empty" Title="Game" Sortable />
            <BoundColumn Property="a => a.CreatedOn" Title="Created On" Sortable DefaultSort="ColumnSort.Descending">
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="a => a.CreatedBy != null ? a.CreatedBy.UserName : String.Empty" Title="Created By" Sortable />
            <ActionsColumn TItem="Archive">
                <Button Text Icon="IconType.UploadSimple" title="Upload" OnClick="() => UploadAsync(context)" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this archive?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </Table>
</PageContent>

<ArchiveUploader @ref="Uploader" OnArchiveUploaded="_ => LoadDataAsync()" />

@code {
    List<Archive>? Archives;

    ArchiveUploader? Uploader;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    async Task LoadDataAsync()
    {
        var missing = new List<Archive>();

        try
        {
            foreach (var archive in await ArchiveService.Include(a => a.Game).Include(a => a.CreatedBy).GetAsync())
            {
                var archivePath = await ArchiveService.GetArchiveFileLocationAsync(archive);

                if (!await ArchiveService.FileExistsAsync(archive.Id) || new FileInfo(archivePath).Length == 0)
                    missing.Add(archive);
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The archives could not be checked");
        }

        Archives = missing;
    }

    async Task UploadAsync(Archive archive)
    {
        try
        {
            var archiveFilePath = await ArchiveService.GetArchiveFileLocationAsync(archive);

            if (await ArchiveService.FileExistsAsync(archive.Id))
                File.Delete(archiveFilePath);

            File.Create(archiveFilePath).Close();

            await Uploader!.Open(archive.Id);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The upload could not be started");
        }
    }

    async Task DeleteAsync(Archive archive)
    {
        try
        {
            await ArchiveService.DeleteAsync(archive);

            await LoadDataAsync();

            Notifications.Success("Archive deleted!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Archive could not be deleted.");
        }
    }
}
