@page "/Settings/Tools/OptimizeImages"
@using Hangfire
@using LANCommander.Server.Jobs.Background
@using LANCommander.Server.Services.Models
@inject MediaService MediaService
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Optimize Images" />

<PageContent>
    <p>
        Reclaim disk space while preserving art quality. Opaque PNG art (backgrounds, covers, screenshots) is converted to high-quality JPEG, oversized images are downscaled, and metadata is stripped. Images with transparency (icons, logos) are never converted. Optimization replaces the original files in place and runs in the background.
    </p>

    <Form Model="Options" OnSubmit="ScanAsync">
        <FormItem Label="Convert opaque PNG to JPEG">
            <Switch @bind-Value="Options.ConvertPngToJpeg" />
        </FormItem>
        <FormItem Label="Downscale oversized images">
            <Switch @bind-Value="Options.Downscale" />
        </FormItem>
        <FormItem Label="Recompress existing JPEGs (lossy)">
            <Switch @bind-Value="Options.RecompressJpeg" />
        </FormItem>
        <FormItem Label="Recompress existing WebP (lossy)">
            <Switch @bind-Value="Options.RecompressWebp" />
        </FormItem>
        <FormItem Label="Strip metadata (EXIF/ICC/XMP)">
            <Switch @bind-Value="Options.StripMetadata" />
        </FormItem>
        <FormItem Label="JPEG quality">
            <NumberInput @bind-Value="Options.JpegQuality" Min="1" Max="100" />
        </FormItem>
        <FormItem Label="WebP quality">
            <NumberInput @bind-Value="Options.WebpQuality" Min="1" Max="100" />
        </FormItem>
        <FormItem Label="Max long edge (px)">
            <NumberInput @bind-Value="Options.MaxLongEdge" Min="256" />
        </FormItem>
    </Form>

    <Flex Align="Align.Center" Gap="Gap.Small" Style="margin-bottom: 16px">
        <Button Primary OnClick="ScanAsync" Loading="Loading">Scan</Button>
        <Popconfirm OnConfirm="Optimize" Title="Optimize all listed images? Originals will be replaced in place." OkText="Optimize" Disabled="@(!Candidates.Any())">
            <Button Disabled="@(!Candidates.Any())">Optimize Listed</Button>
        </Popconfirm>
    </Flex>

    <Spin Loading="Loading">
        <Table TItem="MediaOptimizationCandidate" Items="Candidates" Key="c => c" EmptyText="Scan to list the images that can be optimized" SettingsKey="settings-optimize-images">
            <Columns>
                <BoundColumn Property="c => c.GameTitle" Title="Game" Sortable />
                <BoundColumn Property="c => c.Type" Title="Type" Sortable />
                <BoundColumn Property="c => c.MimeType" Title="Format" Sortable />
                <TemplateColumn TItem="MediaOptimizationCandidate" Title="Dimensions">
                    @context.Width x @context.Height
                </TemplateColumn>
                <BoundColumn Property="c => c.Size" Title="Size" Sortable>
                    <ByteSize Value="context.Size" />
                </BoundColumn>
                <BoundColumn Property="c => c.PlannedAction" Title="Planned Action" />
            </Columns>
        </Table>
    </Spin>
</PageContent>

@code {
    MediaOptimizationOptions Options = new();
    ICollection<MediaOptimizationCandidate> Candidates = new List<MediaOptimizationCandidate>();
    bool Loading;

    async Task ScanAsync()
    {
        Loading = true;

        try
        {
            Candidates = await MediaService.ScanOptimizationCandidatesAsync(Options);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not scan media.");
        }
        finally
        {
            Loading = false;
        }
    }

    void Optimize()
    {
        try
        {
            BackgroundJob.Enqueue<OptimizeImagesJob>(x => x.ExecuteAsync(Options));

            Notifications.Success("Optimization is running in the background.");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Optimization could not be started");
        }
    }
}
