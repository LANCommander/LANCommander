@page "/Settings/Tools/OrphanedFiles"
@using LANCommander.Helpers
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject ArchiveService ArchiveService
@inject StorageLocationService StorageLocationService
@inject MediaService MediaService
@inject NotificationService Notifications

<PageHeader Title="Orphaned Files">
    <Extra>
        <Popconfirm OnConfirm="DeleteAllAsync" Title="Delete all orphan files?" OkText="Delete" Danger Disabled="@(!Orphans.Any())">
            <Button Primary Disabled="@(!Orphans.Any())">Delete All</Button>
        </Popconfirm>
    </Extra>
</PageHeader>

<PageContent>
    <p>
        These files exist on the server, but aren't linked in the database. Use this tool to identify and delete orphaned files.
    </p>

    <Spin Loading="Loading" Tip="Scanning storage locations">
        <Table TItem="OrphanedFile" Items="Orphans" Key="f => f.Path" SettingsKey="settings-orphaned-files">
            <Columns>
                <BoundColumn Property="f => f.Path" Sortable />
                <BoundColumn Property="f => f.Size" Sortable DefaultSort="ColumnSort.Descending">
                    <ByteSize Value="context.Size" />
                </BoundColumn>
                <BoundColumn Property="f => f.CreatedOn" Title="Created On" Sortable FormatString="MM/dd/yyyy hh:mm tt" />
                <ActionsColumn TItem="OrphanedFile">
                    <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this file?" OkText="Delete" Danger>
                        <Button Text Danger Icon="IconType.X" title="Delete" />
                    </Popconfirm>
                </ActionsColumn>
            </Columns>
        </Table>
    </Spin>
</PageContent>

@code {
    List<OrphanedFile> Orphans = new();
    bool Loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    async Task LoadDataAsync()
    {
        Loading = true;

        try
        {
            var orphans = new List<OrphanedFile>();

            var storageLocations = await StorageLocationService.GetAsync();
            var archives = await ArchiveService.GetAsync();
            var archiveFiles = await Task.WhenAll(archives.Select(a => ArchiveService.GetArchiveFileLocationAsync(a)));

            foreach (var storageLocation in storageLocations.Where(l => l.Type == SDK.Enums.StorageLocationType.Archive))
            {
                foreach (var file in Directory.GetFiles(storageLocation.Path).Where(f => !archiveFiles.Contains(f)))
                    orphans.Add(Orphan(file));
            }

            var media = await MediaService.Include(m => m.StorageLocation).GetAsync();
            var mediaFiles = media.Select(m => MediaService.GetMediaPath(m)).ToHashSet();

            foreach (var storageLocation in storageLocations.Where(l => l.Type == SDK.Enums.StorageLocationType.Media))
            {
                foreach (var file in Directory.GetFiles(storageLocation.Path).Where(f => !f.EndsWith(".Thumb") && !mediaFiles.Contains(f)))
                    orphans.Add(Orphan(file));
            }

            Orphans = orphans.OrderByDescending(f => f.Size).ToList();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The storage locations could not be scanned");
        }
        finally
        {
            Loading = false;
        }
    }

    static OrphanedFile Orphan(string path)
    {
        var fileInfo = new FileInfo(path);

        return new OrphanedFile
        {
            Path = path,
            Size = fileInfo.Length,
            CreatedOn = fileInfo.CreationTime
        };
    }

    async Task DeleteAsync(OrphanedFile file)
    {
        try
        {
            FileHelpers.DeleteIfExists(file.Path);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The file could not be deleted");
        }

        await LoadDataAsync();
    }

    async Task DeleteAllAsync()
    {
        try
        {
            foreach (var file in Orphans)
                FileHelpers.DeleteIfExists(file.Path);

            Notifications.Success("Orphaned files deleted!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Some files could not be deleted");
        }

        await LoadDataAsync();
    }
}
