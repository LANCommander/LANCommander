@page "/Settings/Updates"
@using LANCommander.Server.Services.Abstractions
@using LANCommander.Server.Settings
@using LANCommander.Server.Settings.Enums
@using Microsoft.Extensions.Options
@using Octokit
@using Semver
@inject NotificationService Notifications
@inject UpdateService UpdateService
@inject IGitHubService GitHubService
@inject IVersionProvider VersionProvider
@inject IOptions<Settings> Settings
@inject SettingsProvider<Settings> SettingsProvider
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Updates">
    <Extra>
        <Flex Justify="Justify.End" Align="Align.Center" Gap="Gap.Small">
            Release Channel:
            <EnumSelect TEnum="ReleaseChannel" @bind-Value="Settings.Value.Server.Update.ReleaseChannel" @bind-Value:after="ReleaseChannelChanged" Disabled="Loading" />
            <Button Primary OnClick="UpdateAsync" Disabled="@(!UpdateAvailable || Updating)" Loading="Updating">Update</Button>
        </Flex>
    </Extra>
</PageHeader>

<PageContent>
    <Flex Vertical Gap="Gap.Small">
        @if (_error != null)
        {
            <Alert Danger Title="Release information could not be loaded">
                <div>@_error</div>
                <Button Small Icon="IconType.ArrowClockwise" OnClick="CheckForUpdateAsync" Style="margin-top: 8px">Retry</Button>
            </Alert>
        }
        else if (!Loading && !UpdateAvailable)
        {
            <Alert Success>You are on the latest version!</Alert>
        }
        else if (!Loading && UpdateAvailable)
        {
            <Alert Info>A newer version of LANCommander is available</Alert>
        }
        else
        {
            <Alert Warning>Loading release information...</Alert>
        }

        @if (Releases.Any())
        {
            foreach (var release in Releases)
            {
                <Card>
                    <TitleTemplate>
                        @release.Name <span class="release-date">@release.PublishedAt.GetValueOrDefault().ToString("MMMM d yyyy")</span>

                        @if (Releases.First().Equals(release))
                        {
                            <Tag Warning>Latest</Tag>
                        }

                        @if (release.TagName == $"v{CurrentVersion}")
                        {
                            <Tag Primary>Current</Tag>
                        }
                    </TitleTemplate>
                    <Extra>
                        <a href="@release.HtmlUrl" target="_blank">View Release</a>
                    </Extra>
                    <ChildContent>
                        <Markdown Content="@release.Body" />
                    </ChildContent>
                </Card>
            }
        }
        else if (Loading)
        {
            for (var i = 0; i < 5; i++)
            {
                <Card Loading Style="min-height: 120px" />
            }
        }
    </Flex>
</PageContent>

@code {
    bool Loading { get; set; } = true;
    bool Updating { get; set; }
    bool UpdateAvailable { get; set; }
    SemVersion? CurrentVersion { get; set; }
    IEnumerable<Release> Releases { get; set; } = new List<Release>();
    string? _error;

    protected override async Task OnInitializedAsync()
    {
        await CheckForUpdateAsync();
    }

    async Task CheckForUpdateAsync()
    {
        Loading = true;
        _error = null;

        try
        {
            CurrentVersion = VersionProvider.GetCurrentVersion();
            UpdateAvailable = await UpdateService.UpdateAvailableAsync();
            Releases = await GitHubService.GetReleasesAsync(5);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    void ReleaseChannelChanged()
    {
        try
        {
            var releaseChannel = Settings.Value.Server.Update.ReleaseChannel;

            SettingsProvider.Update(s =>
            {
                s.Server.Update.ReleaseChannel = releaseChannel;
            });

            Notifications.Success($"Changed release channel to {releaseChannel}!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The release channel could not be changed");
        }
    }

    async Task UpdateAsync()
    {
        Updating = true;

        try
        {
            if (Settings.Value.Server.Launcher.HostUpdates)
                await UpdateService.DownloadLauncherReleaseAsync(Releases.First());

            await UpdateService.DownloadServerReleaseAsync(Releases.First());
        }
        catch (NotImplementedException ex)
        {
            Notifications.Error(ex, ex.Message);
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "An unknown error occurred while updating. Please check the logs");
        }
        finally
        {
            Updating = false;
        }
    }
}
