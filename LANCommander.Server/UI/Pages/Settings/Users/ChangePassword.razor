@page "/Settings/Users/{id:guid}/ChangePassword"
@using LANCommander.Server.Settings
@using Microsoft.Extensions.Options
@inject UserService UserService
@inject NotificationService Notifications
@inject IOptions<Settings> Settings
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Change Password" Subtitle="@User?.UserName" />

<PageContent Loading="!_loaded">
    @if (!AllowPassword)
    {
        <Alert Info>Password authentication is disabled by the administrator.</Alert>
    }
    else if (User == null)
    {
        <NotFound SubTitle="This user does not exist." />
    }
    else
    {
        <Form Model="Model" OnSubmit="ChangeAsync" Loading="_saving">
            <FormItem Label="New Password" Required>
                <PasswordInput @bind-Value="Model.NewPassword" />
            </FormItem>

            <FormItem Label="Confirm Password" Required>
                <PasswordInput @bind-Value="Model.NewPasswordConfirm" />
            </FormItem>

            <FormItem>
                <Button Primary Submit>Change</Button>
            </FormItem>
        </Form>
    }
</PageContent>

@code {
    [Parameter] public Guid Id { get; set; }

    User? User;
    ChangePasswordModel Model = new();
    bool _loaded;
    bool _saving;

    bool AllowPassword => Settings.Value.Server.Authentication.AllowPassword;

    protected override async Task OnInitializedAsync()
    {
        if (Id != Guid.Empty)
            User = await UserService.GetAsync(Id);

        _loaded = true;
    }

    async Task ChangeAsync()
    {
        if (!AllowPassword)
        {
            Notifications.Error("Password authentication is disabled by the administrator.");
            return;
        }

        if (Model.NewPassword != Model.NewPasswordConfirm)
        {
            Notifications.Error("Passwords do not match");
            return;
        }

        _saving = true;

        try
        {
            var result = await UserService.ChangePassword(User!.UserName, Model.NewPassword);

            if (!result.Succeeded)
            {
                foreach (var error in result.Errors)
                    Notifications.Error(error.Description);
            }
            else
            {
                Notifications.Success("Password changed!");

                Model = new();
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The user's password could not be changed");
        }
        finally
        {
            _saving = false;
        }
    }

    public class ChangePasswordModel
    {
        public string? NewPassword { get; set; }
        public string? NewPasswordConfirm { get; set; }
    }
}
