@using LANCommander.Server.Settings
@using Microsoft.Extensions.Options
@inherits Dialog<User>
@inject UserService UserService
@inject IOptions<Settings> Settings
@inject NotificationService Notifications

<Form @ref="_form" Model="Model" OnSubmit="ConfirmAsync">
    <FormItem Label="Username" Required>
        <TextInput @bind-Value="Model.UserName" AutoFocus />
    </FormItem>
    <FormItem Label="Password" Required>
        <PasswordInput @bind-Value="Model.Password" />
    </FormItem>
    <FormItem Label="Confirm Password" Required>
        <PasswordInput @bind-Value="Model.PasswordConfirm" />
    </FormItem>
    @if (Settings.Value.Server.Authentication.RequireApproval)
    {
        <FormItem Label="Approved">
            <Switch @bind-Value="Model.Approved" />
        </FormItem>
    }

    @* Enter in any field submits *@
    <button type="submit" hidden></button>
</Form>

@code {
    NewUserModel Model { get; set; } = new();
    Form? _form;

    protected override async Task<bool> OnOkAsync()
    {
        if (_form?.Validate() == false)
            return false;

        if (Model.Password != Model.PasswordConfirm)
        {
            Notifications.Error("Passwords do not match!");
            return false;
        }

        if (await UserService.ExistsAsync(u => u.UserName == Model.UserName))
        {
            Notifications.Error("A user with that username already exists!");
            return false;
        }

        var approved = !Settings.Value.Server.Authentication.RequireApproval || Model.Approved;

        var user = new User
        {
            UserName = Model.UserName,
            Approved = approved,
            ApprovedOn = approved ? DateTime.UtcNow : null,
        };

        var checkResult = await UserService.CheckRegister(user, Model.Password);

        if (!checkResult.Succeeded)
        {
            foreach (var error in checkResult.Errors)
                Notifications.Error(error.Description);

            return false;
        }

        user = await UserService.AddAsync(user);

        await UserService.ChangePassword(user.UserName, Model.Password);

        Notifications.Success($"Created {user.UserName}!");

        Result = user;

        return true;
    }

    public class NewUserModel
    {
        public string? UserName { get; set; }
        public string? Password { get; set; }
        public string? PasswordConfirm { get; set; }
        public bool Approved { get; set; } = true;
    }
}
