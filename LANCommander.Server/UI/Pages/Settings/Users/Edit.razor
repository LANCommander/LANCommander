@page "/Settings/Users/{username}"
@inject UserService UserService
@inject NotificationService Notifications
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Edit User">
    <Extra>
        <Button Primary Disabled="!IsModified" Loading="_saving" OnClick="SaveAsync">Save</Button>
    </Extra>
</PageHeader>

<PageContent Loading="!_loaded">
    @if (User == null)
    {
        <NotFound SubTitle="@($"There is no user named {Username}.")" />
    }
    else
    {
        <Form @ref="_form" Model="User" OnSubmit="SaveAsync" OnFieldChanged="StateHasChanged">
            <FormItem Label="Avatar">
                <AvatarUploader UserId="User.Id" />
            </FormItem>

            <FormItem Label="Username" Help="Username changes require a relog">
                <TextInput @bind-Value="User.UserName" />
            </FormItem>

            <FormItem Label="Alias">
                <TextInput @bind-Value="User.Alias" />
            </FormItem>

            <FormItem Label="Email Address" Help="Email changes require a relog">
                <TextInput @bind-Value="User.Email" />
            </FormItem>

            <Divider>Limits</Divider>

            <FormItem Label="Storage Quota (MB)" Help="0 or blank = unlimited; overrides role limits">
                <NumberInput TValue="int?" @bind-Value="User.StorageQuotaMB" Min="0" />
            </FormItem>

            <FormItem Label="Download Speed (KB/s)" Help="0 or blank = unlimited; overrides role limits">
                <NumberInput TValue="int?" @bind-Value="User.DownloadSpeedKBps" Min="0" />
            </FormItem>

            <FormItem Label="Cloud Saves" Help="Overrides role limits">
                <Select TValue="bool?" Items="SaveOptions" @bind-Value="User.EnableSaves" />
            </FormItem>

            <Divider>Custom Fields</Divider>

            @if (User.CustomFields.Count == 0)
            {
                <Empty Description="No custom fields exist for this user">
                    <Button Primary OnClick="AddField">Add Field</Button>
                </Empty>
            }
            else
            {
                foreach (var customField in User.CustomFields)
                {
                    <FormItem>
                        <Flex Gap="Gap.Medium" Align="Align.Center">
                            <TextInput @bind-Value="customField.Name" Placeholder="Name" MaxLength="64" Style="flex: 1" />
                            <TextInput @bind-Value="customField.Value" Placeholder="Value" MaxLength="1024" Style="flex: 1" />
                            <Button Text Danger Icon="IconType.X" title="Remove" OnClick="() => RemoveField(customField)" />
                        </Flex>
                    </FormItem>
                }

                <Flex Justify="Justify.End">
                    <Button Primary OnClick="AddField">Add Field</Button>
                </Flex>
            }
        </Form>
    }
</PageContent>

@code {
    [Parameter] public string Username { get; set; } = "";

    static readonly SelectItem<bool?>[] SaveOptions =
    [
        new(null, "Not set"),
        new(true, "Enabled"),
        new(false, "Disabled"),
    ];

    User? User;
    Form? _form;

    bool _loaded;
    bool _saving;
    bool FieldsModified;

    bool IsModified => (_form?.IsModified ?? false) || FieldsModified;

    protected override async Task OnInitializedAsync()
    {
        User = await UserService
            .Include(u => u.CustomFields)
            .FirstOrDefaultAsync(u => u.UserName == Username);

        if (User != null)
            User.CustomFields ??= new List<UserCustomField>();

        _loaded = true;
    }

    void AddField()
    {
        User!.CustomFields.Add(new UserCustomField());

        FieldsModified = true;
    }

    void RemoveField(UserCustomField customField)
    {
        User!.CustomFields.Remove(customField);

        FieldsModified = true;
    }

    async Task SaveAsync()
    {
        if (!IsModified)
            return;

        _saving = true;

        try
        {
            await UserService.UpdateAsync(User!);

            _form?.MarkAsUnmodified();
            FieldsModified = false;

            Notifications.Success("User updated!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "The user could not be saved");
        }
        finally
        {
            _saving = false;
        }
    }
}
