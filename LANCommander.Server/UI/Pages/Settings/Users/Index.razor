@page "/Settings/Users"
@using LANCommander.Server.Settings
@using LANCommander.Server.UI.Pages.Settings.Users.Components
@using Microsoft.Extensions.Options
@inject UserService UserService
@inject RoleService RoleService
@inject IOptions<Settings> Settings
@inject DialogService Dialogs
@inject NotificationService Notifications
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]

<PageHeader Title="Users" />

<PageContent>
    <DataTable TItem="User"
               @ref="Table"
               Small
               ColumnPicker
               SearchProperty="u => u.UserName"
               OnRowDoubleClick="@(user => NavigationManager.NavigateTo($"/Settings/Users/{user.UserName}"))">
        <RightToolbar>
            <Button Primary Icon="IconType.Plus" OnClick="CreateUserAsync">Add User</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="u => u.UserName" Title="Username" Sortable DefaultSort="ColumnSort.Ascending" />

            <TemplateColumn TItem="User" Title="Roles" Include="UserRoles,UserRoles.Role">
                @foreach (var role in context.Roles ?? [])
                {
                    <Tag>@role.Name</Tag>
                }
            </TemplateColumn>

            <TemplateColumn TItem="User" Title="Saves" Include="GameSaves">
                <ByteSize Value="@(context.GameSaves?.Sum(s => s.Size) ?? 0)" />
            </TemplateColumn>

            <BoundColumn Property="u => u.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>

            @if (Settings.Value.Server.Authentication.RequireApproval)
            {
                <BoundColumn Property="u => u.Approved" Title="Approved" Sortable>
                    <Checkbox Value="context.Approved" Disabled aria-label="Approved" />
                </BoundColumn>

                <BoundColumn Property="u => u.ApprovedOn" Title="Approved On" Sortable>
                    <LocalTime Value="context.ApprovedOn" />
                </BoundColumn>
            }

            <ActionsColumn TItem="User" Width="150px">
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Settings/Users/{context.UserName}")" title="Edit" />

                <Dropdown>
                    <Overlay>
                        <Menu>
                            @if (Settings.Value.Server.Authentication.RequireApproval && !context.Approved)
                            {
                                <MenuItem Icon="IconType.CheckCircle" OnClick="() => ApproveUserAsync(context)">Approve</MenuItem>
                            }

                            <MenuItem Icon="IconType.UsersThree" OnClick="() => ManageRolesAsync(context)">Manage Roles</MenuItem>
                            <MenuItem Icon="IconType.Key" Href="@($"/Settings/Users/{context.Id}/ChangePassword")">Change Password</MenuItem>

                            @if (!IsAdministrator(context))
                            {
                                <MenuItem Icon="IconType.ArrowFatUp" OnClick="() => PromoteUserAsync(context)">Promote</MenuItem>
                            }
                            else
                            {
                                <MenuItem Icon="IconType.ArrowFatDown" OnClick="() => DemoteUserAsync(context)">Demote</MenuItem>
                            }
                        </Menu>
                    </Overlay>
                    <ChildContent>
                        <Button Text Icon="IconType.DotsThree" title="More" />
                    </ChildContent>
                </Dropdown>

                <Popconfirm Title="Are you sure you want to delete this user?" OkText="Delete" Danger OnConfirm="() => DeleteUserAsync(context)">
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    DataTable<User> Table = default!;

    static bool IsAdministrator(User user) => user.Roles?.Any(r => r.Name == RoleService.AdministratorRoleName) ?? false;

    async Task<bool> IsOnlyAdministratorAsync(User user) =>
        IsAdministrator(user) && (await RoleService.GetUsersAsync(RoleService.AdministratorRoleName)).Count() == 1;

    async Task CreateUserAsync()
    {
        var user = await Dialogs.OpenAsync<CreateUserDialog, User>("Add a User", new DialogSettings { OkText = "Create" });

        if (user != null)
            await Table.ReloadAsync();
    }

    async Task ApproveUserAsync(User user)
    {
        try
        {
            var dbUser = await UserService.GetAsync(user.Id);

            if (dbUser != null)
            {
                dbUser.Approved = true;
                dbUser.ApprovedOn = DateTime.UtcNow;

                await UserService.UpdateAsync(dbUser);

                Notifications.Success($"Approved {user.UserName}!");

                await Table.ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not approve {user.UserName}");
        }
    }

    async Task PromoteUserAsync(User user)
    {
        try
        {
            await UserService.AddToRoleAsync(user.UserName, RoleService.AdministratorRoleName);

            Notifications.Success($"Promoted {user.UserName}!");

            await Table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not promote {user.UserName}");
        }
    }

    async Task DemoteUserAsync(User user)
    {
        try
        {
            if (await IsOnlyAdministratorAsync(user))
            {
                Notifications.Error("Cannot demote the only administrator!");
                return;
            }

            await UserService.RemoveFromRole(user.UserName, RoleService.AdministratorRoleName);

            Notifications.Success($"Demoted {user.UserName}!");

            await Table.ReloadAsync();
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not demote {user.UserName}");
        }
    }

    async Task DeleteUserAsync(User user)
    {
        try
        {
            if (await IsOnlyAdministratorAsync(user))
            {
                Notifications.Error("Cannot delete the only administrator!");
                return;
            }

            var dbUser = await UserService.GetAsync(user.Id);

            await UserService.DeleteAsync(dbUser);

            await Table.ReloadAsync();

            Notifications.Success($"Deleted {user.UserName}!");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, $"Could not delete {user.UserName}");
        }
    }

    async Task ManageRolesAsync(User user)
    {
        var updated = await Dialogs.OpenAsync<ManageRolesDialog, Guid, bool>("Manage Roles", user.Id, new DialogSettings
        {
            Size = DialogSize.Large,
            OkText = "Update Roles",
        });

        if (updated)
            await Table.ReloadAsync();
    }
}
