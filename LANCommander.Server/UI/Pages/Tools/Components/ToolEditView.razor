@inject ToolService ToolService
@inject NavigationManager NavigationManager
@inject NotificationService Notifications

<SideLayout>
    <Side>
        <Menu>
            @if (Id != Guid.Empty)
            {
                <MenuItem Icon="IconType.Info" Href="@($"/Tools/{Id}/General")" Exact>General</MenuItem>
                <MenuItem Icon="IconType.Play" Href="@($"/Tools/{Id}/Actions")">Actions</MenuItem>
                <MenuItem Icon="IconType.Archive" Href="@($"/Tools/{Id}/Archives")">Archives</MenuItem>
                <MenuItem Icon="IconType.Code" Href="@($"/Tools/{Id}/Scripts")">Scripts</MenuItem>
            }
            else
            {
                @* The other sections need a saved tool *@
                <MenuItem Icon="IconType.Info" Href="/Tools/Add">General</MenuItem>
            }
        </Menu>
    </Side>

    <ChildContent>
        <PageHeader>
            <TitleTemplate>
                @if (TitleTemplate != null)
                {
                    @TitleTemplate(Tool)
                }
                else
                {
                    @Title
                }
            </TitleTemplate>
            <Extra>
                @TitleExtraTemplate?.Invoke(Tool)
            </Extra>
        </PageHeader>

        @* PageContent catches errors, so a failing section leaves the menu and header usable *@
        <PageContent Loading="_loading">
            @if (!_loading && Tool.Id == Id)
            {
                <CascadingValue Value="Tool.Id" Name="ToolId">
                    @ChildContent?.Invoke(Tool)
                </CascadingValue>
            }
        </PageContent>
    </ChildContent>
</SideLayout>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment<Tool>? TitleTemplate { get; set; }
    [Parameter] public RenderFragment<Tool>? TitleExtraTemplate { get; set; }
    [Parameter] public RenderFragment<Tool>? ChildContent { get; set; }

    Tool Tool { get; set; } = new();
    Guid? _id;
    bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_id == Id)
            return;

        _id = Id;
        _loading = true;

        if (Id != Guid.Empty)
        {
            var tool = await ToolService
                .Include(r => r.Games)
                .Include(r => r.CreatedBy)
                .Include(r => r.UpdatedBy)
                .GetAsync(Id);

            if (tool == null)
            {
                NavigationManager.NavigateTo("/Tools");
                return;
            }

            Tool = tool;
        }
        else
            Tool = new();

        _loading = false;
    }

    public async Task Save()
    {
        try
        {
            if (Id != Guid.Empty)
            {
                await ToolService.UpdateAsync(Tool);

                Notifications.Success("Tool updated!");
            }
            else
            {
                Tool = await ToolService.AddAsync(Tool);

                Notifications.Success("Tool added!");

                NavigationManager.NavigateTo($"/Tools/{Tool.Id}");
            }
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Tool could not be saved!");
        }
    }
}
