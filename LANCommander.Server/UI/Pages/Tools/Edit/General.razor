@page "/Tools/{id:guid}"
@page "/Tools/{id:guid}/General"
@page "/Tools/Add"
@using LANCommander.SDK.Enums
@using LANCommander.Server.Models
@using LANCommander.Server.UI.Pages.Tools.Components
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject GameService GameService
@inject DialogService Dialogs

<ToolEditView @ref="EditView" Id="Id">
    <TitleTemplate>
        @(Id == Guid.Empty ? "Add New Tool" : "General")
    </TitleTemplate>
    <TitleExtraTemplate>
        @if (context.Id != Guid.Empty)
        {
            <Button Icon="IconType.Export" OnClick="() => OpenExportDialogAsync(context)">Export</Button>
        }

        <Button Primary OnClick="() => EditView!.Save()">Save</Button>
    </TitleExtraTemplate>
    <ChildContent>
        <Form Model="context" OnSubmit="() => EditView!.Save()">
            <FormItem Label="Name" Required>
                <TextInput @bind-Value="context.Name" AutoFocus="context.Id == Guid.Empty" />
            </FormItem>

            <FormItem Label="Notes">
                <TextArea @bind-Value="context.Notes" MaxLength="2000" Counter />
            </FormItem>

            <FormItem Label="Description">
                <TextArea @bind-Value="context.Description" MaxLength="500" Counter />
            </FormItem>

            <FormItem Label="Always Install" Help="When enabled, this tool is automatically installed with the game and hidden from the launcher's install options.">
                <Checkbox @bind-Value="context.AlwaysInstall" />
            </FormItem>

            <FormItem Label="Games">
                <Transfer TItem="Game"
                          Items="Games"
                          Values="context.Games"
                          ValuesChanged="games => context.Games = games.ToList()"
                          Text="g => g.Title"
                          SourceTitle="Available"
                          TargetTitle="Selected"
                          Searchable
                          Style="height: 350px" />
            </FormItem>
        </Form>
    </ChildContent>
</ToolEditView>

@code {
    [Parameter] public Guid Id { get; set; }

    ICollection<Game> Games = new List<Game>();
    ToolEditView? EditView;

    protected override async Task OnInitializedAsync()
    {
        Games = await GameService
            .AsNoTracking()
            .SortBy(g => String.IsNullOrWhiteSpace(g.SortTitle) ? g.Title : g.SortTitle)
            .GetAsync(g => g.Type == GameType.MainGame || g.ShowInLibrary || g.BaseGame == null);

        Games = Games.OrderByTitle(g => String.IsNullOrWhiteSpace(g.SortTitle) ? g.Title : g.SortTitle).ToList();
    }

    Task OpenExportDialogAsync(Tool tool) =>
        Dialogs.OpenAsync<ExportDialog, ExportDialogOptions, bool>($"Export {tool.Name}", new ExportDialogOptions
        {
            RecordId = tool.Id,
            RecordType = ImportExportRecordType.Tool,
        }, new DialogSettings { OkText = "Export" });
}
