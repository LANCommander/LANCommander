@page "/Tools"
@using LANCommander.Server.Models
@using ManifestType = LANCommander.SDK.Enums.ManifestType
@attribute [Authorize(Roles = RoleService.AdministratorRoleName)]
@inject ToolService ToolService
@inject DialogService Dialogs
@inject NavigationManager NavigationManager
@inject NotificationService Notifications

<PageHeader Title="Tools" Subtitle="@Total.ToString()" />

<PageContent>
    <DataTable TItem="Tool"
               @ref="Table"
               Small
               ColumnPicker
               @bind-Total="Total"
               SearchProperty="t => t.Name"
               OnRowDoubleClick="@(tool => NavigationManager.NavigateTo($"/Tools/{tool.Id}"))">
        <RightToolbar>
            <Button Icon="IconType.UploadSimple" OnClick="OpenImportDialogAsync">Import</Button>
            <Button Primary Icon="IconType.Plus" Href="/Tools/Add">Add Tool</Button>
        </RightToolbar>
        <Columns>
            <BoundColumn Property="t => t.Name" Sortable DefaultSort="ColumnSort.Ascending" />
            <BoundColumn Property="t => t.Games.Count" Title="Games" Sortable Include="Games" />
            <BoundColumn Property="t => t.CreatedOn" Title="Created On" Sortable>
                <LocalTime Value="context.CreatedOn" />
            </BoundColumn>
            <BoundColumn Property="t => t.CreatedBy != null ? t.CreatedBy.UserName : String.Empty" Title="Created By" Sortable Include="CreatedBy" />
            <BoundColumn Property="t => t.UpdatedOn" Title="Updated On" Sortable>
                <LocalTime Value="context.UpdatedOn" />
            </BoundColumn>
            <BoundColumn Property="t => t.UpdatedBy != null ? t.UpdatedBy.UserName : String.Empty" Title="Updated By" Sortable Include="UpdatedBy" />
            <ActionsColumn TItem="Tool">
                <Button Text Icon="IconType.PencilSimple" Href="@($"/Tools/{context.Id}")" title="Edit" />
                <Popconfirm OnConfirm="() => DeleteAsync(context)" Title="Are you sure you want to delete this tool?" OkText="Delete" Danger>
                    <Button Text Danger Icon="IconType.X" title="Delete" />
                </Popconfirm>
            </ActionsColumn>
        </Columns>
    </DataTable>
</PageContent>

@code {
    int Total;

    DataTable<Tool> Table = default!;

    async Task DeleteAsync(Tool tool)
    {
        try
        {
            await ToolService.DeleteAsync(tool);

            Notifications.Success($"Deleted {tool.Name}");
        }
        catch (Exception ex)
        {
            Notifications.Error(ex, "Could not delete the tool!");
        }

        await Table.ReloadAsync();
    }

    async Task OpenImportDialogAsync()
    {
        await Dialogs.OpenAsync<ImportUploadDialog, ImportDialogOptions, bool>("Import Tool", new ImportDialogOptions
        {
            Hint = "Only LCX files are supported for importing tools",
            ManifestType = ManifestType.Tool,
        }, new DialogSettings { NoFooter = true, Size = DialogSize.Large });

        await Table.ReloadAsync();
    }
}
