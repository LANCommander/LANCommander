@using Microsoft.AspNetCore.Components.Authorization
@using System.Reflection
@using LANCommander.Server.Plugins
@inject IEnumerable<UIRouteAssembly> RouteAssemblies
@inject IEnumerable<IServerRouteAssemblyExtension> PluginRouteAssemblies

<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="@_additionalAssemblies">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <NotFound />
        </LayoutView>
    </NotFound>
</Router>

@code {
    Assembly[] _additionalAssemblies = [];

    protected override void OnInitialized()
    {
        _additionalAssemblies = UIRouteAssembly.Resolve(RouteAssemblies, PluginRouteAssemblies);
    }
}
