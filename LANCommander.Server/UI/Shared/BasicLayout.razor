@using LANCommander.Server.Services.Abstractions
@inherits LayoutComponentBase
@inject IVersionProvider VersionProvider

@* A layout without navigation, for first-time setup *@
<div class="lc-layout lc-layout-basic">
    <div class="lc-layout-main">
        <main class="lc-layout-content lc-layout-content-basic">
            <ErrorHandler Title="Unexpected Error">
                @Body
            </ErrorHandler>
        </main>

        <footer class="lc-layout-footer">
            LANCommander v@(VersionProvider.GetCurrentVersion().ToString())
        </footer>
    </div>
</div>
