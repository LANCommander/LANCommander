@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using LANCommander.SDK.Enums
@using LANCommander.Server.Data
@using LANCommander.Server.Plugins
@using LANCommander.Server.Services.Enums
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<DatabaseContext> DatabaseContextFactory
@inject ServerManager ServerManager
@inject NavigationManager NavigationManager
@inject ILogger<MainMenu> Logger
@inject IEnumerable<IServerNavigationExtension> PluginNavigationExtensions
@inject IEnumerable<IServerRouteAssemblyExtension> PluginRouteAssemblies
@implements IDisposable
@implements IMenuInsertions

@* The sidebar's navigation. Items that front a list carry a count of it, never the records themselves *@
<Menu Variant="MenuVariant.Sidebar" Insertions="this">
    <SubMenu Name="@ServerNavigationSection.Dashboards" Title="Dashboards" Icon="IconType.Gauge">
        <MenuItem Href="/" Icon="IconType.SquaresFour" Exact>Overview</MenuItem>
        <MenuItem Href="/Dashboard/SessionPlaytime" Icon="IconType.Timer">Average Session Playtime</MenuItem>
    </SubMenu>
    <MenuDivider />

    @if (_user != null && _user.IsInRole(RoleService.AdministratorRoleName))
    {
        <MenuItem Href="/Games" Icon="IconType.GameController" Count="_games">Games</MenuItem>
        <SubMenu Name="@ServerNavigationSection.Metadata" Title="Metadata" Icon="IconType.Tag">
            <MenuItem Href="/Metadata/Collections" Icon="IconType.Stack">Collections</MenuItem>
            <MenuItem Href="/Metadata/Companies" Icon="IconType.Buildings">Companies</MenuItem>
            <MenuItem Href="/Metadata/Engines" Icon="IconType.Engine">Engines</MenuItem>
            <MenuItem Href="/Metadata/Genres" Icon="IconType.MaskHappy">Genres</MenuItem>
            <MenuItem Href="/Metadata/Platforms" Icon="IconType.Desktop">Platforms</MenuItem>
            <MenuItem Href="/Metadata/Tags" Icon="IconType.Tag">Tags</MenuItem>
        </SubMenu>
        <MenuItem Href="/Redistributables" Icon="IconType.Package">Redistributables</MenuItem>
        <MenuItem Href="/Tools" Icon="IconType.Wrench">Tools</MenuItem>
        <MenuItem Href="/Servers" Icon="IconType.HardDrives" Extra="@RunningServers">Servers</MenuItem>
        <SubMenu Name="@ServerNavigationSection.Scripting" Title="Scripting" Icon="IconType.Code">
            <MenuItem Href="/Scripting/Snippets" Icon="IconType.Scissors">Snippets</MenuItem>
            <MenuItem Href="/Scripting/Modules" Icon="IconType.Cube">Modules</MenuItem>
            <MenuItem Href="/Scripting/Variables" Icon="IconType.CurrencyDollar">Variables</MenuItem>
        </SubMenu>
        <MenuDivider />
        <SubMenu Name="@ServerNavigationSection.Pages" Title="Pages" Icon="IconType.BookOpen">
            <MenuItem Href="/Pages/Edit" Icon="IconType.PencilSimple">Edit</MenuItem>
            <MenuItem Href="/Pages" Icon="IconType.Eye" Exact>View</MenuItem>
        </SubMenu>
        <MenuItem Href="/Issues" Icon="IconType.Bug" Count="@(_openIssues is > 0 ? _openIssues : null)">Issues</MenuItem>
        <MenuItem Href="/Files" Icon="IconType.Folder">Files</MenuItem>
        <SubMenu Name="@ServerNavigationSection.Settings" Title="Settings" Icon="IconType.Gear">
            <MenuItem Href="/Settings/General" Icon="IconType.Sliders">General</MenuItem>
            <MenuItem Href="/Settings/Database" Icon="IconType.Database">Database</MenuItem>
            <MenuItem Href="/Settings/Users" Icon="IconType.Users">Users</MenuItem>
            <MenuItem Href="/Settings/Roles" Icon="IconType.ShieldCheck">Roles</MenuItem>
            <MenuItem Href="/Settings/Authentication" Icon="IconType.Key">Authentication</MenuItem>
            <MenuItem Href="/Settings/Appearance" Icon="IconType.Palette">Appearance</MenuItem>
            <MenuItem Href="/Settings/UserSaves" Icon="IconType.FloppyDisk">User Saves</MenuItem>
            <MenuItem Href="/Settings/Issues" Icon="IconType.Bug">Issues</MenuItem>
            <MenuItem Href="/Settings/Library" Icon="IconType.Books">Library</MenuItem>
            <MenuItem Href="/Settings/Archives" Icon="IconType.Archive">Archives</MenuItem>
            <MenuItem Href="/Settings/Media" Icon="IconType.Image">Media</MenuItem>
            <MenuItem Href="/Settings/Scripts" Icon="IconType.Scroll">Scripts</MenuItem>
            <MenuItem Href="/Settings/IPXRelay" Icon="IconType.Network">IPX Relay</MenuItem>
            <MenuItem Href="/Settings/Servers" Icon="IconType.HardDrives">Servers</MenuItem>
            <MenuItem Href="/Settings/Beacon" Icon="IconType.Broadcast">Beacon</MenuItem>
            <MenuItem Href="/Settings/Tools" Icon="IconType.Wrench">Tools</MenuItem>
            <MenuItem Href="/Settings/Logs" Icon="IconType.Article">Logs</MenuItem>
            <MenuItem Href="/Settings/Launcher" Icon="IconType.Rocket">Launcher</MenuItem>
            <MenuItem Href="/Settings/Plugins" Icon="IconType.PuzzlePiece">Plugins</MenuItem>
            <MenuItem Href="/Settings/Updates" Icon="IconType.ArrowsClockwise">Updates</MenuItem>
            <SubMenu Name="@ServerNavigationSection.Integrations" Title="Integrations" Icon="IconType.PlugsConnected">
                <MenuItem Href="/Settings/Integrations/HQ" Icon="IconType.Cloud">HQ</MenuItem>
                <MenuItem Href="/Settings/Integrations/IGDB" Icon="IconType.MagnifyingGlass">IGDB</MenuItem>
                <MenuItem Href="/Settings/Integrations/PCGamingWiki" Icon="IconType.BookOpenText">PCGamingWiki</MenuItem>
                <MenuItem Href="/Settings/Integrations/Webhooks" Icon="IconType.PlugsConnected">Webhooks</MenuItem>
                <MenuItem Href="/Settings/Integrations/SteamGridDB" Icon="IconType.ImageSquare">SteamGridDB</MenuItem>
            </SubMenu>
            <MenuItem Href="/api" Icon="IconType.BracketsCurly">API</MenuItem>
        </SubMenu>
    }
    else
    {
        <MenuItem Href="/Pages" Icon="IconType.BookOpen">Pages</MenuItem>
    }
</Menu>

@code {
    ClaimsPrincipal? _user;

    int? _games;
    int? _openIssues;
    int? _runningServers;
    PluginNavigation _plugins = new([]);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated ?? false)
            _user = authState.User;

        var pluginAssemblies = UIRouteAssembly.ResolvePluginAssemblies(PluginRouteAssemblies);

        _plugins = new(PluginNavigation.Resolve(PluginNavigationExtensions, Logger)
            .Where(extension => PluginNavigationVisibility.IsVisible(extension, _user, pluginAssemblies)));

        NavigationManager.LocationChanged += RefreshOnNavigation;

        await RefreshCountsAsync();
    }

    public RenderFragment? Start(string? group) => PluginItems(_plugins.Start(group));

    public RenderFragment? After(string? group, string anchor) => PluginItems(_plugins.After(group, anchor));

    public RenderFragment? End(string? group, IReadOnlySet<string> anchors)
    {
        var entries = PluginItems(_plugins.End(group, anchors));

        // The plugin area closes the top level, set apart from the built-in entries
        if (group != null || _plugins.PluginArea.Count == 0)
            return entries;

        return @<text>
            @entries
            <MenuDivider />
            @PluginItems(_plugins.PluginArea)
        </text>;
    }

    RenderFragment? PluginItems(IReadOnlyList<IServerNavigationExtension> entries) => entries.Count == 0 ? null : @<text>
        @foreach (var entry in entries)
        {
            <MenuItem Href="@entry.Href" Icon="@ParseIcon(entry.Icon)">@entry.Label</MenuItem>
        }
    </text>;

    static IconType ParseIcon(string? icon) =>
        Enum.TryParse<IconType>(icon, true, out var parsed) ? parsed : IconType.None;

    // Servers carry only a live dot while any is running, never a count
    RenderFragment? RunningServers => _runningServers is > 0
        ? @<text><span class="lc-sidebar-running" role="img" aria-label="@($"{_runningServers} running")"></span></text>
        : null;

    void RefreshOnNavigation(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        await RefreshCountsAsync();
        StateHasChanged();
    });

    /// <summary>The counts each query returns; the sidebar never loads the records themselves.</summary>
    async Task RefreshCountsAsync()
    {
        if (_user == null || !_user.IsInRole(RoleService.AdministratorRoleName))
            return;

        try
        {
            await using var context = await DatabaseContextFactory.CreateDbContextAsync();

            // The same rows the Games page lists (GameFilters.Listed)
            _games = await context.Set<Game>().CountAsync(g =>
                g.BaseGameId == null || g.BaseGameId == Guid.Empty || g.Type == GameType.MainGame || g.ShowInLibrary);

            _openIssues = await context.Set<Issue>().CountAsync(i => i.ResolvedOn == null);

            var running = 0;

            foreach (var serverId in await context.Set<Data.Models.Server>().Select(s => s.Id).ToListAsync())
            {
                if (ServerManager.IsManaging(serverId) && await ServerManager.GetStatusAsync(serverId) == ServerProcessStatus.Running)
                    running++;
            }

            _runningServers = running;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not count the sidebar's records");
        }
    }

    public void Dispose() => NavigationManager.LocationChanged -= RefreshOnNavigation;
}
