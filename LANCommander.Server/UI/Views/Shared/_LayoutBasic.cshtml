@using LANCommander.Server.Services.Abstractions
@inject IVersionProvider VersionProvider
@{
    var v = VersionProvider.GetCurrentVersion();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LANCommander</title>
    <base href="~/" />

    <component type="typeof(LANCommander.Server.UI.Controls.Theme)" render-mode="Static" />
    <link rel="stylesheet" href="_content/LANCommander.Server.UI/ui.css?v=@v" />
    <link rel="stylesheet" href="css/site.css?v=@v" />
    <link rel="stylesheet" href="css/app.css?v=@v" />
    <link rel="stylesheet" href="css/custom.css?v=@v" />
</head>
<body>
    <main class="layout-basic">
        @RenderBody()
    </main>

    <script src="~/_framework/blazor.server.js?v=@v"></script>
    <component type="typeof(LANCommander.Server.UI.Controls.ThemeScripts)" render-mode="Static" />
    <script src="~/js/site.js?v=@v"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
