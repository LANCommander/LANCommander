# Build directories. Anchored to the SDK root on purpose: an unanchored
# "build/" would also match vendor/picoposh/build/, which holds the tracked
# sources.list that our CMakeLists reads.
/build/
/build_test/
/cmake-build-*/
/out/

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo

# Compiled files
*.obj
*.o
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.exp
